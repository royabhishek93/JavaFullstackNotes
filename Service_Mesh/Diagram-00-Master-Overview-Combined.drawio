        <!-- ===================== USE CASE CAPTIONS ===================== -->
        <mxCell id="uc1" value="💡 Use Case: Polyglot microservices needing identical mTLS, retries &amp; observability without touching app code in every language." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=2;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="515" width="980" height="45" as="geometry" />
        </mxCell>
        <mxCell id="uc2" value="💡 Use Case: Deciding blast radius &amp; HA design — why prod runs 3-5 control-plane replicas so proxies keep working during an outage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=2;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1140" y="515" width="980" height="45" as="geometry" />
        </mxCell>
        <mxCell id="uc3" value="💡 Use Case: Encrypting service-to-service traffic + proving service identity for compliance (PCI-DSS, HIPAA) without app-level TLS code." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=2;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="2220" y="515" width="980" height="45" as="geometry" />
        </mxCell>
        <mxCell id="uc4" value="💡 Use Case: Shrinking PCI/compliance scope by restricting who can call payment-service, instead of one big cluster-wide firewall." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=2;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1055" width="980" height="45" as="geometry" />
        </mxCell>
        <mxCell id="uc5" value="💡 Use Case: Rolling out a risky new service version to 10% of real traffic first, catching bugs tests missed before 100% rollout." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=2;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1140" y="1055" width="980" height="45" as="geometry" />
        </mxCell>
        <mxCell id="uc6" value="💡 Use Case: Cross-region/cross-cloud failover (e.g. AWS outage) — routing traffic to a healthy replica in another cluster automatically." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=2;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="2220" y="1055" width="980" height="45" as="geometry" />
        </mxCell>
        <mxCell id="uc7" value="💡 Use Case: Connecting new Kubernetes microservices to a legacy database/app still on VMs, without migrating it first." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=2;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1655" width="980" height="45" as="geometry" />
        </mxCell>
        <mxCell id="uc8" value="💡 Use Case: Kubernetes-native platforms needing rich L7 traffic control (canary, retries, fault injection) via CRDs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=2;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1140" y="1655" width="980" height="45" as="geometry" />
        </mxCell>
        <mxCell id="uc9" value="💡 Use Case: Large enterprises with mixed VM + Kubernetes + multi-cloud needing one unified mesh across all environments." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=2;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="2220" y="1655" width="980" height="45" as="geometry" />
        </mxCell>

      </root>
