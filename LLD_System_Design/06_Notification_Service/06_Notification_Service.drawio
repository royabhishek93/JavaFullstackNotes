  <diagram name="Sequence Diagram" id="page2">
    <mxGraphModel pageWidth="1654" pageHeight="1169" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- LIFELINES -->
        <mxCell id="life_client" value="Client" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="140" height="550" as="geometry"/>
        </mxCell>
        <mxCell id="life_service" value="NotificationService" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="260" y="50" width="140" height="550" as="geometry"/>
        </mxCell>
        <mxCell id="life_queue" value="NotificationQueue" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="460" y="50" width="140" height="550" as="geometry"/>
        </mxCell>
        <mxCell id="life_worker" value="WorkerThread" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="660" y="50" width="140" height="550" as="geometry"/>
        </mxCell>
        <mxCell id="life_factory" value="SenderFactory" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="860" y="50" width="140" height="550" as="geometry"/>
        </mxCell>
        <mxCell id="life_sender" value="EmailSender" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1060" y="50" width="140" height="550" as="geometry"/>
        </mxCell>
        <mxCell id="life_limiter" value="RateLimiter" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1260" y="50" width="140" height="550" as="geometry"/>
        </mxCell>
        <mxCell id="life_api" value="External API (SendGrid)" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1460" y="50" width="150" height="550" as="geometry"/>
        </mxCell>

        <!-- MESSAGES -->

        <!-- 1: Client -> NotificationService: sendAsync(notification) -->
        <mxCell id="msg_1" value="sendAsync(notification)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="145" as="sourcePoint"/>
            <mxPoint x="330" y="145" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 2: NotificationService -> Queue: put(notification) -->
        <mxCell id="msg_2" value="put(notification)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="185" as="sourcePoint"/>
            <mxPoint x="530" y="185" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 3: return queued -->
        <mxCell id="ret_1" value="queued" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="215" as="sourcePoint"/>
            <mxPoint x="330" y="215" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 4: return to client (async) -->
        <mxCell id="ret_2" value="(returns immediately - async)" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="245" as="sourcePoint"/>
            <mxPoint x="130" y="245" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 5: Worker -> Queue: poll() -->
        <mxCell id="msg_3" value="poll(1, SECONDS)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="295" as="sourcePoint"/>
            <mxPoint x="530" y="295" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 6: return notification -->
        <mxCell id="ret_3" value="notification" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="325" as="sourcePoint"/>
            <mxPoint x="730" y="325" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 7: Worker -> SenderFactory: getSender(type) -->
        <mxCell id="msg_4" value="getSender(EMAIL)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="365" as="sourcePoint"/>
            <mxPoint x="930" y="365" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 8: return EmailSender -->
        <mxCell id="ret_4" value="EmailSender" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="930" y="395" as="sourcePoint"/>
            <mxPoint x="730" y="395" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 9: Worker -> EmailSender: send(notification) -->
        <mxCell id="msg_5" value="send(notification)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="435" as="sourcePoint"/>
            <mxPoint x="1130" y="435" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 10: EmailSender -> RateLimiter: allowRequest() -->
        <mxCell id="msg_6" value="allowRequest()" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1130" y="465" as="sourcePoint"/>
            <mxPoint x="1330" y="465" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 11: return true -->
        <mxCell id="ret_5" value="true" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1330" y="495" as="sourcePoint"/>
            <mxPoint x="1130" y="495" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 12: EmailSender -> External API: callEmailAPI -->
        <mxCell id="msg_7" value="callEmailAPI(email)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1130" y="535" as="sourcePoint"/>
            <mxPoint x="1535" y="535" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 13: return success -->
        <mxCell id="ret_6" value="200 OK / success" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1535" y="565" as="sourcePoint"/>
            <mxPoint x="1130" y="565" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 14: EmailSender sets status SENT, returns true to worker -->
        <mxCell id="ret_7" value="true (status=SENT)" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1130" y="595" as="sourcePoint"/>
            <mxPoint x="730" y="595" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 15: Worker notifies observers -->
        <mxCell id="msg_8" value="notifyObservers(notification, SUCCESS)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="635" as="sourcePoint"/>
            <mxPoint x="330" y="635" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 16: NotificationService notifies LoggingObserver + MetricsObserver -->
        <mxCell id="msg_9" value="onNotificationSent(notification)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="665" as="sourcePoint"/>
            <mxPoint x="130" y="665" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
