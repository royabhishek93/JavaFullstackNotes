          vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="270" height="26" as="geometry"/>
        </mxCell>

        <!-- msg_1: Client -> UrlShortenerService : shorten() -->
        <mxCell id="msg_1" value="1: shorten(longUrl, userId, alias, expiresAt)"
