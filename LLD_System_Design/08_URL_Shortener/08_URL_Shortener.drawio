        <!-- msg_11: UrlShortenerService -> EventPublisher : publish [async fire-and-forget] -->
        <mxCell id="msg_11" value="11: publish(&quot;clicks&quot;, ClickEvent)  [async — CompletableFuture]"
          style="endArrow=block;endFill=1;dashed=1;"
          edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="675" as="sourcePoint"/>
            <mxPoint x="1330" y="675" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ret_7: UrlShortenerService -> Client : longUrl (302 redirect) -->
        <mxCell id="ret_7" value="longUrl  [HTTP 302 redirect — keeps analytics]"
          style="endArrow=open;dashed=1;"
          edge="1" parent="1">
