          </mxGeometry>
        </mxCell>

        <!-- msg_10: UrlShortenerService -> CacheService : set() warm cache -->
        <mxCell id="msg_10" value="10: set(&quot;url:&quot;+shortCode, longUrl, 86400)  [populate cache for next hit]"
