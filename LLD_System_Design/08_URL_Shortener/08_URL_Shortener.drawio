        </mxCell>

        <!-- ret_3: Base62Encoder -> UrlShortenerService : shortCode (7 chars) -->
        <mxCell id="ret_3" value="shortCode (7 chars, Base62)  e.g. &quot;dnh75AB&quot;"
          style="endArrow=open;dashed=1;"
          edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="325" as="sourcePoint"/>
            <mxPoint x="330" y="325" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- msg_5: UrlShortenerService -> UrlRepository : save(shortUrl) -->
        <mxCell id="msg_5" value="5: save(new ShortUrl(shortCode, longUrl, userId, expiresAt))"
          style="endArrow=block;endFill=1;"
          edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="355" as="sourcePoint"/>
            <mxPoint x="930" y="355" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- msg_6: UrlShortenerService -> CacheService : set() warm cache -->
        <mxCell id="msg_6" value="6: set(&quot;url:&quot;+shortCode, longUrl, 86400)  [warm cache 24h TTL]"
          style="endArrow=block;endFill=1;"
          edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="385" as="sourcePoint"/>
            <mxPoint x="1130" y="385" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ret_4: UrlShortenerService -> Client : shortCode -->
        <mxCell id="ret_4" value="shortCode  [e.g. dnh75AB]"
