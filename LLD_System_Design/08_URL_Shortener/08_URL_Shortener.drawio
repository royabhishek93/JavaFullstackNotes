            <mxPoint x="1130" y="525" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ret_5: CacheService -> UrlShortenerService : null (cache miss) -->
        <mxCell id="ret_5" value="null  [cache miss — first request]"
