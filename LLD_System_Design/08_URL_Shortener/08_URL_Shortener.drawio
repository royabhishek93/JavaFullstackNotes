            <mxPoint x="530" y="235" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ret_2: SnowflakeIdGenerator -> UrlShortenerService : unique long id -->
        <mxCell id="ret_2" value="unique long id  [timestamp|machineId|seq]"
          style="endArrow=open;dashed=1;"
          edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="265" as="sourcePoint"/>
            <mxPoint x="330" y="265" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- msg_4: UrlShortenerService -> Base62Encoder : encode(id) -->
        <mxCell id="msg_4" value="4: encode(id)"
