  <diagram name="Sequence Diagram" id="page2">
    <mxGraphModel pageWidth="1654" pageHeight="1169" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ═══ LIFELINES ═══ -->
        <!-- 200px apart starting x=60, width=140 -->
        <!-- Centers: Publisher=130, EventBus=330, InventoryHandler=530, EmailHandler=730, DeadLetterQueue=930 -->

        <mxCell id="life_1" value="Publisher (OrderSvc)" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="140" height="620" as="geometry"/>
        </mxCell>
        <mxCell id="life_2" value="EventBus" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="260" y="50" width="140" height="620" as="geometry"/>
        </mxCell>
        <mxCell id="life_3" value="InventoryHandler" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="460" y="50" width="140" height="620" as="geometry"/>
        </mxCell>
        <mxCell id="life_4" value="EmailHandler" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="660" y="50" width="140" height="620" as="geometry"/>
        </mxCell>
        <mxCell id="life_5" value="DeadLetterQueue" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="860" y="50" width="140" height="620" as="geometry"/>
        </mxCell>

        <!-- ═══ MESSAGES ═══ -->

        <!-- 1. Publisher → EventBus: publish -->
        <mxCell id="msg_1" value="1. publish(&quot;orders&quot;, new Order(...))" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="160" as="sourcePoint"/>
            <mxPoint x="330" y="160" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 2a. EventBus → InventoryHandler: async dispatch -->
        <mxCell id="msg_2" value="2a. [async] deliverWithRetry(event, inventorySub, 0)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="210" as="sourcePoint"/>
            <mxPoint x="530" y="210" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ret_1: InventoryHandler success -->
        <mxCell id="ret_1" value="success (stock deducted)" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="250" as="sourcePoint"/>
            <mxPoint x="330" y="250" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 2b. EventBus → EmailHandler: async dispatch attempt 1 -->
        <mxCell id="msg_3" value="2b. [async] deliverWithRetry(event, emailSub, 0) — attempt 1" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="300" as="sourcePoint"/>
            <mxPoint x="730" y="300" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ret_2: EmailHandler throws -->
        <mxCell id="ret_2" value="throws RuntimeException (&quot;Email server down&quot;)" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="340" as="sourcePoint"/>
            <mxPoint x="330" y="340" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 3a. EventBus → EmailHandler: retry +1s attempt 2 -->
        <mxCell id="msg_4" value="3a. [retry +1s] deliverWithRetry(event, emailSub, 1) — attempt 2" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="400" as="sourcePoint"/>
            <mxPoint x="730" y="400" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ret_3: EmailHandler throws -->
        <mxCell id="ret_3" value="throws RuntimeException" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="440" as="sourcePoint"/>
            <mxPoint x="330" y="440" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 3b. EventBus → EmailHandler: retry +2s attempt 3 -->
        <mxCell id="msg_5" value="3b. [retry +2s] deliverWithRetry(event, emailSub, 2) — attempt 3" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="490" as="sourcePoint"/>
            <mxPoint x="730" y="490" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ret_4: EmailHandler maxRetries exhausted -->
        <mxCell id="ret_4" value="throws RuntimeException (maxRetries=3 exhausted)" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="530" as="sourcePoint"/>
            <mxPoint x="330" y="530" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 4. EventBus → DeadLetterQueue: enqueue -->
        <mxCell id="msg_6" value="4. dlq.enqueue(event, &quot;EmailHandler&quot;, cause)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="580" as="sourcePoint"/>
            <mxPoint x="930" y="580" as="targetPoint"/>
