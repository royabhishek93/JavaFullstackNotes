        <mxCell id="enum_gamestatus" value="&lt;&lt;enum&gt;&gt;&#xa;GameStatus" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1370" y="570" width="170" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="enum_gs_v1" value="ACTIVE" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="enum_gamestatus">
          <mxGeometry x="0" y="30" width="170" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="enum_gs_v2" value="CHECK" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="enum_gamestatus">
          <mxGeometry x="0" y="52" width="170" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="enum_gs_v3" value="CHECKMATE" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="enum_gamestatus">
          <mxGeometry x="0" y="74" width="170" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="enum_gs_v4" value="STALEMATE" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="enum_gamestatus">
          <mxGeometry x="0" y="96" width="170" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="enum_gs_v5" value="DRAW" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="enum_gamestatus">
          <mxGeometry x="0" y="118" width="170" height="22" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- RELATIONSHIPS / EDGES                                   -->
        <!-- ═══════════════════════════════════════════════════════ -->

        <!-- Extends: King/Queen/Rook/Bishop/Knight/Pawn → Piece -->
        <mxCell id="edge_king_piece" value="" style="endArrow=block;endFill=0;" edge="1" source="class_king" target="class_piece" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge_queen_piece" value="" style="endArrow=block;endFill=0;" edge="1" source="class_queen" target="class_piece" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge_rook_piece" value="" style="endArrow=block;endFill=0;" edge="1" source="class_rook" target="class_piece" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge_bishop_piece" value="" style="endArrow=block;endFill=0;" edge="1" source="class_bishop" target="class_piece" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge_knight_piece" value="" style="endArrow=block;endFill=0;" edge="1" source="class_knight" target="class_piece" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge_pawn_piece" value="" style="endArrow=block;endFill=0;" edge="1" source="class_pawn" target="class_piece" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Implements: King → CastlingCapable (dashed) -->
        <mxCell id="edge_king_castling" value="" style="endArrow=block;endFill=0;dashed=1;" edge="1" source="class_king" target="iface_castling" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Implements: Pawn → PromotionCapable (dashed) -->
        <mxCell id="edge_pawn_promo" value="" style="endArrow=block;endFill=0;dashed=1;" edge="1" source="class_pawn" target="iface_promo" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Implements: Pawn → EnPassantCapable (dashed) -->
        <mxCell id="edge_pawn_enpassant" value="" style="endArrow=block;endFill=0;dashed=1;" edge="1" source="class_pawn" target="iface_enpassant" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Uses: Game → Board (1 uses 1) -->
        <mxCell id="edge_game_board" value="1 uses 1" style="endArrow=open;" edge="1" source="class_game" target="class_board" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Uses: Game → Move (1 records *) -->
        <mxCell id="edge_game_move" value="1 records *" style="endArrow=open;" edge="1" source="class_game" target="class_move" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Uses: Game → Player (has 2) -->
        <mxCell id="edge_game_player" value="has 2" style="endArrow=open;" edge="1" source="class_game" target="class_player" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Uses: Game → GameStatus -->
        <mxCell id="edge_game_gs" value="uses" style="endArrow=open;" edge="1" source="class_game" target="enum_gamestatus" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Uses: Board → Piece (contains 0..*) -->
        <mxCell id="edge_board_piece" value="contains 0..*" style="endArrow=open;" edge="1" source="class_board" target="class_piece" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Uses: Move → Position (has 2) -->
        <mxCell id="edge_move_pos" value="has 2" style="endArrow=open;" edge="1" source="class_move" target="class_position" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Uses: Piece → Position (has 1) -->
        <mxCell id="edge_piece_pos" value="has 1" style="endArrow=open;" edge="1" source="class_piece" target="class_position" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Uses: Piece → Color -->
        <mxCell id="edge_piece_color" value="uses" style="endArrow=open;" edge="1" source="class_piece" target="enum_color" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Uses: Move → Piece -->
        <mxCell id="edge_move_piece" value="ref" style="endArrow=open;" edge="1" source="class_move" target="class_piece" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- ISP: Valuable interface  (y=40)                         -->
        <!-- ═══════════════════════════════════════════════════════ -->

        <!-- Valuable -->
        <mxCell id="iface_Valuable" value="&lt;&lt;interface&gt;&gt;&#xa;Valuable" style="swimlane;fontStyle=3;startSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="760" y="40" width="220" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="iface_Valuable_m1" value="+ getValue(): int" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="iface_Valuable">
          <mxGeometry x="0" y="40" width="220" height="25" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- FOLLOW-UP: HumanPlayer + AIPlayer  (y=780)              -->
        <!-- ═══════════════════════════════════════════════════════ -->

        <!-- HumanPlayer -->
        <mxCell id="class_HumanPlayer" value="HumanPlayer" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1180" y="780" width="190" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="class_HumanPlayer_m1" value="+ getNextMove(board): Move" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="class_HumanPlayer">
          <mxGeometry x="0" y="30" width="190" height="22" as="geometry"/>
        </mxCell>

        <!-- AIPlayer -->
        <mxCell id="class_AIPlayer" value="AIPlayer" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1390" y="780" width="220" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="class_AIPlayer_m1" value="+ getNextMove(board): Move" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="class_AIPlayer">
          <mxGeometry x="0" y="30" width="220" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="class_AIPlayer_m2" value="- minimax(board, depth, isMaximizing): MoveScore" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="class_AIPlayer">
          <mxGeometry x="0" y="52" width="220" height="22" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- NEW IMPLEMENTS EDGES                                     -->
        <!-- ═══════════════════════════════════════════════════════ -->

        <!-- Implements: HumanPlayer → Player (dashed) -->
        <mxCell id="edge_humanplayer_player" value="" style="endArrow=block;endFill=0;dashed=1;" edge="1" source="class_HumanPlayer" target="class_player" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Implements: AIPlayer → Player (dashed) -->
        <mxCell id="edge_aiplayer_player" value="" style="endArrow=block;endFill=0;dashed=1;" edge="1" source="class_AIPlayer" target="class_player" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Implements: Queen → Valuable (dashed) -->
        <mxCell id="edge_queen_valuable" value="" style="endArrow=block;endFill=0;dashed=1;" edge="1" source="class_queen" target="iface_Valuable" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Sequence Diagram" id="page2">
    <mxGraphModel pageWidth="1654" pageHeight="1169" grid="1" gridSize="10">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- LIFELINES  (y=50, width=140, height=550, gap=200)       -->
        <!-- Centres: Player=130  Game=330  Board=530  Piece=730  King=930 -->
        <!-- ═══════════════════════════════════════════════════════ -->

        <mxCell id="life_player" value="Player" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="140" height="550" as="geometry"/>
        </mxCell>
        <mxCell id="life_game" value="Game" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="260" y="50" width="140" height="550" as="geometry"/>
        </mxCell>
        <mxCell id="life_board" value="Board" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="460" y="50" width="140" height="550" as="geometry"/>
        </mxCell>
        <mxCell id="life_piece" value="Piece (Pawn)" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="660" y="50" width="140" height="550" as="geometry"/>
        </mxCell>
        <mxCell id="life_king" value="King" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="860" y="50" width="140" height="550" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- MESSAGES                                                -->
        <!-- ═══════════════════════════════════════════════════════ -->

        <!-- 1. Player → Game: makeMove(from="e2", to="e4") -->
        <mxCell id="msg_1" value="1. makeMove(from=e2, to=e4)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="140" as="sourcePoint"/>
            <mxPoint x="330" y="140" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 2. Game → Board: getPiece(from) -->
        <mxCell id="msg_2" value="2. getPiece(e2)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="175" as="sourcePoint"/>
            <mxPoint x="530" y="175" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ret_2: Board → Game: Pawn -->
        <mxCell id="ret_2" value="Pawn" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="195" as="sourcePoint"/>
            <mxPoint x="330" y="195" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 3. Game → Piece: canMove(board, e4) -->
        <mxCell id="msg_3" value="3. canMove(board, e4)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="225" as="sourcePoint"/>
            <mxPoint x="730" y="225" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ret_3: Piece → Game: true -->
        <mxCell id="ret_3" value="true" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="245" as="sourcePoint"/>
            <mxPoint x="330" y="245" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 4. Game → Board: getPiece(to) — check target square -->
        <mxCell id="msg_4" value="4. getPiece(e4)  [check target]" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="275" as="sourcePoint"/>
            <mxPoint x="530" y="275" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ret_4: Board → Game: null (empty square) -->
        <mxCell id="ret_4" value="null  (empty)" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="295" as="sourcePoint"/>
            <mxPoint x="330" y="295" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 5. Game → Board: simulateMove(e2, e4) -->
        <mxCell id="msg_5" value="5. simulateMove(e2, e4)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="325" as="sourcePoint"/>
            <mxPoint x="530" y="325" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 6. Game → Board: getAllPieces(BLACK)  [isKingInCheck] -->
        <mxCell id="msg_6" value="6. getAllPieces(BLACK)  [check detection]" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="360" as="sourcePoint"/>
            <mxPoint x="530" y="360" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ret_6: Board → Game: opponentPieces -->
        <mxCell id="ret_6" value="opponentPieces" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="378" as="sourcePoint"/>
            <mxPoint x="330" y="378" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 7. Game → King: canMove(board, kingPos)  [loop for each opponent piece] -->
        <mxCell id="msg_7" value="7. [for each opponent] canMove(board, kingPos)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="405" as="sourcePoint"/>
            <mxPoint x="930" y="405" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ret_7: King → Game: false (king not in check) -->
        <mxCell id="ret_7" value="false  (king not threatened)" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="930" y="425" as="sourcePoint"/>
            <mxPoint x="330" y="425" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 8. Game → Board: undoSimulation -->
        <mxCell id="msg_8" value="8. undoSimulation(e2, e4, piece, captured)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="455" as="sourcePoint"/>
            <mxPoint x="530" y="455" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 9. Game → Board: movePiece(e2, e4)  [real move] -->
        <mxCell id="msg_9" value="9. movePiece(e2, e4)  [execute real move]" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="490" as="sourcePoint"/>
            <mxPoint x="530" y="490" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 10. Game: record Move + updateGameStatus() -->
        <mxCell id="msg_10" value="10. new Move(e2,e4,pawn,null)  +  updateGameStatus()" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="525" as="sourcePoint"/>
            <mxPoint x="330" y="525" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ret_final: Game → Player: true (move successful) -->
        <mxCell id="ret_final" value="true  (move accepted, status=ACTIVE)" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="555" as="sourcePoint"/>
            <mxPoint x="130" y="555" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- NOTES                                                   -->
        <!-- ═══════════════════════════════════════════════════════ -->

        <!-- Note: Strategy Pattern callout -->
        <mxCell id="note_strategy" value="Strategy Pattern:&#xa;canMove() is polymorphic.&#xa;Game calls Piece.canMove()&#xa;without knowing the type." style="shape=note;whiteSpace=wrap;align=left;fontSize=10;fillColor=#ffffc0;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1000" y="200" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- Note: Facade callout -->
        <mxCell id="note_facade" value="Facade Pattern:&#xa;Game hides Board, Piece,&#xa;Move complexity behind&#xa;simple makeMove() API." style="shape=note;whiteSpace=wrap;align=left;fontSize=10;fillColor=#ffffc0;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1000" y="310" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- Note: Command Pattern callout -->
        <mxCell id="note_command" value="Command Pattern:&#xa;Move object stores full&#xa;context for undo/redo&#xa;and history replay." style="shape=note;whiteSpace=wrap;align=left;fontSize=10;fillColor=#ffffc0;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1000" y="420" width="200" height="80" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
