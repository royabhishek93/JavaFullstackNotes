  <diagram name="Sequence Diagram" id="page2">
    <mxGraphModel pageWidth="1654" pageHeight="1169" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ═══════════════════ LIFELINES ═══════════════════ -->
        <!-- Lifeline centers: User=130, Controller=330, Scheduler=530, Elevator=730, Door=930 -->
        <mxCell id="life_user" value="User" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="140" height="550" as="geometry"/>
        </mxCell>
        <mxCell id="life_controller" value="ElevatorController" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="260" y="50" width="140" height="550" as="geometry"/>
        </mxCell>
        <mxCell id="life_scheduler" value="ElevatorScheduler" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="460" y="50" width="140" height="550" as="geometry"/>
        </mxCell>
        <mxCell id="life_elevator" value="Elevator" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="660" y="50" width="140" height="550" as="geometry"/>
        </mxCell>
        <mxCell id="life_door" value="Door" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="860" y="50" width="140" height="550" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════ MESSAGES ═══════════════════ -->
        <!-- 1. User → ElevatorController: requestElevator(floor, direction) -->
        <mxCell id="msg_1" value="requestElevator(floor, direction)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="160" as="sourcePoint"/>
            <mxPoint x="330" y="160" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 2. ElevatorController → ElevatorScheduler: selectElevator(elevators, floor, direction) -->
        <mxCell id="msg_2" value="selectElevator(elevators, floor, direction)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="210" as="sourcePoint"/>
            <mxPoint x="530" y="210" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 3. ElevatorScheduler → ElevatorController: return bestElevator -->
        <mxCell id="ret_1" value="return bestElevator" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="255" as="sourcePoint"/>
            <mxPoint x="330" y="255" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 4. ElevatorController → Elevator: addRequest(floor) -->
        <mxCell id="msg_3" value="addRequest(floor)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="300" as="sourcePoint"/>
            <mxPoint x="730" y="300" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 5. Elevator → Elevator: processRequests() (self-call) -->
        <mxCell id="msg_4" value="processRequests()" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="345" as="sourcePoint"/>
            <mxPoint x="800" y="345" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="800" y="345"/>
              <mxPoint x="800" y="365"/>
              <mxPoint x="730" y="365"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 6. Elevator moves up/down (note) -->
        <mxCell id="msg_5" value="moveUp() / moveDown()" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="395" as="sourcePoint"/>
            <mxPoint x="800" y="395" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="800" y="395"/>
              <mxPoint x="800" y="415"/>
              <mxPoint x="730" y="415"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 7. Elevator → Door: open() -->
        <mxCell id="msg_6" value="open()" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="450" as="sourcePoint"/>
            <mxPoint x="930" y="450" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 8. Door → Elevator: return -->
        <mxCell id="ret_2" value="doors opened" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="930" y="490" as="sourcePoint"/>
            <mxPoint x="730" y="490" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 9. Elevator → Door: close() -->
        <mxCell id="msg_7" value="close()" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="530" as="sourcePoint"/>
            <mxPoint x="930" y="530" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 10. Door → Elevator: return -->
        <mxCell id="ret_3" value="doors closed" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="930" y="570" as="sourcePoint"/>
            <mxPoint x="730" y="570" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Sequence diagram title note -->
        <mxCell id="seq_note" value="Main Flow: requestElevator() — Nearest Car Selection" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="10" width="600" height="30" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
