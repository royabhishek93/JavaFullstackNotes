        <mxCell id="class_Movie" value="Movie" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="750" width="250" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="class_Movie_f1" value="-title: String" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="class_Movie">
          <mxGeometry x="0" y="30" width="250" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="class_Movie_f2" value="-genre: String" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="class_Movie">
          <mxGeometry x="0" y="52" width="250" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="class_Movie_f3" value="-duration: int" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="class_Movie">
          <mxGeometry x="0" y="74" width="250" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="class_Movie_f4" value="-rating: String" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="class_Movie">
          <mxGeometry x="0" y="96" width="250" height="22" as="geometry"/>
        </mxCell>

        <!-- Theatre -->
        <mxCell id="class_Theatre" value="Theatre" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="320" y="750" width="260" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="class_Theatre_f1" value="-name: String" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="class_Theatre">
          <mxGeometry x="0" y="30" width="260" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="class_Theatre_f2" value="-location: String" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="class_Theatre">
          <mxGeometry x="0" y="52" width="260" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="class_Theatre_f3" value="-screens: List&lt;Screen&gt;" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="class_Theatre">
          <mxGeometry x="0" y="74" width="260" height="22" as="geometry"/>
        </mxCell>

        <!-- Screen -->
        <mxCell id="class_Screen" value="Screen" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="610" y="750" width="260" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="class_Screen_f1" value="-screenNumber: int" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="class_Screen">
          <mxGeometry x="0" y="30" width="260" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="class_Screen_f2" value="-rows: int" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="class_Screen">
          <mxGeometry x="0" y="52" width="260" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="class_Screen_f3" value="-seats: List&lt;Seat&gt;" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="class_Screen">
          <mxGeometry x="0" y="74" width="260" height="22" as="geometry"/>
        </mxCell>

        <!-- ===== EXCEPTION CLASSES (green) ===== -->

        <!-- SeatNotAvailableException -->
        <mxCell id="class_SeatNotAvail" value="&lt;&lt;exception&gt;&gt;&#xa;SeatNotAvailableException" style="swimlane;startSize=40;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="900" y="750" width="280" height="40" as="geometry"/>
        </mxCell>

        <!-- PaymentFailedException -->
        <mxCell id="class_PaymentFailed" value="&lt;&lt;exception&gt;&gt;&#xa;PaymentFailedException" style="swimlane;startSize=40;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1210" y="750" width="280" height="40" as="geometry"/>
        </mxCell>

        <!-- HoldExpiredException -->
        <mxCell id="class_HoldExpired" value="&lt;&lt;exception&gt;&gt;&#xa;HoldExpiredException" style="swimlane;startSize=40;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1210" y="820" width="280" height="40" as="geometry"/>
        </mxCell>

        <!-- ===== NEW EDGES ===== -->

        <!-- Screen has-a Seat -->
        <mxCell id="edge_screen_seat" value="has-a" style="endArrow=open;" edge="1" source="class_Screen" target="class_seat" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Theatre has-a Screen -->
        <mxCell id="edge_theatre_screen" value="has-a" style="endArrow=open;" edge="1" source="class_Theatre" target="class_Screen" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="Sequence Diagram" id="page2">
    <mxGraphModel pageWidth="1654" pageHeight="1169" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ===== LIFELINES ===== -->

        <mxCell id="life_user" value="User" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="140" height="650" as="geometry"/>
        </mxCell>

        <mxCell id="life_bs" value="BookingService" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="260" y="50" width="140" height="650" as="geometry"/>
        </mxCell>

        <mxCell id="life_show" value="Show" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="460" y="50" width="140" height="650" as="geometry"/>
        </mxCell>

        <mxCell id="life_pg" value="PaymentGateway" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="660" y="50" width="140" height="650" as="geometry"/>
        </mxCell>

        <mxCell id="life_ns" value="NotificationService" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="860" y="50" width="140" height="650" as="geometry"/>
        </mxCell>

        <!-- ===== MESSAGES — HOLD PHASE ===== -->

        <!-- 1. User -> BookingService: holdSeats -->
        <mxCell id="msg_1" value="holdSeats(userId, showId, seatIds)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="150" as="sourcePoint"/>
            <mxPoint x="330" y="150" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 2. BookingService -> Show: holdSeats -->
        <mxCell id="msg_2" value="holdSeats(userId, seatIds, 10min)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="185" as="sourcePoint"/>
            <mxPoint x="530" y="185" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 3. Show internal: acquire lock, check availability -->
        <mxCell id="msg_3" value="[acquire showLock]" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="215" as="sourcePoint"/>
            <mxPoint x="595" y="215" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 4. Show internal: verify all AVAILABLE, mark HELD -->
        <mxCell id="msg_4" value="[verify AVAILABLE, mark all HELD atomically]" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="250" as="sourcePoint"/>
            <mxPoint x="595" y="250" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 5. Show -> BookingService: return SeatHold -->
        <mxCell id="ret_1" value="return SeatHold" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="285" as="sourcePoint"/>
            <mxPoint x="330" y="285" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 6. BookingService -> User: return SeatHold -->
        <mxCell id="ret_2" value="return SeatHold (holdId, expiresAt)" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="315" as="sourcePoint"/>
            <mxPoint x="130" y="315" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Divider label -->
        <mxCell id="label_pay" value="--- User proceeds to payment page (10-min TTL running) ---" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="480" height="30" as="geometry"/>
        </mxCell>

        <!-- ===== MESSAGES — PAYMENT + CONFIRM PHASE ===== -->

        <!-- 7. User -> BookingService: confirmBooking -->
        <mxCell id="msg_5" value="confirmBooking(holdId, showId, seatIds, amount, paymentToken)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="390" as="sourcePoint"/>
            <mxPoint x="330" y="390" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 8. BookingService -> PaymentGateway: charge -->
        <mxCell id="msg_6" value="charge(paymentToken, amount)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="425" as="sourcePoint"/>
            <mxPoint x="730" y="425" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 9. PaymentGateway -> BookingService: PaymentResult -->
        <mxCell id="ret_3" value="PaymentResult (success=true, txnId)" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="460" as="sourcePoint"/>
            <mxPoint x="330" y="460" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 10. BookingService -> Show: confirmSeats -->
        <mxCell id="msg_7" value="confirmSeats(holdId, seatIds)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="495" as="sourcePoint"/>
            <mxPoint x="530" y="495" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 11. Show -> BookingService: return true -->
        <mxCell id="ret_4" value="return true (seats CONFIRMED)" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="530" as="sourcePoint"/>
            <mxPoint x="330" y="530" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 12. BookingService -> NotificationService: sendBookingConfirmation -->
        <mxCell id="msg_8" value="sendBookingConfirmation(userId, booking)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="565" as="sourcePoint"/>
            <mxPoint x="930" y="565" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 13. BookingService -> User: return Booking -->
        <mxCell id="ret_5" value="return Booking (CONFIRMED)" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="600" as="sourcePoint"/>
            <mxPoint x="130" y="600" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Failure path note -->
        <mxCell id="note_fail" value="[Alt: if confirmSeats returns false (hold expired) =&gt; paymentGateway.refund(txnId) + throw HoldExpiredException]" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="510" width="440" height="40" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
