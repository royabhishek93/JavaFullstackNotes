  <diagram name="Sequence Diagram" id="page2">
    <mxGraphModel pageWidth="1654" pageHeight="1169" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ===== LIFELINES ===== -->
        <!-- User: x=60, center_x=130 -->
        <mxCell id="life_user" value="User"
          style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;"
          vertex="1" parent="1">
