          vertex="1" parent="1">
          <mxGeometry x="460" y="50" width="140" height="550" as="geometry"/>
        </mxCell>

        <!-- HasMoneyState: x=660, center_x=730 -->
        <mxCell id="life_hasmoney" value="HasMoneyState"
          style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;"
          vertex="1" parent="1">
          <mxGeometry x="660" y="50" width="140" height="550" as="geometry"/>
        </mxCell>

        <!-- DispensingState: x=860, center_x=930 -->
        <mxCell id="life_dispensing" value="DispensingState"
          style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;"
          vertex="1" parent="1">
          <mxGeometry x="860" y="50" width="140" height="550" as="geometry"/>
        </mxCell>

        <!-- Item: x=1060, center_x=1130 -->
        <mxCell id="life_item" value="Item"
          style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;"
          vertex="1" parent="1">
          <mxGeometry x="1060" y="50" width="140" height="550" as="geometry"/>
        </mxCell>

        <!-- ===== MESSAGES ===== -->

        <!-- msg_1: User -> VendingMachine: insertCoin(10) -->
        <mxCell id="msg_1" value="insertCoin(10)"
          style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="130" as="sourcePoint"/>
            <mxPoint x="330" y="130" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- msg_2: VendingMachine -> IdleState: insertCoin(machine, 10) -->
        <mxCell id="msg_2" value="insertCoin(machine, 10)"
          style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="158" as="sourcePoint"/>
            <mxPoint x="530" y="158" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ret_1: IdleState -> VM: addBalance(10), setState(HasMoney) -->
        <mxCell id="ret_1" value="addBalance(10), setState(HasMoneyState)"
          style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="186" as="sourcePoint"/>
            <mxPoint x="330" y="186" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- msg_3: User -> VM: insertCoin(10) [2nd coin — stays in HasMoney] -->
        <mxCell id="msg_3" value="insertCoin(10)"
          style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="224" as="sourcePoint"/>
            <mxPoint x="330" y="224" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- msg_4: VM -> HasMoneyState: insertCoin(machine, 10) -->
        <mxCell id="msg_4" value="insertCoin(machine, 10)"
          style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="252" as="sourcePoint"/>
            <mxPoint x="730" y="252" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ret_2: HasMoney -> VM: balance = 20 -->
        <mxCell id="ret_2" value="balance = 20"
          style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="276" as="sourcePoint"/>
            <mxPoint x="330" y="276" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- msg_5: User -> VM: selectItem("A1") -->
        <mxCell id="msg_5" value="selectItem(&quot;A1&quot;)"
          style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="316" as="sourcePoint"/>
            <mxPoint x="330" y="316" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- msg_6: VM -> HasMoneyState: selectItem(machine, "A1") -->
        <mxCell id="msg_6" value="selectItem(machine, &quot;A1&quot;)"
          style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="344" as="sourcePoint"/>
            <mxPoint x="730" y="344" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- msg_7: HasMoney -> VM: getItem("A1") -->
        <mxCell id="msg_7" value="getItem(&quot;A1&quot;)"
          style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="372" as="sourcePoint"/>
            <mxPoint x="330" y="372" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ret_3: VM -> HasMoney: return Item -->
        <mxCell id="ret_3" value=": Item"
          style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="394" as="sourcePoint"/>
            <mxPoint x="730" y="394" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- msg_8: HasMoney -> VM: setState(DispensingState) -->
        <mxCell id="msg_8" value="setState(DispensingState)"
          style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="422" as="sourcePoint"/>
            <mxPoint x="330" y="422" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- msg_9: HasMoney -> VM: dispense() [auto-trigger after selection] -->
        <mxCell id="msg_9" value="dispense() [auto-trigger]"
          style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="450" as="sourcePoint"/>
            <mxPoint x="330" y="450" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- msg_10: VM -> DispensingState: dispense(machine) -->
        <mxCell id="msg_10" value="dispense(machine)"
