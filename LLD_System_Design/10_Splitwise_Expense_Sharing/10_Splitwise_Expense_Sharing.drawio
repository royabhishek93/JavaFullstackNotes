          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="270" as="sourcePoint"/>
            <mxPoint x="330" y="270" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- msg_3: ExpenseService -> Group: addExpense(expense) [write lock] -->
        <mxCell id="msg_3" value="addExpense(expense) [acquires write lock]" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="330" as="sourcePoint"/>
            <mxPoint x="730" y="330" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ret_2: Group -> ExpenseService: void -->
        <mxCell id="ret_2" value="void" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="380" as="sourcePoint"/>
            <mxPoint x="330" y="380" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ret_3: ExpenseService -> Client: Expense -->
