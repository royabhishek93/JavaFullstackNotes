        </mxCell>

        <mxCell id="life_BalanceCalculator" value=":BalanceCalculator" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="860" y="50" width="140" height="750" as="geometry"/>
        </mxCell>

        <!-- MESSAGES -->
        <!-- Lifeline centers: Client=130, ExpenseService=330, SplitStrategy=530, Group=730, BalanceCalculator=930 -->

        <!-- msg_1: Client -> ExpenseService: addExpense(...) -->
        <mxCell id="msg_1" value="addExpense(groupId, amount, splitType, params)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="160" as="sourcePoint"/>
            <mxPoint x="330" y="160" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- msg_2: ExpenseService -> SplitStrategy: split(...) -->
        <mxCell id="msg_2" value="split(amount, userIds, params)" style="endArrow=block;endFill=1;" edge="1" parent="1">
