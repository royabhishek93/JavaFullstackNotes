            <mxPoint x="330" y="220" as="sourcePoint"/>
            <mxPoint x="530" y="220" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ret_1: SplitStrategy -> ExpenseService: List<UserShare> -->
