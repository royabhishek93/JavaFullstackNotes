        <!-- Rider: x=60 centre=130 -->
        <mxCell id="life_rider" value="Rider" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
