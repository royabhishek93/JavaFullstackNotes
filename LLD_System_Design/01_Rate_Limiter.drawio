          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="lb_title" value="2. LEAKY BUCKET (queue capacity=5, leak=1/sec)" style="text;html=1;fontStyle=1;fontSize=14;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="420" height="30" as="geometry" />
        </mxCell>
