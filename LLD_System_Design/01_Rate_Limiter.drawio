        <mxCell id="fw_title" value="3. FIXED WINDOW (1-min windows, limit=100) — edge-case bug" style="text;html=1;fontStyle=1;fontSize=14;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="fw_w1" value="Window 00:00-01:00&#10;95 req ✓" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fw_w2" value="Window 01:00-02:00&#10;120 req ✗ (limit hit)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="240" y="520" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fw_w3" value="Window 02:00-03:00&#10;80 req ✓" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="440" y="520" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fw_bug" value="Bug: 100 req at 00:59 + 100 req at 01:01&#10;= 200 requests inside 2 real seconds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="520" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="sw_title" value="4. SLIDING WINDOW LOG (window=60s, current=10:00:50)" style="text;html=1;fontStyle=1;fontSize=14;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sw_old" value="9:59:51 (evicted)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sw_1" value="9:59:55" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="200" y="660" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sw_2" value="10:00:10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="660" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sw_3" value="10:00:45" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="660" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sw_note" value="Window: [9:59:50 - 10:00:50] → count 3 timestamps inside window, allow if count &lt; limit" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="640" y="660" width="360" height="40" as="geometry" />
        </mxCell>

        <mxCell id="swc_title" value="5. SLIDING WINDOW COUNTER (hybrid, current=10:30, 50% into window)" style="text;html=1;fontStyle=1;fontSize=14;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="swc_prev" value="Previous Window&#10;09:00-10:00&#10;prev_count" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="swc_curr" value="Current Window&#10;10:00-11:00&#10;curr_count" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="760" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="swc_formula" value="allowed = (prev_count * 0.5) + curr_count &lt;= limit" style="text;html=1;fontSize=11;align=left;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="480" y="775" width="440" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="distributed" name="Distributed Architecture (Redis)">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="client" value="Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lb" value="Load Balancer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="220" y="180" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="app1" value="App Server 1&#10;DistributedRateLimiter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="80" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="app2" value="App Server 2&#10;DistributedRateLimiter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="180" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="app3" value="App Server N&#10;DistributedRateLimiter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="280" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="redis" value="Redis&#10;ZSET key = rate_limit:{key}&#10;member = requestId, score = timestamp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="160" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="steps" value="Redis ops per request (all atomic via pipeline/Lua):&#10;1. ZREMRANGEBYSCORE key 0 (now - windowSizeMs) -- evict expired&#10;2. ZCARD key -- current count&#10;3. if count &lt; maxRequests:&#10;     ZADD key now requestId -- record this request&#10;     EXPIRE key windowSizeMs/1000 + 1&#10;     return ALLOW&#10;   else:&#10;     return REJECT (429)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="720" y="300" width="420" height="180" as="geometry" />
        </mxCell>

        <mxCell id="d1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="client" target="lb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="lb" target="app1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="lb" target="app2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="lb" target="app3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="allowRequest(key)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="app1" target="redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="app2" target="redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="app3" target="redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;" edge="1" parent="1" source="redis" target="steps">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Why Redis and not each app server's own memory?&#10;Any server can handle any request → rate-limit state must be SHARED, not local." style="text;html=1;fontSize=11;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="340" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
