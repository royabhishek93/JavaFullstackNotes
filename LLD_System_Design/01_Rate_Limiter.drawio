          <mxGeometry x="260" y="300" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lb_leak" value="Constant Leak Rate&#10;(processed 1/sec)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="540" y="310" width="180" height="50" as="geometry" />
