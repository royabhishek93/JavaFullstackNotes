        </mxCell>
        <mxCell id="iface_Insurable_m2" value="+ removeInsurance(bookingId: String): void" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="iface_Insurable">
          <mxGeometry y="65" width="290" height="25" as="geometry"/>
        </mxCell>

        <!-- ===== CONCRETE BOOKING CLASSES (ISP) ===== -->

