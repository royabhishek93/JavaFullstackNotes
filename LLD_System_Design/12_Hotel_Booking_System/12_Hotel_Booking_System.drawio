        <mxCell id="msg15" value="cancel()  [status = CANCELLED]" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="808" as="sourcePoint"/>
