        <mxCell id="iface_Modifiable" value="&lt;&lt;interface&gt;&gt;&#xa;ModifiableBooking" style="swimlane;fontStyle=3;startSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="50" y="820" width="290" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="iface_Modifiable_m1" value="+ modifyCheckInDate(bookingId, newCheckIn): void" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="iface_Modifiable">
          <mxGeometry y="40" width="290" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="iface_Modifiable_m2" value="+ modifyCheckOutDate(bookingId, newCheckOut): void" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="iface_Modifiable">
          <mxGeometry y="65" width="290" height="25" as="geometry"/>
        </mxCell>

        <!-- RefundableBooking (ISP: cancel/refund booking) -->
        <mxCell id="iface_Refundable" value="&lt;&lt;interface&gt;&gt;&#xa;RefundableBooking" style="swimlane;fontStyle=3;startSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="380" y="820" width="290" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="iface_Refundable_m1" value="+ calculateRefund(bookingId: String): double" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="iface_Refundable">
          <mxGeometry y="40" width="290" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="iface_Refundable_m2" value="+ processRefund(bookingId: String): void" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="iface_Refundable">
          <mxGeometry y="65" width="290" height="25" as="geometry"/>
        </mxCell>

        <!-- InsurableBooking (ISP: add insurance) -->
        <mxCell id="iface_Insurable" value="&lt;&lt;interface&gt;&gt;&#xa;InsurableBooking" style="swimlane;fontStyle=3;startSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="710" y="820" width="290" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="iface_Insurable_m1" value="+ addInsurance(bookingId, type: InsuranceType): void" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="iface_Insurable">
