            <mxPoint x="130" y="180" as="sourcePoint"/>
            <mxPoint x="360" y="180" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- msg2: HBS -> Hotel: searchAvailableRooms -->
        <mxCell id="msg2" value="searchAvailableRooms(type, checkIn, checkOut)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="360" y="215" as="sourcePoint"/>
            <mxPoint x="590" y="215" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- msg3: Hotel -> Room: isAvailable (loop) -->
