        <mxCell id="life_HBS" value="HotelBookingSystem&#xa;&lt;&lt;Singleton&gt;&gt;" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
