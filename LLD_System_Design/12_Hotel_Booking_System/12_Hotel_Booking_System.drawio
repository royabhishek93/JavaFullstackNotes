          </mxGeometry>
        </mxCell>

        <!-- msg14: HBS -> Room: cancelBooking -->
        <mxCell id="msg14" value="cancelBooking(bookingId)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="360" y="775" as="sourcePoint"/>
