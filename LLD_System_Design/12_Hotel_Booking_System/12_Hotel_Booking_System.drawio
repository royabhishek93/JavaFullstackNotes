          <mxGeometry relative="1" as="geometry">
            <mxPoint x="360" y="840" as="sourcePoint"/>
            <mxPoint x="130" y="840" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Design notes box -->
        <mxCell id="note_design" value="KEY DESIGN POINTS&#xa;- Singleton: HotelBookingSystem.getInstance()&#xa;- Thread-safety: ReentrantLock in Room.addBooking()&#xa;- Overlap formula: start1 &lt; end2 AND end1 &gt; start2&#xa;- Cancel: mark CANCELLED, never delete (audit trail)&#xa;- Strategy: inject PricingStrategy for flexible pricing" style="shape=note;whiteSpace=wrap;fillColor=#fffacd;strokeColor=#d6b656;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="150" width="440" height="120" as="geometry"/>
