          <mxGeometry relative="1" as="geometry">
            <mxPoint x="360" y="612" as="sourcePoint"/>
            <mxPoint x="1030" y="612" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ret4: Room -> HBS: true -->
        <mxCell id="ret4" value="true (added successfully)" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="645" as="sourcePoint"/>
            <mxPoint x="360" y="645" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ret5: HBS -> Client: Booking confirmed -->
