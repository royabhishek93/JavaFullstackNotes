          <mxGeometry x="20" y="710" width="150" height="25" as="geometry"/>
        </mxCell>

        <!-- msg13: Client -> HBS: cancelBooking -->
        <mxCell id="msg13" value="cancelBooking(bookingId)" style="endArrow=block;endFill=1;" edge="1" parent="1">
