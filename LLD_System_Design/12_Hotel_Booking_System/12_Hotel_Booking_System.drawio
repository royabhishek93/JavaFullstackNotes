        </mxCell>
        <mxCell id="class_StdBooking_r1" value="implements ModifiableBooking, RefundableBooking" style="text;align=left;verticalAlign=middle;spacingLeft=4;overflow=hidden;" vertex="1" parent="class_StdBooking">
          <mxGeometry y="30" width="290" height="22" as="geometry"/>
        </mxCell>

        <!-- PremiumHotelBooking (implements all 3 ISP interfaces) -->
        <mxCell id="class_PremBooking" value="PremiumHotelBooking" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
