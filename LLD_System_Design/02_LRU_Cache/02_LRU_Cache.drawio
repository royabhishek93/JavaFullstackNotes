          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="345" as="sourcePoint"/>
            <mxPoint x="130" y="345" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- PUT OPERATION MESSAGES                              -->
        <!-- ═══════════════════════════════════════════════════ -->

        <!-- 6. Client → LRUCache : put(key, value) -->
