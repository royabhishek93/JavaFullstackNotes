  <diagram name="Sequence Diagram" id="page2">
    <mxGraphModel pageWidth="1654" pageHeight="1169" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- LIFELINES  (width=140, 200px apart, leftmost x=60) -->
        <!-- ═══════════════════════════════════════════════════ -->

        <mxCell id="life_Client" value="Client" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="140" height="760" as="geometry"/>
        </mxCell>

        <mxCell id="life_LRUCache" value="LRUCache&lt;K,V&gt;" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="260" y="50" width="140" height="760" as="geometry"/>
        </mxCell>

        <mxCell id="life_HashMap" value="HashMap&lt;K,Node&gt;" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="460" y="50" width="140" height="760" as="geometry"/>
        </mxCell>

        <mxCell id="life_DLL" value="DoublyLinkedList" style="shape=umlLifeline;perimeter=mxPerimeter.RectanglePerimeter;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="660" y="50" width="140" height="760" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- SECTION LABELS                                      -->
        <!-- ═══════════════════════════════════════════════════ -->

        <mxCell id="label_get" value="GET Operation" style="text;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="160" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="label_put" value="PUT Operation (new key + eviction)" style="text;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="290" height="30" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- GET OPERATION MESSAGES                              -->
        <!-- lifeline centers: Client=130  LRUCache=330         -->
        <!--                   HashMap=530 DLL=730              -->
        <!-- ═══════════════════════════════════════════════════ -->

        <!-- 1. Client → LRUCache : get(key) -->
        <mxCell id="msg_1" value="get(key)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="175" as="sourcePoint"/>
            <mxPoint x="330" y="175" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 2. LRUCache → HashMap : cache.get(key) -->
        <mxCell id="msg_2" value="cache.get(key)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="215" as="sourcePoint"/>
            <mxPoint x="530" y="215" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 3. HashMap → LRUCache : node (or null) -->
        <mxCell id="ret_1" value="node (or null)" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="255" as="sourcePoint"/>
            <mxPoint x="330" y="255" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 4. LRUCache → DLL : moveToHead(node)  [guard: node != null] -->
        <mxCell id="msg_3" value="moveToHead(node)  [node != null]" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="295" as="sourcePoint"/>
            <mxPoint x="730" y="295" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 5. LRUCache → Client : return node.value -->
