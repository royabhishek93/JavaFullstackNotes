            <mxPoint x="330" y="485" as="sourcePoint"/>
            <mxPoint x="530" y="485" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 8. HashMap → LRUCache : null (key not found) -->
        <mxCell id="ret_3" value="null  (new key)" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="525" as="sourcePoint"/>
            <mxPoint x="330" y="525" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 9. LRUCache → HashMap : cache.put(key, newNode) -->
        <mxCell id="msg_6" value="cache.put(key, newNode)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="565" as="sourcePoint"/>
            <mxPoint x="530" y="565" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 10. LRUCache → DLL : addToHead(newNode) -->
        <mxCell id="msg_7" value="addToHead(newNode)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="605" as="sourcePoint"/>
            <mxPoint x="730" y="605" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 11. LRUCache → DLL : removeTail()  [guard: cache.size() > capacity] -->
        <mxCell id="msg_8" value="removeTail()  [cache.size() &gt; capacity]" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="645" as="sourcePoint"/>
            <mxPoint x="730" y="645" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 12. DLL → LRUCache : lruNode (evicted) -->
        <mxCell id="ret_4" value="lruNode  (evicted)" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="685" as="sourcePoint"/>
            <mxPoint x="330" y="685" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 13. LRUCache → HashMap : cache.remove(lruNode.key) -->
        <mxCell id="msg_9" value="cache.remove(lruNode.key)" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="725" as="sourcePoint"/>
            <mxPoint x="530" y="725" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 14. LRUCache → Client : return -->
        <mxCell id="ret_5" value="return" style="endArrow=open;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="765" as="sourcePoint"/>
            <mxPoint x="130" y="765" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
