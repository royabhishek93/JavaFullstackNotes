          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="445" as="sourcePoint"/>
            <mxPoint x="330" y="445" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 7. LRUCache → HashMap : cache.get(key) — check existence -->
