<mxfile host="app.diagrams.net" modified="2026-05-03T11:00:00.000Z" agent="GPT-5.3-Codex" version="24.7.17" type="device">
  <diagram id="url-shortener-db" name="URL Shortener DB Interview">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="2600" math="0" shadow="0" background="#F8FAFC">
      <root>
        <mxCell id="0" />
