        <mxCell id="title" value="URL Shortener - Interview Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontStyle=1;fontSize=26;fontFamily=Inter;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="700" height="34" as="geometry" />
        </mxCell>

        <mxCell id="subtitle" value="Clean view: serving path + analytics path + concise data model" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontFamily=Inter;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="serving-group" value="Serving Path (Low-latency redirect)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D7E2;strokeWidth=1;fontStyle=1;fontSize=14;fontFamily=Inter;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1160" height="300" as="geometry" />
        </mxCell>

        <mxCell id="analytics-group" value="Analytics Path (Async, write-heavy)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D7E2;strokeWidth=1;fontStyle=1;fontSize=14;fontFamily=Inter;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="1230" y="100" width="650" height="300" as="geometry" />
        </mxCell>

        <mxCell id="api" value="API Layer&#xa;Create / Redirect / Analytics" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#2F6BFF;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=Inter;align=center;verticalAlign=middle;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="90" y="190" width="240" height="110" as="geometry" />
        </mxCell>

        <mxCell id="redis" value="Redis Cache&#xa;L1 + L2&#xa;short_code -&gt; long_url" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#C97A00;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=Inter;align=center;verticalAlign=middle;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="460" y="190" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="postgres" value="PostgreSQL&#xa;Source of Truth&#xa;url_mappings" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF7EE;strokeColor=#2E8B57;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=Inter;align=center;verticalAlign=middle;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="860" y="190" width="290" height="110" as="geometry" />
        </mxCell>

        <mxCell id="eventbus" value="Event Stream&#xa;(async)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontSize=12;fontStyle=1;fontFamily=Inter;align=center;verticalAlign=middle;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="1320" y="185" width="190" height="74" as="geometry" />
        </mxCell>

        <mxCell id="cassandra" value="Cassandra&#xa;click_events&#xa;high-write analytics" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C0392B;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=Inter;align=center;verticalAlign=middle;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="1590" y="170" width="240" height="110" as="geometry" />
        </mxCell>

        <mxCell id="sync-legend" value="Legend: solid = sync path | dashed = async path" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontFamily=Inter;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="1320" y="312" width="500" height="20" as="geometry" />
        </mxCell>

        <mxCell id="edge-api-redis" value="read / write" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=2;strokeColor=#334155;fontSize=10;fontFamily=Inter;fontColor=#334155;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1" source="api" target="redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge-redis-postgres" value="cache miss" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=2;strokeColor=#334155;fontSize=10;fontFamily=Inter;fontColor=#334155;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1" source="redis" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge-postgres-redis" value="cache fill" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=2;strokeColor=#334155;fontSize=10;fontFamily=Inter;fontColor=#334155;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1" source="postgres" target="redis">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="990" y="330" />
              <mxPoint x="590" y="330" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="edge-api-event" value="click events" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeWidth=2;strokeColor=#0EA5E9;fontSize=10;fontFamily=Inter;fontColor=#0369A1;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1" source="api" target="eventbus">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="330" y="145" />
              <mxPoint x="1320" y="145" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="edge-event-cassandra" value="append-only writes" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeWidth=2;strokeColor=#0EA5E9;fontSize=10;fontFamily=Inter;fontColor=#0369A1;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1" source="eventbus" target="cassandra">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge-redis-postgres-batch" value="periodic counter sync" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeWidth=1.5;strokeColor=#0EA5E9;fontSize=10;fontFamily=Inter;fontColor=#0369A1;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1" source="redis" target="postgres">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="590" y="360" />
              <mxPoint x="990" y="360" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="datamodel-group" value="Data Model Snapshot" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D7E2;strokeWidth=1;fontStyle=1;fontSize=14;fontFamily=Inter;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="1840" height="300" as="geometry" />
        </mxCell>

        <mxCell id="primary-table" value="PostgreSQL: url_mappings&#xa;id (PK), short_code (UNIQUE), long_url, user_id&#xa;created_at, expires_at, is_custom_alias, status, click_count&#xa;Indexes: short_code, user_id, created_at, expires_at" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;align=left;verticalAlign=top;fontFamily=Inter;fontSize=12;spacing=12;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="90" y="500" width="840" height="180" as="geometry" />
        </mxCell>

        <mxCell id="analytics-table" value="Cassandra: click_events&#xa;Partition: (short_code, click_date)&#xa;Clustering: click_hour DESC, click_id DESC&#xa;Columns: ip_address, country, device_type, browser" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;align=left;verticalAlign=top;fontFamily=Inter;fontSize=12;spacing=12;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="980" y="500" width="840" height="180" as="geometry" />
        </mxCell>

        <mxCell id="flows-group" value="Operational Flows" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D7E2;strokeWidth=1;fontStyle=1;fontSize=14;fontFamily=Inter;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="1840" height="380" as="geometry" />
        </mxCell>

        <mxCell id="flow-create" value="A) Create URL&#xa;1. Validate + rate limit&#xa;2. Check duplicate&#xa;3. Generate short code&#xa;4. Insert PostgreSQL&#xa;5. Warm Redis (optional)&#xa;6. Publish creation event" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;align=left;verticalAlign=top;fontFamily=Inter;fontSize=12;spacing=12;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="90" y="840" width="560" height="250" as="geometry" />
        </mxCell>

        <mxCell id="flow-redirect" value="B) Redirect URL&#xa;1. L1 cache check&#xa;2. L2 Redis check&#xa;3. PostgreSQL fallback (ACTIVE)&#xa;4. Expiry validation&#xa;5. Fill cache and redirect&#xa;6. Async click event" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;align=left;verticalAlign=top;fontFamily=Inter;fontSize=12;spacing=12;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="690" y="840" width="560" height="250" as="geometry" />
        </mxCell>

        <mxCell id="flow-update" value="C) Update or Delete&#xa;1. Find by short code&#xa;2. Authorization check&#xa;3. Update fields or soft delete&#xa;4. Save PostgreSQL&#xa;5. Evict Redis and local cache" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F59E0B;strokeWidth=1.5;align=left;verticalAlign=top;fontFamily=Inter;fontSize=12;spacing=12;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="1290" y="840" width="560" height="250" as="geometry" />
        </mxCell>

        <mxCell id="details-group" value="Detailed Interview Blocks (Verbatim)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D7E2;strokeWidth=1;fontStyle=1;fontSize=14;fontFamily=Inter;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="1180" width="1840" height="1360" as="geometry" />
        </mxCell>

        <mxCell id="details-arch-title" value="High-Level Data Layer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontStyle=1;fontSize=15;fontFamily=Inter;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="90" y="1230" width="320" height="24" as="geometry" />
        </mxCell>

        <mxCell id="details-arch" value="                   +----------------------------------+&#xa;                   |         URL Shortener API        |&#xa;                   |  (Create / Redirect / Analytics) |&#xa;                   +----------------+-----------------+&#xa;                                    |&#xa;             +----------------------+----------------------+&#xa;             |                                             |&#xa;             v                                             v&#xa; +---------------------------+                 +-----------------------------+&#xa; | Redis (L1/L2 hot storage) |                 | PostgreSQL (Source of Truth)|&#xa; |---------------------------|                 |-----------------------------|&#xa; | short_code -&gt; long_url    |                 | Table: url_mappings         |&#xa; | long_url -&gt; short_code    |                 | URL metadata + lifecycle    |&#xa; | click counters (optional) |                 | unique short_code           |&#xa; +-------------+-------------+                 +---------------+-------------+&#xa;               |                                                 |&#xa;               | cache miss / write-through                      | events / batch sync&#xa;               v                                                 v&#xa;                                            +--------------------------------------+&#xa;                                            | Cassandra (Analytics event store)    |&#xa;                                            |--------------------------------------|&#xa;                                            | Table: click_events                  |&#xa;                                            | high-write append-only click stream  |&#xa;                                            +--------------------------------------+" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.2;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;spacing=10;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="90" y="1260" width="1710" height="350" as="geometry" />
        </mxCell>

        <mxCell id="details-table1-title" value="Primary Table (PostgreSQL)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontStyle=1;fontSize=15;fontFamily=Inter;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="90" y="1630" width="320" height="24" as="geometry" />
        </mxCell>

        <mxCell id="details-table1" value="+=======================================================================================================+&#xa;|                                         TABLE: url_mappings                                           |&#xa;+=======================================================================================================+&#xa;| Column Name        | Type             | Null | Key/Constraint         | Purpose                       |&#xa;|--------------------+------------------+------+------------------------+-------------------------------|&#xa;| id                 | BIGSERIAL        | NO   | PK                     | internal surrogate key        |&#xa;| short_code         | VARCHAR(10)      | NO   | UNIQUE, indexed        | token used in short URL       |&#xa;| long_url           | TEXT             | NO   |                        | destination URL               |&#xa;| user_id            | BIGINT           | YES  | indexed                | owner (if authenticated user) |&#xa;| created_at         | TIMESTAMP        | NO   | indexed                | creation timestamp            |&#xa;| expires_at         | TIMESTAMP        | YES  | indexed                | optional expiry               |&#xa;| is_custom_alias    | BOOLEAN          | YES  |                        | true when user chose alias    |&#xa;| status             | VARCHAR(20)/ENUM | NO   |                        | ACTIVE / EXPIRED / DELETED   |&#xa;| click_count        | BIGINT           | YES  |                        | fallback aggregate count      |&#xa;+=======================================================================================================+&#xa;&#xa;Indexes:&#xa;- UNIQUE idx_short_code on short_code&#xa;- idx_user_id on user_id&#xa;- idx_created_at on created_at&#xa;- idx_expires_at on expires_at" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.2;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;spacing=10;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="90" y="1660" width="1710" height="320" as="geometry" />
        </mxCell>

        <mxCell id="details-table2-title" value="Analytics Table (Cassandra)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontStyle=1;fontSize=15;fontFamily=Inter;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="90" y="2000" width="340" height="24" as="geometry" />
        </mxCell>

        <mxCell id="details-table2" value="+=======================================================================================================+&#xa;|                                         TABLE: click_events                                           |&#xa;+=======================================================================================================+&#xa;| Column Name   | Type      | Role in Key                     | Purpose                                |&#xa;|---------------+-----------+---------------------------------+----------------------------------------|&#xa;| short_code    | TEXT      | Partition Key (part 1)          | URL identity                           |&#xa;| click_date    | DATE      | Partition Key (part 2)          | keeps partition bounded per day        |&#xa;| click_hour    | INT       | Clustering Key (desc)           | hour-level ordering                    |&#xa;| click_id      | TIMEUUID  | Clustering Key (desc)           | unique + time ordered event id         |&#xa;| ip_address    | TEXT      | non-key                         | client IP                              |&#xa;| country       | TEXT      | non-key                         | geo analytics                           |&#xa;| device_type   | TEXT      | non-key                         | mobile/desktop/tablet                  |&#xa;| browser       | TEXT      | non-key                         | browser analytics                       |&#xa;+=======================================================================================================+&#xa;&#xa;Primary Key: PRIMARY KEY ((short_code, click_date), click_hour, click_id)&#xa;Clustering Order: (click_hour DESC, click_id DESC)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.2;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;spacing=10;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="90" y="2030" width="1710" height="300" as="geometry" />
        </mxCell>

        <mxCell id="details-flow-title" value="Read/Write Data Flows" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontStyle=1;fontSize=15;fontFamily=Inter;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="90" y="2340" width="260" height="24" as="geometry" />
        </mxCell>

        <mxCell id="details-flow-a" value="A) Create Short URL (Write Path)&#xa;Client&#xa;  |&#xa;  v&#xa;[Validate URL + security checks + rate limit]&#xa;  |&#xa;  v&#xa;[Check duplicate by long_url]&#xa;  |-- found --&gt; return existing mapping&#xa;  |&#xa;  |-- not found --&gt;&#xa;  v&#xa;[Generate short_code]&#xa;  |&#xa;  v&#xa;[INSERT into PostgreSQL url_mappings]&#xa;  |&#xa;  +--&gt; [Warm Redis cache for premium/hot path]&#xa;  |&#xa;  +--&gt; [Publish creation event for analytics pipeline]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.2;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacing=10;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="90" y="2370" width="550" height="150" as="geometry" />
        </mxCell>

        <mxCell id="details-flow-b" value="B) Redirect (Read Path)&#xa;Client hits /{short_code}&#xa;  |&#xa;  v&#xa;[L1 local cache]&#xa;  |-- hit --&gt; return long_url&#xa;  |&#xa;  |-- miss --&gt;&#xa;  v&#xa;[L2 Redis]&#xa;  |-- hit --&gt; fill L1 and return long_url&#xa;  |&#xa;  |-- miss --&gt;&#xa;  v&#xa;[PostgreSQL lookup by short_code + status=ACTIVE]&#xa;  |-- not found --&gt; 404&#xa;  |-- expired   --&gt; URL expired response&#xa;  |&#xa;  v&#xa;[Fill Redis + L1]&#xa;  |&#xa;  v&#xa;[302/301 redirect to long_url]&#xa;  |&#xa;  +--&gt; [async click event -&gt; Cassandra]&#xa;  +--&gt; [counter updates -&gt; Redis / periodic DB sync]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.2;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacing=10;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="670" y="2370" width="550" height="150" as="geometry" />
        </mxCell>

        <mxCell id="details-flow-c" value="C) Update/Delete&#xa;[Find row by short_code]&#xa;  |&#xa;  v&#xa;[Authorization check]&#xa;  |&#xa;  +--&gt; update long_url / expires_at&#xa;  |      -&gt; save PostgreSQL&#xa;  |      -&gt; evict Redis and local cache&#xa;  |&#xa;  +--&gt; soft delete&#xa;         -&gt; status = DELETED&#xa;         -&gt; save PostgreSQL&#xa;         -&gt; evict caches" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F59E0B;strokeWidth=1.2;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacing=10;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="1250" y="2370" width="550" height="150" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
