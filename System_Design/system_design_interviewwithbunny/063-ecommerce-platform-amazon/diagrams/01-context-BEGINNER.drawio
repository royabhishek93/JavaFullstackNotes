        <!-- Real-World Analogy -->
        <mxCell id="analogy-box" value="🏪 REAL-WORLD ANALOGY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#01579b;strokeWidth=3;fontSize=14;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="1620" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="analogy-text" value="Physical store during Black Friday flash sale: 1 TV left, 100 customers rush to checkout. Cashier (distributed lock) lets only 1 person hold the TV while scanning items (inventory reservation). Others wait in line (Redis SETNX queue). If holder's credit card declines (payment fails), TV goes back on shelf (reserved_qty decremented, qty unchanged). If payment succeeds, TV leaves warehouse (qty decremented, order confirmed). Stockroom ledger (inventory DB) is source of truth — never trust display shelf count during chaos. Product catalog = shelf labels with specs. Search = store directory that tells you which aisle. Cart = shopping basket you carry around. Checkout = register transaction. Payment webhook = credit card approval from bank. Warehouse = backroom where fulfilled orders are picked/packed/shipped. The hard part: preventing that 1 TV from being sold to 2 people when both reach the cashier simultaneously." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="50" y="810" width="1600" height="40" as="geometry" />
        </mxCell>
        
        <!-- Monitoring Box -->
        <mxCell id="monitoring-box" value="📈 MONITORING &amp; OBSERVABILITY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=3;fontSize=14;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="1620" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="monitoring-text" value="• **Inventory Discrepancy Alert**: SUM(orders.qty) - SUM(inventory.deducted) != 0 → overselling detected • **Checkout Success Rate**: &lt;95% → investigate lock timeouts • **Search Latency**: p99 &gt;500ms → ES cluster under load • **Payment Webhook Lag**: &gt;5 min → check gateway health • **Cart Abandonment Rate**: &gt;70% → UX issue or pricing problem • **Redis Lock Timeout Rate**: &gt;1% → increase lock TTL or optimize checkout flow • **CDC Lag (MongoDB → ES)**: &gt;10 sec → Kafka consumer backlog, scale indexer • **PostgreSQL Connection Pool**: &gt;90% utilization → increase pool size or add read replicas • **Distributed Lock Contention**: SETNX failure rate per product_id → hot product, scale horizontally • **Order PENDING_PAYMENT &gt;30min**: Cron reconciliation job, poll payment gateway API for true status" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=8" vertex="1" parent="1">
          <mxGeometry x="50" y="910" width="1600" height="40" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
