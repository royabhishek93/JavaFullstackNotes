        <mxCell id="rel-order-payment" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#e65100;dashed=1;endArrow=classic;endFill=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1450" y="440" as="sourcePoint" />
