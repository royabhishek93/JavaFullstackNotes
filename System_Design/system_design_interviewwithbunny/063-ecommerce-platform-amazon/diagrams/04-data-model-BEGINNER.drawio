        </mxCell>
        <mxCell id="rel-product-inventory-label" value="product_id FK" style="text;html=1;strokeColor=none;fillColor=#c8e6c9;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=8" vertex="1" parent="1">
          <mxGeometry x="540" y="195" width="80" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="rel-cart-product" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#388e3c;dashed=1;endArrow=classic;endFill=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="400" as="sourcePoint" />
