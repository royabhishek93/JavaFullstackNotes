          <mxGeometry x="1290" y="780" width="180" height="160" as="geometry" />
        </mxCell>
        
        <!-- S3 -->
        <mxCell id="s3" value="📦 S3 + CloudFront&#xa;(Product Images)&#xa;&#xa;500TB images&#xa;Edge caching&#xa;Low latency delivery&#xa;Signed URLs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=center" vertex="1" parent="1">
          <mxGeometry x="1490" y="780" width="170" height="160" as="geometry" />
        </mxCell>
        
        <!-- Data Warehouse -->
        <mxCell id="data-warehouse" value="🏢 Data Warehouse&#xa;(Redshift/BigQuery)&#xa;&#xa;ETL from Kafka&#xa;Historical orders&#xa;Sales analytics&#xa;User behavior" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=center" vertex="1" parent="1">
          <mxGeometry x="1680" y="780" width="170" height="160" as="geometry" />
