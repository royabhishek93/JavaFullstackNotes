          <mxGeometry x="740" y="780" width="150" height="160" as="geometry" />
        </mxCell>
        
        <!-- Elasticsearch -->
        <mxCell id="elasticsearch" value="🔍 Elasticsearch&#xa;(Search Index)&#xa;&#xa;100M products indexed&#xa;Full-text + facets&#xa;10-node cluster&#xa;Synced from MongoDB CDC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=center" vertex="1" parent="1">
          <mxGeometry x="910" y="780" width="170" height="160" as="geometry" />
        </mxCell>
        
        <!-- Redis -->
        <mxCell id="redis" value="⚡ Redis&#xa;(Cache + Locks)&#xa;&#xa;SETNX distributed lock&#xa;Cart cache (HSET)&#xa;Search cache&#xa;Product cache&#xa;inventory:{pid} (5min TTL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=center" vertex="1" parent="1">
          <mxGeometry x="1100" y="780" width="170" height="160" as="geometry" />
