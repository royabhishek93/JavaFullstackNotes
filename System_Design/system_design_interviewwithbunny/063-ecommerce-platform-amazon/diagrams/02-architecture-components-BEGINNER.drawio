          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="arrow-kafka-indexer" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#f57f17;dashed=1;endArrow=classic;endFill=1" edge="1" parent="1" source="kafka" target="es-indexer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="arrow-indexer-es" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#f57f17;dashed=1;endArrow=classic;endFill=1" edge="1" parent="1" source="es-indexer" target="elasticsearch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- WHY BOXES -->
        
        <!-- WHY MongoDB -->
        <mxCell id="why-mongo" value="💡 WHY MongoDB for Product Catalog?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="60" y="980" width="420" height="180" as="geometry" />
        </mxCell>
        
        <mxCell id="why-mongo-text" value="Different product categories have completely different attributes:&#xa;• Mobile phones: {RAM, storage, processor, screen_size, battery}&#xa;• Books: {author, ISBN, publisher, page_count, language}&#xa;• Clothing: {size, color, material, fit_type, care_instructions}&#xa;&#xa;PostgreSQL would require:&#xa;  1. One massive table with 200+ nullable columns (sparse, wasteful)&#xa;  2. EAV pattern (product_attributes table) requiring joins for every query&#xa;  3. ALTER TABLE for every new category added&#xa;&#xa;MongoDB: Just insert a document with new fields. No schema migration.&#xa;Flexible schema handles multi-category marketplace elegantly.&#xa;&#xa;CDC via MongoDB oplog → Kafka → ES indexer keeps search fresh.&#xa;Product writes stay fast (no dual-write to ES), indexer catches up async." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="70" y="1010" width="400" height="140" as="geometry" />
        </mxCell>
        
        <!-- WHY Elasticsearch -->
        <mxCell id="why-es" value="💡 WHY Elasticsearch for Search?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="500" y="980" width="440" height="180" as="geometry" />
        </mxCell>
        
        <mxCell id="why-es-text" value="Requirements: 100K searches/sec, full-text, fuzzy matching, faceted filters.&#xa;&#xa;PostgreSQL LIKE '%laptop%': Scans every row, can't fix typos (labtop → laptop),&#xa;no relevance scoring (title match vs description mention), no faceted counts&#xa;(how many per brand/price range). Falls over at 100K QPS.&#xa;&#xa;Elasticsearch: Pre-built inverted index (like book back-index: word → pages).&#xa;• Fuzzy matching: 'labtop' → 'laptop' (Levenshtein distance)&#xa;• Relevance scoring: title^3 (boost title 3x over description)&#xa;• Faceted aggregations: Count results per brand, category, price range&#xa;• Synonyms: laptop = notebook (query expansion)&#xa;• Autocomplete: edge n-gram tokenizer ('lap' → 'laptop', 'lapdesk')&#xa;&#xa;10-node cluster handles 100K QPS. Synced from MongoDB via CDC (1-2 sec lag).&#xa;Eventual consistency acceptable — checkout validates inventory anyway." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=8" vertex="1" parent="1">
          <mxGeometry x="510" y="1010" width="420" height="140" as="geometry" />
        </mxCell>
        
        <!-- WHY PostgreSQL Inventory -->
        <mxCell id="why-postgres-inv" value="💡 WHY PostgreSQL for Inventory?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="960" y="980" width="440" height="180" as="geometry" />
        </mxCell>
        
        <mxCell id="why-postgres-inv-text" value="ACID transactions with row-level locking required. Overselling is unacceptable.&#xa;&#xa;reserved_qty pattern: available = qty - reserved_qty&#xa;• qty: Total warehouse stock&#xa;• reserved_qty: In active checkouts (not yet paid)&#xa;&#xa;SELECT qty, reserved_qty FROM inventory WHERE product_id=? FOR UPDATE;&#xa;→ Pessimistic row lock. Blocks other transactions from modifying this row&#xa;  until current transaction commits. Prevents two users reserving same unit.&#xa;&#xa;UPDATE inventory SET reserved_qty = reserved_qty + cart_qty; (reserve)&#xa;[After payment webhook success]:&#xa;UPDATE inventory SET qty = qty - cart_qty, reserved_qty = reserved_qty - cart_qty;&#xa;&#xa;WHY NOT Redis as source of truth: Redis eviction under memory pressure&#xa;loses reservation state silently. Crash = all locks lost. PostgreSQL MVCC&#xa;handles concurrent checkouts without full table locks. Strong consistency." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=8" vertex="1" parent="1">
          <mxGeometry x="970" y="1010" width="420" height="140" as="geometry" />
        </mxCell>
        
        <!-- WHY Redis Distributed Lock -->
        <mxCell id="why-redis-lock" value="💡 WHY Redis Distributed Lock (SETNX)?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="1420" y="980" width="440" height="180" as="geometry" />
        </mxCell>
        
        <mxCell id="why-redis-lock-text" value="Thundering herd problem: Flash sale, 10K users hit checkout simultaneously.&#xa;&#xa;Without Redis lock: All 10K go to PostgreSQL, acquire FOR UPDATE lock serially.&#xa;Connection pool (200 conns) exhausted in 50ms. DB falls over.&#xa;&#xa;With Redis lock:&#xa;  SETNX lock:inventory:{product_id} {session_id} EX 30&#xa;  → Returns 1 if acquired, 0 if already locked.&#xa;  → Executes in &lt;1ms. 9999 users rejected immediately (409 Conflict).&#xa;  → Only 1 user proceeds to PostgreSQL FOR UPDATE.&#xa;&#xa;EX 30 (30-second expiry): If service crashes mid-checkout, lock auto-releases.&#xa;Prevents inventory permanently locked. Idempotent retry safe.&#xa;&#xa;Two-layer locking:&#xa;  Layer 1 (Redis): Fast rejection, prevents thundering herd&#xa;  Layer 2 (PostgreSQL): ACID guarantee during reservation&#xa;&#xa;Redis handles 100K ops/sec. Trivial at 300 lock acquisitions/sec peak load." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=8" vertex="1" parent="1">
          <mxGeometry x="1430" y="1010" width="420" height="140" as="geometry" />
        </mxCell>
        
        <!-- WHY Kafka -->
        <mxCell id="why-kafka" value="💡 WHY Kafka Event-Driven Architecture?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="60" y="1180" width="880" height="160" as="geometry" />
        </mxCell>
        
        <mxCell id="why-kafka-text" value="Decouples post-checkout workflow. Payment Service publishes payment.success event to Kafka. Consumers:&#xa;• Notification Service → send email/SMS (can be slow, non-blocking)&#xa;• Warehouse Service → pick/pack/ship order (offline process, can retry)&#xa;• Analytics Service → ETL to data warehouse (batch processing)&#xa;• Inventory Service → invalidate cache (real-time)&#xa;&#xa;Without Kafka (synchronous calls): Checkout Service waits for Notification to send email, Warehouse to generate label, Analytics to log event.&#xa;One slow downstream service blocks entire checkout. If Notification fails, order processing halts.&#xa;&#xa;With Kafka: Checkout publishes event, returns 201 immediately. Each consumer scales independently, fails independently, retries independently.&#xa;7-day retention = audit trail. Can replay events to rebuild Elasticsearch index if ES cluster corrupts. Consumer groups enable horizontal scaling.&#xa;Dead-letter queue (DLQ) prevents one bad event from blocking entire consumer. Kafka handles 10M messages/sec. Our 10 orders/sec = trivial." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=8" vertex="1" parent="1">
          <mxGeometry x="70" y="1210" width="860" height="120" as="geometry" />
        </mxCell>
        
        <!-- WHY ON CONFLICT for Cart -->
        <mxCell id="why-cart-conflict" value="💡 WHY ON CONFLICT for Cart Race Condition?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="960" y="1180" width="900" height="160" as="geometry" />
        </mxCell>
        
        <mxCell id="why-cart-conflict-text" value="User opens mobile app and web simultaneously. Adds same product from both. Race condition:&#xa;&#xa;WITHOUT ON CONFLICT:&#xa;  INSERT INTO cart_items (cart_id, product_id, qty) VALUES (?, ?, 2); [mobile]&#xa;  INSERT INTO cart_items (cart_id, product_id, qty) VALUES (?, ?, 1); [web]&#xa;  → Two rows for same product_id in cart → broken UX, duplicate checkout&#xa;&#xa;WITH UNIQUE constraint + ON CONFLICT:&#xa;  UNIQUE (cart_id, product_id) — composite index&#xa;  INSERT INTO cart_items (cart_id, product_id, qty) VALUES (?, ?, 2)&#xa;    ON CONFLICT (cart_id, product_id) DO UPDATE SET qty = cart_items.qty + EXCLUDED.qty;&#xa;  → First insert wins, second insert finds conflict → UPDATE qty = 2 + 1 = 3 (correct)&#xa;&#xa;Cross-device sync: Cart tied to user_id (not session). PostgreSQL source of truth. Redis HSET cart:{userId} cached for &lt;1ms reads.&#xa;Write to PostgreSQL first → invalidate Redis → next read rebuilds from DB. Cache-aside pattern. Survives cache eviction.&#xa;WHY NOT session-based: User adds item on mobile, switches to web → cart empty (different session). user_id ensures sync across all devices." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=7" vertex="1" parent="1">
          <mxGeometry x="970" y="1210" width="880" height="120" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
