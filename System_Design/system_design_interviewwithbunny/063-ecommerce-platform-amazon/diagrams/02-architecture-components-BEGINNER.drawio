          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="arrow-order-mysql" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#388e3c;dashed=1;endArrow=classic;endFill=1" edge="1" parent="1" source="order-service" target="mysql-orders">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
