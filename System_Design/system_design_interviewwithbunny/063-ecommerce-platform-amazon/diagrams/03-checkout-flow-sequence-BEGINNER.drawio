        <!-- API Gateway -->
        <mxCell id="actor-gateway" value="⚡ API GATEWAY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;strokeWidth=3;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="180" height="50" as="geometry" />
