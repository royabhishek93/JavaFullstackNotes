<mxCell id="t" value="STOCK TRADING - Order Execution Flow (Fund Locking + Kafka Validation + FIX Protocol + Settlement)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="60" y="20" width="2280" height="35" as="geometry"/></mxCell>
<mxCell id="subtitle" value="6 Phases: (1) Order Placement + Fund Lock | (2) Kafka Async Validation | (3) FIX Protocol to Exchange | (4) Matching Engine Execution | (5) Settlement | (6) Portfolio Update + Notification" style="text;html=1;strokeColor=none;fillColor=#e8eaf6;align=center;rounded=1;fontSize=12" vertex="1" parent="1"><mxGeometry x="80" y="65" width="2240" height="28" as="geometry"/></mxCell>

<mxCell id="user" value="User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="60" y="130" width="100" height="50" as="geometry"/></mxCell>
