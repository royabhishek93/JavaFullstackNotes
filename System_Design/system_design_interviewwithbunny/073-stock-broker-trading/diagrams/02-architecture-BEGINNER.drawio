<mxfile host="app.diagrams.net"><diagram name="Architecture" id="trading-arch"><mxGraphModel dx="2200" dy="1500" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2200" pageHeight="1500" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="STOCK TRADING PLATFORM - High-Level Architecture (CAP Split: Market Data AP | Order Placement CP)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="60" y="20" width="2080" height="35" as="geometry"/></mxCell>

<mxCell id="clientLayer" value="CLIENT LAYER" style="text;html=1;strokeColor=#1976d2;fillColor=#e3f2fd;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="80" width="2080" height="25" as="geometry"/></mxCell>
<mxCell id="webClient" value="Web Client&#10;(React/Vue)&#10;WebSocket prices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="80" y="120" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="mobileClient" value="Mobile Client&#10;(iOS/Android)&#10;REST + WS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="260" y="120" width="150" height="70" as="geometry"/></mxCell>

<mxCell id="edgeLayer" value="EDGE LAYER (Load Balancer + WebSocket Gateway)" style="text;html=1;strokeColor=#c2185b;fillColor=#fce4ec;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="220" width="2080" height="25" as="geometry"/></mxCell>
<mxCell id="apiLB" value="API Gateway LB&#10;Auth + Rate Limit&#10;10 orders/sec/user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcc80;strokeColor=#ef6c00;strokeWidth=3;fontSize=11" vertex="1" parent="1"><mxGeometry x="80" y="260" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="wsLB" value="WebSocket LB&#10;Sticky Session&#10;(user_id hash)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcc80;strokeColor=#ef6c00;strokeWidth=3;fontSize=11" vertex="1" parent="1"><mxGeometry x="260" y="260" width="150" height="70" as="geometry"/></mxCell>

<mxCell id="serviceLayer" value="SERVICE LAYER (CAP Split: Price AP | Order CP)" style="text;html=1;strokeColor=#388e3c;fillColor=#e8f5e9;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="360" width="2080" height="25" as="geometry"/></mxCell>

<mxCell id="orderSvc" value="Order Service&#10;Fund locking SELECT FOR UPDATE&#10;Kafka new_orders publish&#10;Status: PENDING&#10;CAP: CP (Consistency)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=3;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="80" y="400" width="200" height="110" as="geometry"/></mxCell>

<mxCell id="validator" value="Validator Service&#10;KYC check (VERIFIED status)&#10;Fund check (sufficient balance)&#10;Risk check (exposure limit)&#10;Circuit breaker (price volatility)&#10;Dedup (Redis SETNX)&#10;CAP: CP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="320" y="400" width="220" height="130" as="geometry"/></mxCell>

<mxCell id="exchGW" value="Exchange Gateway&#10;FIX protocol formatter&#10;400-500 persistent connections&#10;Grouped by symbol&#10;Status: PLACED → EXECUTED&#10;CAP: CP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=3;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="580" y="400" width="220" height="120" as="geometry"/></mxCell>

<mxCell id="priceIngester" value="Price Ingester Service&#10;Subscribe NSE/BSE feed&#10;InfluxDB time-series INSERT&#10;Redis PubSub PUBLISH&#10;CAP: AP (Availability)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="840" y="400" width="220" height="100" as="geometry"/></mxCell>

<mxCell id="wsGateway" value="WebSocket Gateway&#10;Subscribe Redis PubSub&#10;Push to clients (sticky)&#10;Only watched stocks&#10;CAP: AP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="1100" y="400" width="200" height="100" as="geometry"/></mxCell>

<mxCell id="portfolioSvc" value="Portfolio Service&#10;P&amp;L on-the-fly calculation&#10;current_value = qty × Redis price&#10;profit_loss = current - investment&#10;CAP: Eventual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="1340" y="400" width="220" height="100" as="geometry"/></mxCell>

<mxCell id="orderTracker" value="Order Tracker Service&#10;Kafka order_status consumer&#10;UPDATE orders table&#10;INSERT trades table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="400" width="200" height="90" as="geometry"/></mxCell>

<mxCell id="notificationSvc" value="Notification Service&#10;FCM/APNS push&#10;Email/SMS async&#10;WebSocket real-time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="400" width="180" height="90" as="geometry"/></mxCell>

<mxCell id="dataLayer" value="DATA LAYER (Redis Cache + PostgreSQL ACID + Kafka Events + InfluxDB Time-Series)" style="text;html=1;strokeColor=#7b1fa2;fillColor=#f3e5f5;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="560" width="2080" height="25" as="geometry"/></mxCell>

<mxCell id="redis" value="Redis Cluster&#10;stock_price:{symbol} STRING (TTL 1s)&#10;stock_price PUBSUB channel&#10;order_lock:{orderId} SETNX (dedup)&#10;Sub-millisecond reads" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=3;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="80" y="600" width="240" height="120" as="geometry"/></mxCell>

<mxCell id="postgres" value="PostgreSQL (Sharded by user_id)&#10;orders (order_id, status, executed_at)&#10;funds (available_balance, locked_balance)&#10;portfolio (quantity, avg_buy_price)&#10;trades (executed_price, commission)&#10;SELECT FOR UPDATE SERIALIZABLE" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="360" y="600" width="300" height="130" as="geometry"/></mxCell>

<mxCell id="kafka" value="Kafka&#10;new_orders topic (Order Svc → Validator)&#10;verified_orders (Validator → Exch GW)&#10;order_status (NSE → Order Tracker + Portfolio)&#10;50 partitions, RF=3, at-least-once" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffcc80;strokeColor=#ef6c00;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="700" y="600" width="320" height="120" as="geometry"/></mxCell>

<mxCell id="influx" value="InfluxDB (Time-Series)&#10;100K+ price writes/sec&#10;1-min candles forever&#10;Auto-downsample: 5m → 1h → daily&#10;Chart query: mean(price) GROUP BY time(5m)&#10;&lt;100ms for 1Y data" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="1060" y="600" width="300" height="120" as="geometry"/></mxCell>

<mxCell id="nse" value="NSE/BSE Exchange&#10;FIX Protocol&#10;Sequential matching per symbol" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=3;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="1400" y="600" width="200" height="80" as="geometry"/></mxCell>

<mxCell id="whyCAP" value="WHY CAP SPLIT (AP vs CP)?&#10;&#10;Market data viewing (stock prices): AP (Availability + Partition tolerance) — 100ms stale price is acceptable, must serve 100M users with high availability. Price Ingester writes to InfluxDB + Redis PubSub (both eventually consistent), WebSocket Gateway fans out to millions without blocking.&#10;Order placement / fund management: CP (Consistency + Partition tolerance) — wrong balance or duplicate trade causes financial loss, correctness over uptime. Fund locking uses SELECT FOR UPDATE SERIALIZABLE pessimistic lock — two simultaneous orders on same row block until first commits. One succeeds, other sees updated balance and fails if insufficient." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1640" y="600" width="500" height="140" as="geometry"/></mxCell>

<mxCell id="whyWS" value="WHY WEBSOCKET (NOT HTTP POLLING)?&#10;&#10;HTTP polling: 10M users × 1 req/sec checking if price changed = 10M req/sec overhead (99% empty responses no change).&#10;WebSocket: persistent bidirectional TCP, server pushes price ONLY when it changes, ONLY to users watching that stock. User subscribes to 10 stocks in watchlist → server pushes only those 10, not all 8-10K. Bandwidth 1000x reduction. Sticky session: user_id hash keeps same user on same server instance (connection state preserved). Fallback: on disconnect, exponential backoff reconnect + GET REST to fetch missed updates." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="80" y="760" width="640" height="120" as="geometry"/></mxCell>

<mxCell id="whyFIX" value="WHY FIX PROTOCOL WITH 400-500 PERSISTENT CONNECTIONS?&#10;&#10;FIX (Financial Information eXchange): binary TCP protocol all exchanges use globally. Tag 35=D NewOrderSingle (place), Tag 35=8 ExecutionReport (confirm). Exchange Gateway maintains 400-500 persistent FIX connections to NSE/BSE grouped by symbol: RELIANCE, TCS, INFY on same connection → reuse connections, avoid TCP handshake overhead ~3-5ms per order. Connection pooling: load balance orders by symbol hash. Matching engine on exchange is sequential per stock (one auctioneer prevents duplicate matches), in-memory order book sorted by price-time priority." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="760" y="760" width="660" height="100" as="geometry"/></mxCell>

<mxCell id="whyKafka" value="WHY KAFKA FOR ORDER EVENTS (NOT DIRECT SERVICE CALLS)?&#10;&#10;Decouples: Order Svc → Validator → Exchange Gateway → Order Tracker. Async processing: Order Svc returns 200 PENDING in &lt;10ms (user not blocked), downstream continues async. Horizontal scaling: add more consumers per topic. At-least-once delivery: Kafka guarantees no order lost, consumer offset not committed until processing complete. Validator 5 instances 50 partitions. If Exchange Gateway crashes for 30s, Kafka buffers all verified_orders → replay on restart → zero lost orders." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1460" y="760" width="680" height="100" as="geometry"/></mxCell>

<mxCell id="whyInflux" value="WHY INFLUXDB TIME-SERIES (NOT SQL)?&#10;&#10;Stock prices append-only, time-stamped data stream (never update yesterday price). InfluxDB LSM tree optimized for append-only writes at 100K+/sec across 10K stocks. SQL B-tree rebuilds index on every insert → write bottleneck. Auto-downsampling: 1-min candles (raw data forever) → continuous query aggregates to 5-min → hourly → daily candles. Chart query: RELIANCE 1Y data = mean(price) GROUP BY time(5m) returns 288 points in &lt;100ms. Time-based partitioning: last hour query skips directly to that time chunk. SQL would need 3 trillion rows for 10 years all stocks — impossible." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="80" y="900" width="720" height="100" as="geometry"/></mxCell>

<mxCell id="whyPL" value="WHY P&amp;L ON-THE-FLY (NEVER STORE CURRENT_VALUE)?&#10;&#10;Portfolio table stores: quantity, avg_buy_price, total_investment (static). current_value and profit_loss calculated fresh every GET /api/v1/portfolio: Redis GET stock_price:RELIANCE → current price 2460, current_value = qty × 2460, PL = current_value - total_investment. Price changes hundreds of times per second → stored value stale instantly. Redis cache TTL 1s refreshed continuously by Price Ingester. If you stored current_value in DB, user sees wrong P&amp;L until next refresh job runs (minutes delay)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="840" y="900" width="680" height="100" as="geometry"/></mxCell>

<mxCell id="whyCircuit" value="WHY CIRCUIT BREAKER (10% PRICE MOVE IN 5 MIN)?&#10;&#10;2010 US Flash Crash: Dow fell 1000 points in minutes because trading algorithms fed off each other panic sell spiral. Circuit breaker: if RELIANCE moves &gt;10% in 5 min, Validator auto-rejects all new RELIANCE orders until market stabilizes. SEBI (India regulator) legally mandates these halts. Prevents algorithmic feedback loop that can crash stock to zero, wiping millions in one cascade. Implementation: Validator checks Redis GET price_change:RELIANCE:5m → if &gt;10% → reject with 429 Too Many Requests Circuit Breaker Active." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1560" y="900" width="580" height="100" as="geometry"/></mxCell>

<mxCell id="flowSummary" value="CRITICAL PATH FLOW: User POST /orders → Order Svc SELECT FOR UPDATE locks funds → INSERT order PENDING → Kafka new_orders → Validator checks KYC/funds/risk/circuit/dedup → Kafka verified_orders → Exchange Gateway FIX protocol → NSE matching engine sequential per symbol → EXECUTED → Kafka order_status → Order Tracker UPDATE orders EXECUTED + INSERT trades → Portfolio Svc UPDATE holdings → Notification Svc push FCM/APNS. Parallel price path: NSE tick → Price Ingester → InfluxDB INSERT + Redis PubSub PUBLISH &lt;10ms → WebSocket Gateway subscribe → push to clients ~20ms total." style="text;html=1;strokeColor=#1976d2;fillColor=#e3f2fd;align=center;fontSize=11;rounded=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="80" y="1040" width="2060" height="60" as="geometry"/></mxCell>

<mxCell id="scaleNumbers" value="SCALE: 1M users, 8-10K stocks, 100K orders/min peak, 100K price writes/sec InfluxDB, 10K WebSocket connections per server, 400-500 FIX connections per Exchange Gateway, Validator 5 instances 50 Kafka partitions, PostgreSQL 10 shards by user_id, Redis 20 nodes, ~₹50L/month infra cost" style="text;html=1;strokeColor=#ef6c00;fillColor=#fff3e0;align=center;fontSize=11;rounded=1" vertex="1" parent="1"><mxGeometry x="80" y="1120" width="2060" height="40" as="geometry"/></mxCell>

</root></mxGraphModel></diagram></mxfile>
