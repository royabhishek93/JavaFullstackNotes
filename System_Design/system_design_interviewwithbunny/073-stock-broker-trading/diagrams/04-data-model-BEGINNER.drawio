<mxfile host="app.diagrams.net"><diagram name="Data Model" id="trading-data"><mxGraphModel dx="2200" dy="1900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2200" pageHeight="1900" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="STOCK TRADING PLATFORM - Data Model (PostgreSQL ACID + Redis Cache + Kafka Events + InfluxDB Time-Series)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="60" y="20" width="2080" height="35" as="geometry"/></mxCell>

<mxCell id="postgresTitle" value="POSTGRESQL SCHEMAS (Sharded by user_id | SERIALIZABLE Isolation)" style="text;html=1;strokeColor=#7b1fa2;fillColor=#f3e5f5;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="80" width="1040" height="25" as="geometry"/></mxCell>

<mxCell id="ordersTable" value="TABLE: orders&#10;&#10;order_id UUID PK&#10;user_id UUID FK (shard key)&#10;stock_symbol VARCHAR(20)&#10;order_type ENUM(MARKET, LIMIT, STOP_LOSS)&#10;trade_type ENUM(BUY, SELL)&#10;quantity INT NOT NULL&#10;price DECIMAL(10,2) (NULL for MARKET)&#10;status ENUM(PENDING, VERIFIED, PLACED, EXECUTED, REJECTED, CANCELLED)&#10;placed_at TIMESTAMPTZ DEFAULT NOW()&#10;executed_at TIMESTAMPTZ&#10;exchange_order_id VARCHAR(50)&#10;executed_price DECIMAL(10,2)&#10;commission_fee DECIMAL(8,2)&#10;rejection_reason TEXT&#10;&#10;INDEXES:&#10;idx_orders_user (user_id, placed_at DESC)&#10;idx_orders_status (status, placed_at)&#10;idx_orders_stock (stock_symbol, status)&#10;&#10;CRITICAL: status state machine&#10;PENDING → VERIFIED → PLACED → EXECUTED&#10;OR → REJECTED at any stage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="60" y="120" width="340" height="380" as="geometry"/></mxCell>

<mxCell id="fundsTable" value="TABLE: funds (CRITICAL for SELECT FOR UPDATE)&#10;&#10;user_id UUID PK&#10;available_balance DECIMAL(15,2) NOT NULL DEFAULT 0&#10;locked_balance DECIMAL(15,2) NOT NULL DEFAULT 0&#10;total_balance DECIMAL(15,2) GENERATED ALWAYS AS&#10;  (available_balance + locked_balance)&#10;bank_account_id VARCHAR(50)&#10;last_deposit_at TIMESTAMPTZ&#10;last_withdrawal_at TIMESTAMPTZ&#10;&#10;USAGE:&#10;BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE&#10;SELECT available_balance FROM funds&#10;WHERE user_id = ? FOR UPDATE&#10;-- Pessimistic row lock blocks concurrent txns&#10;IF available_balance &gt;= estimated_cost&#10;  UPDATE funds SET&#10;    available_balance -= estimated_cost,&#10;    locked_balance += estimated_cost&#10;  COMMIT&#10;ELSE ROLLBACK 400 Insufficient Funds&#10;&#10;WHY FOR UPDATE: Two simultaneous orders&#10;on same user_id → second waits on row lock,&#10;reads updated balance → prevents overdraft" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=3;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="420" y="120" width="340" height="380" as="geometry"/></mxCell>

<mxCell id="portfolioTable" value="TABLE: portfolio&#10;&#10;PK: (user_id, stock_symbol)&#10;user_id UUID&#10;stock_symbol VARCHAR(20)&#10;quantity INT NOT NULL DEFAULT 0&#10;locked_quantity INT NOT NULL DEFAULT 0&#10;  (shares locked in pending SELL orders)&#10;avg_buy_price DECIMAL(10,2)&#10;total_investment DECIMAL(15,2)&#10;last_updated_at TIMESTAMPTZ&#10;&#10;-- current_value and profit_loss&#10;-- NEVER STORED (calculated on-the-fly)&#10;&#10;ON-THE-FLY P&amp;L CALCULATION:&#10;GET /api/v1/portfolio:&#10;FOR each holding:&#10;  current_price = Redis GET stock_price:{symbol}&#10;  current_value = quantity × current_price&#10;  profit_loss = current_value - total_investment&#10;  pnl_percent = (PL / total_investment) × 100&#10;&#10;WHY ON-THE-FLY: Price changes hundreds of&#10;times per second. Stored value stale instantly.&#10;Redis cache TTL 1s refreshed continuously.&#10;&#10;SELL FLOW: UPDATE portfolio SET&#10;  quantity -= qty, locked_quantity += qty&#10;On EXECUTED: UPDATE locked_quantity -= qty&#10;On REJECTED: restore quantity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="780" y="120" width="320" height="420" as="geometry"/></mxCell>

<mxCell id="tradesTable" value="TABLE: trades (historical execution records)&#10;&#10;trade_id UUID PK&#10;order_id UUID FK → orders&#10;user_id UUID&#10;stock_symbol VARCHAR(20)&#10;trade_type ENUM(BUY, SELL)&#10;quantity INT&#10;executed_price DECIMAL(10,2) (actual exchange price)&#10;executed_at TIMESTAMPTZ&#10;exchange ENUM(NSE, BSE)&#10;commission_fee DECIMAL(8,2)&#10;settlement_status ENUM(PENDING, T_PLUS_1, SETTLED)&#10;&#10;INDEXES:&#10;idx_trades_user_date (user_id, executed_at DESC)&#10;idx_trades_symbol (stock_symbol, executed_at DESC)&#10;&#10;USAGE: Trade history, audit trail, tax reporting&#10;&#10;WHY SEPARATE FROM ORDERS:&#10;One order can have multiple partial fills&#10;(limit orders executed in chunks over time)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="60" y="520" width="340" height="280" as="geometry"/></mxCell>

<mxCell id="stocksTable" value="TABLE: stocks (metadata, NOT source of truth for price)&#10;&#10;stock_symbol VARCHAR(20) PK (RELIANCE, TCS, INFY)&#10;company_name VARCHAR(255)&#10;exchange ENUM(NSE, BSE)&#10;current_price DECIMAL(10,2) (cached from Redis, NOT SoT)&#10;prev_close DECIMAL(10,2) (updated at end of trading day)&#10;day_high DECIMAL(10,2)&#10;day_low DECIMAL(10,2)&#10;volume BIGINT&#10;market_cap DECIMAL(15,2)&#10;sector VARCHAR(100)&#10;last_updated_at TIMESTAMPTZ&#10;&#10;WHY prev_close stored: For day_change calculation&#10;day_change_percent = (current - prev_close) / prev_close × 100&#10;&#10;CRITICAL: current_price cached for display only.&#10;Source of truth: Redis stock_price:{symbol} TTL 1s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="420" y="520" width="340" height="280" as="geometry"/></mxCell>

<mxCell id="redisTitle" value="REDIS KEYS (Cache + PubSub + Dedup + Session State)" style="text;html=1;strokeColor=#f57f17;fillColor=#fff9c4;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="1140" y="80" width="1000" height="25" as="geometry"/></mxCell>

<mxCell id="redisPrice" value="KEY: stock_price:{symbol} STRING&#10;&#10;Example: stock_price:RELIANCE&#10;Value: 2458.75&#10;TTL: 1s (refreshed continuously by Price Ingester)&#10;&#10;USAGE:&#10;- Order Svc: GET stock_price:RELIANCE → estimate cost&#10;- Portfolio Svc: P&amp;L on-the-fly calculation&#10;- WebSocket Gateway: current quote on reconnect&#10;&#10;WRITE: Price Ingester subscribes to NSE/BSE feed&#10;  → SET stock_price:{symbol} {price} EX 1&#10;  → Redis TTL 1s (auto-evict if ingester crashes)&#10;&#10;WHY TTL 1s: Price changes hundreds of times/sec&#10;Cache hit rate: 99%+ (all reads use cached price)&#10;Sub-millisecond read latency vs S3 200ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=3;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1140" y="120" width="340" height="260" as="geometry"/></mxCell>

<mxCell id="redisPubSub" value="CHANNEL: stock_price PUBSUB&#10;&#10;PUBLISH: Price Ingester&#10;  PUBLISH stock_price '{symbol: RELIANCE,&#10;  price: 2458.75, change: +0.2%, volume: 125K}'&#10;&#10;SUBSCRIBE: WebSocket Gateway (10+ instances)&#10;  SUBSCRIBE stock_price&#10;  On message → find users watching RELIANCE&#10;  → push via WebSocket to clients&#10;&#10;LATENCY BREAKDOWN:&#10;Exchange → Price Ingester: 5ms&#10;Price Ingester → Redis PUBLISH: 2ms&#10;Redis PubSub → WS Gateway: 3ms (in-memory fan-out)&#10;WS Gateway → Client: 10ms (internet)&#10;TOTAL: ~20ms (well under 50ms target)&#10;&#10;WHY PUBSUB (NOT POLLING):&#10;10 WS Gateway instances subscribe once&#10;Price Ingester publishes 1 message&#10;All 10 receive instantly (&lt;10ms)&#10;No persistence, no Kafka overhead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1140" y="400" width="340" height="340" as="geometry"/></mxCell>

<mxCell id="redisDedup" value="KEY: order_lock:{orderId} STRING&#10;&#10;Example: order_lock:ORD123&#10;Value: 1 (or user_id for tracking)&#10;TTL: 30s&#10;&#10;USAGE: Validator duplicate order detection&#10;Consume Kafka new_orders:&#10;SETNX order_lock:{orderId} 1 EX 30&#10;IF returns 1 → success, first time seeing this order&#10;IF returns 0 → duplicate, reject with 409 Conflict&#10;&#10;WHY SETNX (NOT EXISTS + SET):&#10;SETNX is atomic (SET if Not eXists)&#10;Two simultaneous validators process same order&#10;→ one gets 1 (success), other gets 0 (duplicate)&#10;No race condition (atomic operation)&#10;&#10;TTL 30s: Order validated within 30s or retry&#10;Auto-cleanup prevents key space explosion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1500" y="120" width="320" height="300" as="geometry"/></mxCell>

<mxCell id="redisCircuit" value="KEY: price_change:{symbol}:{timeframe} STRING&#10;&#10;Example: price_change:RELIANCE:5m&#10;Value: +2.3% (or -10.5% during crash)&#10;TTL: 5 minutes (rolling window)&#10;&#10;USAGE: Validator circuit breaker check&#10;GET price_change:RELIANCE:5m&#10;IF ABS(change) &gt; 10%&#10;  → REJECT order with 429 Too Many Requests&#10;  → message: Circuit Breaker Active -&#10;     Price volatility exceeded threshold&#10;&#10;WRITE: Price Ingester calculates:&#10;current_price = 2458.75&#10;price_5m_ago = GET price_snapshot:RELIANCE:5m_ago&#10;change_pct = (current - 5m_ago) / 5m_ago × 100&#10;SET price_change:RELIANCE:5m {change_pct} EX 300&#10;&#10;WHY CIRCUIT BREAKER:&#10;2010 US Flash Crash: Dow fell 1000 pts in minutes&#10;Algorithmic feedback loop panic sell spiral&#10;Circuit breaker halts trading → prevents market crash&#10;SEBI regulatory requirement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1500" y="440" width="320" height="300" as="geometry"/></mxCell>

<mxCell id="redisSession" value="KEY: user_session:{token} HASH&#10;&#10;Example: user_session:JWT_abc123&#10;Fields: user_id, email, kyc_status, login_at&#10;TTL: 24h (JWT token validity)&#10;&#10;USAGE: Fast session lookup on every API call&#10;Extract JWT from Authorization header&#10;GET user_session:{token}&#10;IF miss → validate JWT signature + DB lookup → SET cache&#10;IF hit → read user_id, kyc_status directly&#10;&#10;WHY CACHE SESSIONS:&#10;Every API call needs user_id (100K req/sec)&#10;PostgreSQL lookup 10ms × 100K = overload&#10;Redis read &lt;1ms × 100K = negligible load&#10;&#10;Alternative: session:{user_id} with WS conn tracking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1840" y="120" width="300" height="280" as="geometry"/></mxCell>

<mxCell id="kafkaTitle" value="KAFKA TOPICS (Event-Driven Order Flow | At-Least-Once Delivery)" style="text;html=1;strokeColor=#ef6c00;fillColor=#fff3e0;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="830" width="1040" height="25" as="geometry"/></mxCell>

<mxCell id="kafkaNew" value="TOPIC: new_orders&#10;&#10;PRODUCER: Order Service&#10;CONSUMER: Validator Service (5 instances)&#10;PARTITIONS: 50 (by order_id hash)&#10;REPLICATION: RF=3 (fault tolerance)&#10;&#10;MESSAGE SCHEMA:&#10;{&#10;  orderId: ORD123,&#10;  userId: UUID,&#10;  stockSymbol: RELIANCE,&#10;  orderType: MARKET,&#10;  tradeType: BUY,&#10;  quantity: 10,&#10;  price: null (for MARKET),&#10;  estimatedCost: 24607.50,&#10;  timestamp: 2025-01-01T10:30:00Z&#10;}&#10;&#10;FLOW: Order Svc returns 200 PENDING → user not blocked&#10;Validator consumes async → runs 4-stage validation&#10;(dedup, KYC, risk, circuit breaker)&#10;&#10;WHY KAFKA: Decouples Order Svc from Validator&#10;If Validator crashes, Kafka buffers messages&#10;Consumer offset not committed until validation done&#10;→ at-least-once delivery, zero lost orders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="60" y="870" width="320" height="400" as="geometry"/></mxCell>

<mxCell id="kafkaVerified" value="TOPIC: verified_orders&#10;&#10;PRODUCER: Validator Service&#10;CONSUMER: Exchange Gateway (3 instances)&#10;PARTITIONS: 50 (by stock_symbol for ordering)&#10;REPLICATION: RF=3&#10;&#10;MESSAGE SCHEMA:&#10;{&#10;  orderId: ORD123,&#10;  stockSymbol: RELIANCE,&#10;  orderType: MARKET,&#10;  tradeType: BUY,&#10;  quantity: 10,&#10;  validatedAt: timestamp,&#10;  userId: UUID (for audit)&#10;}&#10;&#10;FLOW: Validator SET status=VERIFIED in DB&#10;→ publish verified_orders → Exchange Gateway consumes&#10;→ format FIX message → send to NSE via persistent conn&#10;&#10;WHY SEPARATE TOPIC:&#10;new_orders can have high volume (all user orders)&#10;verified_orders filtered (only valid orders)&#10;Exchange Gateway only processes valid traffic&#10;Reduces FIX connection load" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="400" y="870" width="320" height="360" as="geometry"/></mxCell>

<mxCell id="kafkaStatus" value="TOPIC: order_status&#10;&#10;PRODUCER: Exchange Gateway (on FIX ExecutionReport)&#10;CONSUMERS: Order Tracker + Portfolio Svc + Notification&#10;  (parallel consumption, different consumer groups)&#10;PARTITIONS: 50 (by order_id hash)&#10;REPLICATION: RF=3&#10;&#10;MESSAGE SCHEMA:&#10;{&#10;  orderId: ORD123,&#10;  status: EXECUTED (or REJECTED),&#10;  executedPrice: 2459.00,&#10;  executedQuantity: 10,&#10;  executedAt: timestamp,&#10;  exchangeOrderId: NSE_XYZ789,&#10;  commissionFee: 20.00&#10;}&#10;&#10;PARALLEL CONSUMERS (each in own group):&#10;1. Order Tracker: UPDATE orders SET status=EXECUTED&#10;   INSERT trades (trade_id, executed_price, ...)&#10;2. Portfolio Svc: UPDATE portfolio holdings&#10;   (quantity, avg_buy_price, total_investment)&#10;3. Notification Svc: Push FCM/APNS to user mobile&#10;   WebSocket real-time if user online&#10;&#10;WHY PARALLEL: All 3 services process same event&#10;independently, at own pace, can retry on failure&#10;One slow consumer does not block others" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=3;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="740" y="870" width="360" height="400" as="geometry"/></mxCell>

<mxCell id="influxTitle" value="INFLUXDB TIME-SERIES (100K+ Price Writes/Sec | Auto-Downsampling)" style="text;html=1;strokeColor=#388e3c;fillColor=#e8f5e9;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="1140" y="780" width="1000" height="25" as="geometry"/></mxCell>

<mxCell id="influxMeasurement" value="MEASUREMENT: stock_prices&#10;&#10;TAGS (indexed for fast queries):&#10;  symbol (RELIANCE, TCS, INFY, ...)&#10;  exchange (NSE, BSE)&#10;&#10;FIELDS (actual data):&#10;  price FLOAT&#10;  volume INT&#10;  day_high FLOAT&#10;  day_low FLOAT&#10;  bid FLOAT (best buyer price)&#10;  ask FLOAT (best seller price)&#10;&#10;TIMESTAMP: nanosecond precision&#10;&#10;WRITE EXAMPLE:&#10;stock_prices,symbol=RELIANCE,exchange=NSE&#10;  price=2458.75,volume=125000,day_high=2465,&#10;  day_low=2450 1704096600000000000&#10;&#10;SCALE: 100K+ writes/sec across 8-10K stocks&#10;Why InfluxDB handles it: LSM tree append-only writes,&#10;no index rebuild (unlike SQL B-tree)&#10;Time-based partitioning: data stored in time chunks&#10;Last hour query skips directly to that chunk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1140" y="820" width="340" height="360" as="geometry"/></mxCell>

<mxCell id="influxDownsample" value="CONTINUOUS QUERIES (Auto-Downsampling)&#10;&#10;RETENTION POLICY:&#10;1-min candles: stored forever (raw data)&#10;5-min candles: auto-aggregated from 1-min&#10;1-hour candles: auto-aggregated from 5-min&#10;Daily candles: auto-aggregated from 1-hour&#10;&#10;CONTINUOUS QUERY EXAMPLE:&#10;CREATE CONTINUOUS QUERY cq_5m_candles ON trading_db&#10;BEGIN&#10;  SELECT mean(price) AS price,&#10;         first(price) AS open, max(price) AS high,&#10;         min(price) AS low, last(price) AS close,&#10;         sum(volume) AS volume&#10;  INTO stock_prices_5m&#10;  FROM stock_prices&#10;  GROUP BY time(5m), symbol, exchange&#10;END&#10;&#10;QUERY FOR 1-DAY CHART:&#10;SELECT mean(price) FROM stock_prices_5m&#10;WHERE symbol = 'RELIANCE' AND time &gt; now() - 1d&#10;GROUP BY time(5m)&#10;Returns: 288 data points (24hr × 12 per hour)&#10;Latency: &lt;100ms (pre-aggregated, indexed by time)&#10;&#10;WHY DOWNSAMPLING:&#10;1Y chart with 1-sec data = 31.5M points (too many)&#10;1Y chart with 5-min candles = 105K points (perfect)&#10;Storage savings: 70% (compressed + aggregated)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1500" y="820" width="360" height="440" as="geometry"/></mxCell>

<mxCell id="influxQuery" value="EXAMPLE QUERIES:&#10;&#10;1. Current quote (fallback when Redis miss):&#10;SELECT last(price), last(volume), last(bid), last(ask)&#10;FROM stock_prices&#10;WHERE symbol = 'RELIANCE'&#10;AND time &gt; now() - 1m&#10;-- Returns: latest tick in last 1 min&#10;&#10;2. 1-hour intraday chart (5-min candles):&#10;SELECT mean(price) FROM stock_prices_5m&#10;WHERE symbol = 'TCS' AND time &gt; now() - 1h&#10;GROUP BY time(5m)&#10;-- Returns: 12 data points&#10;&#10;3. Historical comparison (daily candles):&#10;SELECT first(price) AS open, max(price) AS high,&#10;       min(price) AS low, last(price) AS close&#10;FROM stock_prices_daily&#10;WHERE symbol = 'INFY' AND time &gt; now() - 1y&#10;GROUP BY time(1d)&#10;-- Returns: 365 OHLC candles for 1-year chart&#10;&#10;WHY TIME-SERIES BEATS SQL:&#10;SQL: 3 trillion rows (10 years × 10K stocks)&#10;B-tree index rebuild on every INSERT → thrashes&#10;InfluxDB: time-based partitioning + LSM tree&#10;100K writes/sec sustained, zero index rebuild" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1880" y="820" width="260" height="440" as="geometry"/></mxCell>

<mxCell id="failureTitle" value="FAILURE SCENARIOS AND RECOVERY STRATEGIES" style="text;html=1;strokeColor=#c62828;fillColor=#ffebee;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="1310" width="2080" height="25" as="geometry"/></mxCell>

<mxCell id="fail1" value="FAILURE 1: Redis Cache Down&#10;&#10;SYMPTOM: Stock price reads fail, P&amp;L calculation breaks&#10;&#10;IMMEDIATE IMPACT:&#10;- Order placement: cannot estimate cost → 503 Service Unavailable&#10;- Portfolio view: cannot calculate P&amp;L → show last known values&#10;- WebSocket: cannot push prices → fallback to polling InfluxDB&#10;&#10;RECOVERY:&#10;1. Fallback: Query InfluxDB for current quote:&#10;   SELECT last(price) FROM stock_prices&#10;   WHERE symbol = 'RELIANCE' AND time &gt; now() - 1m&#10;   (slower ~100ms vs Redis 1ms, but functional)&#10;2. WebSocket Gateway switches to InfluxDB polling (every 1s)&#10;   instead of Redis PubSub push&#10;3. Order Svc uses PostgreSQL stocks.current_price (stale OK)&#10;4. Redis auto-recovery: restart cluster, Price Ingester&#10;   repopulates cache in ~30s (8-10K stocks)&#10;&#10;PREVENTION:&#10;- Redis Cluster with 20 nodes RF=3 (high availability)&#10;- Monitoring: alert if cache hit rate drops below 95%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="60" y="1350" width="420" height="320" as="geometry"/></mxCell>

<mxCell id="fail2" value="FAILURE 2: Kafka Broker Crash (Partition Leader Lost)&#10;&#10;SYMPTOM: order_status topic partition 25 leader crashed&#10;All orders with orderId hash → partition 25 stuck&#10;&#10;IMMEDIATE IMPACT:&#10;- Orders in partition 25: PLACED status, awaiting EXECUTED&#10;- Order Tracker cannot consume → trades table not updated&#10;- Portfolio Svc cannot consume → holdings not updated&#10;- Notification Svc cannot consume → users not notified&#10;&#10;RECOVERY (AUTOMATIC):&#10;1. Kafka controller elects new leader from ISR (in-sync replica)&#10;   Partition 25 leadership: Broker 3 (crashed) → Broker 5 (new leader)&#10;   Election time: ~5 seconds&#10;2. Consumers reconnect to new leader partition&#10;   Resume from last committed offset (no message loss)&#10;3. Buffered messages (during leader election) replayed&#10;   Order Tracker catches up in ~10s&#10;&#10;DATA CONSISTENCY:&#10;- Kafka RF=3: each message replicated to 3 brokers&#10;- Even if 2 brokers crash, 1 replica survives → zero data loss&#10;- At-least-once delivery: consumer commits offset only after&#10;  processing complete (DB write + notification sent)&#10;&#10;PREVENTION:&#10;- 10 Kafka brokers, RF=3 (can lose 2 brokers per partition)&#10;- min.insync.replicas=2 (producer waits for 2 acks)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="500" y="1350" width="440" height="400" as="geometry"/></mxCell>

<mxCell id="fail3" value="FAILURE 3: Fund Locking Deadlock (Two Users Cross-Locking)&#10;&#10;SCENARIO:&#10;User A places BUY RELIANCE ₹49K (locks funds row A)&#10;User B places BUY TCS ₹40K (locks funds row B)&#10;Both are PENDING, funds locked&#10;Now User A tries to BUY TCS ₹10K → waits for row A lock&#10;User B tries to BUY RELIANCE ₹5K → waits for row B lock&#10;DEADLOCK if cross-locking occurs&#10;&#10;POSTGRESQL DEADLOCK DETECTION:&#10;PostgreSQL detects cycle: txn A waits for B, B waits for A&#10;Automatically aborts one transaction (youngest txn)&#10;Aborted txn returns: 40001 SQLSTATE deadlock_detected&#10;&#10;RECOVERY:&#10;1. Order Svc catches deadlock exception&#10;2. ROLLBACK transaction, unlock funds&#10;3. Return 409 Conflict: Order processing failed, please retry&#10;4. User retries → second attempt likely succeeds (no lock contention)&#10;&#10;ACTUAL RISK: Low (each user locks own funds row, different rows)&#10;Deadlock only if same user fires two simultaneous orders&#10;from different devices/tabs → rare edge case&#10;&#10;PREVENTION:&#10;- Lock timeout: SET lock_timeout = 5s&#10;  If lock not acquired in 5s → abort with timeout error&#10;- Retry logic: exponential backoff (100ms → 200ms → 400ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="960" y="1350" width="440" height="400" as="geometry"/></mxCell>

<mxCell id="fail4" value="FAILURE 4: Exchange Gateway FIX Connection Drop&#10;&#10;SYMPTOM: FIX connection to NSE lost (network partition)&#10;Orders in VERIFIED status cannot be sent to exchange&#10;&#10;IMMEDIATE IMPACT:&#10;- verified_orders topic messages accumulate in Kafka&#10;- Orders stuck in VERIFIED status (not PLACED)&#10;- Users see: Order verified, awaiting exchange confirmation&#10;&#10;RECOVERY:&#10;1. Exchange Gateway detects connection loss (heartbeat miss)&#10;2. Attempt reconnect with exponential backoff:&#10;   Try 1: immediate, Try 2: 2s, Try 3: 4s, max 30s&#10;3. FIX protocol session recovery: send ResendRequest&#10;   to replay any missed ExecutionReports during downtime&#10;4. Once reconnected, resume consuming verified_orders from Kafka&#10;   Buffered orders sent to NSE in sequence&#10;&#10;DATA CONSISTENCY:&#10;- Kafka retains verified_orders until processed&#10;- Exchange Gateway consumer offset not committed until&#10;  FIX send confirmed AND status=PLACED updated in DB&#10;- If Gateway crashes, new instance resumes from last offset&#10;&#10;ORDER TIMEOUT:&#10;If connection down &gt;5 min (market hours):&#10;- Order Tracker polls orders WHERE status=VERIFIED AND&#10;  placed_at &lt; now() - 5min → flag as STALE&#10;- Admin alert: Manual review, may need to CANCEL and refund&#10;&#10;PREVENTION:&#10;- 3 Exchange Gateway instances (active-active)&#10;- Each maintains separate FIX connections pool&#10;- If one instance FIX conn drops, others handle load" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1420" y="1350" width="440" height="440" as="geometry"/></mxCell>

<mxCell id="fail5" value="FAILURE 5: InfluxDB Write Overload (Price Ingester Lag)&#10;&#10;SYMPTOM: Price Ingester cannot keep up with 100K writes/sec&#10;InfluxDB write queue full, backpressure builds&#10;&#10;IMMEDIATE IMPACT:&#10;- Historical prices lagging (chart data delayed ~5 min)&#10;- Current quotes still OK (Redis cache independent)&#10;- WebSocket live feed OK (Redis PubSub independent)&#10;&#10;VISIBLE TO USER:&#10;- Portfolio P&amp;L: accurate (uses Redis current price)&#10;- Chart: shows prices from 5 min ago (stale but functional)&#10;- Order placement: unaffected (uses Redis price)&#10;&#10;RECOVERY:&#10;1. Price Ingester implements sampling: write every 5th tick&#10;   instead of every tick (reduces write load 80%)&#10;2. InfluxDB auto-scales: add more nodes to cluster&#10;   Horizontal scaling: distribute writes across nodes&#10;3. Continuous queries catch up once load decreases&#10;   Downsampling (1-min → 5-min) resumes normally&#10;&#10;MONITORING:&#10;- Alert if InfluxDB write lag &gt; 2 min&#10;- Price Ingester metrics: messages_processed, write_failures&#10;&#10;PREVENTION:&#10;- InfluxDB cluster with 10 nodes (write distribution)&#10;- Batching: Price Ingester batches 1000 points per write&#10;  (reduces network overhead 100x)&#10;- Retention policy: drop ticks older than 1 year&#10;  (only 1-min candles retained forever)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="60" y="1690" width="460" height="420" as="geometry"/></mxCell>

<mxCell id="fail6" value="FAILURE 6: Circuit Breaker False Positive&#10;(Legitimate Price Movement Blocked)&#10;&#10;SCENARIO:&#10;RELIANCE announces stellar quarterly results at 9:30 AM&#10;Stock price jumps +12% in 3 minutes (genuine demand)&#10;Circuit breaker: price_change:RELIANCE:5m = +12%&#10;→ Validator rejects all new RELIANCE orders&#10;&#10;IMMEDIATE IMPACT:&#10;- Users cannot BUY RELIANCE (frustrated, lost opportunity)&#10;- Validator logs: 10,000 orders rejected in 5 min&#10;- Status: 429 Too Many Requests Circuit Breaker Active&#10;&#10;ADMIN REVIEW:&#10;1. Risk team checks: Is this genuine news or manipulation?&#10;   - Check NSE official announcements: Quarterly results OK&#10;   - Volume spike: 10× normal (confirms genuine demand)&#10;2. Decision: Disable circuit breaker for RELIANCE temporarily&#10;   SET circuit_breaker:RELIANCE:override 0 EX 3600 (1 hour)&#10;3. Validator checks override before rejecting:&#10;   IF circuit_breaker:{symbol}:override exists → allow order&#10;4. Resume normal trading, re-enable after 1 hour&#10;&#10;AUTOMATED CALIBRATION:&#10;- Circuit breaker threshold dynamic: 10% during normal hours,&#10;  20% during result announcement season (quarterly earnings)&#10;- Machine learning: train on historical volatility patterns&#10;  to reduce false positives&#10;&#10;TRADEOFF:&#10;False positive: frustrated users, lost trading opportunity&#10;False negative: allow manipulation, market crash risk&#10;Regulatory requirement: err on side of caution (SEBI mandate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="540" y="1770" width="480" height="440" as="geometry"/></mxCell>

<mxCell id="scaleNote" value="SCALE SUMMARY: 1M users, 8-10K stocks, 100K orders/min peak, 100K price writes/sec InfluxDB, PostgreSQL 10 shards by user_id (100K users/shard), Redis 20-node cluster, Kafka 10 brokers 50 partitions RF=3, Exchange Gateway 3 instances (400-500 FIX connections each), WebSocket Gateway 10 instances (10K connections each), Validator 5 instances (parallel processing), ~₹50L/month AWS infra cost (RDS Multi-AZ, ElastiCache, MSK Kafka, EC2 t3.large × 30)" style="text;html=1;strokeColor=#1976d2;fillColor=#e3f2fd;align=center;fontSize=11;rounded=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1040" y="1830" width="1100" height="60" as="geometry"/></mxCell>

</root></mxGraphModel></diagram></mxfile>
