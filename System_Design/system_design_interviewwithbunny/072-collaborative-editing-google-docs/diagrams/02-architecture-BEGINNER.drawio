<mxCell id="t" value="TEXT EDITOR - High-Level Architecture (OT Engine + Redis Canonical Copy + WebSocket Real-Time Broadcast)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1980" height="35" as="geometry"/></mxCell>

<mxCell id="clientLayer" value="CLIENT LAYER" style="text;html=1;strokeColor=#1976d2;fillColor=#e3f2fd;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="80" width="1980" height="25" as="geometry"/></mxCell>
<mxCell id="webClient" value="Web Client&#10;(React/Vue)&#10;WebSocket conn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="80" y="120" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="mobileClient" value="Mobile Client&#10;(iOS/Android)&#10;WebSocket conn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="260" y="120" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="offlineClient" value="Offline Client&#10;(IndexedDB Queue)&#10;Sync on reconnect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;fontSize=11;dashed=1" vertex="1" parent="1"><mxGeometry x="440" y="120" width="150" height="70" as="geometry"/></mxCell>

<mxCell id="edgeLayer" value="EDGE LAYER (CDN + Load Balancers)" style="text;html=1;strokeColor=#c2185b;fillColor=#fce4ec;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="220" width="1980" height="25" as="geometry"/></mxCell>
<mxCell id="cdn" value="CDN&#10;(CloudFront)&#10;Static Assets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#c2185b;strokeWidth=3;fontSize=11" vertex="1" parent="1"><mxGeometry x="80" y="260" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="wsLB" value="WebSocket LB&#10;Sticky Session&#10;10K conn/instance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcc80;strokeColor=#ef6c00;strokeWidth=3;fontSize=11" vertex="1" parent="1"><mxGeometry x="260" y="260" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="apiLB" value="API Gateway LB&#10;REST + Auth&#10;Rate Limiting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcc80;strokeColor=#ef6c00;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="440" y="260" width="150" height="70" as="geometry"/></mxCell>

<mxCell id="serviceLayer" value="SERVICE LAYER (Document Management + Real-Time Sync)" style="text;html=1;strokeColor=#388e3c;fillColor=#e8f5e9;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="360" width="1980" height="25" as="geometry"/></mxCell>

<mxCell id="wsGateway" value="WebSocket Gateway&#10;Maintains persistent connections&#10;Handles join/leave events&#10;Broadcasts ops to all editors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=3;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="80" y="400" width="220" height="90" as="geometry"/></mxCell>

<mxCell id="editorService" value="Document Editor Service&#10;OT transformation engine&#10;Assigns server_version (order)&#10;Validates ops (position, permission)&#10;Manages Redis canonical copy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=3;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="340" y="400" width="220" height="110" as="geometry"/></mxCell>

<mxCell id="metadataService" value="Metadata Service&#10;Document CRUD&#10;Permissions (view/edit/comment)&#10;Sharing + collaborators&#10;Version list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="600" y="400" width="200" height="100" as="geometry"/></mxCell>

<mxCell id="reconService" value="Reconciliation Service&#10;Kafka consumer (doc.operations)&#10;Snapshot generation (50 ops/5 min)&#10;Op validation + checksum&#10;State rebuild on cache miss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="840" y="400" width="220" height="110" as="geometry"/></mxCell>

<mxCell id="exportService" value="Export Service&#10;Async job: snapshot → render&#10;PDF/DOCX/TXT conversion&#10;Pre-signed S3 URL return" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="1100" y="400" width="200" height="90" as="geometry"/></mxCell>

<mxCell id="dataLayer" value="DATA LAYER (Redis Cache + Op-log DB + Blob Storage)" style="text;html=1;strokeColor=#7b1fa2;fillColor=#f3e5f5;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="540" width="1980" height="25" as="geometry"/></mxCell>

<mxCell id="redis" value="Redis Cluster&#10;doc:{docId}:state (TTL 30min)&#10;cursors:{docId} HASH (TTL 5min)&#10;lock:doc:{docId}:{section} (pessimistic)&#10;Sub-millisecond read, 90% cache hit" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=3;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="80" y="580" width="240" height="120" as="geometry"/></mxCell>

<mxCell id="postgres" value="PostgreSQL (Sharded)&#10;documents table (metadata, permissions)&#10;operations table (append-only op-log)&#10;snapshots table (version pointers)&#10;INDEX (doc_id, server_version)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="360" y="580" width="260" height="120" as="geometry"/></mxCell>

<mxCell id="kafka" value="Kafka&#10;doc.operations topic&#10;100 partitions, RF=3&#10;Consumed by Reconciliation,&#10;Metadata, Analytics" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffcc80;strokeColor=#ef6c00;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="660" y="580" width="220" height="120" as="geometry"/></mxCell>

<mxCell id="s3" value="S3 Storage&#10;docs/{docId}/v{N}.txt.gz&#10;gzip compressed snapshots&#10;Lifecycle: Standard → IA (30d)&#10;→ Glacier (90d)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="920" y="580" width="240" height="120" as="geometry"/></mxCell>

<mxCell id="whyWS" value="WHY WEBSOCKET GATEWAY?&#10;&#10;HTTP polling = 1M users × 1 req/sec = 1M req/sec overhead (99% empty responses).&#10;WebSocket = persistent bidirectional connection, server pushes updates ONLY when data changes → 100x traffic reduction.&#10;Sticky session (IP hash) keeps same user on same gateway instance for WebSocket state continuity (connection not lost on instance switch)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1400" y="80" width="640" height="100" as="geometry"/></mxCell>

<mxCell id="whyOT" value="WHY OT TRANSFORMATION ENGINE?&#10;&#10;Concurrent edits without central ordering → divergent states. User A inserts 'X' at pos 5, User B deletes at pos 3 — both at version 10.&#10;OT: Server assigns sequential versions (A=v11, B arrives late at v10) → transforms B's position: delete happened before insert → shift B by +1 → converge.&#10;Server-assigned order (server_version) = single source of truth. All clients apply in server order → guaranteed convergence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1400" y="200" width="640" height="100" as="geometry"/></mxCell>

<mxCell id="whyRedis" value="WHY REDIS CANONICAL COPY?&#10;&#10;90% of reads hit Redis (sub-ms) instead of S3 (200ms fetch) or replaying 10K ops from PostgreSQL (5 seconds).&#10;TTL=30 min for active docs, auto-evict inactive. On cache miss: fetch snapshot from S3 + replay recent ops from op-log → cache result.&#10;Cursors EPHEMERAL in Redis HASH TTL=5 min — NEVER persist to DB (100 updates/sec/user × 100 editors = 10K writes/sec, all temporary)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=3;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1400" y="320" width="640" height="100" as="geometry"/></mxCell>

<mxCell id="whyOpLog" value="WHY APPEND-ONLY OP-LOG?&#10;&#10;Every edit is immutable operation {type, position, content, server_version} inserted into PostgreSQL (never updated/deleted).&#10;Replay ops to reconstruct state. Version history = list of snapshots (S3 pointer + timestamp). Rollback creates NEW snapshot (never mutates).&#10;Audit trail: who changed what when. Op-log is source of truth for all document state transitions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1400" y="440" width="640" height="90" as="geometry"/></mxCell>

<mxCell id="whySnapshot" value="WHY SNAPSHOTS EVERY 50 OPS / 5 MIN?&#10;&#10;Without snapshots: replaying 10K ops = 5 seconds to open doc. With snapshots: load latest snapshot + replay only 5-50 recent ops = ~65ms.&#10;gzip compression: 70% size reduction. S3 lifecycle: Standard → IA (30d) → Glacier (90d) for old versions.&#10;Trade-off: Snapshot frequency vs storage cost. 50 ops balances both (worst-case 50 ops replay ~50ms)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1400" y="550" width="640" height="90" as="geometry"/></mxCell>

<mxCell id="whyKafka" value="WHY KAFKA FOR OPERATIONS TOPIC?&#10;&#10;Decouples Editor Service (writes ops) from consumers (Reconciliation, Metadata update, Analytics).&#10;Async snapshot generation doesn't block real-time editing. 100 partitions for horizontal scaling.&#10;Op published to Kafka → Reconciliation Service consumes → generates snapshot if 50 ops threshold hit → uploads to S3." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1400" y="660" width="640" height="90" as="geometry"/></mxCell>

<mxCell id="edgeArrow1" value="" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#1976d2" edge="1" parent="1" source="webClient" target="wsLB"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="edgeArrow2" value="" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#1976d2" edge="1" parent="1" source="mobileClient" target="apiLB"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>

<mxCell id="svcArrow1" value="" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#388e3c" edge="1" parent="1" source="wsLB" target="wsGateway"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="svcArrow2" value="" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#388e3c" edge="1" parent="1" source="wsGateway" target="editorService"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="svcArrow3" value="" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#388e3c" edge="1" parent="1" source="apiLB" target="metadataService"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>

<mxCell id="dataArrow1" value="Cache&#10;90% hit" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=3;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="editorService" target="redis"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="dataArrow2" value="Op-log&#10;append" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#7b1fa2;fontSize=10" edge="1" parent="1" source="editorService" target="postgres"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="dataArrow3" value="Publish&#10;op" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#ef6c00;fontSize=10" edge="1" parent="1" source="editorService" target="kafka"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="dataArrow4" value="Consume&#10;snapshot" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#ef6c00;fontSize=10" edge="1" parent="1" source="kafka" target="reconService"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="dataArrow5" value="Upload&#10;snapshot" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#c62828;fontSize=10" edge="1" parent="1" source="reconService" target="s3"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>

<mxCell id="flowSummary" value="CRITICAL PATH FLOW: User types 'X' → WebSocket Gateway → Editor Service validates + OT transform + assign server_version → INSERT op-log → publish Kafka → SET Redis cache → broadcast to all other editors → Reconciliation Service (async) generates snapshot if 50 ops threshold → S3 upload. Total latency: &lt;300ms from keystroke to all 50 editors seeing change." style="text;html=1;strokeColor=#1976d2;fillColor=#e3f2fd;align=center;fontSize=11;rounded=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="80" y="740" width="1960" height="50" as="geometry"/></mxCell>

<mxCell id="scaleNumbers" value="SCALE AT 1M USERS: 100 WebSocket Gateway instances (10K conn each), 200 Editor Service instances, 100 Redis nodes, 100 PostgreSQL shards (by doc_id hash), 20 Kafka brokers 100 partitions, ~60 Gbps network, $500K/month infrastructure cost" style="text;html=1;strokeColor=#ef6c00;fillColor=#fff3e0;align=center;fontSize=11;rounded=1" vertex="1" parent="1"><mxGeometry x="80" y="810" width="1960" height="40" as="geometry"/></mxCell>

</root></mxGraphModel></diagram></mxfile>
