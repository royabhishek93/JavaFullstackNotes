<mxfile host="app.diagrams.net"><diagram name="Data Model" id="texteditor-data"><mxGraphModel dx="2000" dy="1500" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2000" pageHeight="1650" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="TEXT EDITOR - Data Model (PostgreSQL Op-log + Redis Ephemeral Cache + S3 Snapshots)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1880" height="35" as="geometry"/></mxCell>

<mxCell id="pgTitle" value="POSTGRESQL SCHEMAS (Metadata + Append-Only Op-log + Snapshot Pointers)" style="text;html=1;strokeColor=#7b1fa2;fillColor=#f3e5f5;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="80" width="920" height="30" as="geometry"/></mxCell>

<mxCell id="documentsTable" value="documents table (metadata + permissions)&#10;&#10;PRIMARY KEY: doc_id&#10;INDEX: owner_id&#10;INDEX: (deleted_at IS NULL) for soft-delete filter&#10;&#10;Column: doc_id (UUID PK)&#10;Column: owner_id (UUID FK to Users)&#10;Column: title (VARCHAR 255)&#10;Column: metadata (JSONB for created_at, tags, category)&#10;Column: permissions (JSONB array of user_id and role)&#10;Column: latest_snapshot_version (INT)&#10;Column: deleted_at (TIMESTAMP NULL or soft-delete)&#10;Column: created_at (TIMESTAMP)&#10;Column: updated_at (TIMESTAMP)&#10;&#10;WHY JSONB for permissions: Flexible roles without schema migration. Query with GIN index for fast array containment checks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="60" y="120" width="920" height="260" as="geometry"/></mxCell>

<mxCell id="operationsTable" value="operations table (APPEND-ONLY op-log — NEVER UPDATE/DELETE, immutable source of truth)&#10;&#10;PRIMARY KEY: op_id&#10;INDEX: (doc_id, server_version) — CRITICAL for range queries&#10;INDEX: (doc_id, timestamp) for time-based queries&#10;PARTITION BY: doc_id hash (shard across 100 nodes)&#10;&#10;Column: op_id (UUID PK)&#10;Column: doc_id (UUID FK partition key)&#10;Column: user_id (UUID who made edit)&#10;Column: type (ENUM: insert, delete, format, replace_all)&#10;Column: position (INT character position 0-indexed)&#10;Column: content (TEXT inserted or deleted)&#10;Column: client_version (INT client last known version)&#10;Column: server_version (INT SERIAL auto-increment, single source of truth)&#10;Column: timestamp (TIMESTAMP when server received)&#10;&#10;CRITICAL: server_version is SERIAL (auto-incrementing counter) = single source of truth for operation order.&#10;All clients replay ops sorted by server_version ASC → guaranteed convergence.&#10;&#10;WHY NEVER DELETE OPS: Audit trail, version history, state reconstruction. Archival: ops older than 90 days moved to S3 Glacier." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="60" y="400" width="920" height="340" as="geometry"/></mxCell>

<mxCell id="snapshotsTable" value="snapshots table (version history pointers to S3 blobs)&#10;&#10;PRIMARY KEY: snapshot_id&#10;INDEX: (doc_id, version DESC) for version list&#10;&#10;Column: snapshot_id (UUID PK)&#10;Column: doc_id (UUID FK to documents)&#10;Column: version (INT incremental version number)&#10;Column: blob_path (VARCHAR S3 path docs/{docId}/v{N}.txt.gz)&#10;Column: operations_since_last (INT op count since previous snapshot)&#10;Column: created_at (TIMESTAMP snapshot generation time)&#10;Column: created_by (UUID system or user_id for rollback)&#10;Column: checksum (VARCHAR SHA-256 for validation)&#10;&#10;WHY pointer to S3: Snapshots can be 1.02M chars (multi-MB). Storing in DB bloats table, slow queries. S3 blob + pointer = fast metadata queries, cheap storage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="60" y="760" width="920" height="260" as="geometry"/></mxCell>

<mxCell id="redisTitle" value="REDIS KEY SPACE (Ephemeral Cache + Real-Time State — NO PERSISTENCE, TTL Auto-Expire)" style="text;html=1;strokeColor=#f57f17;fillColor=#fff9c4;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="1020" y="80" width="920" height="30" as="geometry"/></mxCell>

<mxCell id="redisDocState" value="doc:{docId}:state (STRING with TTL) — Canonical Document Copy&#10;&#10;Key pattern: doc:{docId}:state&#10;Value: Full document content (plain text or rich text JSON)&#10;TTL: 1800 seconds (30 minutes)&#10;&#10;Usage:&#10;  On document open: GET doc:{docId}:state&#10;  If HIT: return immediately (1ms cache hit, 90% of reads)&#10;  If MISS: fetch S3 snapshot + replay ops from PostgreSQL then cache result with SET doc:{docId}:state content EX 1800&#10;  On edit: UPDATE cache immediately after op applied&#10;&#10;Example:&#10;  doc:abc-123:state stores 'The quick brown fox...' (500KB text) with TTL 1423s&#10;  doc:xyz-789:state stores JSON rich text with ops array, TTL 902s&#10;&#10;Auto-eviction: Inactive docs (no edits for 30 min) expire from Redis, next open refetches from S3.&#10;&#10;WHY TTL=30 min: Balance cache hit rate vs memory. 30 min covers typical editing session. Longer TTL = more memory for inactive docs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=3;fontSize=10;align=left;verticalAlign=top;spacing=8;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="1020" y="120" width="920" height="280" as="geometry"/></mxCell>

<mxCell id="redisCursors" value="cursors:{docId} (HASH with TTL) — Ephemeral Cursor Presence&#10;&#10;Key pattern: cursors:{docId}&#10;Value: HASH mapping user_id to JSON with cursor_pos, selection start/end, color&#10;TTL: 300 seconds (5 minutes)&#10;&#10;Usage:&#10;  On cursor move: HSET cursors:{docId} user:{userId} with JSON payload of cursor position, selection range, color&#10;  On disconnect: HDEL cursors:{docId} user:{userId} + broadcast user_left event&#10;  On reconnect: HGETALL cursors:{docId} to list all active users cursors&#10;&#10;Example:&#10;  cursors:doc-abc is a HASH with fields:&#10;    user:alice maps to JSON with cursor_pos 10, selection start 10 end 15, color blue&#10;    user:bob maps to JSON with cursor_pos 50, no selection, color green&#10;  TTL: 287 seconds&#10;&#10;WHY HASH: One Redis key per doc (not per user) so HGETALL fetches all cursors in one command. Atomic HSET/HDEL for concurrent updates.&#10;WHY NEVER persist to DB: 100 cursor updates/sec/user times 100 editors = 10K writes/sec, all temporary with no recovery value. Pure real-time state." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=3;fontSize=10;align=left;verticalAlign=top;spacing=8;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="1020" y="420" width="920" height="300" as="geometry"/></mxCell>

<mxCell id="redisLock" value="lock:doc:{docId}:{section} (STRING with TTL) — Pessimistic Locking (Optional, High-Stakes Docs)&#10;&#10;Key pattern: lock:doc:{docId}:{section}&#10;Value: user_id who holds the lock&#10;TTL: 300 seconds (5 minutes, prevents deadlock if user disconnects)&#10;&#10;Usage:&#10;  On lock acquire: SETNX lock:doc:{docId}:para_5 with user_id value and EX 300 TTL&#10;  If success: return locked true with expires_at&#10;  If fail: return locked false with locked_by other_user_id&#10;  On edit: Validate lock still held before applying ops&#10;  On release: DELETE lock:doc:{docId}:para_5 + broadcast lock_released&#10;&#10;Example:&#10;  lock:doc:abc-123:section_financial_table stores user:alice with TTL 287s&#10;&#10;Trade-off: Pessimistic eliminates conflicts (good for legal contracts, financial tables) but kills concurrent editing flexibility (bad for general docs).&#10;Default: Optimistic (OT/CRDT). Pessimistic: Opt-in for specific sections." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="1020" y="740" width="920" height="240" as="geometry"/></mxCell>

<mxCell id="redisSession" value="session:{sessionId} (HASH with TTL) — User Session Tracking&#10;&#10;Key pattern: session:{sessionId}&#10;Value: HASH mapping user_id, doc_id, color&#10;TTL: 3600 seconds (1 hour)&#10;&#10;Usage:&#10;  On WebSocket connect: HSET session:{sessionId} user_id doc_id color, then EXPIRE session:{sessionId} 3600&#10;  On heartbeat/activity: refresh TTL (EXPIRE session:{sessionId} 3600)&#10;  On disconnect: DEL session:{sessionId}&#10;  Used by WebSocket Gateway to route reconnects and validate which doc/user a socket belongs to&#10;&#10;WHY separate from cursors:{docId}: cursors:{docId} is keyed per document (all users editing that doc); session:{sessionId} is keyed per connection (one user's active socket), letting the gateway look up session state without knowing the doc_id in advance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="1020" y="1000" width="920" height="220" as="geometry"/></mxCell>

<mxCell id="s3Title" value="S3 BLOB STORAGE (Compressed Snapshots + Lifecycle Management)" style="text;html=1;strokeColor=#c62828;fillColor=#ffebee;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="1260" width="1880" height="30" as="geometry"/></mxCell>

<mxCell id="s3Layout" value="S3 STORAGE LAYOUT&#10;&#10;Path structure:&#10;  docs/{doc_id}/v{version}.txt.gz for active snapshots with gzip compression 70% size reduction&#10;  docs/{doc_id}/v{version}_metadata.json for snapshot metadata (user, timestamp, op count)&#10;  archive/{doc_id}/ops_{year}_{month}.gz for archived old operations (90+ days, moved to Glacier)&#10;&#10;Examples:&#10;  docs/abc-123/v10.txt.gz is snapshot version 10, 500KB gzipped (1.5MB uncompressed)&#10;  docs/abc-123/v10_metadata.json contains version 10, created_at 2026-08-01, created_by system, ops_since_last 52, checksum sha256&#10;  docs/abc-123/v11.txt.gz is snapshot version 11, 502KB gzipped&#10;  archive/abc-123/ops_2026_08.gz contains all ops from August 2026 (compressed archive for compliance)&#10;&#10;Lifecycle Policy:&#10;  Standard Storage (0-30 days): Fast retrieval, frequent access, cost 0.023 dollars per GB per month&#10;  IA Infrequent Access (30-90 days): View-only access, cost 0.0125 dollars per GB per month (45% cheaper)&#10;  Glacier (90+ days): Compliance archive, retrieval time 5-12 hours, cost 0.004 dollars per GB per month (83% cheaper)&#10;&#10;WHY gzip compression: 1.02M char doc (1.5 MB text) compressed to 500 KB gzipped = 67% size reduction. S3 charges by GB-month so 3x storage savings.&#10;WHY versioned snapshots: Immutable history, never overwrite. Rollback fetches old version, creates new snapshot (v12 = restored v8).&#10;&#10;Retention:&#10;  Named versions (user-labeled milestones): NEVER expire&#10;  Auto-snapshots: Hot 30 days then IA 90 days then Glacier 1 year — snapshots themselves are kept forever, never purged (only archived operations older than 90 days are cleaned from hot storage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="60" y="1300" width="1880" height="280" as="geometry"/></mxCell>

</root></mxGraphModel></diagram></mxfile>
