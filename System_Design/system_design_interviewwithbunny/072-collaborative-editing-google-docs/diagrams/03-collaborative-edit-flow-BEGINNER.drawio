<mxfile host="app.diagrams.net"><diagram name="Collaborative Edit Flow" id="texteditor-seq"><mxGraphModel dx="2200" dy="1600" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2200" pageHeight="1600" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="TEXT EDITOR - Collaborative Edit Flow (Concurrent OT Transformation + Redis Cache + WebSocket Broadcast)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="60" y="20" width="2080" height="35" as="geometry"/></mxCell>
<mxCell id="subtitle" value="4 Phases: (1) Document Open + WebSocket Connect | (2) User A Inserts 'X' | (3) User B Deletes (Concurrent) | (4) OT Transformation + Broadcast" style="text;html=1;strokeColor=none;fillColor=#e8eaf6;align=center;rounded=1;fontSize=12" vertex="1" parent="1"><mxGeometry x="80" y="65" width="2040" height="28" as="geometry"/></mxCell>

<mxCell id="userA" value="User A&#10;(Editor)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="60" y="130" width="120" height="60" as="geometry"/></mxCell>
