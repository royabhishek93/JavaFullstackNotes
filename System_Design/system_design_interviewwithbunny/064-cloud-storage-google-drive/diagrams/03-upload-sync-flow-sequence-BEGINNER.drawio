<mxfile host="app.diagrams.net"><diagram name="Upload and Sync Flow" id="cloud-upload-flow"><mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="CLOUD STORAGE - Resumable Upload and Cross-Device Sync" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=22;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1820" height="35" as="geometry"/></mxCell>
<mxCell id="actors" value="Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=3;fontSize=13;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="100" width="140" height="45" as="geometry"/></mxCell>
<mxCell id="upload" value="File Uploader" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=3;fontSize=13;fontStyle=1" vertex="1" parent="1"><mxGeometry x="330" y="100" width="150" height="45" as="geometry"/></mxCell>
<mxCell id="redis" value="Redis Session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=3;fontSize=13;fontStyle=1" vertex="1" parent="1"><mxGeometry x="590" y="100" width="150" height="45" as="geometry"/></mxCell>
<mxCell id="dedup" value="Dedup Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=3;fontSize=13;fontStyle=1" vertex="1" parent="1"><mxGeometry x="850" y="100" width="150" height="45" as="geometry"/></mxCell>
<mxCell id="s3" value="S3 Blob Storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=3;fontSize=13;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1110" y="100" width="150" height="45" as="geometry"/></mxCell>
<mxCell id="meta" value="Metadata DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=3;fontSize=13;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1370" y="100" width="150" height="45" as="geometry"/></mxCell>
<mxCell id="kafka" value="Kafka + Sync Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=3;fontSize=13;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1630" y="100" width="180" height="45" as="geometry"/></mxCell>
<mxCell id="l1" style="endArrow=none;dashed=1;strokeColor=#1976d2" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="145" as="sourcePoint"/><mxPoint x="130" y="1000" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="l2" style="endArrow=none;dashed=1;strokeColor=#388e3c" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="405" y="145" as="sourcePoint"/><mxPoint x="405" y="1000" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="l3" style="endArrow=none;dashed=1;strokeColor=#f57f17" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="665" y="145" as="sourcePoint"/><mxPoint x="665" y="1000" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="l4" style="endArrow=none;dashed=1;strokeColor=#388e3c" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="145" as="sourcePoint"/><mxPoint x="925" y="1000" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="l5" style="endArrow=none;dashed=1;strokeColor=#c62828" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1185" y="145" as="sourcePoint"/><mxPoint x="1185" y="1000" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="l6" style="endArrow=none;dashed=1;strokeColor=#7b1fa2" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1445" y="145" as="sourcePoint"/><mxPoint x="1445" y="1000" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="l7" style="endArrow=none;dashed=1;strokeColor=#7b1fa2" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1720" y="145" as="sourcePoint"/><mxPoint x="1720" y="1000" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="p1" value="PHASE 1 - INITIATE AND RESUME" style="text;html=1;strokeColor=none;fillColor=#e3f2fd;align=left;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="50" y="175" width="500" height="25" as="geometry"/></mxCell>
<mxCell id="e1" value="1. POST /api/v1/files/upload/init {fileName, fileSize, parentFolderId}" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#1976d2;fontSize=10" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="220" as="sourcePoint"/><mxPoint x="405" y="220" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="e2" value="2. Create uploadId and session bitmap (TTL)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#f57f17;fontSize=10" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="405" y="260" as="sourcePoint"/><mxPoint x="665" y="260" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="e3" value="3. {fileId, uploadId, chunkSize=5MB, existingChunks=[]}" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#1976d2;dashed=1;fontSize=10" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="405" y="300" as="sourcePoint"/><mxPoint x="130" y="300" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="noteResume" value="Resume: client calls init with resumeUploadId. Redis returns uploaded chunk indexes, for example [1,2,3,4,5]. Client skips them and resumes at chunk 6." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=10;align=left;verticalAlign=middle;spacing=8" vertex="1" parent="1"><mxGeometry x="500" y="325" width="600" height="50" as="geometry"/></mxCell>
<mxCell id="p2" value="PHASE 2 - CHUNK, DEDUPLICATE, UPLOAD IN PARALLEL" style="text;html=1;strokeColor=none;fillColor=#e8f5e9;align=left;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="50" y="400" width="700" height="25" as="geometry"/></mxCell>
<mxCell id="e4" value="4. Split file into 5 MB chunks; calculate SHA-256 hash per chunk" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#1976d2;fontSize=10" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="445" as="sourcePoint"/><mxPoint x="130" y="470" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="e5" value="5. Request URL {uploadId, chunkIndex, chunkHash}" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#1976d2;fontSize=10" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="500" as="sourcePoint"/><mxPoint x="405" y="500" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="e6" value="6. Does this SHA-256 chunk already exist?" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#388e3c;fontSize=10" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="405" y="540" as="sourcePoint"/><mxPoint x="925" y="540" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="e7" value="7. Miss: generate short-lived S3 PUT URL; Hit: return existing chunk ID" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#388e3c;dashed=1;fontSize=10" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="580" as="sourcePoint"/><mxPoint x="405" y="580" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="e8" value="8. PUT chunk bytes directly to S3 (three chunks in parallel)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=3;strokeColor=#c62828;fontSize=10" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="630" as="sourcePoint"/><mxPoint x="1185" y="630" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="e9" value="9. Mark chunk uploaded in bitmap" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#f57f17;fontSize=10" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="405" y="670" as="sourcePoint"/><mxPoint x="665" y="670" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="p3" value="PHASE 3 - ATOMIC COMMIT, THEN EVENTUAL DEVICE SYNC" style="text;html=1;strokeColor=none;fillColor=#f3e5f5;align=left;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="50" y="715" width="800" height="25" as="geometry"/></mxCell>
<mxCell id="e10" value="10. POST /api/v1/files/{uploadId}/commit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=3;strokeColor=#1976d2;fontSize=10" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="760" as="sourcePoint"/><mxPoint x="405" y="760" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="e11" value="11. BEGIN: create FileVersion + FileVersionChunks; update File.current_version_id; COMMIT" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=3;strokeColor=#7b1fa2;fontSize=10" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="405" y="800" as="sourcePoint"/><mxPoint x="1445" y="800" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="e12" value="12. Publish file.changed {fileId, versionId, changeType}" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#7b1fa2;fontSize=10" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="405" y="840" as="sourcePoint"/><mxPoint x="1720" y="840" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="e13" value="13. Return 201 Created {fileId, versionId}" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#1976d2;dashed=1;fontSize=10" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="405" y="880" as="sourcePoint"/><mxPoint x="130" y="880" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="e14" value="14. Sync Service fans out to connected devices; offline devices consume missed events and pull delta later" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#7b1fa2;dashed=1;fontSize=10" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1720" y="920" as="sourcePoint"/><mxPoint x="130" y="920" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="key" value="INTERVIEW KEY: Upload completion is synchronous only through the metadata commit. Notifications to other devices are asynchronous. This keeps upload fast and lets offline clients catch up from Kafka later. A metadata transaction makes one complete version visible, never a half-uploaded file." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=11;align=left;verticalAlign=middle;spacing=10" vertex="1" parent="1"><mxGeometry x="60" y="1030" width="1740" height="70" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>