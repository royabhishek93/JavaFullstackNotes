<mxfile host="app.diagrams.net"><diagram name="Architecture Components" id="cloud-architecture"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="CLOUD STORAGE - Architecture Components" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=22;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="80" y="20" width="1640" height="35" as="geometry"/></mxCell>
<mxCell id="clientLayer" value="CLIENT LAYER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1720" height="120" as="geometry"/></mxCell>
<mxCell id="apps" value="Web App\nDesktop App\nMobile App\n\nWatcher: detects local change\nChunker: 5 MB chunks + SHA-256\nUpload Manager: 3 parallel uploads\nSync Engine: pull/push changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="260" y="120" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="gatewayLayer" value="EDGE LAYER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="230" width="1720" height="100" as="geometry"/></mxCell>
<mxCell id="gateway" value="LOAD BALANCER + API GATEWAY\nJWT authentication | authorization | per-user rate limit | route request | quota check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcc80;strokeColor=#ef6c00;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=10" vertex="1" parent="1"><mxGeometry x="260" y="260" width="800" height="45" as="geometry"/></mxCell>
<mxCell id="serviceLayer" value="SERVICE LAYER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="350" width="1720" height="230" as="geometry"/></mxCell>
<mxCell id="userSvc" value="User + Quota Service\n\nRegister/login\nStorage quota\nAccount settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="70" y="400" width="180" height="120" as="geometry"/></mxCell>
<mxCell id="uploadSvc" value="File Uploader Service\n\nInitiate upload session\nGenerate pre-signed URLs\nCommit upload\nPublish change event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="280" y="400" width="190" height="120" as="geometry"/></mxCell>
<mxCell id="metaSvc" value="File Metadata Service\n\nFiles/folders CRUD\nVersions\nPermissions\nStrong metadata writes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="500" y="400" width="190" height="120" as="geometry"/></mxCell>
<mxCell id="readSvc" value="Read / Download Service\n\nPermission check\nGenerate signed GET URL\nRedirect to CDN\nVersion download" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="720" y="400" width="190" height="120" as="geometry"/></mxCell>
<mxCell id="dedupSvc" value="Dedup + Validator\n\nSHA-256 lookup\nReuse identical blob\nCheck size / quota\nAsync malware scan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="940" y="400" width="180" height="120" as="geometry"/></mxCell>
<mxCell id="syncSvc" value="Sync Service\n\nConsumes Kafka events\nFanout to connected devices\nOffline devices pull later\nConflict resolution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1150" y="400" width="190" height="120" as="geometry"/></mxCell>
<mxCell id="dataLayer" value="DATA + INFRASTRUCTURE LAYER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1720" height="180" as="geometry"/></mxCell>
<mxCell id="userDb" value="User DB\naccounts, quota" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="70" y="650" width="150" height="80" as="geometry"/></mxCell>
<mxCell id="redis" value="Redis\nupload session state\nchunk bitmap\nTTL + retry count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="270" y="650" width="160" height="80" as="geometry"/></mxCell>
<mxCell id="metaDb" value="Metadata DB\nfiles, folders, versions\nchunks, permissions\nACID transactions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="480" y="650" width="170" height="80" as="geometry"/></mxCell>
<mxCell id="s3" value="S3 Blob Storage\nchunk bytes only\nobject key = hash\nreplicated / durable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="700" y="650" width="170" height="80" as="geometry"/></mxCell>
<mxCell id="kafka" value="Kafka\nfile.changed events\ndurable event log\nreplay for offline sync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="920" y="650" width="160" height="80" as="geometry"/></mxCell>
<mxCell id="cdn" value="CDN\ncache downloads near user\nshort-lived signed URLs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="1130" y="650" width="160" height="80" as="geometry"/></mxCell>
<mxCell id="e1" value="direct chunk upload" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#c62828;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="uploadSvc" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="commit metadata" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#7b1fa2;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="uploadSvc" target="metaDb"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="file.changed" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#7b1fa2;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="uploadSvc" target="kafka"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="consume" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#7b1fa2;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="kafka" target="syncSvc"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="why" value="WHY THESE CHOICES\n\nS3: inexpensive, durable object storage for huge blobs; do not store GB files in a relational database.\nMetadata DB: folders, names, permissions and versions need transactions and immediate consistent reads.\nRedis: upload sessions are short-lived and need very fast chunk-progress updates.\nKafka: upload completion must not wait for every device to sync; durable events let devices catch up.\nPre-signed URL: transfers bytes from client to S3 directly, avoiding application-server bandwidth bottlenecks.\nContent hash: same chunk bytes produce same ID, so duplicate chunks share one object." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="60" y="820" width="1270" height="180" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>