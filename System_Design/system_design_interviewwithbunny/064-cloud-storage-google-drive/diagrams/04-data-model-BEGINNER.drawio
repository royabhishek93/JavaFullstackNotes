<mxfile host="app.diagrams.net"><diagram name="Data Model" id="cloud-data"><mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="CLOUD STORAGE - Data Model, Chunk Deduplication, and Sync State" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=22;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1800" height="35" as="geometry"/></mxCell>
<mxCell id="users" value="USERS\n----------------\nuser_id (PK)\nemail (UNIQUE)\npassword_hash\nquota_bytes\nused_bytes\ncreated_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0277bd;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="60" y="100" width="230" height="180" as="geometry"/></mxCell>
<mxCell id="folders" value="FOLDERS\n----------------\nfolder_id (PK)\nparent_folder_id (FK, NULL=root)\nowner_id (FK -> users)\nname\nis_deleted\ncreated_at\nupdated_at\n\nIndex: (parent_folder_id, name)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="360" y="100" width="270" height="220" as="geometry"/></mxCell>
<mxCell id="files" value="FILES\n----------------\nfile_id (PK)\nparent_folder_id (FK -> folders)\nowner_id (FK -> users)\nname\nsize_bytes\ncurrent_version_id (FK)\nis_deleted\ncreated_at\nupdated_at\n\nIndex: (parent_folder_id, name)\nFull-text index: name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=3;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="700" y="100" width="290" height="240" as="geometry"/></mxCell>
<mxCell id="versions" value="FILE_VERSIONS\n----------------\nversion_id (PK)\nfile_id (FK -> files)\nsize_bytes\ncreated_by\ncreated_at\n\nRestore = UPDATE files\nSET current_version_id = :oldVersion\n\nO(1) metadata write; do not copy blob" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="1060" y="100" width="300" height="230" as="geometry"/></mxCell>
<mxCell id="chunks" value="CHUNKS\n----------------\nchunk_id (PK = SHA-256 hash)\nobject_key (S3 path)\nsize_bytes\nchecksum\nreference_count\ncreated_at\n\nSame bytes -> same hash -> same S3 blob\nreference_count reaches 0 -> async garbage collection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=3;fontSize=10;align=left;verticalAlign=top;spacing=8;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="1430" y="100" width="330" height="220" as="geometry"/></mxCell>
<mxCell id="versionChunks" value="FILE_VERSION_CHUNKS\n----------------\nversion_id (FK)\nchunk_index\nchunk_id (FK -> chunks)\n\nPRIMARY KEY (version_id, chunk_index)\n\nThis join table rebuilds a version from chunks in order." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="1060" y="390" width="350" height="170" as="geometry"/></mxCell>
<mxCell id="permissions" value="PERMISSIONS\n----------------\npermission_id (PK)\nresource_type (file | folder)\nresource_id\nuser_id (FK -> users)\nrole (viewer | editor | owner)\ncreated_at\n\nUNIQUE(resource_type, resource_id, user_id)\nChecked before every read/write." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="60" y="390" width="360" height="210" as="geometry"/></mxCell>
<mxCell id="uploadSession" value="REDIS: UPLOAD SESSION\n----------------\nupload:{upload_id}\n{ user_id, file_id, parent_folder_id,\n  chunk_size: 5MB, uploaded_bitmap,\n  chunk_hashes, retry_count }\nTTL: short-lived session state (fast expiry, not the source of truth)\n\nResume request returns bitmap: [1,2,3,4,5]\nRedis is temporary coordinator, not file source of truth." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="490" y="390" width="500" height="210" as="geometry"/></mxCell>
<mxCell id="events" value="KAFKA: FILE CHANGE EVENTS\n----------------\nTopic: file.changed\nKey: file_id (ordering per file)\nPayload: { event_id, file_id, version_id,\nchange_type, actor_id, timestamp }\n\nConsumers:\n- Sync Service: notify/pull on devices\n\nAt-least-once delivery: consumers deduplicate event_id." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="1450" y="390" width="310" height="210" as="geometry"/></mxCell>
<mxCell id="r1" value="owns" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#7b1fa2;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="users" target="folders"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="r2" value="contains" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#7b1fa2;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="folders" target="files"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="r3" value="has versions" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#7b1fa2;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="files" target="versions"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="r4" value="maps ordered chunks" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#f57f17;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="versions" target="versionChunks"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="r5" value="deduplicated reference" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#c62828;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="versionChunks" target="chunks"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="why" value="WHY THIS MODEL WORKS\n\nA File is the logical object the user sees. A FileVersion is an immutable snapshot. FileVersionChunks maps the snapshot to ordered content-addressed chunks. Chunks are stored once in S3 and shared by every version or user with the same SHA-256 hash. Metadata is compact and transactional; chunk bytes are huge and belong in object storage. Permissions reference a file or folder, so sharing does not duplicate the bytes. Redis tracks interrupted upload progress only; Kafka persists the event stream used for eventual device synchronization." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="60" y="680" width="1700" height="110" as="geometry"/></mxCell>
<mxCell id="failure" value="FAILURE CASES\n\n1. Network drops during upload: the committed bitmap in Redis lets the client upload only missing chunks.\n2. Client uploads chunks but never commits: chunks are unreferenced; a lifecycle job removes them after the session TTL.\n3. Commit fails: database transaction rolls back, so no incomplete FileVersion becomes current.\n4. Device offline: Kafka retains file.changed event; the client later asks for changes since its sync cursor.\n5. Duplicate event: event_id deduplication makes Sync/Search/Audit consumers idempotent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="60" y="830" width="1700" height="140" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>