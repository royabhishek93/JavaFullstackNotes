<mxfile host="app.diagrams.net">
  <diagram name="Cloud Storage Context" id="cloud-storage-context">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="CLOUD STORAGE PLATFORM (Google Drive / Dropbox) - System Context" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=22;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1480" height="35" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="Upload files safely, keep metadata consistent, and synchronize changes across devices" style="text;html=1;strokeColor=none;fillColor=#e8eaf6;align=center;rounded=1;fontSize=13" vertex="1" parent="1"><mxGeometry x="220" y="65" width="1160" height="28" as="geometry" /></mxCell>

        <mxCell id="boundary" value="CLOUD STORAGE PLATFORM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#ef6c00;strokeWidth=4;fontSize=16;fontStyle=1;align=left;verticalAlign=top;spacingTop=10;spacingLeft=15" vertex="1" parent="1"><mxGeometry x="320" y="150" width="960" height="640" as="geometry" /></mxCell>

        <mxCell id="clients" value="CLIENT APPS\n\nWeb browser\nDesktop sync client\nMobile app\n\nWatcher notices local changes\nChunker splits files into 5 MB parts\nSync Engine pushes and pulls changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="350" y="205" width="210" height="210" as="geometry" /></mxCell>
        <mxCell id="gateway" value="API GATEWAY\n\nAuthentication\nRate limiting\nRouting\nQuota checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcc80;strokeColor=#ef6c00;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="620" y="205" width="160" height="150" as="geometry" /></mxCell>
        <mxCell id="services" value="CORE SERVICES\n\nUser and Quota Service\nFile Uploader Service\nFile Metadata Service\nRead / Download Service\nDeduplication Service\nSync Service\nValidator / malware scan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="840" y="205" width="210" height="210" as="geometry" /></mxCell>
        <mxCell id="storage" value="STORAGE AND EVENTS\n\nS3 object storage: raw chunks\nMetadata DB: files, folders, versions\nRedis: upload session state\nKafka: file.changed events\nCDN: fast download delivery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="1100" y="205" width="150" height="210" as="geometry" /></mxCell>

        <mxCell id="principles" value="KEY DESIGN RULES\n\n1. Raw bytes and metadata are separate: S3 stores large file chunks cheaply; a relational Metadata DB stores names, folders, owners, versions and permissions with strong consistency.\n\n2. Every file is split into chunks. A failed 1 GB upload resumes from the missing chunk, and several chunks can upload in parallel.\n\n3. Chunks use SHA-256 content hashes. Identical chunks share one S3 object, saving storage through deduplication.\n\n4. Upload uses short-lived pre-signed S3 URLs. The client transfers bytes directly to S3; application servers only coordinate and validate.\n\n5. Metadata commit is strong and atomic. Device synchronization is eventual: a Kafka event lets offline devices catch up later.\n\n6. Permissions are checked for every resource. viewer = read, editor = read/write, owner = administration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="350" y="465" width="900" height="295" as="geometry" /></mxCell>

        <mxCell id="user" value="USER\n\nUploads and downloads files\nCreates folders\nShares access\nRestores older versions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="50" y="240" width="200" height="145" as="geometry" /></mxCell>
        <mxCell id="user-edge" value="Use web, desktop, mobile" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#1976d2;endArrow=classic;endFill=1;fontSize=10" edge="1" parent="1" source="user" target="boundary"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s3" value="S3 OBJECT STORAGE\n\nDurable chunk blobs\n11 nines durability\nMulti-AZ replication\nObject key by content hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="1350" y="190" width="200" height="145" as="geometry" /></mxCell>
        <mxCell id="s3-edge" value="Pre-signed PUT / GET URLs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#c62828;endArrow=classic;endFill=1;startArrow=classic;startFill=1;fontSize=10" edge="1" parent="1" source="boundary" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="devices" value="OTHER DEVICES\n\nDesktop, phone, browser\nreceive file.changed event\npull changed metadata/chunks\nmay be offline temporarily" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="1350" y="400" width="200" height="145" as="geometry" /></mxCell>
        <mxCell id="devices-edge" value="Kafka sync events (eventual)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#388e3c;dashed=1;endArrow=classic;endFill=1;fontSize=10" edge="1" parent="1" source="boundary" target="devices"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="cdn" value="CDN\n\nCaches popular downloads\nserves nearby users\nreduces S3 bandwidth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="1350" y="610" width="200" height="115" as="geometry" /></mxCell>
        <mxCell id="cdn-edge" value="Fast global downloads" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#c2185b;dashed=1;endArrow=classic;endFill=1;fontSize=10" edge="1" parent="1" source="boundary" target="cdn"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="analogy" value="BEGINNER ANALOGY: The platform is a library. S3 is the warehouse holding physical pages. The Metadata DB is the library catalogue: file name, folder, owner and permission. Chunk hashes are fingerprints that reveal duplicate pages. Kafka is the change-notice board that tells every branch library a book has changed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0277bd;strokeWidth=2;fontSize=11;align=left;verticalAlign=middle;spacing=10" vertex="1" parent="1"><mxGeometry x="50" y="840" width="1500" height="75" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
