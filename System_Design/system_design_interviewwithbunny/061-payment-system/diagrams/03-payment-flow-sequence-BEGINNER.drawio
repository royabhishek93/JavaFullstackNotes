        </mxCell>
        <mxCell id="label18" value="UPDATE payments&#xa;SET status=PROCESSING" style="text;html=1;strokeColor=none;fillColor=#e1bee7;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=8" vertex="1" parent="1">
          <mxGeometry x="850" y="825" width="140" height="25" as="geometry" />
        </mxCell>
        
        <!-- Step 19: Optimistic lock check -->
        <mxCell id="arrow19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#8e24aa;endArrow=block;endFill=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1090" y="870" as="sourcePoint" />
            <mxPoint x="695" y="870" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="label19" value="SELECT balance, version&#xa;FROM accounts WHERE id=alice&#xa;FOR UPDATE (or optimistic)" style="text;html=1;strokeColor=none;fillColor=#e1bee7;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=7" vertex="1" parent="1">
          <mxGeometry x="800" y="855" width="190" height="30" as="geometry" />
        </mxCell>
        
        <!-- Step 20: Call Bank API -->
        <mxCell id="arrow20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#d84315;endArrow=block;endFill=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1090" y="900" as="sourcePoint" />
            <mxPoint x="1240" y="900" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="label20" value="POST /charge&#xa;{amount, from, to,&#xa; paymentId}" style="text;html=1;strokeColor=#d84315;fillColor=#ffccbc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1105" y="880" width="120" height="35" as="geometry" />
        </mxCell>
        
        <!-- Step 21: Bank processing (1-30s) -->
        <mxCell id="bank-processing" value="⏱️ Bank processes&#xa;(1-30 sec latency)" style="text;html=1;strokeColor=#d84315;fillColor=#fff3e0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=9;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1180" y="930" width="120" height="35" as="geometry" />
        </mxCell>
        
        <!-- Step 22: Bank SUCCESS response -->
        <mxCell id="arrow22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#388e3c;dashed=1;endArrow=block;endFill=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="980" as="sourcePoint" />
            <mxPoint x="1090" y="980" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="label22" value="200 OK&#xa;{status: SUCCESS,&#xa; ref_id: HDFC_XYZ}" style="text;html=1;strokeColor=#388e3c;fillColor=#c8e6c9;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1105" y="960" width="120" height="35" as="geometry" />
        </mxCell>
        
        <!-- Step 23: UPDATE payment SUCCESS -->
        <mxCell id="arrow23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#388e3c;endArrow=block;endFill=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1090" y="1015" as="sourcePoint" />
            <mxPoint x="695" y="1015" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="label23" value="BEGIN TX:&#xa;  UPDATE payments SET status=SUCCESS,&#xa;    bank_ref=HDFC_XYZ&#xa;  UPDATE accounts SET balance=balance-10000,&#xa;    version=version+1 WHERE id=alice&#xa;  UPDATE accounts SET balance=balance+10000&#xa;    WHERE id=bob&#xa;  INSERT ledger_entries (DEBIT alice -10000)&#xa;  INSERT ledger_entries (CREDIT bob +10000)&#xa;COMMIT ✓" style="text;html=1;strokeColor=#388e3c;fillColor=#c8e6c9;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=7;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="710" y="980" width="370" height="90" as="geometry" />
        </mxCell>
        
        <!-- Step 24: Publish success event to Kafka -->
        <mxCell id="arrow24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#01579b;endArrow=block;endFill=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1090" y="1090" as="sourcePoint" />
            <mxPoint x="950" y="1090" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="label24" value="Publish payment.success" style="text;html=1;strokeColor=none;fillColor=#e1f5fe;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="960" y="1075" width="120" height="20" as="geometry" />
        </mxCell>
        
        <!-- PHASE 4: NOTIFICATION -->
        <mxCell id="phase4-label" value="═══ PHASE 4: NOTIFICATION (async) ═══" style="text;html=1;strokeColor=#f57c00;fillColor=#fff3e0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="1120" width="1410" height="30" as="geometry" />
        </mxCell>
        
        <!-- Step 25: Notification service consumes -->
        <mxCell id="arrow25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#f57c00;endArrow=block;endFill=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="950" y="1170" as="sourcePoint" />
            <mxPoint x="1385" y="1170" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="label25" value="Consume payment.success event" style="text;html=1;strokeColor=none;fillColor=#ffe0b2;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="1050" y="1155" width="190" height="20" as="geometry" />
        </mxCell>
        
        <!-- Step 26: Send email/SMS -->
        <mxCell id="arrow26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#f57c00;dashed=1;endArrow=block;endFill=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1385" y="1210" as="sourcePoint" />
            <mxPoint x="100" y="1210" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="label26" value="📧 Email/SMS: Payment Rs.100 SUCCESS" style="text;html=1;strokeColor=#f57c00;fillColor=#ffe0b2;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=9;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="580" y="1195" width="260" height="20" as="geometry" />
        </mxCell>
        
        <!-- KEY INSIGHTS BOX -->
        <mxCell id="insights-box" value="🔑 KEY INSIGHTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;strokeWidth=3;fontSize=14;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="1480" y="200" width="490" height="580" as="geometry" />
        </mxCell>
        
        <mxCell id="insights-text" value="1. CLIENT GETS 202 IN &lt;100ms&#xa;   Payment not yet confirmed by bank.&#xa;   INITIATED status means accepted for&#xa;   processing, NOT completed.&#xa;&#xa;2. IDEMPOTENCY KEY PREVENTS DOUBLE-CHARGE&#xa;   Second retry: Redis HIT → return cached&#xa;   response (same paymentId, no re-process).&#xa;&#xa;3. OUTBOX PATTERN = ZERO EVENT LOSS&#xa;   If app crashes after COMMIT but before&#xa;   Kafka publish → relay picks up event.&#xa;   Event delivery guaranteed.&#xa;&#xa;4. OPTIMISTIC LOCK PREVENTS OVERDRAFT&#xa;   Two concurrent debits:&#xa;   UPDATE ... WHERE version=10&#xa;   First wins, second gets 0 rows updated&#xa;   → ROLLBACK or retry.&#xa;&#xa;5. BANK API LATENCY: 100ms–30sec&#xa;   NEVER hold DB lock during bank call.&#xa;   Set status=PROCESSING, call async,&#xa;   then UPDATE result.&#xa;&#xa;6. DOUBLE-ENTRY LEDGER (IMMUTABLE)&#xa;   Every payment = 2 ledger rows:&#xa;   • DEBIT alice -Rs.100&#xa;   • CREDIT bob +Rs.100&#xa;   Sum always = 0. Never UPDATE/DELETE.&#xa;   Balance discrepancy? SUM(ledger).&#xa;&#xa;7. TIMEOUT SCENARIO&#xa;   If bank no response after 30s:&#xa;   UPDATE status=PENDING&#xa;   Schedule retry: poll bank status API&#xa;   GET /charge/{paymentId}&#xa;   Eventually bank responds SUCCESS/FAILED.&#xa;&#xa;8. FAILURE SCENARIO (bank rejects)&#xa;   Bank returns 400 {status: FAILED}&#xa;   UPDATE payment status=FAILED&#xa;   NO ledger entries created.&#xa;   Notify customer: payment declined.&#xa;&#xa;9. SAGA FOR CROSS-BANK TRANSFERS&#xa;   Debit our system → COMMIT&#xa;   Call external bank → if FAILED:&#xa;   Compensating txn (reverse debit).&#xa;   NOT 2PC — external APIs don't support it.&#xa;&#xa;10. RECONCILIATION (NIGHTLY)&#xa;    Download bank CSV statement.&#xa;    Compare each bank txn vs our ledger.&#xa;    Mismatch → alert ops, freeze account.&#xa;    Final safety net after all automation." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=8;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="1490" y="230" width="470" height="540" as="geometry" />
        </mxCell>
        
        <!-- FAILURE SCENARIO -->
        <mxCell id="failure-box" value="❌ FAILURE SCENARIO: IDEMPOTENCY KEY HIT (Retry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=3;fontSize=13;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="1480" y="810" width="490" height="180" as="geometry" />
        </mxCell>
        
        <mxCell id="failure-text" value="Client retries same payment (network timeout):&#xa;&#xa;POST /payments {idempotencyKey: uuid_abc, ...}&#xa;&#xa;API Gateway → Redis GET uuid_abc → HIT&#xa;  {paymentId: pay_xyz789, status: INITIATED}&#xa;&#xa;API Gateway returns 409 Conflict:&#xa;  {paymentId: pay_xyz789, status: INITIATED,&#xa;   message: 'Already processing this payment'}&#xa;&#xa;Client polls GET /payments/pay_xyz789 for status.&#xa;Eventually status changes to SUCCESS/FAILED.&#xa;&#xa;KEY: Idempotency key MUST be client-generated UUID.&#xa;Server-generated ID would change on retry → double charge." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=8;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="1490" y="840" width="470" height="140" as="geometry" />
        </mxCell>
        
        <!-- TIMEOUT SCENARIO -->
        <mxCell id="timeout-box" value="⏱️ TIMEOUT SCENARIO: Bank API no response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;strokeWidth=3;fontSize=13;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="1480" y="1010" width="490" height="180" as="geometry" />
        </mxCell>
        
        <mxCell id="timeout-text" value="Processor calls bank API → waits 30 sec → no response.&#xa;&#xa;Processor: UPDATE payments SET status=PENDING&#xa;Schedule retry job (exponential backoff):&#xa;  1st retry: 30 sec later&#xa;  2nd retry: 1 min later&#xa;  3rd retry: 2 min later&#xa;  ...&#xa;&#xa;Poll bank status API:&#xa;GET /charge/{paymentId} → eventually returns:&#xa;  {status: SUCCESS, ref_id: HDFC_XYZ}&#xa;&#xa;Processor: UPDATE status=SUCCESS, insert ledger.&#xa;&#xa;If 10 retries fail → manual ops review.&#xa;Bank might have charged but response lost.&#xa;Reconciliation (nightly) catches this discrepancy.&#xa;&#xa;KEY: NEVER UPDATE account balance until bank confirms." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=8;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="1490" y="1040" width="470" height="140" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>