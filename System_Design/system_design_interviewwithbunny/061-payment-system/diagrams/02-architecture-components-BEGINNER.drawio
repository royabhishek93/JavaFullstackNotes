        </mxCell>
        
        <mxCell id="gateway-label" value="API GATEWAY LAYER" style="text;html=1;strokeColor=none;fillColor=#e65100;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
          <mxGeometry x="50" y="210" width="150" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="load-balancer" value="Load Balancer&#xa;(AWS ALB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#e65100;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="220" y="210" width="140" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="api-gateway" value="API Gateway&#xa;(TLS, Auth/JWT,&#xa; Rate Limit 100/min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#e65100;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="390" y="210" width="160" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="idempotency-check" value="Idempotency Check&#xa;Redis GET idempotency_key&#xa;HIT → return cached&#xa;MISS → proceed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#e65100;fontSize=9;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="580" y="210" width="160" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="arrow-client-gw" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1976d2" edge="1" parent="1" source="client-web" target="load-balancer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="265" y="170" as="sourcePoint" />
            <mxPoint x="290" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- CORE SERVICES LAYER -->
        <mxCell id="services-layer-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#388e3c;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="1820" height="280" as="geometry" />
        </mxCell>
        
        <mxCell id="services-label" value="CORE SERVICES (Microservices)" style="text;html=1;strokeColor=none;fillColor=#388e3c;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
          <mxGeometry x="50" y="330" width="220" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="payment-service" value="Payment Service&#xa;(CREATE payment)&#xa;BEGIN TX:&#xa;  INSERT payment (INITIATED)&#xa;  INSERT outbox_event&#xa;COMMIT&#xa;Return 202 Accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=9;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="180" height="95" as="geometry" />
        </mxCell>
        
        <mxCell id="outbox-relay" value="Outbox Relay Service&#xa;(Kafka publisher)&#xa;Poll outbox WHERE&#xa;  published=false&#xa;Publish to Kafka&#xa;Mark published=true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=9;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="260" y="370" width="170" height="95" as="geometry" />
        </mxCell>
        
        <mxCell id="processor-service" value="Payment Processor&#xa;(consume Kafka)&#xa;UPDATE status=PROCESSING&#xa;Call bank API (async)&#xa;ON SUCCESS:&#xa;  UPDATE status=SUCCESS&#xa;  INSERT ledger_entries&#xa;ON FAILURE: FAILED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=8;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="450" y="370" width="170" height="110" as="geometry" />
        </mxCell>
        
        <mxCell id="refund-service" value="Refund Service&#xa;(reverse payment)&#xa;CREATE new payment&#xa;  (reverse direction)&#xa;INSERT ledger DEBIT/CREDIT&#xa;(compensating transaction)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=9;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="640" y="370" width="170" height="90" as="geometry" />
        </mxCell>
        
        <mxCell id="fraud-service" value="Fraud Detection&#xa;(async scoring)&#xa;ML model: velocity,&#xa;location anomaly,&#xa;blacklist check&#xa;Score &lt;5 sec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=9;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="830" y="370" width="160" height="90" as="geometry" />
        </mxCell>
        
        <mxCell id="notification-service" value="Notification Service&#xa;(email/SMS)&#xa;Consume Kafka events:&#xa;  payment.success&#xa;  payment.failed&#xa;Send via SendGrid/Twilio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=9;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="1010" y="370" width="170" height="95" as="geometry" />
        </mxCell>
        
        <mxCell id="reconciliation-service" value="Reconciliation Service&#xa;(nightly batch)&#xa;Download bank CSV&#xa;Compare ledger vs bank&#xa;Mismatch → alert ops,&#xa;freeze account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=9;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="1200" y="370" width="170" height="95" as="geometry" />
        </mxCell>
        
        <mxCell id="webhook-service" value="Webhook Service&#xa;(notify merchant)&#xa;On payment complete:&#xa;POST merchant_url&#xa;  {paymentId, status}&#xa;Retry with exp backoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=9;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="1390" y="370" width="160" height="95" as="geometry" />
        </mxCell>
        
        <mxCell id="analytics-service" value="Analytics Service&#xa;(metrics &amp; dashboards)&#xa;TPS, success rate,&#xa;fraud trends,&#xa;revenue reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=9;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="1570" y="370" width="150" height="85" as="geometry" />
        </mxCell>
        
        <mxCell id="balance-service" value="Balance Service&#xa;(account inquiry)&#xa;GET account.balance&#xa;  (materialized view)&#xa;Fallback: SUM(ledger)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=9;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="60" y="485" width="180" height="95" as="geometry" />
        </mxCell>
        
        <mxCell id="history-service" value="Transaction History&#xa;(ledger query)&#xa;GET /accounts/{id}/txns&#xa;Cursor pagination&#xa;Filter by date range" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=9;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="260" y="485" width="170" height="85" as="geometry" />
        </mxCell>
        
        <!-- DATA STORES LAYER -->
        <mxCell id="data-stores-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#8e24aa;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="1820" height="200" as="geometry" />
        </mxCell>
        
        <mxCell id="data-stores-label" value="DATA STORES" style="text;html=1;strokeColor=none;fillColor=#8e24aa;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
          <mxGeometry x="50" y="630" width="120" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="mysql" value="MySQL (Master + 5 Replicas)&#xa;• payments (ACID transactions)&#xa;• accounts (balance + version)&#xa;• ledger_entries (append-only)&#xa;• outbox_events (relay source)&#xa;• users, merchants&#xa;Shard by account_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#8e24aa;fontSize=10;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="60" y="670" width="230" height="130" as="geometry" />
        </mxCell>
        
        <mxCell id="redis-idempotency" value="Redis (Idempotency Cache)&#xa;idempotencyKey → {paymentId, status}&#xa;TTL: 24 hours&#xa;Sub-millisecond lookup&#xa;Prevents double-charge&#xa;on client retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#d84315;fontSize=10;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="310" y="670" width="240" height="115" as="geometry" />
        </mxCell>
        
        <mxCell id="kafka" value="Kafka (Event Streaming)&#xa;Topic: payment.commands&#xa;  partition by from_account_id&#xa;Outbox relay publishes&#xa;Processor consumes&#xa;7-day retention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#01579b;fontSize=10;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="570" y="670" width="220" height="115" as="geometry" />
        </mxCell>
        
        <mxCell id="s3-storage" value="S3 (Bank Statement Storage)&#xa;Daily CSV files from bank&#xa;Used by Reconciliation Service&#xa;7-year retention (regulatory)&#xa;Immutable storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;fontSize=10;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="810" y="670" width="240" height="105" as="geometry" />
        </mxCell>
        
        <mxCell id="external-bank" value="External Bank/Card Network&#xa;HDFC, SBI, Visa, Mastercard&#xa;Charge request API&#xa;Response: SUCCESS/FAILED/TIMEOUT&#xa;Latency: 100ms–30s (varies)&#xa;NOT under our control" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=10;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="1070" y="670" width="250" height="115" as="geometry" />
        </mxCell>
        
        <!-- WHY BOXES -->
        <mxCell id="why-mysql" value="❓ WHY MYSQL (ACID)?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="350" height="240" as="geometry" />
        </mxCell>
        
        <mxCell id="why-mysql-text" value="Payment creation is multi-table transaction:&#xa;&#xa;BEGIN;&#xa;  INSERT payments (status=INITIATED);&#xa;  INSERT outbox_events (unpublished);&#xa;  -- optionally UPDATE accounts balance&#xa;COMMIT;&#xa;&#xa;ACID guarantees:&#xa;• Atomicity: ALL or NOTHING (no partial writes)&#xa;• If app crashes after INSERT but before COMMIT&#xa;  → rollback, payment never existed&#xa;• No money creation/loss from partial writes&#xa;&#xa;Cassandra/MongoDB eventual consistency:&#xa;• Payment row written, outbox missed → event lost&#xa;• Two concurrent debits see same balance&#xa;  → both succeed, overdraft&#xa;&#xa;MySQL handles 10K TPS/shard easily.&#xa;Volume (100 TPS) NOT the constraint.&#xa;Correctness is." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=8;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="50" y="870" width="330" height="200" as="geometry" />
        </mxCell>
        
        <mxCell id="why-outbox" value="❓ WHY OUTBOX PATTERN?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="410" y="840" width="360" height="240" as="geometry" />
        </mxCell>
        
        <mxCell id="why-outbox-text" value="Classic failure scenario:&#xa;&#xa;1. Payment Service: INSERT payment → COMMIT&#xa;2. Payment Service: PUBLISH to Kafka → [CRASH]&#xa;3. Payment in DB, but downstream never notified&#xa;&#xa;Outbox fix:&#xa;BEGIN;&#xa;  INSERT payments;&#xa;  INSERT outbox_events (published=false);&#xa;COMMIT;&#xa;&#xa;Separate Outbox Relay (polls every 100ms):&#xa;SELECT * FROM outbox WHERE published=false;&#xa;PUBLISH to Kafka;&#xa;UPDATE outbox SET published=true;&#xa;&#xa;If app crashes after DB commit:&#xa;• Relay picks up event on next poll&#xa;• Guaranteed at-least-once delivery&#xa;• Idempotent consumers handle duplicates&#xa;&#xa;Direct Kafka publish = silent event loss.&#xa;Outbox = zero event loss guarantee." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=8;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="420" y="870" width="340" height="200" as="geometry" />
        </mxCell>
        
        <mxCell id="why-idempotency" value="❓ WHY IDEMPOTENCY KEY?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="790" y="840" width="360" height="240" as="geometry" />
        </mxCell>
        
        <mxCell id="why-idempotency-text" value="Scenario: Customer taps Pay, network times out&#xa;after 2 sec. Customer taps again.&#xa;&#xa;Without idempotency:&#xa;• First tap: payment_1 created, charged&#xa;• Second tap: payment_2 created, charged AGAIN&#xa;• Customer charged Rs.200 for Rs.100 order&#xa;&#xa;With idempotency (client-generated UUID):&#xa;&#xa;First tap:&#xa;POST /payments {idempotencyKey: abc123, ...}&#xa;Redis GET abc123 → MISS&#xa;CREATE payment → Redis SET abc123 = {paymentId, status}&#xa;Return 202 {paymentId: pay_xyz}&#xa;&#xa;Second tap (retry):&#xa;POST /payments {idempotencyKey: abc123, ...}&#xa;Redis GET abc123 → HIT {paymentId: pay_xyz, status}&#xa;Return cached response (no re-processing)&#xa;&#xa;Client sees same paymentId twice.&#xa;Only ONE charge to bank.&#xa;&#xa;TTL 24hr covers all reasonable retry windows." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=7;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="800" y="870" width="340" height="200" as="geometry" />
        </mxCell>
        
        <mxCell id="why-optimistic" value="❓ WHY OPTIMISTIC LOCKING?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="1170" y="840" width="360" height="240" as="geometry" />
        </mxCell>
        
        <mxCell id="why-optimistic-text" value="Race condition scenario:&#xa;Alice has Rs.100. Two payments fire simultaneously:&#xa;• Payment A: debit Rs.100 (balance → 0)&#xa;• Payment B: debit Rs.100 (balance → -100???)&#xa;&#xa;Without locking (naive):&#xa;Txn A: READ balance=100 → write balance=0&#xa;Txn B: READ balance=100 → write balance=0&#xa;Both see sufficient funds, both succeed.&#xa;Bank overdraft, money created from nothing.&#xa;&#xa;Optimistic locking (version column):&#xa;accounts table: balance=100, version=5&#xa;&#xa;Txn A: UPDATE accounts SET balance=0, version=6&#xa;        WHERE account_id=123 AND version=5;&#xa;→ 1 row updated (success)&#xa;&#xa;Txn B: UPDATE accounts SET balance=0, version=6&#xa;        WHERE account_id=123 AND version=5;&#xa;→ 0 rows updated (another txn modified it)&#xa;→ ROLLBACK, retry or reject&#xa;&#xa;Pessimistic lock (SELECT FOR UPDATE):&#xa;• Holds row lock during bank API call (100ms–30s)&#xa;• Deadlocks at scale, lock timeouts&#xa;• Optimistic lock = NO locks held, just version check" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=7;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="1180" y="870" width="340" height="200" as="geometry" />
        </mxCell>
        
        <mxCell id="why-saga" value="❓ WHY SAGA (not 2PC)?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="1550" y="840" width="310" height="240" as="geometry" />
        </mxCell>
        
        <mxCell id="why-saga-text" value="Cross-bank transfer:&#xa;• Debit Alice (our system)&#xa;• Credit Bob (external bank API)&#xa;&#xa;2PC (two-phase commit):&#xa;PREPARE phase:&#xa;  Our system: PREPARE debit → OK&#xa;  Bank API: PREPARE credit → ???&#xa;  (Bank doesn't support PREPARE)&#xa;COMMIT phase: only if both OK&#xa;&#xa;Problem: Bank APIs are black boxes.&#xa;No PREPARE support, no rollback.&#xa;If bank times out in PREPARE:&#xa;we hold locks forever, deadlock.&#xa;&#xa;Saga pattern:&#xa;1. Debit Alice (COMMIT locally)&#xa;2. Call bank API to credit Bob&#xa;3a. Success → UPDATE payment=SUCCESS&#xa;3b. Failure → compensating txn:&#xa;    CREATE reverse payment&#xa;    (credit Alice, refund)&#xa;&#xa;Saga = eventual consistency OK.&#xa;Nightly reconciliation catches&#xa;what saga missed (final safety net)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=7;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="1560" y="870" width="290" height="200" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>