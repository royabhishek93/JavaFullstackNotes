        <mxCell id="arrow-analytics" value="ETL data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#c2185b;fontSize=10;fontStyle=1;dashed=1;endArrow=classic;endFill=1" edge="1" parent="1" source="system-boundary" target="ext-analytics">
