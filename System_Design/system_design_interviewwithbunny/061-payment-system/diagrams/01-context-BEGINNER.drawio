<mxfile host="app.diagrams.net">
  <diagram name="System Context" id="context">
    <mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title -->
        <mxCell id="title" value="PAYMENT SYSTEM (Stripe/Razorpay) — System Context" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1660" height="35" as="geometry" />
        </mxCell>
        
        <mxCell id="subtitle" value="ACID transactions + Idempotency + Double-entry ledger + Exactly-once money movement + Outbox pattern + Reconciliation" style="text;html=1;strokeColor=none;fillColor=#e8eaf6;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="150" y="50" width="1400" height="25" as="geometry" />
        </mxCell>
        
        <!-- System Boundary -->
        <mxCell id="system-boundary" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#ff6f00;strokeWidth=4;" vertex="1" parent="1">
          <mxGeometry x="300" y="120" width="1100" height="750" as="geometry" />
        </mxCell>
        
        <mxCell id="system-label" value="PAYMENT SYSTEM (Stripe/Razorpay)" style="text;html=1;strokeColor=none;fillColor=#ff6f00;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
          <mxGeometry x="310" y="130" width="320" height="30" as="geometry" />
        </mxCell>
        
        <!-- Core Services Inside System -->
        <mxCell id="services-box" value="CORE SERVICES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=13;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="320" y="180" width="500" height="240" as="geometry" />
        </mxCell>
        
        <mxCell id="service-list" value="• Payment Service (idempotency check → MySQL transaction)&#xa;• Outbox Relay Service (polls unpublished events → Kafka)&#xa;• Payment Processor Service (consume Kafka → call bank API)&#xa;• Reconciliation Service (nightly bank statement vs ledger)&#xa;• Fraud Detection Service (async ML scoring, rule engine)&#xa;• Notification Service (email/SMS on payment status)&#xa;• Refund Service (creates reverse payment + ledger entries)&#xa;• Webhook Service (notify merchant on payment completion)&#xa;• Analytics Service (transaction volume, success rate dashboards)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="330" y="210" width="480" height="195" as="geometry" />
        </mxCell>
        
        <!-- Data Stores -->
        <mxCell id="data-stores-box" value="DATA STORES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#8e24aa;strokeWidth=2;fontSize=13;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="840" y="180" width="540" height="240" as="geometry" />
        </mxCell>
        
        <mxCell id="data-stores-list" value="• MySQL (ACID transactions — non-negotiable for money)&#xa;  tables: payments, accounts, ledger_entries, outbox_events&#xa;  Optimistic locking: accounts.version prevents race conditions&#xa;  Sharding: by account_id (all user data on same shard)&#xa;&#xa;• Redis (idempotency key cache)&#xa;  idempotencyKey → {paymentId, status} TTL 24hr&#xa;  If key exists → return cached response (no re-processing)&#xa;&#xa;• Kafka (event streaming)&#xa;  Topic: payment.commands (partition by from_account_id)&#xa;  Outbox relay publishes, Processor consumes&#xa;&#xa;• S3 (bank statement storage)&#xa;  Daily reconciliation CSV files, 7-year retention" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="850" y="210" width="520" height="195" as="geometry" />
        </mxCell>
        
        <!-- Key Principles -->
        <mxCell id="principles-box" value="KEY DESIGN PRINCIPLES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;strokeWidth=2;fontSize=13;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="320" y="440" width="1060" height="160" as="geometry" />
        </mxCell>
        
        <mxCell id="principles-list" value="1. IDEMPOTENCY: Client-generated UUID prevents double-charge on retry (Redis cache check before processing)&#xa;2. ACID TRANSACTIONS: payments + ledger_entries + outbox in ONE MySQL transaction (all-or-nothing)&#xa;3. DOUBLE-ENTRY BOOKKEEPING: Every payment = DEBIT source + CREDIT dest (sum of ledger always zero)&#xa;4. APPEND-ONLY LEDGER: Never UPDATE/DELETE ledger rows (immutable audit trail, regulatory requirement)&#xa;5. OUTBOX PATTERN: Write event to DB outbox in same TX as payment → relay publishes to Kafka (no event loss)&#xa;6. OPTIMISTIC LOCKING: accounts.version prevents race condition (two concurrent debits both seeing sufficient balance)&#xa;7. SAGA (not 2PC): Bank APIs don't support PREPARE phase → use saga with compensating transactions (refund on failure)&#xa;8. RECONCILIATION: Daily compare our ledger vs bank statement CSV → alert on mismatch (final safety net)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="330" y="470" width="1040" height="120" as="geometry" />
        </mxCell>
        
        <!-- Monitoring -->
        <mxCell id="monitoring-box" value="MONITORING &amp; OBSERVABILITY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=13;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="320" y="620" width="1060" height="230" as="geometry" />
        </mxCell>
        
        <mxCell id="monitoring-list" value="• Transactions/sec (TPS) — avg ~12 TPS, peak ~100 TPS (1M/day)&#xa;• Success rate % (target: &gt;99.5% — failures only from bank rejections, not system bugs)&#xa;• Payment latency: API response &lt;500ms (202 Accepted), bank settlement avg 3s&#xa;• Idempotency hit rate (should be ~10-15% — retries due to network timeouts)&#xa;• Optimistic lock collision rate (&lt;0.1% — concurrent debits from same account)&#xa;• Outbox relay lag (unpublished events backlog — alert if &gt;1000 or age &gt;5 min)&#xa;• Ledger balance vs account balance mismatch (should be ZERO — alert immediately)&#xa;• Reconciliation mismatch count (bank statement vs our ledger — investigate if &gt;0)&#xa;• Fraud detection latency (&lt;5 sec for async scoring)&#xa;• Alert: if payment stuck in PROCESSING &gt;30 min → escalate to ops&#xa;• Alert: if MySQL replication lag &gt;5 sec → read replicas stale, risky for fraud checks&#xa;• Alert: if Redis idempotency cache down → all requests hit DB, massive load spike&#xa;• Dashboard: payment state funnel (INITIATED → PROCESSING → SUCCESS/FAILED %)&#xa;• Dashboard: top failure reasons (insufficient funds, bank timeout, invalid card)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="330" y="650" width="1040" height="190" as="geometry" />
        </mxCell>
        
        <!-- EXTERNAL ACTORS -->
        
        <!-- Client/Merchant -->
        <mxCell id="actor-client" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="220" height="180" as="geometry" />
        </mxCell>
        
        <mxCell id="client-title" value="💳 CLIENT / MERCHANT" style="text;html=1;strokeColor=none;fillColor=#1976d2;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
          <mxGeometry x="50" y="210" width="200" height="30" as="geometry" />
