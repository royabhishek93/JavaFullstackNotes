<mxfile host="app.diagrams.net">
  <diagram name="Hotel Booking Context" id="hotel-context">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="HOTEL BOOKING PLATFORM (Airbnb / Booking.com) - System Context" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=22;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1480" height="35" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="Search by location and dates → Check real-time availability → Reserve atomically with distributed lock → Confirm with idempotent payment" style="text;html=1;strokeColor=none;fillColor=#e8eaf6;align=center;rounded=1;fontSize=13" vertex="1" parent="1"><mxGeometry x="200" y="65" width="1200" height="28" as="geometry" /></mxCell>

        <mxCell id="boundary" value="HOTEL BOOKING PLATFORM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#ef6c00;strokeWidth=4;fontSize=16;fontStyle=1;align=left;verticalAlign=top;spacingTop=10;spacingLeft=15" vertex="1" parent="1"><mxGeometry x="320" y="150" width="960" height="640" as="geometry" /></mxCell>

        <mxCell id="clients" value="CLIENTS\n\nWeb app, mobile app\n\nSearch hotels near location\nFilter by price, amenities, rating\nView room details and photos\nBook and pay\nManage bookings\nWrite reviews" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="350" y="205" width="210" height="220" as="geometry" /></mxCell>
        <mxCell id="gateway" value="API GATEWAY\n\nAuthentication\nRate limiting\nRouting\nGeo-based routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcc80;strokeColor=#ef6c00;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="620" y="205" width="160" height="150" as="geometry" /></mxCell>
        <mxCell id="services" value="CORE SERVICES\n\nUser Service\nSearch Service\nBooking Service\nPayment Service\nReview Service\nNotification Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="840" y="205" width="210" height="210" as="geometry" /></mxCell>
        <mxCell id="storage" value="DATA + EVENTS\n\nPostgreSQL: hotels, bookings\nElasticsearch: geo search\nRedis: distributed locks\nKafka: booking events\nS3 + CDN: hotel images" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="1100" y="205" width="150" height="210" as="geometry" /></mxCell>

        <mxCell id="principles" value="KEY DESIGN RULES\n\n1. Double booking prevention: Redis distributed lock (SETNX) rejects 499 concurrent requests in 1-2 ms. PostgreSQL FOR UPDATE provides ACID guarantee. Atomic transaction commits booking and marks room unavailable together.\n\n2. Search and availability are separate: Elasticsearch finds hotels by location and amenities (geo_distance query). PostgreSQL checks real-time per-date room availability. Never check availability in Elasticsearch.\n\n3. Payment idempotency: booking_id is the idempotency key. Payment gateway returns same intent if retried. UNIQUE constraint on payments(booking_id) prevents duplicate charges. Webhook handler checks existing payment before processing.\n\n4. Booking state machine: PENDING_PAYMENT → CONFIRMED → CANCELLED. Auto-expire PENDING bookings after 15 min if payment not received. Room release is atomic with status update.\n\n5. Dynamic pricing: price_calendar stores one price per room per date. Snapshot price into booking at creation so guests pay the rate they saw.\n\n6. Event-driven notifications: Kafka decouples booking from email/SMS. If notification service fails, booking still succeeds." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="350" y="465" width="900" height="295" as="geometry" /></mxCell>

        <mxCell id="user" value="GUEST\n\nSearches hotels\nBooks rooms\nMakes payment\nReceives confirmation\nWrites reviews" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="50" y="240" width="200" height="145" as="geometry" /></mxCell>
        <mxCell id="user-edge" value="Use web or mobile app" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#1976d2;endArrow=classic;endFill=1;fontSize=10" edge="1" parent="1" source="user" target="boundary"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="elasticsearch" value="ELASTICSEARCH\n\nGeo-point index\nFuzzy text search\nFilter by amenities\n1-2 sec sync lag from DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="1350" y="190" width="200" height="145" as="geometry" /></mxCell>
        <mxCell id="es-edge" value="Search hotels geo query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#f57f17;endArrow=classic;endFill=1;startArrow=classic;startFill=1;fontSize=10" edge="1" parent="1" source="boundary" target="elasticsearch"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="payment-gateway" value="PAYMENT GATEWAY\n\nStripe / Razorpay\nIdempotent charge\nWebhook callback\nRefund processing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="1350" y="400" width="200" height="145" as="geometry" /></mxCell>
        <mxCell id="payment-edge" value="Charge with idempotency_key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#c62828;endArrow=classic;endFill=1;startArrow=classic;startFill=1;fontSize=10" edge="1" parent="1" source="boundary" target="payment-gateway"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="hotel-admin" value="HOTEL MANAGER\n\nUpdate inventory\nSet room to Maintenance\nOverride pricing\nView booking analytics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="50" y="450" width="200" height="115" as="geometry" /></mxCell>
        <mxCell id="admin-edge" value="Admin API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#388e3c;dashed=1;endArrow=classic;endFill=1;fontSize=10" edge="1" parent="1" source="hotel-admin" target="boundary"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="cdn" value="CDN (CloudFront)\n\nHotel images\nRoom photos\n95% cache hit\n&lt;50ms globally" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="1350" y="610" width="200" height="115" as="geometry" /></mxCell>
        <mxCell id="cdn-edge" value="Fast image delivery" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#c2185b;dashed=1;endArrow=classic;endFill=1;fontSize=10" edge="1" parent="1" source="boundary" target="cdn"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="analogy" value="BEGINNER ANALOGY: The platform is a concert ticket booth. Elasticsearch is the poster board listing concerts nearby. PostgreSQL is the inventory ledger showing exactly which seats are still free. Redis lock is the wristband that says you're next in line. The payment gateway is the cash register. Kafka is the receipt-printer that triggers email confirmations and audit logs without blocking the sale." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0277bd;strokeWidth=2;fontSize=11;align=left;verticalAlign=middle;spacing=10" vertex="1" parent="1"><mxGeometry x="50" y="840" width="1500" height="75" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
