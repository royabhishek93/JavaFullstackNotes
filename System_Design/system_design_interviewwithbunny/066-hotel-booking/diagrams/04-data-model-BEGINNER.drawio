<mxfile host="app.diagrams.net"><diagram name="Data Model" id="hotel-data"><mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="HOTEL BOOKING - Data Model, Redis Keys, Kafka Topics, Failure Cases" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=22;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1600" height="35" as="geometry"/></mxCell>

<mxCell id="dbSection" value="POSTGRESQL SCHEMA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1620" height="410" as="geometry"/></mxCell>

<mxCell id="users" value="USERS\n\nPK: user_id UUID\nname VARCHAR(100)\nemail VARCHAR(100) UNIQUE\npassword_hash VARCHAR(255)\ncreated_at TIMESTAMP\nmetadata JSONB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="70" y="120" width="210" height="140" as="geometry"/></mxCell>

<mxCell id="hotels" value="HOTELS\n\nPK: hotel_id UUID\nname VARCHAR(200)\naddress TEXT\ngeo_pos POINT (lat, lng)\nrating DECIMAL(2,1)\namenities TEXT[]\nimages TEXT[]\nmetadata JSONB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="310" y="120" width="210" height="160" as="geometry"/></mxCell>

<mxCell id="rooms" value="ROOMS\n\nPK: room_id UUID\nFK: hotel_id → hotels\nroom_type VARCHAR(50)\ncapacity INT\namenities TEXT[]\nbase_price DECIMAL(10,2)\nmetadata JSONB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="550" y="120" width="220" height="150" as="geometry"/></mxCell>

<mxCell id="availability" value="ROOM_AVAILABILITY ⭐ CRITICAL\n\nPK: (hotel_id, room_id, date)\nFK: hotel_id → hotels\nFK: room_id → rooms\ndate DATE\nstatus ENUM('Available','Booked','Maintenance')\nbooking_id UUID NULL\n\nINDEX: (room_id, date, status)\n\nWHY: One row per room per date.\nEnables per-date granular locking.\nSELECT ... FOR UPDATE prevents\nrace conditions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=3;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="810" y="120" width="280" height="220" as="geometry"/></mxCell>

<mxCell id="bookings" value="BOOKINGS ⭐ STATE MACHINE\n\nPK: booking_id UUID\nFK: user_id → users\nFK: hotel_id → hotels\nFK: room_id → rooms\ncheck_in DATE\ncheck_out DATE\nstatus ENUM('PENDING_PAYMENT',\n            'CONFIRMED', 'CANCELLED')\namount DECIMAL(10,2)\npayment_id UUID NULL\ncancellation_policy JSONB (snapshot)\ncreated_at TIMESTAMP\n\nWHY: status tracks lifecycle.\nPENDING expires in 15 min if no payment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=3;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1130" y="120" width="290" height="220" as="geometry"/></mxCell>

<mxCell id="priceCalendar" value="PRICE_CALENDAR\n\nPK: (hotel_id, room_id, date)\ndate DATE\nprice DECIMAL(10,2)\ncurrency CHAR(3)\n\nWHY: Dynamic pricing.\nSame room = different price\nper date (holiday surge)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="70" y="290" width="210" height="165" as="geometry"/></mxCell>

<mxCell id="payments" value="PAYMENTS ⭐ IDEMPOTENCY\n\nPK: payment_id UUID\n(from gateway)\n\nUNIQUE: booking_id\n(prevents duplicate charge)\n\namount DECIMAL(10,2)\nstatus ENUM('PENDING',\n            'SUCCESS', 'FAILED')\ngateway_response JSONB\ncreated_at TIMESTAMP\n\nWHY: UNIQUE constraint enforces\none payment per booking." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=3;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="310" y="290" width="260" height="180" as="geometry"/></mxCell>

<mxCell id="reviews" value="REVIEWS\n\nPK: review_id UUID\nFK: hotel_id → hotels\nFK: user_id → users\nUNIQUE: booking_id\n(one review per booking)\nrating INT (1-5)\ncomment TEXT\nimages TEXT[]\ncreated_at TIMESTAMP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="600" y="290" width="220" height="165" as="geometry"/></mxCell>

<mxCell id="redisSection" value="REDIS KEY PATTERNS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="520" width="800" height="160" as="geometry"/></mxCell>

<mxCell id="redisLock" value="lock:hotel:{hotelId}:room:{roomId}:{checkIn}:{checkOut}\nValue: {booking_attempt_id}\nTTL: EX 30 (auto-release on crash)\n\nPurpose: Fast rejection of concurrent booking attempts (1-2 ms)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="70" y="560" width="350" height="100" as="geometry"/></mxCell>

<mxCell id="redisCache" value="search:{hash(location,filters)}\nTTL: 10 minutes\n\nuser:{userId}:bookings\nTTL: 5 minutes\n\nbooking:{bookingId}:expires\nTTL: 900s (15 min payment window)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="450" y="560" width="360" height="100" as="geometry"/></mxCell>

<mxCell id="kafkaSection" value="KAFKA TOPICS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="870" y="520" width="790" height="160" as="geometry"/></mxCell>

<mxCell id="kafkaTopics" value="booking.created\n{bookingId, userId, hotelId, roomId, checkIn, checkOut, amount, timestamp}\n\npayment.success\n{bookingId, paymentId, amount, gateway, timestamp}\n\nbooking.confirmed\n{bookingId, userId, confirmationNumber, hotel, room, checkIn, checkOut}\n\nbooking.cancelled\n{bookingId, userId, cancellationReason, refundAmount, timestamp}\n\nConsumers: Notification Service, Analytics, Channel Manager (OTA sync)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="900" y="560" width="730" height="100" as="geometry"/></mxCell>

<mxCell id="whySection" value="WHY THIS MODEL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="710" width="1620" height="130" as="geometry"/></mxCell>

<mxCell id="whyText" value="room_availability table: Per-date granularity is required because a room can be booked Feb 1-3, free Feb 4, booked Feb 5-7. A single booked/free flag can't express partial overlaps. FOR UPDATE lock on this table prevents double booking at the database level.\n\nbookings state machine: PENDING_PAYMENT holds the room for 15 minutes while the guest completes payment. Auto-expiry prevents orphaned reservations. CONFIRMED means payment received. CANCELLED returns room to inventory.\n\npayments UNIQUE constraint: Enforces idempotency at the DB level. Even if webhook fires twice (common with Stripe), the second INSERT fails gracefully and returns 200 OK.\n\nRedis distributed lock: Rejects 499 competing requests in 1-2 ms before they touch PostgreSQL. Without it, all 500 would queue at the DB FOR UPDATE lock, creating a bottleneck.\n\nprice_calendar: Dynamic pricing (surge on holidays, discounts during off-season). Snapshot into booking at creation time protects guest from price changes.\n\nKafka: Decouples booking from notification. If email service is down, booking still succeeds; email eventually sends when service recovers." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="70" y="750" width="1560" height="70" as="geometry"/></mxCell>

<mxCell id="failureSection" value="FAILURE SCENARIOS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1620" height="180" as="geometry"/></mxCell>

<mxCell id="f1" value="1. Redis down during booking\n\nFallback: Skip Redis lock, rely solely on\nPostgreSQL FOR UPDATE.\n\nImpact: Slightly slower (all requests hit DB),\nbut no double booking." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="70" y="910" width="300" height="110" as="geometry"/></mxCell>

<mxCell id="f2" value="2. Payment webhook never arrives\n\nSolution: Booking stays PENDING_PAYMENT\nfor 15 min, then cron job auto-cancels\nand releases room.\n\nAlso: Poll payment gateway API\nevery 5 min as backup." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="400" y="910" width="300" height="110" as="geometry"/></mxCell>

<mxCell id="f3" value="3. Booking service crashes mid-transaction\n\nSolution: Redis lock auto-expires in 30s.\nPostgreSQL transaction auto-rolls back.\nRoom returns to Available.\n\nGuest sees 500 error, retries,\ngets new booking_id." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="730" y="910" width="300" height="110" as="geometry"/></mxCell>

<mxCell id="f4" value="4. Network timeout after payment charged\n\nSolution: Idempotency key prevents\ndouble charge on retry.\n\nWebhook handler checks\nSELECT * FROM payments WHERE booking_id\nbefore processing.\n\nIf exists → return 200 OK (already processed)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1060" y="910" width="300" height="110" as="geometry"/></mxCell>

<mxCell id="f5" value="5. Guest cancels booking\n\nSolution: Atomic transaction:\nUPDATE bookings status='CANCELLED'\nUPDATE room_availability status='Available'\n\nRefund via payment gateway webhook.\n\nPublish booking.cancelled to Kafka\nfor email notification." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1390" y="910" width="240" height="110" as="geometry"/></mxCell>

</root></mxGraphModel></diagram></mxfile>