<mxfile host="app.diagrams.net"><diagram name="Booking Flow Sequence" id="booking-sequence"><mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="HOTEL BOOKING FLOW - Sequence Diagram (with Double-Booking Prevention)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=22;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="80" y="20" width="1740" height="35" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Multi-layer protection: Redis SETNX (fast rejection) → PostgreSQL FOR UPDATE (ACID guarantee) → Atomic commit → Event-driven confirmation" style="text;html=1;strokeColor=none;fillColor=#e8eaf6;align=center;rounded=1;fontSize=13" vertex="1" parent="1"><mxGeometry x="250" y="65" width="1400" height="28" as="geometry"/></mxCell>

<mxCell id="client" value="Client\n(Guest)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;fontSize=12;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="80" y="140" width="120" height="60" as="geometry"/></mxCell>
<mxCell id="bookingSvc" value="Booking\nService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=3;fontSize=12;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="260" y="140" width="120" height="60" as="geometry"/></mxCell>
<mxCell id="redis" value="Redis\n(Lock)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=12;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="440" y="140" width="120" height="60" as="geometry"/></mxCell>
<mxCell id="db" value="PostgreSQL\n(Availability)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=12;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="620" y="140" width="140" height="60" as="geometry"/></mxCell>
<mxCell id="bookingDb" value="PostgreSQL\n(Booking)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=12;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="820" y="140" width="140" height="60" as="geometry"/></mxCell>
<mxCell id="paymentSvc" value="Payment\nService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=12;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="1020" y="140" width="120" height="60" as="geometry"/></mxCell>
<mxCell id="gateway" value="Payment\nGateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=12;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="1200" y="140" width="120" height="60" as="geometry"/></mxCell>
<mxCell id="kafka" value="Kafka" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=12;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="1380" y="140" width="120" height="60" as="geometry"/></mxCell>
<mxCell id="notif" value="Notification\nService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=12;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="1560" y="140" width="120" height="60" as="geometry"/></mxCell>

<mxCell id="l1" value="" style="line;strokeWidth=2;html=1;strokeColor=#1976d2" vertex="1" parent="1"><mxGeometry x="140" y="210" width="0" height="920" as="geometry"/></mxCell>
<mxCell id="l2" value="" style="line;strokeWidth=2;html=1;strokeColor=#388e3c" vertex="1" parent="1"><mxGeometry x="320" y="210" width="0" height="920" as="geometry"/></mxCell>
<mxCell id="l3" value="" style="line;strokeWidth=2;html=1;strokeColor=#f57f17" vertex="1" parent="1"><mxGeometry x="500" y="210" width="0" height="920" as="geometry"/></mxCell>
<mxCell id="l4" value="" style="line;strokeWidth=2;html=1;strokeColor=#7b1fa2" vertex="1" parent="1"><mxGeometry x="690" y="210" width="0" height="920" as="geometry"/></mxCell>
<mxCell id="l5" value="" style="line;strokeWidth=2;html=1;strokeColor=#7b1fa2" vertex="1" parent="1"><mxGeometry x="890" y="210" width="0" height="920" as="geometry"/></mxCell>
<mxCell id="l6" value="" style="line;strokeWidth=2;html=1;strokeColor=#388e3c" vertex="1" parent="1"><mxGeometry x="1080" y="210" width="0" height="920" as="geometry"/></mxCell>
<mxCell id="l7" value="" style="line;strokeWidth=2;html=1;strokeColor=#c62828" vertex="1" parent="1"><mxGeometry x="1260" y="210" width="0" height="920" as="geometry"/></mxCell>
<mxCell id="l8" value="" style="line;strokeWidth=2;html=1;strokeColor=#7b1fa2" vertex="1" parent="1"><mxGeometry x="1440" y="210" width="0" height="920" as="geometry"/></mxCell>
<mxCell id="l9" value="" style="line;strokeWidth=2;html=1;strokeColor=#388e3c" vertex="1" parent="1"><mxGeometry x="1620" y="210" width="0" height="920" as="geometry"/></mxCell>

<mxCell id="s1" value="1. POST /v1/booking/{roomId}\n{checkIn, checkOut, guests}" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#1976d2;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.2" y="8" relative="1" as="geometry"><mxPoint x="140" y="240" as="sourcePoint"/><mxPoint x="320" y="240" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="phase1" value="PHASE 1: ACQUIRE DISTRIBUTED LOCK (fast rejection)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=5" vertex="1" parent="1"><mxGeometry x="30" y="270" width="400" height="30" as="geometry"/></mxCell>

<mxCell id="s2" value="2. SETNX lock:hotel:{id}:room:{id}:{checkIn}:{checkOut}\n{booking_attempt_id} EX 30" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#f57f17;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.3" y="10" relative="1" as="geometry"><mxPoint x="320" y="310" as="sourcePoint"/><mxPoint x="500" y="310" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="s3" value="3. Return 1 (lock acquired)\nOR 0 (someone else has lock)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#f57f17;dashed=1;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.3" y="-10" relative="1" as="geometry"><mxPoint x="500" y="340" as="sourcePoint"/><mxPoint x="320" y="340" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="note1" value="If 0 → return 409 Conflict immediately\n(499 users rejected here in 1-2 ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle" vertex="1" parent="1"><mxGeometry x="540" y="315" width="220" height="40" as="geometry"/></mxCell>

<mxCell id="phase2" value="PHASE 2: PESSIMISTIC DB CHECK (ACID guarantee)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=5" vertex="1" parent="1"><mxGeometry x="30" y="380" width="900" height="30" as="geometry"/></mxCell>

<mxCell id="s4" value="4. SELECT ... FROM room_availability\nWHERE room_id AND date BETWEEN\nFOR UPDATE" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#7b1fa2;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.2" y="12" relative="1" as="geometry"><mxPoint x="320" y="420" as="sourcePoint"/><mxPoint x="690" y="420" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="s5" value="5. Row locked + all dates Available" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#7b1fa2;dashed=1;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.2" y="-10" relative="1" as="geometry"><mxPoint x="690" y="450" as="sourcePoint"/><mxPoint x="320" y="450" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="note2" value="If any date NOT Available →\nROLLBACK + DEL lock →\n409 Conflict" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle" vertex="1" parent="1"><mxGeometry x="760" y="415" width="180" height="50" as="geometry"/></mxCell>

<mxCell id="phase3" value="PHASE 3: ATOMIC BOOKING COMMIT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0277bd;strokeWidth=2;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=5" vertex="1" parent="1"><mxGeometry x="30" y="490" width="900" height="30" as="geometry"/></mxCell>

<mxCell id="s6" value="6. BEGIN TRANSACTION" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#7b1fa2;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.1" y="8" relative="1" as="geometry"><mxPoint x="320" y="530" as="sourcePoint"/><mxPoint x="890" y="530" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="s7" value="7. INSERT INTO bookings\n(user_id, room_id, checkIn, checkOut, status='PENDING_PAYMENT', amount)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#7b1fa2;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.2" y="12" relative="1" as="geometry"><mxPoint x="320" y="565" as="sourcePoint"/><mxPoint x="890" y="565" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="s8" value="8. UPDATE room_availability\nSET status='Booked', booking_id={id}\nWHERE room_id AND date BETWEEN" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#7b1fa2;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.15" y="12" relative="1" as="geometry"><mxPoint x="320" y="610" as="sourcePoint"/><mxPoint x="690" y="610" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="s9" value="9. COMMIT" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#388e3c;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.1" y="8" relative="1" as="geometry"><mxPoint x="320" y="650" as="sourcePoint"/><mxPoint x="890" y="650" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="note3" value="Room marked Booked atomically\nwith booking creation\n(all-or-nothing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle" vertex="1" parent="1"><mxGeometry x="960" y="595" width="200" height="50" as="geometry"/></mxCell>

<mxCell id="s10" value="10. DEL lock (release)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#f57f17;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.2" y="8" relative="1" as="geometry"><mxPoint x="320" y="690" as="sourcePoint"/><mxPoint x="500" y="690" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="phase4" value="PHASE 4: PAYMENT + EVENT NOTIFICATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=5" vertex="1" parent="1"><mxGeometry x="30" y="720" width="1650" height="30" as="geometry"/></mxCell>

<mxCell id="s11" value="11. Create payment intent with idempotency_key={booking_id}" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#c62828;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.15" y="10" relative="1" as="geometry"><mxPoint x="320" y="760" as="sourcePoint"/><mxPoint x="1080" y="760" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="s12" value="12. Charge with idempotency guarantee" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#c62828;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.1" y="8" relative="1" as="geometry"><mxPoint x="1080" y="790" as="sourcePoint"/><mxPoint x="1260" y="790" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="s13" value="13. Return {payment_url, expires_at: now()+15min}" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#1976d2;dashed=1;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.2" y="-10" relative="1" as="geometry"><mxPoint x="320" y="820" as="sourcePoint"/><mxPoint x="140" y="820" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="note4" value="PENDING_PAYMENT state\nauto-expires in 15 min if\npayment not received" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle" vertex="1" parent="1"><mxGeometry x="30" y="845" width="170" height="50" as="geometry"/></mxCell>

<mxCell id="s14" value="14. Webhook: payment.success" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#c62828;dashed=1;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.1" y="-8" relative="1" as="geometry"><mxPoint x="1260" y="870" as="sourcePoint"/><mxPoint x="1080" y="870" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="s15" value="15. UPDATE bookings\nSET status='CONFIRMED', payment_id={id}" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#7b1fa2;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.15" y="10" relative="1" as="geometry"><mxPoint x="1080" y="900" as="sourcePoint"/><mxPoint x="890" y="900" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="s16" value="16. Publish booking.confirmed + payment.success to Kafka" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#7b1fa2;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.1" y="10" relative="1" as="geometry"><mxPoint x="1080" y="940" as="sourcePoint"/><mxPoint x="1440" y="940" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="s17" value="17. Consume event → send email/SMS" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#388e3c;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.1" y="8" relative="1" as="geometry"><mxPoint x="1440" y="970" as="sourcePoint"/><mxPoint x="1620" y="970" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="note5" value="Async notification\n(booking succeeds even if\nemail service is down)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle" vertex="1" parent="1"><mxGeometry x="1520" y="985" width="180" height="50" as="geometry"/></mxCell>

<mxCell id="key" value="INTERVIEW KEY\n\nSynchronous boundary: Steps 1-13 (user waits for payment_url; &lt; 2s SLA)\nAsynchronous boundary: Steps 14-17 (webhook + notification; may take seconds or minutes)\n\nWhy Redis lock expires in 30s? If booking service crashes mid-transaction, lock auto-releases. Room doesn't stay frozen forever.\nWhy FOR UPDATE? Redis might fail; DB lock is the ACID safety net.\nWhy idempotency_key? Network timeout → retry → same payment_intent returned, no double charge.\nWhy PENDING_PAYMENT state? Reservation holds room for 15 min; auto-cancels if payment window expires." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0277bd;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="60" y="1070" width="1640" height="100" as="geometry" /></mxCell>

</root></mxGraphModel></diagram></mxfile>