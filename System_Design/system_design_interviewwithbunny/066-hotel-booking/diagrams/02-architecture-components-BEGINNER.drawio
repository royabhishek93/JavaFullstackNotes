<mxfile host="app.diagrams.net"><diagram name="Architecture Components" id="hotel-architecture"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="HOTEL BOOKING - Architecture Components" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=22;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="80" y="20" width="1640" height="35" as="geometry"/></mxCell>
<mxCell id="clientLayer" value="CLIENT LAYER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1720" height="120" as="geometry"/></mxCell>
<mxCell id="apps" value="Web | Mobile | Admin Portal\n\nSearch hotels (geo + filters)\nView availability calendar\nBook and pay\nManage bookings\nWrite reviews" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="260" y="120" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="gatewayLayer" value="EDGE LAYER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="230" width="1720" height="100" as="geometry"/></mxCell>
<mxCell id="gateway" value="LOAD BALANCER + API GATEWAY\nJWT authentication | rate limit (100 req/min per user) | geo-based routing | round-robin to services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcc80;strokeColor=#ef6c00;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=10" vertex="1" parent="1"><mxGeometry x="260" y="260" width="800" height="45" as="geometry"/></mxCell>
<mxCell id="serviceLayer" value="SERVICE LAYER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="350" width="1720" height="230" as="geometry"/></mxCell>
<mxCell id="userSvc" value="User Service\n\nRegister / login\nJWT issue\nProfile CRUD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="70" y="400" width="150" height="120" as="geometry"/></mxCell>
<mxCell id="searchSvc" value="Search Service\n\nGeo-distance query\nFilter amenities / price\nCache popular searches\nRoute to Elasticsearch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="250" y="400" width="170" height="120" as="geometry"/></mxCell>
<mxCell id="bookingSvc" value="Booking Service\n\nCheck availability (DB)\nAcquire Redis lock\nCreate booking\nCoordinate payment\nPublish events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=3;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="450" y="400" width="170" height="120" as="geometry"/></mxCell>
<mxCell id="paymentSvc" value="Payment Service\n\nCharge with idempotency\nWebhook handler\nRefund processing\nReconciliation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="650" y="400" width="160" height="120" as="geometry"/></mxCell>
<mxCell id="reviewSvc" value="Review Service\n\nCRUD reviews\nRating aggregation\nImage upload to S3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="840" y="400" width="150" height="120" as="geometry"/></mxCell>
<mxCell id="notifySvc" value="Notification Service\n\nConsume Kafka events\nEmail / SMS / push\nTemplate rendering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1020" y="400" width="160" height="120" as="geometry"/></mxCell>
<mxCell id="dataLayer" value="DATA + INFRASTRUCTURE LAYER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1720" height="180" as="geometry"/></mxCell>
<mxCell id="userDb" value="User DB (PostgreSQL)\nusers, sessions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="70" y="650" width="150" height="80" as="geometry"/></mxCell>
<mxCell id="hotelDb" value="Hotel DB (PostgreSQL)\nhotels, rooms, room_availability\nprice_calendar, bookings\nStrong consistency for booking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=3;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="260" y="650" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="redis" value="Redis\ndistributed lock (SETNX)\nsearch cache\nbooking expiry TTL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=3;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="500" y="650" width="160" height="80" as="geometry"/></mxCell>
<mxCell id="es" value="Elasticsearch\ngeo_point index\nhotel search\nsync via CDC (1-2s lag)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="700" y="650" width="170" height="80" as="geometry"/></mxCell>
<mxCell id="kafka" value="Kafka\nbooking.created\npayment.success\nbooking.confirmed\nbooking.cancelled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="910" y="650" width="160" height="90" as="geometry"/></mxCell>
<mxCell id="s3" value="S3 + CDN\nhotel images\nroom photos\n95% cache hit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="1110" y="650" width="140" height="80" as="geometry"/></mxCell>
<mxCell id="paymentDb" value="Payment DB\npayments table\nUNIQUE(booking_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="1290" y="650" width="150" height="80" as="geometry"/></mxCell>
<mxCell id="e1" value="lock" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#f57f17;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="bookingSvc" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="check + FOR UPDATE" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#7b1fa2;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="bookingSvc" target="hotelDb"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="publish event" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#7b1fa2;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="bookingSvc" target="kafka"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="consume" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#7b1fa2;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="kafka" target="notifySvc"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="idempotent charge" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#c62828;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="paymentSvc" target="paymentDb"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="why" value="WHY THESE CHOICES\n\nRedis distributed lock (SETNX): rejects 499 concurrent booking attempts in 1-2 ms, prevents PostgreSQL bottleneck.\nPostgreSQL FOR UPDATE: ACID guarantee even if Redis fails; row-level lock on room_availability.\nElasticsearch geo_distance: finds hotels within 20 km with fuzzy text and amenity filters in under 100 ms; PostgreSQL can't do this at scale.\nKafka: decouples booking from notification; if email service is down, booking still succeeds.\nPayment idempotency: booking_id as key prevents double charge on network retry; UNIQUE constraint in DB enforces it.\nCDN for images: 95% cache hit, under 50 ms globally instead of 800 ms cross-region S3 fetch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="60" y="820" width="1300" height="180" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>