<mxCell id="t" value="EMAIL SEND DELIVERY FLOW - Outbox Pattern + SMTP + SPF/DKIM/DMARC Authentication" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="60" y="20" width="2480" height="35" as="geometry"/></mxCell>
