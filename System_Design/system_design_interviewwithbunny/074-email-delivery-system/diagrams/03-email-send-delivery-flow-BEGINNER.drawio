<mxCell id="phase1" value="PHASE 1: COMPOSE &amp; S3 ATTACHMENT UPLOAD" style="text;html=1;strokeColor=#c62828;fillColor=#ffebee;align=left;fontSize=12;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="1850" y="230" width="680" height="25" as="geometry"/></mxCell>

<mxCell id="s1" value="1. Upload attachment.pdf 5MB" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#1976d2;fontSize=10" edge="1" parent="1" source="userLine" target="composeLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s2" value="2. POST multipart/form" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#c62828;fontSize=10" edge="1" parent="1" source="composeLine" target="s3Line"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s3" value="3. Presigned URL upload" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeWidth=1;strokeColor=#c62828;fontSize=10" edge="1" parent="1" source="s3Line" target="composeLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s4" value="4. Virus scan ClamAV&#10;(if infected reject)" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#388e3c;fontSize=10" edge="1" parent="1" source="composeLine" target="composeLine"><mxGeometry width="80" relative="1" as="geometry"><mxPoint x="250" y="330" as="sourcePoint"/><mxPoint x="270" y="330" as="offset"/></mxGeometry></mxCell>
<mxCell id="s5" value="5. {attachmentId, s3Url}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeWidth=1;strokeColor=#388e3c;fontSize=10" edge="1" parent="1" source="composeLine" target="userLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>

<mxCell id="phase2" value="PHASE 2: MAIL SEND &amp; OUTBOX INSERT (DURABLE QUEUE)" style="text;html=1;strokeColor=#7b1fa2;fillColor=#f3e5f5;align=left;fontSize=12;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="1850" y="400" width="680" height="25" as="geometry"/></mxCell>

<mxCell id="s6" value="6. POST /emails/send&#10;{to,subject,body,attachmentId}" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#1976d2;fontSize=10" edge="1" parent="1" source="userLine" target="mailLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s7" value="7. Quota check 15GB limit&#10;Validate recipients DNS MX&#10;Spam/policy check" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#388e3c;fontSize=10" edge="1" parent="1" source="mailLine" target="mailLine"><mxGeometry width="80" relative="1" as="geometry"><mxPoint x="500" y="480" as="sourcePoint"/><mxPoint x="520" y="480" as="offset"/></mxGeometry></mxCell>
<mxCell id="s8" value="8. BEGIN TRANSACTION&#10;INSERT outbox (user_id,&#10;email_id, status:PENDING)" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=3;strokeColor=#7b1fa2;fontSize=10" edge="1" parent="1" source="mailLine" target="outboxLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="outboxNote" value="DURABLE STORAGE&#10;survives crash" style="text;html=1;strokeColor=#7b1fa2;fillColor=#f3e5f5;align=center;fontSize=10;rounded=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1850" y="550" width="140" height="35" as="geometry"/></mxCell>
<mxCell id="s9" value="9. Kafka.send(email.outbound)" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#ef6c00;fontSize=10" edge="1" parent="1" source="mailLine" target="kafkaLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s10" value="10. COMMIT" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeWidth=1;strokeColor=#7b1fa2;fontSize=10" edge="1" parent="1" source="outboxLine" target="mailLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s11" value="11. 200 OK&#10;status:SENDING" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeWidth=1;strokeColor=#388e3c;fontSize=10" edge="1" parent="1" source="mailLine" target="userLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="userNote" value="User not blocked&#10;&lt;10ms response" style="text;html=1;strokeColor=#388e3c;fillColor=#e8f5e9;align=center;fontSize=10;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="680" width="100" height="35" as="geometry"/></mxCell>

<mxCell id="phase3" value="PHASE 3: SLA PRIORITY ROUTING" style="text;html=1;strokeColor=#ef6c00;fillColor=#fff3e0;align=left;fontSize=12;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="1850" y="750" width="680" height="25" as="geometry"/></mxCell>

<mxCell id="s12" value="12. Consume email.outbound" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#ef6c00;fontSize=10" edge="1" parent="1" source="kafkaLine" target="orchLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s13" value="13. Determine priority:&#10;Same domain → HIGH&#10;Known contacts → HIGH&#10;Bulk → LOW" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#388e3c;fontSize=10" edge="1" parent="1" source="orchLine" target="orchLine"><mxGeometry width="80" relative="1" as="geometry"><mxPoint x="860" y="840" as="sourcePoint"/><mxPoint x="880" y="840" as="offset"/></mxGeometry></mxCell>
<mxCell id="s14" value="14. Kafka.send(email.smtp.normal)" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#ef6c00;fontSize=10" edge="1" parent="1" source="orchLine" target="kafkaLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>

<mxCell id="phase4" value="PHASE 4: SMTP HANDSHAKE &amp; EMAIL TRANSMISSION" style="text;html=1;strokeColor=#f57f17;fillColor=#fff9c4;align=left;fontSize=12;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="1850" y="940" width="680" height="25" as="geometry"/></mxCell>

<mxCell id="s15" value="15. Consume smtp.normal" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#ef6c00;fontSize=10" edge="1" parent="1" source="kafkaLine" target="smtpLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s16" value="16. dig MX outlook.com" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="smtpLine" target="dnsLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s17" value="17. MX IP addresses" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeWidth=1;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="dnsLine" target="smtpLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s18" value="18. TCP connect:25&#10;STARTTLS (TLS upgrade)" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=3;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="smtpLine" target="receiverLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s19" value="19. EHLO gmail.com" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="smtpLine" target="receiverLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s20" value="20. 250 Hello" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeWidth=1;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="receiverLine" target="smtpLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s21" value="21. MAIL FROM sender@gmail.com" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="smtpLine" target="receiverLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s22" value="22. 250 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeWidth=1;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="receiverLine" target="smtpLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s23" value="23. RCPT TO alice@outlook.com" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="smtpLine" target="receiverLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s24" value="24. Check user exists&#10;SELECT user_id" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#7b1fa2;fontSize=10" edge="1" parent="1" source="receiverLine" target="receiverLine"><mxGeometry width="80" relative="1" as="geometry"><mxPoint x="1235" y="1270" as="sourcePoint"/><mxPoint x="1255" y="1270" as="offset"/></mxGeometry></mxCell>
<mxCell id="s25" value="25. 250 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeWidth=1;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="receiverLine" target="smtpLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s26" value="26. DATA" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="smtpLine" target="receiverLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s27" value="27. 354 Start input" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeWidth=1;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="receiverLine" target="smtpLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s28" value="28. Headers + Body&#10;DKIM-Signature:&#10;From:, To:, Subject:&#10;Content + attachments&#10;. (period end)" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=3;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="smtpLine" target="receiverLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>

<mxCell id="phase5" value="PHASE 5: SPF/DKIM/DMARC AUTHENTICATION" style="text;html=1;strokeColor=#1976d2;fillColor=#e3f2fd;align=left;fontSize=12;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="1850" y="1450" width="680" height="25" as="geometry"/></mxCell>

<mxCell id="s29" value="29. dig TXT gmail.com (SPF)" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="receiverLine" target="dnsLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s30" value="30. v=spf1 ip4:74.125..." style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeWidth=1;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="dnsLine" target="receiverLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s31" value="31. Check sender IP&#10;in SPF range → PASS" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#388e3c;fontSize=10" edge="1" parent="1" source="receiverLine" target="receiverLine"><mxGeometry width="80" relative="1" as="geometry"><mxPoint x="1235" y="1560" as="sourcePoint"/><mxPoint x="1255" y="1560" as="offset"/></mxGeometry></mxCell>
<mxCell id="s32" value="32. dig TXT default._domainkey.gmail.com" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="receiverLine" target="dnsLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s33" value="33. Public key RSA" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeWidth=1;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="dnsLine" target="receiverLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s34" value="34. Verify DKIM signature&#10;matches content → PASS" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#388e3c;fontSize=10" edge="1" parent="1" source="receiverLine" target="receiverLine"><mxGeometry width="80" relative="1" as="geometry"><mxPoint x="1235" y="1660" as="sourcePoint"/><mxPoint x="1255" y="1660" as="offset"/></mxGeometry></mxCell>
<mxCell id="s35" value="35. 250 OK Message accepted" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeWidth=1;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="receiverLine" target="smtpLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s36" value="36. QUIT" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="smtpLine" target="receiverLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s37" value="37. UPDATE outbox&#10;status=SENT&#10;DELETE pending" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#7b1fa2;fontSize=10" edge="1" parent="1" source="smtpLine" target="outboxLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>

<mxCell id="phase6" value="PHASE 6: INBOUND INSERT &amp; THREAD DETECTION" style="text;html=1;strokeColor=#388e3c;fillColor=#e8f5e9;align=left;fontSize=12;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="1850" y="1320" width="680" height="25" as="geometry"/></mxCell>

<mxCell id="s38" value="38. Spam/malware filter" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#388e3c;fontSize=10" edge="1" parent="1" source="receiverLine" target="spamLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s39" value="39. Bayesian score 0.2&#10;ClamAV clean → INBOX" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeWidth=1;strokeColor=#388e3c;fontSize=10" edge="1" parent="1" source="spamLine" target="receiverLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s40" value="40. Kafka.send(email.inbound)" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#ef6c00;fontSize=10" edge="1" parent="1" source="receiverLine" target="kafkaLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
