<mxCell id="s42" value="42. Thread detect:&#10;In-Reply-To header&#10;match existing thread" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#388e3c;fontSize=10" edge="1" parent="1" source="inboundLine" target="inboundLine"><mxGeometry width="80" relative="1" as="geometry"><mxPoint x="1495" y="1510" as="sourcePoint"/><mxPoint x="1515" y="1510" as="offset"/></mxGeometry></mxCell>
