<mxfile host="app.diagrams.net"><diagram name="Architecture" id="email-arch"><mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2400" pageHeight="1600" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="EMAIL DELIVERY SYSTEM - Architecture (Outbox Pattern + SLA Priority + SMTP Authentication)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="60" y="20" width="2280" height="35" as="geometry"/></mxCell><mxCell id="clientLayer" value="CLIENT LAYER" style="text;html=1;strokeColor=#1976d2;fillColor=#e3f2fd;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="80" width="2280" height="25" as="geometry"/></mxCell><mxCell id="webClient" value="Web Client&#10;(React/Vue)&#10;Compose UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="80" y="120" width="140" height="70" as="geometry"/></mxCell><mxCell id="mobileClient" value="Mobile Client&#10;(iOS/Android)&#10;Push notifications" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="250" y="120" width="140" height="70" as="geometry"/></mxCell><mxCell id="edgeLayer" value="EDGE LAYER (Load Balancer + API Gateway)" style="text;html=1;strokeColor=#c2185b;fillColor=#fce4ec;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="220" width="2280" height="25" as="geometry"/></mxCell><mxCell id="apiGW" value="API Gateway&#10;Auth (JWT)&#10;Rate Limit&#10;500 emails/day free" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcc80;strokeColor=#ef6c00;strokeWidth=3;fontSize=11" vertex="1" parent="1"><mxGeometry x="80" y="260" width="180" height="80" as="geometry"/></mxCell><mxCell id="serviceLayer" value="SERVICE LAYER (Event-Driven with Kafka Async Processing)" style="text;html=1;strokeColor=#388e3c;fillColor=#e8f5e9;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="370" width="2280" height="25" as="geometry"/></mxCell><mxCell id="composeSvc" value="Compose Service&#10;Draft save&#10;Attachment S3&#10;Virus scan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="80" y="410" width="200" height="90" as="geometry"/></mxCell><mxCell id="mailSendSvc" value="Mail Send Service&#10;Quota check&#10;Recipient validate&#10;Spam check&#10;Outbox INSERT&#10;Kafka publish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=3;fontSize=11" vertex="1" parent="1"><mxGeometry x="320" y="410" width="220" height="120" as="geometry"/></mxCell><mxCell id="outboxOrch" value="Outbox Delivery Orchestrator&#10;SLA priority route&#10;HIGH/NORMAL/LOW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=3;fontSize=11" vertex="1" parent="1"><mxGeometry x="580" y="410" width="240" height="80" as="geometry"/></mxCell><mxCell id="smtpWorkers" value="SMTP Workers&#10;HIGH 50 workers&#10;NORMAL 100 workers&#10;LOW 20 workers&#10;TCP pool&#10;SPF/DKIM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=3;fontSize=11" vertex="1" parent="1"><mxGeometry x="860" y="410" width="220" height="120" as="geometry"/></mxCell><mxCell id="inboundSMTP" value="Inbound SMTP Service&#10;Receive external&#10;MAIL FROM validate&#10;RCPT TO check&#10;Spam filter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="1120" y="410" width="220" height="100" as="geometry"/></mxCell><mxCell id="searchSvc" value="Search Service&#10;Elasticsearch query&#10;Full-text&#10;ngram autocomplete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="1380" y="410" width="220" height="90" as="geometry"/></mxCell><mxCell id="notificationSvc" value="Notification Service&#10;FCM/APNS push&#10;Email forwarding&#10;VIP alerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="1640" y="410" width="200" height="80" as="geometry"/></mxCell><mxCell id="dataLayer" value="DATA LAYER (PostgreSQL Sharded + S3 Attachments + Kafka Events + Elasticsearch Index)" style="text;html=1;strokeColor=#7b1fa2;fillColor=#f3e5f5;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="560" width="2280" height="25" as="geometry"/></mxCell><mxCell id="mailboxDB" value="Mailbox DB&#10;PostgreSQL&#10;sharded by user_id&#10;mailbox_items&#10;1 master + 10 replicas" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="80" y="600" width="200" height="100" as="geometry"/></mxCell><mxCell id="outboxDB" value="Outbox DB&#10;PostgreSQL&#10;Durable queue&#10;pending sends&#10;retry logic" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=3;fontSize=11" vertex="1" parent="1"><mxGeometry x="320" y="600" width="180" height="100" as="geometry"/></mxCell><mxCell id="kafka" value="Kafka Topics&#10;email.outbound&#10;email.smtp.*&#10;email.inbound&#10;email.indexed" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffcc80;strokeColor=#ef6c00;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="540" y="600" width="200" height="100" as="geometry"/></mxCell><mxCell id="s3" value="S3 Blob Storage&#10;Attachments 25MB&#10;Presigned URLs&#10;Lifecycle Glacier&#10;11 nines" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="780" y="600" width="200" height="100" as="geometry"/></mxCell><mxCell id="elastic" value="Elasticsearch&#10;emails index&#10;10 shards&#10;subject/body&#10;autocomplete" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="1020" y="600" width="200" height="100" as="geometry"/></mxCell><mxCell id="threadsDB" value="Threads DB&#10;PostgreSQL&#10;thread_id&#10;participant_emails&#10;message_count" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="1260" y="600" width="200" height="100" as="geometry"/></mxCell><mxCell id="whyOutbox" value="WHY OUTBOX PATTERN? At-least-once delivery guarantee. INSERT outbox BEFORE Kafka publish in same transaction prevents email loss on crash. Retry exponential backoff 1min 5min 15min max 10 attempts. Permanent failure 550 send bounce. DLQ after max retries." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=3;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="80" y="740" width="540" height="100" as="geometry"/></mxCell><mxCell id="whySLA" value="WHY SLA PRIORITY ROUTING? HIGH same domain known contacts VIP 50 workers 1min. NORMAL external first-time 100 workers 5min. LOW bulk newsletters 20 workers 30min rate limited. Auto-suggestion correlation in contacts HIGH priority better UX." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="660" y="740" width="540" height="100" as="geometry"/></mxCell><mxCell id="whySMTP" value="WHY SMTP AUTHENTICATION? SPF validates sending IP authorized DNS TXT check. DKIM validates not tampered signature verification public key DNS. DMARC enforces policy reject quarantine none requires SPF or DKIM alignment. All three combined blocks spoofing phishing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1240" y="740" width="540" height="100" as="geometry"/></mxCell><mxCell id="whyS3" value="WHY S3 FOR ATTACHMENTS? 25MB times 1B emails equals 25 petabytes in PostgreSQL disaster. DB buffer pool contamination attachment bytes evict hot indexes. S3 11 nines durability lifecycle Glacier after 1yr saves 90 percent cost presigned URLs direct upload download bypasses server reduces load." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="80" y="880" width="520" height="80" as="geometry"/></mxCell><mxCell id="whyKafka" value="WHY KAFKA EVENT-DRIVEN? Mail Send returns 200 OK immediately user not blocked. Async processing decouples services horizontal scaling at-least-once delivery Kafka retains until consumed prevents cascading failures. Topics email.outbound smtp.priority inbound indexed received." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="640" y="880" width="560" height="80" as="geometry"/></mxCell><mxCell id="whyElastic" value="WHY ELASTICSEARCH? SQL LIKE scans all rows minutes. Elasticsearch full-text index stemming meeting meet ngram autocomplete 10 shards parallel query under 100ms. PostgreSQL exact match Elasticsearch fuzzy full-text autocomplete." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1240" y="880" width="540" height="80" as="geometry"/></mxCell><mxCell id="flowSummary" value="CRITICAL PATH: User compose upload S3 virus scan Mail Send quota check recipient validate INSERT outbox Kafka publish Outbox Orchestrator priority route SMTP worker DNS MX TCP EHLO MAIL FROM RCPT TO DATA headers body QUIT Receiver SPF DKIM DMARC spam filter Inbound INSERT mailbox thread detect Elasticsearch index Notification push FCM" style="text;html=1;strokeColor=#1976d2;fillColor=#e3f2fd;align=center;fontSize=11;rounded=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="80" y="1000" width="1700" height="40" as="geometry"/></mxCell><mxCell id="scaleNumbers" value="SCALE: 1.8B users billions emails daily petabytes S3 millions emails per min peak 100 partitions Kafka 50 100 20 SMTP workers high normal low 1 master 10 read replicas PostgreSQL 10 shards Elasticsearch 99.99 percent uptime 15GB quota free 2M USD monthly AWS cost RDS Multi-AZ S3 ElastiCache MSK Kafka EC2 SMTP workers" style="text;html=1;strokeColor=#ef6c00;fillColor=#fff3e0;align=center;fontSize=11;rounded=1" vertex="1" parent="1"><mxGeometry x="80" y="1060" width="1700" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
