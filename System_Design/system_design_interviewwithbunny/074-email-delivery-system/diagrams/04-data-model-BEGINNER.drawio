<mxfile host="app.diagrams.net"><diagram name="Data Model" id="email-data"><mxGraphModel dx="2400" dy="2000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2400" pageHeight="2000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="EMAIL DELIVERY SYSTEM - Data Model (PostgreSQL Sharded + S3 Blobs + Kafka Events + Elasticsearch)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="60" y="20" width="2280" height="35" as="geometry"/></mxCell>

<mxCell id="postgresTitle" value="POSTGRESQL SCHEMAS (Sharded by user_id | Composite PK | Read Replicas)" style="text;html=1;strokeColor=#7b1fa2;fillColor=#f3e5f5;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="80" width="1160" height="25" as="geometry"/></mxCell>

<mxCell id="mailboxTable" value="TABLE: mailbox_items (Inbox/Sent/Spam/Trash)&#10;&#10;Composite PK: (user_id, email_id)&#10;user_id UUID FK → Users (shard key)&#10;email_id UUID (globally unique)&#10;message_id VARCHAR(255) (RFC 5322 &lt;uuid@gmail.com&gt;)&#10;thread_id UUID FK → Threads&#10;from_email VARCHAR(255)&#10;to_emails TEXT[] (array)&#10;cc_emails TEXT[]&#10;bcc_emails TEXT[]&#10;subject TEXT&#10;snippet TEXT (first 100 chars for preview)&#10;has_attachment BOOLEAN&#10;url_attachment TEXT (S3 URLs comma-separated)&#10;folder VARCHAR(50) (INBOX/SENT/DRAFTS/SPAM/TRASH)&#10;is_read BOOLEAN DEFAULT false&#10;is_starred BOOLEAN DEFAULT false&#10;received_at TIMESTAMPTZ&#10;&#10;INDEXES:&#10;INDEX (user_id, folder, received_at DESC) for listing&#10;INDEX (user_id, thread_id) for conversation view&#10;&#10;SHARDING: Hash(user_id) mod N shards&#10;User emails on same shard fast queries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="60" y="120" width="360" height="440" as="geometry"/></mxCell>

<mxCell id="outboxTable" value="TABLE: outbox (Durable Queue Pending Sends)&#10;&#10;Composite PK: (user_id, email_id)&#10;user_id UUID&#10;email_id UUID&#10;message_id VARCHAR(255)&#10;thread_id UUID (if reply)&#10;from_email VARCHAR(255)&#10;to_emails TEXT[]&#10;subject TEXT&#10;body TEXT (full HTML or plain)&#10;has_attachment BOOLEAN&#10;url_attachment TEXT (S3 URLs)&#10;scheduled_at TIMESTAMPTZ (for retry scheduling)&#10;retry_count INT DEFAULT 0&#10;status ENUM(PENDING, SENDING, SENT, FAILED)&#10;created_at TIMESTAMPTZ&#10;&#10;PURPOSE: At-least-once delivery guarantee&#10;Email survives server crash (durable storage)&#10;&#10;CRITICAL FLOW:&#10;BEGIN TRANSACTION&#10;  INSERT INTO outbox (status=PENDING)&#10;  Kafka.send(email.outbound)&#10;COMMIT&#10;&#10;SMTP worker processes → status=SENT → DELETE&#10;IF failed → retry_count++, scheduled_at = now() + backoff&#10;Exponential backoff: 1min, 5min, 15min, max 10 attempts&#10;&#10;Permanent failure 550 → status=FAILED, bounce notify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=3;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="440" y="120" width="380" height="440" as="geometry"/></mxCell>

<mxCell id="threadsTable" value="TABLE: threads (Conversation Grouping)&#10;&#10;thread_id UUID PRIMARY KEY&#10;subject TEXT (first email subject)&#10;participant_emails TEXT[] (all unique emails)&#10;email_ids UUID[] (ordered oldest→newest)&#10;last_updated_at TIMESTAMPTZ&#10;message_count INT&#10;&#10;INDEXES:&#10;INDEX participant_emails GIN (array containment)&#10;&#10;THREAD DETECTION:&#10;Check In-Reply-To and References headers&#10;IF match existing message_id:&#10;  UPDATE thread SET&#10;    email_ids = array_append(email_ids, new_email_id),&#10;    last_updated_at = now(),&#10;    message_count++&#10;ELSE:&#10;  INSERT new thread&#10;&#10;CACHE: Redis (message_id → thread_id)&#10;TTL 7 days, 95% hit rate, avoids DB query on reply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="840" y="120" width="380" height="300" as="geometry"/></mxCell>

<mxCell id="usersTable" value="TABLE: users&#10;&#10;user_id UUID PRIMARY KEY&#10;email_address VARCHAR(255) UNIQUE&#10;password_hash VARCHAR(255) (bcrypt)&#10;name VARCHAR(255)&#10;quota_limit BIGINT (15GB default = 15×1024³ bytes)&#10;quota_used BIGINT (bytes, updated on email/attachment)&#10;created_at TIMESTAMPTZ&#10;last_login_at TIMESTAMPTZ&#10;&#10;QUOTA CHECK:&#10;SELECT quota_used, quota_limit&#10;FROM users WHERE user_id = ?&#10;IF quota_used &gt;= quota_limit →403 Quota exceeded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="840" y="440" width="380" height="120" as="geometry"/></mxCell>

<mxCell id="kafkaTitle" value="KAFKA TOPICS (Event-Driven Async Processing | At-Least-Once Delivery)" style="text;html=1;strokeColor=#ef6c00;fillColor=#fff3e0;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="600" width="1160" height="25" as="geometry"/></mxCell>

<mxCell id="kafkaOutbound" value="TOPIC: email.outbound&#10;&#10;PRODUCER: Mail Send Service&#10;CONSUMER: Outbox Delivery Orchestrator (5 instances)&#10;PARTITIONS: 100 (by user_id hash)&#10;REPLICATION: RF=3&#10;&#10;MESSAGE:&#10;{emailId, userId, toEmails[], subject, body,&#10; hasAttachment, s3UrlAttachment, priority, createdAt}&#10;&#10;FLOW: Mail Send → INSERT outbox → Kafka.send&#10;User gets 200 OK immediately (not blocked)&#10;Orchestrator consumes async → determine priority" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="60" y="640" width="360" height="200" as="geometry"/></mxCell>

<mxCell id="kafkaSMTP" value="TOPIC: email.smtp.{priority}&#10;&#10;email.smtp.high (50 workers, &lt;1min SLA)&#10;  Same domain OR known contacts OR VIP&#10;email.smtp.normal (100 workers, 5min SLA)&#10;  External first-time contact&#10;email.smtp.low (20 workers, 30min SLA)&#10;  Bulk 100+ recipients, newsletters&#10;&#10;PRODUCER: Outbox Delivery Orchestrator&#10;CONSUMER: SMTP Workers (170 total)&#10;PARTITIONS: 50 per topic&#10;&#10;SLA ROUTING:&#10;IF same_domain OR in_contacts: → high&#10;ELSE IF bulk OR List-Unsubscribe: → low&#10;ELSE: → normal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=3;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="440" y="640" width="380" height="240" as="geometry"/></mxCell>

<mxCell id="kafkaInbound" value="TOPIC: email.inbound&#10;&#10;PRODUCER: Inbound SMTP Service (external emails)&#10;CONSUMER: Mailbox Receiver DB Service&#10;PARTITIONS: 50&#10;&#10;MESSAGE:&#10;{emailId, recipientEmail, fromEmail, subject,&#10; body, hasAttachment, spamScore, policyCheck:&#10; {spf: PASS/FAIL, dkim: PASS/FAIL, dmarc: PASS}}&#10;&#10;FLOW: External SMTP → Spam filter → Kafka inbound&#10;→ Mailbox Receiver inserts mailbox_items&#10;→ Thread detection → Elasticsearch index" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="840" y="640" width="380" height="200" as="geometry"/></mxCell>

<mxCell id="s3Title" value="S3 BLOB STORAGE (Attachments 25MB Max | 11 Nines Durability | Lifecycle Policies)" style="text;html=1;strokeColor=#c62828;fillColor=#ffebee;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="1260" y="80" width="1080" height="25" as="geometry"/></mxCell>

<mxCell id="s3Structure" value="S3 BUCKET STRUCTURE:&#10;&#10;s3://email-attachments/&#10;  {user_id}/&#10;    {email_id}/&#10;      presentation.pdf (5MB)&#10;      document.docx (2MB)&#10;      image.jpg (1MB)&#10;&#10;METADATA:&#10;attachment_id UUID PK&#10;email_id UUID FK → mailbox_items&#10;filename VARCHAR(255)&#10;size_bytes BIGINT (5MB = 5×1024²)&#10;content_type VARCHAR(100) (application/pdf, image/jpeg)&#10;s3_url TEXT (full S3 path)&#10;virus_scan_status ENUM(PENDING, CLEAN, INFECTED)&#10;uploaded_at TIMESTAMPTZ&#10;&#10;UPLOAD FLOW:&#10;1. Compose Svc: POST /attachments/upload multipart/form&#10;2. Generate presigned URL: PUT s3://.../file.pdf (1hr expiry)&#10;3. Client uploads directly to S3 (bypasses server)&#10;4. Virus scan ClamAV: IF infected → DELETE, ELSE mark CLEAN&#10;5. Return {attachmentId, s3Url} for email send&#10;&#10;DOWNLOAD FLOW:&#10;1. GET /attachments/{attachmentId}&#10;2. Check virus_scan_status = CLEAN&#10;3. Generate presigned GET URL (15min expiry)&#10;4. Redirect client to presigned URL&#10;5. Client downloads directly from S3&#10;&#10;WHY S3 (NOT DB):&#10;25MB × 1B emails = 25 petabytes in PostgreSQL impossible&#10;DB buffer pool contamination (attachment evicts hot indexes)&#10;Backup disaster (restore takes weeks)&#10;S3: 11 nines durability, never lose attachments&#10;Lifecycle: archive to Glacier after 1yr (saves 90% cost)&#10;Presigned URLs: direct upload/download (reduces server load)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1260" y="120" width="520" height="480" as="geometry"/></mxCell>

<mxCell id="elasticTitle" value="ELASTICSEARCH INDEX (Full-Text Search | ngram Autocomplete | Stemming)" style="text;html=1;strokeColor=#f57f17;fillColor=#fff9c4;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="1800" y="120" width="540" height="25" as="geometry"/></mxCell>

<mxCell id="elasticIndex" value="INDEX: emails (10 shards by user_id hash)&#10;&#10;FIELDS:&#10;user_id (keyword) — exact match&#10;email_id (keyword)&#10;from_email (keyword)&#10;to_emails (keyword array)&#10;subject (text with ngram analyzer)&#10;  meeting → [mee, eet, eti, tin, ing]&#10;body (text with standard analyzer + stemming)&#10;  meetings → meet, tomorrow → tomorrow&#10;snippet (text)&#10;has_attachment (boolean)&#10;folder (keyword) — INBOX/SENT/SPAM&#10;sent_at (date)&#10;&#10;SEARCH QUERY:&#10;User searches: meeting tomorrow&#10;GET /emails/_search&#10;{&#10;  query: {&#10;    bool: {&#10;      must: [&#10;        {match: {subject: meeting tomorrow}},&#10;        {match: {body: meeting tomorrow}}&#10;      ],&#10;      filter: [{term: {user_id: U123}}]&#10;    }&#10;  },&#10;  sort: [{sent_at: desc}]&#10;}&#10;&#10;AUTOCOMPLETE:&#10;User types: meet...&#10;Completion suggester returns:&#10;[meeting, meetings, meet and greet]&#10;&#10;INDEXING FLOW:&#10;Kafka email.indexed topic → Elasticsearch Svc&#10;POST /emails/_doc/{email_id} with full content&#10;Async indexing (not blocking mailbox insert)&#10;&#10;WHY ELASTICSEARCH (NOT SQL LIKE):&#10;SQL LIKE %meeting% = full table scan (minutes)&#10;Elasticsearch inverted index: token → doc IDs (&lt;100ms)&#10;Stemming: meet matches meeting, meetings, meet&#10;ngram: partial match for autocomplete&#10;Fuzzy search: meetng → meeting (typo tolerance)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1800" y="160" width="540" height="440" as="geometry"/></mxCell>

<mxCell id="failureTitle" value="FAILURE SCENARIOS AND RECOVERY STRATEGIES" style="text;html=1;strokeColor=#c62828;fillColor=#ffebee;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="900" width="2280" height="25" as="geometry"/></mxCell>

<mxCell id="fail1" value="FAILURE 1: Outbox Pattern Guarantees Email Survives Crash&#10;&#10;SCENARIO: User sends email → Mail Send Svc inserts outbox → Kafka publish succeeds → server crashes BEFORE commit → email lost&#10;&#10;SOLUTION: Atomic transaction&#10;BEGIN TRANSACTION ISOLATION SERIALIZABLE&#10;  INSERT INTO outbox (email_id, status=PENDING)&#10;  Kafka.send(email.outbound, {emailId, ...})&#10;COMMIT&#10;&#10;Both succeed or both rollback (atomicity)&#10;If commit fails → Kafka message discarded by consumer (no offset commit)&#10;If commit succeeds → email durable in outbox DB + Kafka&#10;&#10;RECOVERY ON RESTART:&#10;SELECT * FROM outbox WHERE status=PENDING ORDER BY created_at&#10;FOR EACH pending_email:&#10;  Kafka.send(email.outbound) — replay from durable queue&#10;  SMTP worker processes → DELETE FROM outbox on success&#10;&#10;RETRY STRATEGY:&#10;Exponential backoff: 1min, 5min, 15min, 40min, max 10 attempts 24hr&#10;Temporary failures (4xx SMTP codes): retry&#10;  421 Service unavailable, 450 Mailbox busy&#10;Permanent failures (5xx codes): stop, bounce notification&#10;  550 User not found, 552 Mailbox full&#10;  UPDATE outbox SET status=FAILED&#10;  INSERT bounce email to sender inbox&#10;Dead Letter Queue after 10 attempts: manual investigation&#10;&#10;IDEMPOTENCY:&#10;Message-ID header: &lt;{email_id}@gmail.com&gt;&#10;Receiver deduplicates: if seen Message-ID → discard duplicate&#10;Prevents same email delivered twice on retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=3;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="60" y="940" width="540" height="440" as="geometry"/></mxCell>

<mxCell id="fail2" value="FAILURE 2: SMTP Worker Crash During Send&#10;&#10;SCENARIO: SMTP worker sends email → EHLO/MAIL FROM/RCPT TO succeed → DATA transmission 50% → worker crashes → email incomplete&#10;&#10;IMPACT:&#10;- Receiver SMTP waits for . (period) end marker → timeout after 5 min&#10;- Email discarded by receiver (incomplete data)&#10;- Outbox still has status=SENDING (not SENT yet)&#10;&#10;RECOVERY:&#10;Outbox monitoring job runs every 1 min:&#10;SELECT * FROM outbox&#10;WHERE status=SENDING AND updated_at &lt; now() - 10min&#10;&#10;Stuck emails (SENDING &gt; 10 min) → retry:&#10;UPDATE outbox SET&#10;  status=PENDING,&#10;  retry_count++,&#10;  scheduled_at = now() + (2^retry_count × 1min)&#10;&#10;Kafka.send(email.outbound) — re-queue for retry&#10;New SMTP worker picks up → retries full send from scratch&#10;&#10;STATELESS WORKERS:&#10;SMTP workers are stateless (no in-memory state)&#10;All state in outbox DB (status, retry_count)&#10;Any worker can resume from any point&#10;Horizontal scaling: add more workers without state migration&#10;&#10;CONNECTION POOLING:&#10;Maintain persistent TCP connections to frequent domains&#10;gmail.com → outlook.com: reuse connection (avoids TLS handshake)&#10;Connection pool size: 100 per SMTP worker&#10;Reduces latency: ~200ms TLS setup saved on reuse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="620" y="940" width="520" height="400" as="geometry"/></mxCell>

<mxCell id="fail3" value="FAILURE 3: Kafka Broker Crash (Partition Leader Lost)&#10;&#10;SCENARIO: Kafka broker hosting email.smtp.normal partition 25 crashes → all emails hashed to partition 25 stuck&#10;&#10;IMMEDIATE IMPACT:&#10;- SMTP workers cannot consume from partition 25&#10;- Emails in that partition queue up (backlog grows)&#10;- Other partitions (0-24, 26-49) continue processing normally&#10;&#10;AUTOMATIC RECOVERY:&#10;1. Kafka controller detects leader failure (heartbeat timeout 3s)&#10;2. Elects new leader from ISR (in-sync replicas)&#10;   Partition 25 leadership: Broker 3 (crashed) → Broker 5 (new leader)&#10;   Election time: ~5 seconds&#10;3. SMTP workers reconnect to new leader partition&#10;   Resume from last committed offset (no message loss)&#10;4. Process backlog: 1000 messages queued during 5s downtime&#10;   100 workers drain backlog in ~10s&#10;&#10;DATA CONSISTENCY:&#10;Kafka RF=3 (replication factor): each message on 3 brokers&#10;Even if 2 brokers crash, 1 replica survives → zero data loss&#10;min.insync.replicas=2: producer waits for 2 acks before success&#10;Guarantees: at-least-once delivery, no message lost on broker crash&#10;&#10;MONITORING:&#10;Alert if partition lag &gt; 1000 messages (backlog growing)&#10;Alert if ISR count &lt; 2 (replica falling behind)&#10;Auto-scaling: add more SMTP workers if sustained high lag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1160" y="940" width="520" height="380" as="geometry"/></mxCell>

<mxCell id="fail4" value="FAILURE 4: PostgreSQL Master Failover&#10;&#10;SCENARIO: PostgreSQL master crashes → all write operations fail (outbox insert, mailbox insert)&#10;&#10;TOPOLOGY:&#10;1 master (writes: INSERT outbox, INSERT mailbox_items)&#10;10 read replicas (reads: folder listing, search, thread view)&#10;Replication lag: &lt;1s (synchronous replication to 2 replicas)&#10;&#10;FAILOVER PROCESS:&#10;1. Health check detects master down (TCP timeout 5s)&#10;2. Promote read replica to new master (automated via RDS)&#10;   Failover time: ~30 seconds&#10;3. Update DNS: write endpoint points to new master&#10;4. Application reconnects to new master&#10;   Connection pool refreshes in ~10s&#10;&#10;DATA LOSS RISK:&#10;Asynchronous replication: last 1s of writes may be lost&#10;Synchronous replication to 2 replicas: zero data loss&#10;  Master waits for 2 replicas ACK before COMMIT success&#10;  Slower writes (+5ms latency) but guaranteed durability&#10;&#10;IMPACT ON EMAIL SEND:&#10;During 30s failover window:&#10;- Mail Send Svc cannot INSERT outbox → returns 503 Service Unavailable&#10;- User retries send after 30s → succeeds on new master&#10;- Emails in Kafka email.outbound buffer during failover&#10;  SMTP workers retry consuming → success after failover&#10;&#10;READ REPLICAS:&#10;Folder listing, search, thread view continue on replicas (no downtime)&#10;Only writes affected during failover&#10;95% of traffic reads → minimal user impact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1700" y="940" width="640" height="420" as="geometry"/></mxCell>

<mxCell id="fail5" value="FAILURE 5: Elasticsearch Indexing Lag&#10;&#10;SCENARIO: Kafka email.indexed topic backlog 10K messages → Elasticsearch Svc cannot keep up → search results stale&#10;&#10;IMPACT:&#10;- User sends email at 10:00 AM → Kafka email.indexed at 10:00:05&#10;- Elasticsearch Svc processes at 10:05 AM (5 min lag)&#10;- User searches for that email at 10:02 AM → not found (not indexed yet)&#10;&#10;VISIBLE TO USER:&#10;- Recent emails missing from search results (5 min delay)&#10;- Folder listing works fine (reads from PostgreSQL mailbox_items)&#10;- Once indexed, search works normally&#10;&#10;ROOT CAUSE:&#10;- Email spike: 1M emails/min during peak hours&#10;- Elasticsearch cluster overloaded (CPU 90%, indexing slow)&#10;&#10;RECOVERY:&#10;1. Horizontal scaling: add more Elasticsearch nodes&#10;   10 shards distributed across 20 nodes (double capacity)&#10;2. Indexing batching: group 100 emails per bulk index request&#10;   Reduces network overhead 100×&#10;3. Priority indexing: HIGH priority emails indexed first&#10;   Bulk emails indexed during off-peak (low priority queue)&#10;4. Catch-up: process backlog at 10K emails/sec&#10;   10K messages drain in ~10 minutes&#10;&#10;FALLBACK:&#10;If Elasticsearch down: search falls back to PostgreSQL ILIKE&#10;SELECT * FROM mailbox_items&#10;WHERE user_id=? AND (subject ILIKE %meeting% OR body ILIKE %meeting%)&#10;ORDER BY received_at DESC LIMIT 20&#10;Slower (5 seconds vs 100ms) but functional&#10;&#10;MONITORING:&#10;Alert if Kafka email.indexed lag &gt; 1000 messages&#10;Alert if Elasticsearch indexing rate &lt; 1000/sec (slow)&#10;Auto-scale Elasticsearch cluster if CPU &gt; 80% sustained 5 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="60" y="1400" width="640" height="420" as="geometry"/></mxCell>

<mxCell id="fail6" value="FAILURE 6: S3 Attachment Upload Failure&#10;&#10;SCENARIO: User uploads 25MB attachment → network timeout at 80% (20MB uploaded) → upload fails&#10;&#10;CLIENT-SIDE RETRY:&#10;Multipart upload: split 25MB into 5MB chunks&#10;Upload each chunk independently (5 PUT requests)&#10;If chunk 4 fails → retry only chunk 4 (not full 25MB)&#10;S3 reassembles chunks on complete (CompleteMultipartUpload API)&#10;&#10;PRESIGNED URL EXPIRY:&#10;Presigned PUT URL expires after 1 hour&#10;If upload takes &gt; 1hr → 403 Forbidden&#10;Client requests new presigned URL from Compose Svc&#10;Resume upload with new URL (S3 supports resume via Range header)&#10;&#10;VIRUS SCAN QUARANTINE:&#10;Upload succeeds → ClamAV virus scan detects malware&#10;DELETE s3://email-attachments/{user_id}/{email_id}/infected.exe&#10;UPDATE attachments SET virus_scan_status=INFECTED&#10;Notify user: Your attachment infected.exe was removed (virus detected)&#10;Email send proceeds without attachment (or blocked entirely if policy)&#10;&#10;S3 EVENTUAL CONSISTENCY:&#10;PUT s3://.../file.pdf succeeds → immediate read may 404 Not Found&#10;S3 eventually consistent for overwrite PUT (rare)&#10;S3 strong consistency for new PUT (2020+) → no 404 race&#10;&#10;LIFECYCLE POLICIES:&#10;Transition to Glacier after 1 year (save 90% cost):&#10;  s3://email-attachments/{user_id}/ → Glacier after 365 days&#10;Delete from Glacier after 7 years (compliance retention)&#10;Restore from Glacier: 3-5 hours (user requests old attachment)&#10;  Compose Svc: initiate Glacier restore → notify when ready&#10;&#10;DURABILITY:&#10;S3: 11 nines durability (99.999999999%)&#10;Expected loss: 1 file per 10M years (never lose attachments)&#10;Cross-region replication: replicate to second region for disaster recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="720" y="1400" width="620" height="440" as="geometry"/></mxCell>

<mxCell id="scaleNote" value="SCALE SUMMARY: 1.8B users, billions of emails/day, petabytes S3 storage, millions emails/min peak, 100 Kafka partitions email.outbound, 50/100/20 SMTP workers high/normal/low priority, 1 PostgreSQL master + 10 read replicas per shard (10 shards total = 110 DB instances), 10 shards Elasticsearch, Kafka 10 brokers RF=3, ~$2M/month AWS cost (RDS Multi-AZ, S3 Standard+Glacier, ElastiCache Redis, MSK Kafka, EC2 SMTP workers c5.xlarge × 170, Elasticsearch 20-node cluster)" style="text;html=1;strokeColor=#1976d2;fillColor=#e3f2fd;align=center;fontSize=11;rounded=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="1860" width="2280" height="60" as="geometry"/></mxCell>

</root></mxGraphModel></diagram></mxfile>
