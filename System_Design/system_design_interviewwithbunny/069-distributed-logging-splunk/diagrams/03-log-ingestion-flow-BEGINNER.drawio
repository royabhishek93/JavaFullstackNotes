<mxfile host="app.diagrams.net"><diagram name="Log Ingestion Flow" id="log-flow"><mxGraphModel dx="1900" dy="1500" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1900" pageHeight="1500" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="DISTRIBUTED LOGGING - Log Ingestion Flow (Agent → Kafka → Flink → Cassandra + ES)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="80" y="20" width="1740" height="35" as="geometry"/></mxCell>
<mxCell id="subtitle" value="At-least-once delivery with deduplication: Agent retries → Kafka buffering → Flink watermark processing → Dual-write Cassandra + ES → Query routing hot/warm/cold" style="text;html=1;strokeColor=none;fillColor=#e8eaf6;align=center;rounded=1;fontSize=13" vertex="1" parent="1"><mxGeometry x="150" y="65" width="1600" height="28" as="geometry"/></mxCell>

<mxCell id="c1" value="FluentBit Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="120" width="180" height="50" as="geometry"/></mxCell>
<mxCell id="c2" value="Ingestion Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="280" y="120" width="180" height="50" as="geometry"/></mxCell>
<mxCell id="c3" value="Kafka (raw_logs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="500" y="120" width="180" height="50" as="geometry"/></mxCell>
<mxCell id="c4" value="Apache Flink" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="720" y="120" width="160" height="50" as="geometry"/></mxCell>
<mxCell id="c5" value="Cassandra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="920" y="120" width="160" height="50" as="geometry"/></mxCell>
<mxCell id="c6" value="Elasticsearch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1120" y="120" width="160" height="50" as="geometry"/></mxCell>
<mxCell id="c7" value="Alert Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1320" y="120" width="160" height="50" as="geometry"/></mxCell>

<mxCell id="phase1" value="PHASE 1: Agent Local Buffering + Batching (~10s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#1976d2;strokeWidth=2;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingTop=5;spacingLeft=10" vertex="1" parent="1"><mxGeometry x="40" y="190" width="1820" height="160" as="geometry"/></mxCell>

<mxCell id="s1" value="1. App writes to stdout: ERROR - Payment failed user_id=42" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;spacing=5" vertex="1" parent="1"><mxGeometry x="60" y="220" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="s2" value="2. FluentBit tails stdout → buffer in memory (up to 100 logs OR 10s)&#10;   Add metadata: timestamp, hostname, k8s_pod, k8s_namespace&#10;   Sample: DEBUG 10%, INFO 50%, ERROR 100%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;spacing=5" vertex="1" parent="1"><mxGeometry x="60" y="260" width="500" height="60" as="geometry"/></mxCell>

<mxCell id="note1" value="NOTE: Agent local buffer = 10MB disk. If network fails, retry with exponential backoff for 24h. This prevents log loss during transient network issues. If 24h expires, logs written to local.log file for manual recovery." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=10;align=left;spacing=5" vertex="1" parent="1"><mxGeometry x="600" y="220" width="600" height="60" as="geometry"/></mxCell>

<mxCell id="phase2" value="PHASE 2: HTTP POST + Kafka Publish (~100ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingTop=5;spacingLeft=10" vertex="1" parent="1"><mxGeometry x="40" y="370" width="1820" height="200" as="geometry"/></mxCell>

<mxCell id="s3" value="3. POST /agents/agent123/logs&#10;   Body: [{timestamp, level, message, service, metadata}, ...] (batch of 100)&#10;   Headers: Authorization: Bearer JWT_TOKEN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#1976d2;endArrow=classic;endFill=1;fontSize=10" edge="1" parent="1" source="c1" target="c2"><mxGeometry x="-0.2" y="30" relative="1" as="geometry"><mxGeometry as="offset"/></mxGeometry></mxCell>
<mxCell id="s4" value="4. Validate JWT, rate limit check (10K logs/min per client)&#10;   Validate schema (required: timestamp, level, message, service)&#10;   Enrich: client_id from JWT, ingest_timestamp=now()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;spacing=5" vertex="1" parent="1"><mxGeometry x="270" y="420" width="450" height="60" as="geometry"/></mxCell>

<mxCell id="s5" value="5. Publish to Kafka: topic=raw_logs, key=client_id, acks=all" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#f57f17;endArrow=classic;endFill=1;fontSize=10" edge="1" parent="1" source="c2" target="c3"><mxGeometry y="20" relative="1" as="geometry"><mxGeometry as="offset"/></mxGeometry></mxCell>
<mxCell id="s6" value="6. Kafka acks (RF=3, min.insync.replicas=2 must ack)&#10;   Total: ~100ms (network + 2 replica acks)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#388e3c;endArrow=classic;endFill=1;dashed=1;fontSize=10" edge="1" parent="1" source="c3" target="c2"><mxGeometry y="-25" relative="1" as="geometry"><mxGeometry as="offset"/></mxGeometry></mxCell>
<mxCell id="s7" value="7. Return 202 Accepted (request_id)&#10;   Agent immediately starts next batch (async)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#388e3c;endArrow=classic;endFill=1;dashed=1;fontSize=10" edge="1" parent="1" source="c2" target="c1"><mxGeometry y="-20" relative="1" as="geometry"><mxGeometry as="offset"/></mxGeometry></mxCell>

<mxCell id="note2" value="NOTE: Return 202 immediately after Kafka ack (100ms). Do NOT wait for Flink processing or ES indexing (would add 500ms latency). Agent does not block — it submits next batch while Kafka/Flink process previous batch async." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=10;align=left;spacing=5" vertex="1" parent="1"><mxGeometry x="750" y="400" width="600" height="60" as="geometry"/></mxCell>

<mxCell id="phase3" value="PHASE 3: Flink Stream Processing (~500ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#f57f17;strokeWidth=2;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingTop=5;spacingLeft=10" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1820" height="240" as="geometry"/></mxCell>

<mxCell id="s8" value="8. Flink consumes from Kafka (consumer group, 32 parallel tasks)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#f57f17;endArrow=classic;endFill=1;fontSize=10" edge="1" parent="1" source="c3" target="c4"><mxGeometry y="25" relative="1" as="geometry"><mxGeometry as="offset"/></mxGeometry></mxCell>
<mxCell id="s9" value="9. Flink processing pipeline:&#10;   a) Validate schema → DLQ if malformed&#10;   b) Parse + Normalize (syslog/JSON/custom → standard)&#10;   c) Enrich (geo lookup from IP, K8s pod metadata)&#10;   d) Dedup: hash = (ts_minute + service + msg[0:100])&#10;      If hash in RocksDB state → drop; else → emit + save hash&#10;   e) Watermark: event-time - 5 min (accept logs up to 10 min late)&#10;   f) Checkpoint state to S3 every 60s (exactly-once recovery)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;spacing=5" vertex="1" parent="1"><mxGeometry x="60" y="650" width="640" height="150" as="geometry"/></mxCell>

<mxCell id="note3" value="NOTE: Watermark handling crucial for correct alerting. Example: Log from 3:04 PM arrives at 3:07 PM due to network delay. Watermark = 3:07 - 5 min = 3:02. Since log event-time (3:04) &gt; watermark (3:02), it is included in the 3:00-3:05 window. Without watermark, it would land in wrong window → alert window (ERROR count &gt; 100 in 5 min) would miscount. Extremely late logs (10+ min) → DLQ for manual investigation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#f57f17;strokeWidth=2;fontSize=10;align=left;spacing=5" vertex="1" parent="1"><mxGeometry x="740" y="630" width="620" height="100" as="geometry"/></mxCell>

<mxCell id="phase4" value="PHASE 4: Dual-Write Cassandra + Elasticsearch + Alert (~200ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingTop=5;spacingLeft=10" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1820" height="180" as="geometry"/></mxCell>

<mxCell id="s10" value="10. Write to Cassandra:&#10;    INSERT INTO logs_by_service (service_name, log_date, timestamp, log_id, ...)&#10;    VALUES (payment_service, 2024-01-15, 3:04:17 PM, uuid(), ...)&#10;    USING TTL 1209600; -- 14 days auto-delete&#10;    Consistency: QUORUM (2 of 3 replicas ack)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#7b1fa2;endArrow=classic;endFill=1;fontSize=10" edge="1" parent="1" source="c4" target="c5"><mxGeometry y="50" relative="1" as="geometry"><mxGeometry as="offset"/></mxGeometry></mxCell>
<mxCell id="s11" value="11. Bulk index to Elasticsearch (5K log batch):&#10;    POST _bulk { index: logs-2024-01-15, ... }&#10;    ILM policy: rollover daily, move to warm after 14d" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#f57f17;endArrow=classic;endFill=1;fontSize=10" edge="1" parent="1" source="c4" target="c6"><mxGeometry y="50" relative="1" as="geometry"><mxGeometry as="offset"/></mxGeometry></mxCell>
<mxCell id="s12" value="12. If log matches alert rule:&#10;    Publish to alert_topic (ERROR count &gt; threshold)&#10;    Alert Service consumes → apply cooldown → PagerDuty" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#388e3c;dashed=1;endArrow=classic;endFill=1;fontSize=10" edge="1" parent="1" source="c4" target="c7"><mxGeometry y="45" relative="1" as="geometry"><mxGeometry as="offset"/></mxGeometry></mxCell>

<mxCell id="note4" value="NOTE: Dual-write is NOT transactional (no 2PC). Cassandra write may succeed while ES write fails. This is acceptable (eventual consistency). ES failure → Flink retries via es_retry Kafka topic. Cassandra is source of truth; ES is search index (can be rebuilt from Cassandra if needed). Total Cassandra+ES write: ~200ms. Alert is async (Kafka topic) to avoid blocking main pipeline." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=left;spacing=5" vertex="1" parent="1"><mxGeometry x="60" y="940" width="900" height="70" as="geometry"/></mxCell>

<mxCell id="phase5" value="PHASE 5: Query Routing (Hot/Warm/Cold Tiers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingTop=5;spacingLeft=10" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="1820" height="160" as="geometry"/></mxCell>

<mxCell id="s13" value="13. User query: Search logs for payment_service, ERROR level, last 7 days&#10;    Query range = 0-7 days → Hot tier&#10;    Search Service → Elasticsearch DSL query&#10;    Response: sub-200ms, top 100 results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;spacing=5" vertex="1" parent="1"><mxGeometry x="60" y="1090" width="550" height="80" as="geometry"/></mxCell>
<mxCell id="s14" value="14. If query range = 14-30 days → Warm tier&#10;    Search Service → Cassandra CQL query&#10;    SELECT * FROM logs_by_service&#10;    WHERE service_name=payment_service AND log_date BETWEEN ...&#10;    Response: 1-2s (HDD slower than SSD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;spacing=5" vertex="1" parent="1"><mxGeometry x="650" y="1090" width="550" height="80" as="geometry"/></mxCell>
<mxCell id="s15" value="15. If query range = 60 days → Cold tier&#10;    Search Service → S3 Athena query&#10;    SELECT * FROM logs_parquet WHERE year=2024 AND month=01&#10;    Parquet partitioned by year/month/day/service&#10;    Response: 10-30s (scan S3 objects)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;spacing=5" vertex="1" parent="1"><mxGeometry x="1240" y="1090" width="550" height="80" as="geometry"/></mxCell>

<mxCell id="key" value="INTERVIEW KEY&#10;&#10;✅ Async: Agent POST returns 202 Accepted immediately (100ms). Flink processing happens async (~500ms). User query is sync (waits for ES response, sub-200ms for hot).&#10;✅ At-least-once delivery: Agent retries on failure (network, timeout). Kafka RF=3 ensures durability. Flink checkpoints every 60s to S3 (exactly-once recovery). Cassandra RF=3, QUORUM writes. Result: no data loss even if nodes fail.&#10;✅ Deduplication: Agents retry → duplicates. Flink deduplicates using 5-min tumbling window + hash(timestamp_minute + service + message[0:100]). Catches 99% of duplicates. State stored in RocksDB (local disk). Cross-window duplicates not detected (acceptable trade-off).&#10;✅ Watermark handling: Logs arrive out-of-order. Watermark = event-time - 5 min. Flink waits 5 min before closing window. Logs up to 10 min late → included in correct window. Extremely late → DLQ. Critical for alert accuracy (ERROR count &gt; 100 in 5 min).&#10;✅ Tiered storage routing: Hot (0-14d): ES → 200ms. Warm (14-45d): Cassandra → 1-2s. Cold (45+d): S3 Athena → 10-30s. Search Service auto-routes based on time range. Cross-tier queries fan-out in parallel + merge results." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="60" y="1240" width="1800" height="150" as="geometry"/></mxCell>

<mxCell id="analogy" value="BEGINNER ANALOGY: Ingesting logs is like processing mail at a post office. The postal truck (FluentBit agent) collects mail from 100 houses and delivers a batch to the sorting center (Kafka buffer). The sorting center holds mail safely even if the warehouse is closed (buffer during outages). The sorting machine (Flink) validates addresses, removes duplicates (same letter sent twice due to confusion), and handles late arrivals (yesterday's mail found under the truck seat). Sorted mail is filed in the hot cabinet (Cassandra SSD + Elasticsearch for recent letters, instant lookup) and eventually moved to the warm archive room (HDD, slower) and cold basement storage (S3, very slow but cheap). When you ask for a letter, the clerk checks the hot cabinet first (sub-200ms), then warm room (1-2s), then basement (10-30s) depending on how old the letter is." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0277bd;strokeWidth=2;fontSize=11;align=left;verticalAlign=middle;spacing=10" vertex="1" parent="1"><mxGeometry x="60" y="1420" width="1800" height="90" as="geometry"/></mxCell>

</root></mxGraphModel></diagram></mxfile>
