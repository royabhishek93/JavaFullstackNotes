<mxCell id="es" value="ELASTICSEARCH&#10;&#10;Full-text search&#10;Inverted index&#10;Aggregations&#10;ILM (14-day hot)&#10;Sub-200ms queries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="1380" y="380" width="200" height="155" as="geometry"/></mxCell>
<mxCell id="es-edge" value="Search layer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#7b1fa2;endArrow=classic;endFill=1;startArrow=classic;startFill=1;fontSize=10" edge="1" parent="1" source="boundary" target="es"><mxGeometry relative="1" as="geometry"/></mxCell>

<mxCell id="devops" value="DEVOPS ENGINEERS&#10;&#10;Search logs&#10;Real-time tail&#10;Create alerts&#10;Export for audit&#10;Investigate incidents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="50" y="450" width="200" height="145" as="geometry"/></mxCell>
<mxCell id="devops-edge" value="Query API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#388e3c;dashed=1;endArrow=classic;endFill=1;fontSize=10" edge="1" parent="1" source="devops" target="boundary"><mxGeometry relative="1" as="geometry"/></mxCell>

<mxCell id="s3" value="S3 COLD STORAGE&#10;&#10;Parquet format&#10;Snappy compression&#10;45+ day logs&#10;Athena queries&#10;$0.01/GB/month" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="1380" y="580" width="200" height="145" as="geometry"/></mxCell>
<mxCell id="s3-edge" value="Cold archival" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#c62828;dashed=1;endArrow=classic;endFill=1;fontSize=10" edge="1" parent="1" source="boundary" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>

<mxCell id="analogy" value="BEGINNER ANALOGY: The platform is a postal sorting facility. Apps (houses) drop mail (logs) in mailboxes (FluentBit agent). The postal truck (agent) picks up batches and delivers to the sorting center (Kafka buffer) — even if the warehouse is closed, mail is held safely. The sorting machine (Flink) validates addresses, removes duplicates, and routes letters. Fresh mail (0-14 days) goes to the hot file cabinet (Cassandra SSD + Elasticsearch, fast search). Older mail (14-45 days) moves to the warm archive room (Cassandra HDD, slower but cheaper). Ancient mail (45+ days) goes to the basement cold storage (S3, very cheap but slow to retrieve). DevOps engineers can search any letter instantly using the card catalog (Elasticsearch inverted index) or request old archives from the basement (Athena S3 queries)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0277bd;strokeWidth=2;fontSize=11;align=left;verticalAlign=middle;spacing=10" vertex="1" parent="1"><mxGeometry x="50" y="840" width="1530" height="95" as="geometry"/></mxCell>

</root></mxGraphModel></diagram></mxfile>
