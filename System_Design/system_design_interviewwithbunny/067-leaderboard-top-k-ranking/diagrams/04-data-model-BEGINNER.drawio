<mxfile host="app.diagrams.net"><diagram name="Data Model" id="leaderboard-data"><mxGraphModel dx="1800" dy="1150" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1150" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="TOP-K LEADERBOARD - Data Model (Redis ZSET Keys, Kafka Topics, DB Schema, Trending Formula)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=22;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1700" height="35" as="geometry"/></mxCell>

<mxCell id="redisSection" value="REDIS ZSET KEY PATTERNS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1720" height="220" as="geometry"/></mxCell>

<mxCell id="global" value="GLOBAL LEADERBOARDS\n\nleaderboard:global:alltime\nZADD score member\nNo TTL (permanent)\n\nExample:\n  ZINCRBY leaderboard:global:alltime 1 V123\n  ZREVRANGE ... 0 9 WITHSCORES\n  → top-10 all-time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="70" y="120" width="280" height="150" as="geometry"/></mxCell>

<mxCell id="windowed" value="TIME-WINDOWED KEYS\n\nleaderboard:global:daily:YYYY-MM-DD\nTTL: 7 days\n\nleaderboard:global:weekly:YYYY-WWW\nTTL: 90 days\n\nleaderboard:global:monthly:YYYY-MM\nTTL: 365 days\n\nAuto-expire old windows\nNo cleanup jobs needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="380" y="120" width="320" height="150" as="geometry"/></mxCell>

<mxCell id="multidim" value="MULTI-DIMENSIONAL KEYS\n\nleaderboard:{region}:alltime\nExample: leaderboard:US:alltime\n\nleaderboard:{category}:alltime\nExample: leaderboard:music:alltime\n\nleaderboard:{category}:{region}:alltime\nExample: leaderboard:music:US:alltime\n\nleaderboard:{category}:{region}:daily:DATE\nExample: leaderboard:music:IN:daily:2026-01-25" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="730" y="120" width="380" height="150" as="geometry"/></mxCell>

<mxCell id="trending" value="TRENDING KEYS\n\nleaderboard:trending\nTTL: 2 hours (safety net)\n\nRecomputed hourly by batch job\nTime-decay formula:\ntrending_score = engagement /\n  (age_hours + 2)^1.8\n\nContains only last 7 days\nZREMRANGEBYSCORE clears\nlow-score entries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=3;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1140" y="120" width="290" height="150" as="geometry"/></mxCell>

<mxCell id="dedupSection" value="REDIS DEDUP KEYS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="320" width="540" height="120" as="geometry"/></mxCell>

<mxCell id="dedup" value="view_dedup:{user_id}:{entity_id}\nValue: 1\nTTL: 300 seconds (5 minutes)\n\nPurpose: Prevent same user from inflating view count\nwithin 5-minute window. Second view within window\nreturns 200 OK but skips Kafka publish.\n\nCommands:\n  GET view_dedup:U456:V123 → exists? skip\n  SET view_dedup:U456:V123 1 EX 300" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="70" y="360" width="480" height="60" as="geometry"/></mxCell>

<mxCell id="kafkaSection" value="KAFKA TOPICS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="610" y="320" width="1150" height="120" as="geometry"/></mxCell>

<mxCell id="kafkaTopic" value="score.updated\nPartitions: 100 (for throughput)\nPartition key: hash(entity_id) → ensures ordering per entity\nRetention: 7 days (for Kafka replay after Redis crash)\n\nMessage schema:\n{\n  event_id: UUID,\n  entity_id: string (video_id / player_id / song_id),\n  score_delta: int (+1 view, +10 like),\n  timestamp: ISO8601,\n  region: string ('US', 'IN', ...),\n  category: string ('music', 'gaming', ...),\n  metadata: { user_id, device_type, ... }\n}\n\nConsumer groups:\n  redis-consumer (updates Redis ZSET, ~100ms lag)\n  db-consumer (persists to Score DB, ~1s lag)\n  analytics-consumer (writes to InfluxDB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="640" y="360" width="1090" height="60" as="geometry"/></mxCell>

<mxCell id="dbSection" value="SCORE DB SCHEMA (Spanner / Cassandra / BigQuery)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="460" width="1720" height="200" as="geometry"/></mxCell>

<mxCell id="scoresTable" value="scores TABLE (persistent source of truth)\n\nPK: score_id UUID\nentity_id VARCHAR(100)  ← video_id / player_id / song_id\nscore_delta INT  ← +1 view, +10 like\nleaderboard_id VARCHAR(100)  ← 'global', 'US', 'music:US'\nregion VARCHAR(10)  ← 'US', 'IN', 'EU', ...\ncategory VARCHAR(50)  ← 'music', 'gaming', 'sports', ...\ntimestamp TIMESTAMPTZ  ← event time\nmetadata JSONB  ← user_id, device_type, etc.\n\nINDEXES:\n  (leaderboard_id, timestamp)  ← for time-windowed queries\n  (entity_id)  ← for entity lookup\n\nSHARDING: hash(entity_id) mod 10 → 10 shards\nPARTITIONING: monthly partitions by timestamp\n  → scores_2026_01, scores_2026_02, ...\n  → old partitions archived to cold storage after 1 year\n\nDB Consumer writes (~1s eventual lag)\nFallback reads only (rare, Redis miss)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=3;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="70" y="500" width="800" height="130" as="geometry"/></mxCell>

<mxCell id="aggregatedTable" value="aggregated_scores TABLE (optional: batch approach)\n\nPK: entity_id VARCHAR(100)\ntotal_score BIGINT  ← sum(score_delta) all-time\ndaily_score BIGINT  ← sum for today, reset daily\nweekly_score BIGINT  ← sum for this week\nmonthly_score BIGINT  ← sum for this month\nlast_updated TIMESTAMP\n\nBatch job (cron 2 AM) computes from scores table:\n  SELECT entity_id, SUM(score_delta)\n  FROM scores\n  WHERE timestamp >= '2026-01-01'\n  GROUP BY entity_id\n  ORDER BY SUM DESC LIMIT 1000\n\nWritten to aggregated_scores\nCached in Redis for fast reads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="910" y="500" width="490" height="130" as="geometry"/></mxCell>

<mxCell id="influxSection" value="INFLUXDB SCHEMA (Time-Series Analytics)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="680" width="1720" height="140" as="geometry"/></mxCell>

<mxCell id="influx" value="MEASUREMENT: entity_scores\n\nTags (indexed, low cardinality):  entity_id, region, category\nFields (not indexed, high cardinality):  views_count INT, likes_count INT, score FLOAT\nTimestamp: nanosecond precision\n\nRetention policy:\n  1-minute raw data: 7 days\n  1-hour aggregated data: 90 days\n  1-day aggregated data: forever\n\nContinuous query (auto-downsampling):\n  CREATE CONTINUOUS QUERY cq_hourly ON leaderboard BEGIN\n    SELECT SUM(views_count) AS views_sum\n    INTO entity_scores_hourly\n    FROM entity_scores\n    GROUP BY time(1h), entity_id, region, category\n  END\n\nQuery example (top-K last 24h):\n  SELECT SUM(views_count) FROM entity_scores\n  WHERE time > now() - 24h AND region = 'US'\n  GROUP BY entity_id\n  ORDER BY SUM DESC\n  LIMIT 10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="70" y="720" width="1660" height="80" as="geometry"/></mxCell>

<mxCell id="trendingSection" value="TRENDING FORMULA + KEY OPERATIONS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="840" width="1720" height="160" as="geometry"/></mxCell>

<mxCell id="trendingFormula" value="TIME-DECAY FORMULA (Hacker News-style)\n\ntrending_score = engagement_score / (age_in_hours + 2)^1.8\n\nengagement_score = views + (likes × 10) + (comments × 20) + (shares × 30)\n\nExample:\n  Video A: 10M views, 7 days old (168 hours)\n    score = 10,000,000 / (168 + 2)^1.8 ≈ 13,895\n  Video B: 500K views, 3 hours old\n    score = 500,000 / (3 + 2)^1.8 ≈ 95,763\n  → Video B ranks HIGHER on trending (recent momentum)\n\nBatch job (cron hourly):\n  1. Query last 7 days from scores DB\n  2. Compute trending_score for each entity\n  3. DEL leaderboard:trending\n  4. ZADD leaderboard:trending {score} {entity_id} (top 1000 only)\n  5. EXPIRE leaderboard:trending 7200 (2h TTL safety net)\n  6. ZREMRANGEBYSCORE leaderboard:trending -inf {threshold}\n     → evict low-score entries to save memory\n\nIncremental optimization:\n  Instead of full recompute, process only entities with new events\n  in last hour (consume Kafka stream)\n  Reduces compute from O(millions) → O(new events)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=3;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="70" y="880" width="800" height="100" as="geometry"/></mxCell>

<mxCell id="keyOps" value="REDIS ZSET KEY OPERATIONS SUMMARY\n\nZINCRBY leaderboard:key score member\n  → Atomic increment (thread-safe, no race)\n  → O(log N)\n\nZREVRANGE leaderboard:key start stop WITHSCORES\n  → Top-K from pre-sorted skip list\n  → O(log N + K), &lt;1ms for K=10 even with 10M members\n\nZREVRANK leaderboard:key member\n  → Get member's rank (0-indexed from top)\n  → O(log N)\n\nZSCORE leaderboard:key member\n  → Get member's score\n  → O(1)\n\nZCARD leaderboard:key\n  → Total member count\n  → O(1)\n\nZUNIONSTORE dest numkeys key1 key2 ... WEIGHTS ...\n  → Merge multiple ZSETs (e.g., weekly from 7 daily)\n  → O(N) where N = total members across all keys\n\nZREMRANGEBYSCORE key min max\n  → Remove members with score in range\n  → Used to prune low-score entries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="910" y="880" width="490" height="100" as="geometry"/></mxCell>

<mxCell id="whySection" value="WHY THIS DATA MODEL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="1720" height="100" as="geometry"/></mxCell>

<mxCell id="why" value="Kafka as source of truth: If Redis crashes, replay Kafka from offset 0 to rebuild all ZSETs. 7-day retention allows full rebuild even if crash goes undetected for days.\n\nTime-windowed keys with TTL: Separate ZSET per window (daily, weekly, monthly, all-time). TTL auto-expires old keys so no cleanup jobs needed. Alternative (compute windows on read) requires scanning millions of rows per query.\n\nMulti-dimensional key explosion: 5 regions × 10 categories × 4 time windows = 200 keys. Fix: lazy init (create on first write), EXPIRE unused keys after 30 days, separate Redis cluster per region.\n\nDedup with Redis TTL: Prevents fraudulent inflation. Second view within 5 min returns 200 OK but skips Kafka. TTL auto-expires so legitimate repeat views after 5 min are counted.\n\nTrending time-decay: Recent items with moderate engagement beat old items with massive engagement. Batch recompute hourly for last 7 days only (not all entities). Incremental approach processes only new events.\n\nScore DB partitioning: Monthly partitions by timestamp (scores_2026_01, scores_2026_02). Old partitions archived to cold storage. Shard by entity_id hash for write throughput.\n\nInfluxDB continuous queries: Auto-downsamples 1-min data to 1-hour rollups to 1-day rollups. Keeps memory footprint constant while preserving historical trends." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="70" y="1060" width="1660" height="40" as="geometry"/></mxCell>

</root></mxGraphModel></diagram></mxfile>