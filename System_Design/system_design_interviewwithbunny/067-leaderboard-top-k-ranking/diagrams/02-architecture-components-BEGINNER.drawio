<mxfile host="app.diagrams.net"><diagram name="Architecture Components" id="leaderboard-architecture"><mxGraphModel dx="1900" dy="1150" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="TOP-K LEADERBOARD - Architecture Components (Hybrid: Redis + Kafka + DB)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=22;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="80" y="20" width="1740" height="35" as="geometry"/></mxCell>
<mxCell id="clientLayer" value="CLIENT LAYER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1820" height="110" as="geometry"/></mxCell>
<mxCell id="apps" value="Game Apps | Web Dashboards | Mobile Apps\n\nSubmit scores/views/likes (POST /api/v1/scores)\nQuery top-K (GET /api/v1/leaderboards/{id}/top)\nCheck personal rank (GET /rank/{entity_id})\nWebSocket for live rank updates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="240" y="120" width="560" height="60" as="geometry"/></mxCell>
<mxCell id="gatewayLayer" value="EDGE LAYER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="220" width="1820" height="90" as="geometry"/></mxCell>
<mxCell id="gateway" value="LOAD BALANCER + API GATEWAY\nJWT authentication | rate limiting | geo-routing | WebSocket upgrade" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcc80;strokeColor=#ef6c00;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=10" vertex="1" parent="1"><mxGeometry x="240" y="250" width="900" height="40" as="geometry"/></mxCell>
<mxCell id="serviceLayer" value="SERVICE LAYER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="330" width="1820" height="200" as="geometry"/></mxCell>
<mxCell id="scoreSvc" value="Score Service\n\nValidate entity exists\nDedup check (Redis)\nPublish to Kafka\nReturn 200 OK (async)\nFraud detection hooks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=3;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="70" y="380" width="200" height="120" as="geometry"/></mxCell>
<mxCell id="rankingSvc" value="Ranking Service\n\nRead from Redis ZSET\nFallback to DB on miss\nQuery top-K\nLookup rank by entity\nNearby ranks (range)\nWebSocket push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=3;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="310" y="380" width="210" height="120" as="geometry"/></mxCell>
<mxCell id="redisConsumer" value="Redis Consumer\n(Kafka → Redis)\n\nConsume score.updated\nZINCRBY leaderboard key\nUpdate all time windows\n(daily, weekly, monthly)\nCommit offset on success" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="560" y="380" width="220" height="120" as="geometry"/></mxCell>
<mxCell id="dbConsumer" value="DB Consumer\n(Kafka → Score DB)\n\nConsume score.updated\nINSERT into scores table\nBatch write (10k/sec)\nShard by entity_id hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="820" y="380" width="200" height="120" as="geometry"/></mxCell>
<mxCell id="analyticsConsumer" value="Analytics Consumer\n(Kafka → InfluxDB)\n\nConsume score.updated\nAggregate to time buckets\nWrite to InfluxDB\nContinuous queries\nfor downsampling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1060" y="380" width="210" height="120" as="geometry"/></mxCell>
<mxCell id="trendingJob" value="Trending Batch Job\n(Cron hourly)\n\nQuery last 7 days from DB\nCompute time-decay score\nZADD to trending ZSET\nEXPIRE old keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1310" y="380" width="200" height="120" as="geometry"/></mxCell>
<mxCell id="dataLayer" value="DATA + INFRASTRUCTURE LAYER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="550" width="1820" height="200" as="geometry"/></mxCell>
<mxCell id="kafka" value="Kafka\nscore.updated topic\n100 partitions\nkey: entity_id hash\n7-day retention\n\nConsumer groups:\nredis-consumer\ndb-consumer\nanalytics-consumer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=3;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="80" y="600" width="190" height="110" as="geometry"/></mxCell>
<mxCell id="redis" value="Redis ZSET\nleaderboard:global:alltime\nleaderboard:global:daily:DATE\nleaderboard:US:alltime\nleaderboard:trending\n\nCommands:\nZINCRBY (write)\nZREVRANGE (top-K)\nZREVRANK (rank lookup)\nZSCORE (entity score)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=3;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="310" y="600" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="scoreDb" value="Score DB (Spanner/Cassandra)\nscores table\nentity_id | score_delta\ntimestamp | region\nShard by entity_id hash\nPartition by month\n\nDB Consumer writes\n(~1s eventual lag)\nFallback reads only\n(rare, Redis miss)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="570" y="600" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="influx" value="InfluxDB\nentity_scores measurement\ntags: entity_id, region\nfields: views_count, score\nDownsampled rollups:\n1-min → 1-hour → 1-day\n\nContinuous queries\nfor auto-aggregation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="840" y="600" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="dedupRedis" value="Redis (Dedup)\nview_dedup:{userId}:{entityId}\nTTL: 300s\n\nPrevents same user\nfrom double-counting\nwithin 5 minutes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="1100" y="600" width="200" height="110" as="geometry"/></mxCell>
<mxCell id="cacheRedis" value="Redis (Cache)\nleaderboard_cache:{id}\nTTL 24h (batch approach)\n\nEntity metadata (MGET)\nfor response enrichment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="1340" y="600" width="180" height="110" as="geometry"/></mxCell>
<mxCell id="e1" value="publish" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#7b1fa2;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="scoreSvc" target="kafka"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="consume" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#7b1fa2;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="kafka" target="redisConsumer"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="ZINCRBY" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#f57f17;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="redisConsumer" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="read top-K" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#f57f17;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="rankingSvc" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="consume" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#7b1fa2;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="kafka" target="dbConsumer"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="INSERT batch" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#7b1fa2;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="dbConsumer" target="scoreDb"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="dedup check" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#f57f17;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="scoreSvc" target="dedupRedis"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="why" value="WHY THESE CHOICES\n\nKafka as source of truth: All scores flow through Kafka first. Redis consumer has lag (~100ms), DB consumer has lag (~1s). If Redis crashes, replay Kafka from offset 0 to rebuild all ZSETs. Kafka 7-day retention is the disaster recovery mechanism.\n\nRedis ZSET pre-sorted skip list: ZINCRBY is O(log N) atomic increment, no race conditions even with 1M concurrent writes. ZREVRANGE returns top-K in O(log N + K) from the already-sorted structure, under 1ms regardless of total member count. Alternative (SQL ORDER BY) scans and sorts millions of rows on every query.\n\nDedup with Redis TTL: Prevents fraudulent score inflation. Same user viewing same video within 5 minutes returns 200 OK but skips Kafka publish. TTL auto-expires the dedup key so legitimate repeat views after 5 min are counted.\n\nTime-windowed keys with auto-expiry: Separate ZSET per time window (daily, weekly, monthly, all-time). Daily keys have 7-day TTL, weekly keys have 90-day TTL. No cleanup jobs needed. Alternative (compute windows on read) requires scanning millions of raw events per query.\n\nTrending batch job: Computes time-decay score hourly for last 7 days only (engagement / (age_hours + 2)^1.8). Incremental approach avoids full recompute of all entities. Writes to trending ZSET with 2-hour TTL safety net.\n\nHybrid read path: Try Redis (fast, &lt;1ms), fallback to DB (slow, ~100ms) on cache miss. Rebuild Redis ZSET from DB asynchronously in background. Best of both worlds: speed + durability." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="60" y="790" width="1580" height="230" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>