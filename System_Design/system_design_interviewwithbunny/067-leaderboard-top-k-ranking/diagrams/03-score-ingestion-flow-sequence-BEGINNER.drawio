<mxfile host="app.diagrams.net"><diagram name="Score Ingestion Sequence" id="score-sequence"><mxGraphModel dx="2000" dy="1250" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2000" pageHeight="1250" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="TOP-K LEADERBOARD - Score Ingestion Flow (with Dedup + Redis ZSET Update)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=22;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="80" y="20" width="1840" height="35" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Async ingestion: Score Service → Kafka → Redis Consumer → ZINCRBY | Query path: Ranking Service → Redis ZREVRANGE (&lt;1ms)" style="text;html=1;strokeColor=none;fillColor=#e8eaf6;align=center;rounded=1;fontSize=13" vertex="1" parent="1"><mxGeometry x="250" y="65" width="1500" height="28" as="geometry"/></mxCell>

<mxCell id="client" value="Client\n(Player)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;fontSize=12;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="80" y="140" width="120" height="60" as="geometry"/></mxCell>
<mxCell id="scoreSvc" value="Score\nService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=3;fontSize=12;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="260" y="140" width="120" height="60" as="geometry"/></mxCell>
<mxCell id="dedupRedis" value="Redis\n(Dedup)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=12;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="440" y="140" width="120" height="60" as="geometry"/></mxCell>
<mxCell id="kafka" value="Kafka\n(score.updated)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=12;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="620" y="140" width="140" height="60" as="geometry"/></mxCell>
<mxCell id="redisConsumer" value="Redis\nConsumer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=12;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="820" y="140" width="120" height="60" as="geometry"/></mxCell>
<mxCell id="zset" value="Redis\nZSET" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=3;fontSize=12;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="120" height="60" as="geometry"/></mxCell>
<mxCell id="scoreDb" value="Score DB\n(Persistence)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=12;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="1180" y="140" width="140" height="60" as="geometry"/></mxCell>
<mxCell id="rankingSvc" value="Ranking\nService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=12;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="1380" y="140" width="120" height="60" as="geometry"/></mxCell>
<mxCell id="client2" value="Client\n(Query)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;fontSize=12;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="1560" y="140" width="120" height="60" as="geometry"/></mxCell>

<mxCell id="l1" value="" style="line;strokeWidth=2;html=1;strokeColor=#1976d2" vertex="1" parent="1"><mxGeometry x="140" y="210" width="0" height="970" as="geometry"/></mxCell>
<mxCell id="l2" value="" style="line;strokeWidth=2;html=1;strokeColor=#388e3c" vertex="1" parent="1"><mxGeometry x="320" y="210" width="0" height="970" as="geometry"/></mxCell>
<mxCell id="l3" value="" style="line;strokeWidth=2;html=1;strokeColor=#f57f17" vertex="1" parent="1"><mxGeometry x="500" y="210" width="0" height="970" as="geometry"/></mxCell>
<mxCell id="l4" value="" style="line;strokeWidth=2;html=1;strokeColor=#7b1fa2" vertex="1" parent="1"><mxGeometry x="690" y="210" width="0" height="970" as="geometry"/></mxCell>
<mxCell id="l5" value="" style="line;strokeWidth=2;html=1;strokeColor=#388e3c" vertex="1" parent="1"><mxGeometry x="880" y="210" width="0" height="970" as="geometry"/></mxCell>
<mxCell id="l6" value="" style="line;strokeWidth=2;html=1;strokeColor=#f57f17" vertex="1" parent="1"><mxGeometry x="1060" y="210" width="0" height="970" as="geometry"/></mxCell>
<mxCell id="l7" value="" style="line;strokeWidth=2;html=1;strokeColor=#7b1fa2" vertex="1" parent="1"><mxGeometry x="1250" y="210" width="0" height="970" as="geometry"/></mxCell>
<mxCell id="l8" value="" style="line;strokeWidth=2;html=1;strokeColor=#388e3c" vertex="1" parent="1"><mxGeometry x="1440" y="210" width="0" height="970" as="geometry"/></mxCell>
<mxCell id="l9" value="" style="line;strokeWidth=2;html=1;strokeColor=#1976d2" vertex="1" parent="1"><mxGeometry x="1620" y="210" width="0" height="970" as="geometry"/></mxCell>

<mxCell id="phase1" value="PHASE 1: SCORE SUBMISSION (async write path)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=5" vertex="1" parent="1"><mxGeometry x="30" y="240" width="730" height="30" as="geometry"/></mxCell>

<mxCell id="s1" value="1. POST /api/v1/scores\n{entity_id: 'V123', user_id: 'U456', score_delta: 1, region: 'US'}" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#1976d2;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.2" y="10" relative="1" as="geometry"><mxPoint x="140" y="280" as="sourcePoint"/><mxPoint x="320" y="280" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="s2" value="2. Validate entity exists (check entity_id in cache/DB)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1;strokeColor=#388e3c;dashed=1;endArrow=none;endFill=0;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.1" y="8" relative="1" as="geometry"><mxPoint x="320" y="310" as="sourcePoint"/><mxPoint x="320" y="330" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="s3" value="3. GET view_dedup:U456:V123" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#f57f17;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.2" y="8" relative="1" as="geometry"><mxPoint x="320" y="350" as="sourcePoint"/><mxPoint x="500" y="350" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="s4" value="4. Return NIL (not exists)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#f57f17;dashed=1;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.2" y="-8" relative="1" as="geometry"><mxPoint x="500" y="380" as="sourcePoint"/><mxPoint x="320" y="380" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="note1" value="If EXISTS → return 200 OK\n(skip Kafka, already counted)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle" vertex="1" parent="1"><mxGeometry x="540" y="340" width="200" height="50" as="geometry"/></mxCell>

<mxCell id="s5" value="5. SET view_dedup:U456:V123 1 EX 300 (5 min TTL)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#f57f17;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.2" y="10" relative="1" as="geometry"><mxPoint x="320" y="420" as="sourcePoint"/><mxPoint x="500" y="420" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="s6" value="6. Publish to Kafka score.updated\n{event_id, entity_id: 'V123', score_delta: 1, timestamp, region: 'US'}\nPartition key: hash(entity_id)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#7b1fa2;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.15" y="12" relative="1" as="geometry"><mxPoint x="320" y="465" as="sourcePoint"/><mxPoint x="690" y="465" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="s7" value="7. Return 200 OK immediately (async)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#1976d2;dashed=1;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.2" y="-10" relative="1" as="geometry"><mxPoint x="320" y="500" as="sourcePoint"/><mxPoint x="140" y="500" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="note2" value="Client gets instant response\nDoes NOT wait for Redis/DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle" vertex="1" parent="1"><mxGeometry x="30" y="515" width="180" height="40" as="geometry"/></mxCell>

<mxCell id="phase2" value="PHASE 2: REDIS ZSET UPDATE (background consumer, ~100ms lag)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=5" vertex="1" parent="1"><mxGeometry x="30" y="570" width="1090" height="30" as="geometry"/></mxCell>

<mxCell id="s8" value="8. Poll Kafka (consumer group: redis-consumer)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#7b1fa2;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.1" y="8" relative="1" as="geometry"><mxPoint x="690" y="610" as="sourcePoint"/><mxPoint x="880" y="610" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="s9" value="9. ZINCRBY leaderboard:global:alltime 1 V123" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#f57f17;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.15" y="10" relative="1" as="geometry"><mxPoint x="880" y="650" as="sourcePoint"/><mxPoint x="1060" y="650" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="s10" value="10. ZINCRBY leaderboard:global:daily:2026-01-25 1 V123" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#f57f17;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.15" y="10" relative="1" as="geometry"><mxPoint x="880" y="690" as="sourcePoint"/><mxPoint x="1060" y="690" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="s11" value="11. ZINCRBY leaderboard:US:alltime 1 V123" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#f57f17;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.15" y="10" relative="1" as="geometry"><mxPoint x="880" y="730" as="sourcePoint"/><mxPoint x="1060" y="730" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="note3" value="Atomic increment\nNo race conditions\nRedis skip list auto-sorts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle" vertex="1" parent="1"><mxGeometry x="1130" y="660" width="170" height="50" as="geometry"/></mxCell>

<mxCell id="s12" value="12. Commit Kafka offset (ack processed)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#7b1fa2;dashed=1;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.1" y="-8" relative="1" as="geometry"><mxPoint x="880" y="770" as="sourcePoint"/><mxPoint x="690" y="770" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="phase3" value="PHASE 3: DB PERSISTENCE (async, ~1s lag)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0277bd;strokeWidth=2;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=5" vertex="1" parent="1"><mxGeometry x="30" y="810" width="1290" height="30" as="geometry"/></mxCell>

<mxCell id="s13" value="13. DB Consumer polls Kafka (consumer group: db-consumer)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#7b1fa2;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.1" y="8" relative="1" as="geometry"><mxPoint x="690" y="850" as="sourcePoint"/><mxPoint x="1250" y="850" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="s14" value="14. INSERT INTO scores (...)\nBatch 10K rows/sec" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#7b1fa2;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.1" y="10" relative="1" as="geometry"><mxPoint x="1250" y="890" as="sourcePoint"/><mxPoint x="1250" y="920" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="note4" value="Persistent source of truth\nUsed for Kafka replay\nif Redis crashes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle" vertex="1" parent="1"><mxGeometry x="1330" y="865" width="170" height="50" as="geometry"/></mxCell>

<mxCell id="phase4" value="PHASE 4: QUERY TOP-K (read path, &lt;1ms from Redis)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacing=5" vertex="1" parent="1"><mxGeometry x="30" y="960" width="1650" height="30" as="geometry"/></mxCell>

<mxCell id="s15" value="15. GET /api/v1/leaderboards/global/top?limit=10" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#1976d2;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.15" y="10" relative="1" as="geometry"><mxPoint x="1620" y="1000" as="sourcePoint"/><mxPoint x="1440" y="1000" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="s16" value="16. ZREVRANGE leaderboard:global:alltime 0 9 WITHSCORES" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#f57f17;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.15" y="10" relative="1" as="geometry"><mxPoint x="1440" y="1040" as="sourcePoint"/><mxPoint x="1060" y="1040" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="s17" value="17. Return top-10 with scores\n[{V123: 9821}, {V456: 9500}, ...] (&lt;1ms)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#f57f17;dashed=1;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.15" y="-12" relative="1" as="geometry"><mxPoint x="1060" y="1080" as="sourcePoint"/><mxPoint x="1440" y="1080" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="s18" value="18. Return JSON to client" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#1976d2;dashed=1;endArrow=block;endFill=1;fontSize=10" edge="1" parent="1"><mxGeometry x="-0.1" y="-10" relative="1" as="geometry"><mxPoint x="1440" y="1115" as="sourcePoint"/><mxPoint x="1620" y="1115" as="targetPoint"/><mxPoint as="offset"/></mxGeometry></mxCell>

<mxCell id="note5" value="Pre-sorted skip list\nNo aggregation needed\nAlways current" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=1;fontSize=10;align=left;verticalAlign=middle" vertex="1" parent="1"><mxGeometry x="890" y="1050" width="140" height="50" as="geometry"/></mxCell>

<mxCell id="key" value="INTERVIEW KEY\n\nAsync write path: Phases 1-3 happen independently. Client gets 200 OK in &lt;10ms (Phase 1). Redis updates in ~100ms (Phase 2). DB write happens in ~1s (Phase 3). No blocking.\n\nKafka as buffer: If Redis consumer crashes, events stay in Kafka (7-day retention). When consumer recovers, it resumes from last committed offset. No data loss.\n\nDedup prevents inflation: Without dedup, a bot could submit 1000 views/sec for the same video from same user_id. With dedup, second request within 5 min returns 200 OK but doesn't increment score.\n\nZINCRBY is atomic: Even with 1M concurrent ZINCRBY for same entity_id, Redis guarantees correct final count. No lost updates.\n\nWhy WITHSCORES? Returns both member (entity_id) and score. Client displays: 'Video V123: 9821 views'. Without scores, client would need separate ZSCORE calls for each entity." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0277bd;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="60" y="1150" width="1740" height="80" as="geometry"/></mxCell>

</root></mxGraphModel></diagram></mxfile>