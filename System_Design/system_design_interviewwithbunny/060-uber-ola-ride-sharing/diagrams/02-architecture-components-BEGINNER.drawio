<mxfile host="app.diagrams.net">
  <diagram name="Architecture Components" id="architecture">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title -->
        <mxCell id="title" value="UBER/OLA — High-Level Architecture &amp; Component Design" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1560" height="35" as="geometry" />
        </mxCell>
        
        <mxCell id="subtitle" value="From ride request → driver matching (geo-search + Zookeeper lock) → real-time tracking (WebSocket) → payment → rating" style="text;html=1;strokeColor=none;fillColor=#e8eaf6;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="150" y="50" width="1300" height="25" as="geometry" />
        </mxCell>
        
        <!-- Client Layer -->
        <mxCell id="rider-app" value="📱 Rider App&#xa;(iOS/Android)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;fontSize=12;fontStyle=1;align=center" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="130" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="driver-app" value="🚕 Driver App&#xa;(iOS/Android)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=12;fontStyle=1;align=center" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="130" height="60" as="geometry" />
        </mxCell>
        
        <!-- Gateway Layer -->
        <mxCell id="load-balancer" value="⚖️ Load Balancer&#xa;(Round-robin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=12;fontStyle=1;align=center" vertex="1" parent="1">
          <mxGeometry x="230" y="110" width="140" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="api-gateway" value="🚪 API Gateway&#xa;&#xa;• Auth (JWT)&#xa;• Rate limiting&#xa;• Routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=11;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="230" y="190" width="140" height="90" as="geometry" />
        </mxCell>
        
        <mxCell id="websocket-gateway" value="🔌 WebSocket&#xa;Gateway&#xa;&#xa;• Sticky sessions&#xa;• 10K conn/instance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=11;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="230" y="300" width="140" height="90" as="geometry" />
        </mxCell>
        
        <!-- Core Services -->
        <mxCell id="ride-service" value="🚗 Ride Service&#xa;&#xa;• Fare estimation&#xa;• Trip management&#xa;• Request validation&#xa;• Trip status updates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=11;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="430" y="110" width="160" height="110" as="geometry" />
        </mxCell>
        
        <mxCell id="matching-service" value="🎯 Driver Matching Svc&#xa;&#xa;• GEORADIUS search&#xa;• Vehicle type filter&#xa;• Zookeeper locking&#xa;• Retry on decline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=11;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="430" y="240" width="160" height="110" as="geometry" />
        </mxCell>
        
        <mxCell id="location-service" value="📍 Location Update Svc&#xa;(WebSocket Server)&#xa;&#xa;• Driver location stream&#xa;• Redis GEOADD&#xa;• Kafka publish&#xa;• Heartbeat monitor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=11;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="430" y="370" width="160" height="120" as="geometry" />
        </mxCell>
        
        <mxCell id="payment-service" value="💳 Payment Service&#xa;&#xa;• Stripe integration&#xa;• Charge riders&#xa;• Payout drivers&#xa;• Refunds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=11;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="620" y="110" width="150" height="100" as="geometry" />
        </mxCell>
        
        <mxCell id="rating-service" value="⭐ Rating Service&#xa;&#xa;• Anonymous ratings&#xa;• Avg calculation&#xa;• Driver prioritization&#xa;• Low-rated flags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=11;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="620" y="230" width="150" height="110" as="geometry" />
        </mxCell>
        
        <mxCell id="notification-service" value="🔔 Notification Svc&#xa;&#xa;• Kafka consumer&#xa;• FCM/APN push&#xa;• WebSocket real-time&#xa;• SMS fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=11;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="620" y="360" width="150" height="110" as="geometry" />
        </mxCell>
        
        <mxCell id="surge-calculator" value="📈 Surge Calculator&#xa;&#xa;• Demand/supply ratio&#xa;• Geohash grouping&#xa;• Smoothing algorithm&#xa;• Max cap: 3.0×" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=11;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="620" y="490" width="150" height="100" as="geometry" />
        </mxCell>
        
        <mxCell id="analytics-service" value="📊 Trip Update Consumer&#xa;(Analytics)&#xa;&#xa;• Kafka consumer&#xa;• Location history&#xa;• Metrics aggregation&#xa;• Fraud detection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9e9e9e;fontSize=11;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="620" y="610" width="150" height="120" as="geometry" />
        </mxCell>
        
        <!-- Storage Layer -->
        <mxCell id="postgresql" value="🗄️ PostgreSQL&#xa;&#xa;TABLES:&#xa;• drivers&#xa;• riders/users&#xa;• trips/rides&#xa;• payments&#xa;• ratings&#xa;• location_history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#8e24aa;fontSize=11;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="830" y="110" width="140" height="150" as="geometry" />
        </mxCell>
        
        <mxCell id="redis-geo" value="⚡ Redis Geospatial&#xa;&#xa;drivers:available&#xa;• GEOADD&#xa;• GEORADIUS&#xa;• WITHDIST ASC&#xa;&#xa;Find 10 nearest&#xa;in ~10ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#d84315;fontSize=11;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="830" y="280" width="140" height="150" as="geometry" />
        </mxCell>
        
        <mxCell id="redis-cache" value="⚡ Redis Cache&#xa;&#xa;TTL-based:&#xa;• location:{id} 60s&#xa;• surge:{geohash} 120s&#xa;• fare_estimate 300s&#xa;• trip:{id} 7200s&#xa;• driver:status 300s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#d84315;fontSize=11;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="830" y="450" width="140" height="140" as="geometry" />
        </mxCell>
        
        <mxCell id="zookeeper" value="🔒 Zookeeper&#xa;Distributed Locks&#xa;&#xa;/locks/drivers/{id}/&#xa;  ephemeral_node&#xa;&#xa;• Prevent double-assign&#xa;• Auto-delete on crash&#xa;• 30s session timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=11;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="830" y="610" width="140" height="160" as="geometry" />
        </mxCell>
        
        <mxCell id="kafka" value="📡 Kafka&#xa;Event Streaming&#xa;&#xa;TOPICS:&#xa;• ride.requested&#xa;• ride.matched&#xa;• driver.location_updated&#xa;• trip.started/completed&#xa;&#xa;Partition by trip_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#01579b;fontSize=11;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="1010" y="110" width="170" height="180" as="geometry" />
        </mxCell>
        
        <!-- External Services -->
        <mxCell id="google-maps" value="🗺️ Google Maps&#xa;Distance Matrix API&#xa;&#xa;• Route calculation&#xa;• Distance &amp; duration&#xa;• ETA prediction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=11;fontStyle=1;align=center" vertex="1" parent="1">
          <mxGeometry x="1010" y="310" width="170" height="100" as="geometry" />
        </mxCell>
        
        <mxCell id="stripe" value="💳 Stripe/Razorpay&#xa;&#xa;• Process payments&#xa;• Refunds&#xa;• Payouts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#01579b;fontSize=11;fontStyle=1;align=center" vertex="1" parent="1">
          <mxGeometry x="1010" y="430" width="170" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="fcm-apn" value="🔔 FCM + APN&#xa;&#xa;• Push notifications&#xa;• Device token mgmt&#xa;• High priority msgs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=11;fontStyle=1;align=center" vertex="1" parent="1">
          <mxGeometry x="1010" y="530" width="170" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="cdn" value="☁️ CDN&#xa;(CloudFront)&#xa;&#xa;• Driver/rider photos&#xa;• Vehicle images&#xa;• Map tiles cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9e9e9e;fontSize=11;fontStyle=1;align=center" vertex="1" parent="1">
          <mxGeometry x="1010" y="630" width="170" height="90" as="geometry" />
        </mxCell>
        
        <!-- Arrows -->
        <mxCell id="arrow1" value="HTTP/REST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1976d2;fontSize=9" edge="1" parent="1" source="rider-app" target="load-balancer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="arrow2" value="WebSocket" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#388e3c;fontSize=9" edge="1" parent="1" source="driver-app" target="websocket-gateway">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="190" y="220" />
              <mxPoint x="190" y="345" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="arrow3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#757575" edge="1" parent="1" source="load-balancer" target="api-gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="arrow4" value="Fare calc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#388e3c;fontSize=9" edge="1" parent="1" source="api-gateway" target="ride-service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="arrow5" value="Ride request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#388e3c;fontSize=9" edge="1" parent="1" source="ride-service" target="matching-service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="arrow6" value="Location stream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#388e3c;fontSize=9" edge="1" parent="1" source="websocket-gateway" target="location-service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="arrow7" value="GEORADIUS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d84315;fontSize=9;dashed=1" edge="1" parent="1" source="matching-service" target="redis-geo">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="295" />
              <mxPoint x="750" y="355" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="arrow8" value="Acquire lock" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#e65100;fontSize=9;dashed=1" edge="1" parent="1" source="matching-service" target="zookeeper">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="780" y="295" />
              <mxPoint x="780" y="690" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="arrow9" value="GEOADD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d84315;fontSize=9" edge="1" parent="1" source="location-service" target="redis-geo">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="810" y="430" />
              <mxPoint x="810" y="355" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="arrow10" value="Publish events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#01579b;fontSize=9" edge="1" parent="1" source="location-service" target="kafka">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="600" y="430" />
              <mxPoint x="600" y="540" />
              <mxPoint x="990" y="540" />
              <mxPoint x="990" y="200" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="arrow11" value="Store trips" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#8e24aa;fontSize=9;dashed=1" edge="1" parent="1" source="ride-service" target="postgresql">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="790" y="165" />
              <mxPoint x="790" y="185" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="arrow12" value="Consume events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#01579b;fontSize=9;dashed=1" edge="1" parent="1" source="notification-service" target="kafka">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="990" y="415" />
              <mxPoint x="990" y="200" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="arrow13" value="Send push" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#7b1fa2;fontSize=9" edge="1" parent="1" source="notification-service" target="fcm-apn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="arrow14" value="Distance API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#e65100;fontSize=9" edge="1" parent="1" source="ride-service" target="google-maps">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="800" y="165" />
              <mxPoint x="800" y="80" />
              <mxPoint x="1095" y="80" />
              <mxPoint x="1095" y="360" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="arrow15" value="Charge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#01579b;fontSize=9" edge="1" parent="1" source="payment-service" target="stripe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- WHY Boxes -->
        <mxCell id="why-redis-geo" value="❓ WHY REDIS GEOSPATIAL?&#xa;&#xa;Finding nearest driver from 1M = slow table scan (seconds).&#xa;Redis GEORADIUS indexes locations in a sorted grid →&#xa;returns 10 nearest in ~10ms. Like pre-sorting a phonebook&#xa;by area code vs searching page by page." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#01579b;fontSize=10;align=left" vertex="1" parent="1">
          <mxGeometry x="1220" y="110" width="360" height="100" as="geometry" />
        </mxCell>
        
        <mxCell id="why-zookeeper" value="❓ WHY ZOOKEEPER LOCKS?&#xa;&#xa;Without locks: 3 riders request → all matched to same driver&#xa;(race condition). Zookeeper ephemeral nodes = distributed lock.&#xa;First to create lock wins the driver. If matching service crashes,&#xa;lock auto-deletes after 30s (ephemeral). Redis SETNX could work&#xa;but Zookeeper handles crashes better with session timeouts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=10;align=left" vertex="1" parent="1">
          <mxGeometry x="1220" y="230" width="360" height="120" as="geometry" />
        </mxCell>
        
        <mxCell id="why-websocket" value="❓ WHY WEBSOCKET NOT HTTP POLLING?&#xa;&#xa;HTTP polling = ask &quot;where is driver?&quot; every 3 seconds →&#xa;33K req/sec for 100K trips. WebSocket = persistent connection,&#xa;driver sends location when it changes → 10× less bandwidth,&#xa;&lt;100ms latency vs 1-3s. Like keeping a phone call open vs&#xa;calling back repeatedly." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=10;align=left" vertex="1" parent="1">
          <mxGeometry x="1220" y="370" width="360" height="120" as="geometry" />
        </mxCell>
        
        <mxCell id="why-kafka" value="❓ WHY KAFKA FOR EVENTS?&#xa;&#xa;Kafka = order ticket printer in restaurant. Ride Service drops&#xa;&quot;ride.requested&quot; event and returns to user immediately. Matching&#xa;Service consumes event at its own pace. Decoupling = slow matching&#xa;never freezes rider app. Event durably stored even if consumers down.&#xa;Multiple subscribers (matching, analytics, notifications) read same&#xa;event independently." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#01579b;fontSize=10;align=left" vertex="1" parent="1">
          <mxGeometry x="1220" y="510" width="360" height="140" as="geometry" />
        </mxCell>
        
        <mxCell id="why-surge" value="❓ WHY SURGE PRICING?&#xa;&#xa;10 riders waiting, 2 drivers available → demand 5× supply.&#xa;Surge raises prices to attract more drivers onto the road.&#xa;Geohash divides city into 5km squares. Calculate ratio per square&#xa;every 60s. Smoothing (70% old + 30% new) prevents sudden spikes.&#xa;Rider must explicitly accept higher fare. Max cap = 3.0× anti-gouge." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=10;align=left" vertex="1" parent="1">
          <mxGeometry x="1220" y="670" width="360" height="130" as="geometry" />
        </mxCell>
        
        <!-- Scale Numbers -->
        <mxCell id="scale-box" value="📊 SCALE NUMBERS&#xa;&#xa;• 100K concurrent rides&#xa;• 1M drivers globally&#xa;• Location updates: 100K/min&#xa;• GEORADIUS: &lt;10ms p99&#xa;• Driver matching: &lt;1s&#xa;• WebSocket: 10K conn/instance&#xa;• Kafka: 100 partitions&#xa;• Zookeeper: 5-node ensemble" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#616161;fontSize=10;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="330" height="200" as="geometry" />
        </mxCell>
        
        <!-- Technologies Used -->
        <mxCell id="tech-box" value="🔧 TECHNOLOGIES USED&#xa;&#xa;Database: PostgreSQL (trips, drivers, riders)&#xa;Cache: Redis (geospatial index, TTL-based cache)&#xa;Locks: Zookeeper (distributed coordination)&#xa;Messaging: Kafka (event streaming)&#xa;Real-time: WebSocket (location updates)&#xa;Maps: Google Distance Matrix API&#xa;Payments: Stripe/Razorpay&#xa;Push: FCM (Android) + APN (iOS)&#xa;CDN: CloudFront (photos, images)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="430" y="530" width="340" height="200" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>