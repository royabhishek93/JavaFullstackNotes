        <mxCell id="step1-response" value="Show fare&#xa;estimate + ETA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;fontSize=10;align=center" vertex="1" parent="1">
