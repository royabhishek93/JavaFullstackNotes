        <mxCell id="arrow6" value="Kafka:&#xa;ride.requested" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#388e3c;fontSize=9;fontStyle=1" edge="1" parent="1" source="step2-validate" target="step2-match">
