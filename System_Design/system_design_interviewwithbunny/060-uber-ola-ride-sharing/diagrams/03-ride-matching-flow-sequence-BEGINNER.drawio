        <mxCell id="arrow8" value="Try D1 (closest)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#e65100;fontSize=9;fontStyle=1" edge="1" parent="1" source="step2-filter" target="step2-lock">
