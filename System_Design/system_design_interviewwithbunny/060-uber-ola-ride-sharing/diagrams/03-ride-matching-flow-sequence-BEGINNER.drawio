        <mxCell id="step1-redis" value="SET&#xa;fare_estimate:{id}&#xa;EX 300" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#d84315;fontSize=9;align=center" vertex="1" parent="1">
          <mxGeometry x="670" y="270" width="120" height="50" as="geometry" />
