        <mxCell id="arrow3" value="Cache 5min TTL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d84315;fontSize=9;dashed=1" edge="1" parent="1" source="step1-calc" target="step1-redis">
