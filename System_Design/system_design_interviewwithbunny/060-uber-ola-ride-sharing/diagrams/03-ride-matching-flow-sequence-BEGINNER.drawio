        <mxCell id="step2-filter" value="Filter by&#xa;vehicle_type:&#xa;SEDAN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=9;align=center" vertex="1" parent="1">
