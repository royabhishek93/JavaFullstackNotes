        <mxCell id="arrow1" value="POST /fare/estimate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1976d2;fontSize=9;fontStyle=1" edge="1" parent="1" source="step1-input" target="step1-api">
