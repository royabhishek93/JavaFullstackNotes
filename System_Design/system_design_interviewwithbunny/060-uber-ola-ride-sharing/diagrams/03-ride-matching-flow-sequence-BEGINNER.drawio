        <mxCell id="arrow10" value="POST /ride/rides&#xa;{action: accept}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#388e3c;fontSize=9;fontStyle=1" edge="1" parent="1" source="step3-accept">
