        <mxCell id="step2-lock-acquired" value="✅ LOCK&#xa;ACQUIRED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=10;fontStyle=1;align=center" vertex="1" parent="1">
