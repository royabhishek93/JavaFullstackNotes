        <mxCell id="arrow4" value="{estimated_fare: $20.85,&#xa;breakdown, vehicle_options,&#xa;eta_min: 5}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1976d2;fontSize=8;dashed=1" edge="1" parent="1" target="step1-response">
