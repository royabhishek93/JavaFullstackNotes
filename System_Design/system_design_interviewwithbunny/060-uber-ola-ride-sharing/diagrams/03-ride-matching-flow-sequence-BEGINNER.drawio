        <!-- PHASE 2: RIDE REQUEST &amp; DRIVER MATCHING (100ms-1.5s) -->
        <mxCell id="phase2-label" value="PHASE 2: RIDE REQUEST &amp; DRIVER MATCHING (100ms-1.5s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=11;fontStyle=1;align=center" vertex="1" parent="1">
