        <mxCell id="step2-request" value="Tap&#xa;&quot;Request Sedan&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;fontSize=10;align=center" vertex="1" parent="1">
          <mxGeometry x="50" y="460" width="120" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="arrow5" value="POST /ride/request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1976d2;fontSize=9;fontStyle=1" edge="1" parent="1" source="step2-request">
