        <mxCell id="step2-lock" value="CREATE&#xa;/locks/drivers/D1/&#xa;request_R1_seq0001&#xa;(ephemeral node)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=9;align=center" vertex="1" parent="1">
