        <mxCell id="step2-update-driver" value="SET driver:D1:status&#xa;'BUSY' EX 900&#xa;GEOREM D1 from&#xa;drivers:available" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#d84315;fontSize=9;align=center" vertex="1" parent="1">
