<mxCell id="apps" value="Mobile Apps | Web Apps\nGET /api/v1/places/search?lat=12.97&amp;lng=77.59&amp;radius=5\nGET /api/v1/places/{id}\nGET /api/v1/directions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;fontSize=11;align=left;verticalAlign=middle;spacing=10" vertex="1" parent="1"><mxGeometry x="240" y="110" width="800" height="50" as="geometry"/></mxCell>

