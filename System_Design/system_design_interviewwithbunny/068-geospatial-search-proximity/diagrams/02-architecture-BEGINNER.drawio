<mxCell id="t" value="PROXIMITY SEARCH - Architecture (Hybrid: Redis + Elasticsearch + PostgreSQL PostGIS)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=22;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="80" y="20" width="1740" height="35" as="geometry"/></mxCell>

