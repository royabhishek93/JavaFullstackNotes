<mxfile host="app.diagrams.net"><diagram name="Proximity Flow" id="prox-flow"><mxGraphModel dx="1900" dy="1400" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1900" pageHeight="1400" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="PROXIMITY SEARCH - Radius Query Flow (Hybrid: Redis → Elasticsearch → PostgreSQL PostGIS)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="80" y="20" width="1740" height="35" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Query: 'Find restaurants within 5km of (12.97, 77.59)' → Cache-first → Bounding box filter → Spatial index → Haversine exact → Sort by distance" style="text;html=1;strokeColor=none;fillColor=#e8eaf6;align=center;rounded=1;fontSize=13" vertex="1" parent="1"><mxGeometry x="150" y="65" width="1600" height="28" as="geometry"/></mxCell>

<mxCell id="c1" value="Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="120" width="140" height="50" as="geometry"/></mxCell>
<mxCell id="c2" value="Search Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="240" y="120" width="180" height="50" as="geometry"/></mxCell>
<mxCell id="c3" value="Redis Geo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="460" y="120" width="160" height="50" as="geometry"/></mxCell>
<mxCell id="c4" value="Elasticsearch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="660" y="120" width="160" height="50" as="geometry"/></mxCell>
<mxCell id="c5" value="PostgreSQL PostGIS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="860" y="120" width="200" height="50" as="geometry"/></mxCell>
<mxCell id="c6" value="Place Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1100" y="120" width="160" height="50" as="geometry"/></mxCell>
<mxCell id="c7" value="Redis Cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1300" y="120" width="160" height="50" as="geometry"/></mxCell>

<mxCell id="phase1" value="PHASE 1: Request Validation + Hot Cache Lookup (~5ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#1976d2;strokeWidth=2;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingTop=5;spacingLeft=10" vertex="1" parent="1"><mxGeometry x="40" y="190" width="1820" height="160" as="geometry"/></mxCell>

<mxCell id="s1" value="1. GET /api/v1/places/search\n?lat=12.97&amp;lng=77.59&amp;radius=5&amp;category=restaurant&amp;rating_min=4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#1976d2;endArrow=classic;endFill=1;fontSize=10" edge="1" parent="1" source="c1" target="c2"><mxGeometry x="-0.2" y="20" relative="1" as="geometry"><mxGeometry as="offset"/></mxGeometry></mxCell>
<mxCell id="s2" value="2. Validate params (lat ≤ 90, lng ≤ 180, radius ≤ 50km)\nGenerate cache key: 'search:12.97:77.59:5:restaurant:4'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;spacing=5" vertex="1" parent="1"><mxGeometry x="230" y="220" width="420" height="45" as="geometry"/></mxCell>

<mxCell id="s3" value="3. GET search:12.97:77.59:5:restaurant:4 (query result cache)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#f57f17;endArrow=classic;endFill=1;fontSize=10" edge="1" parent="1" source="c2" target="c3"><mxGeometry y="20" relative="1" as="geometry"><mxGeometry as="offset"/></mxGeometry></mxCell>
<mxCell id="s4" value="4. Cache HIT (top 100)\n[{place_id, dist_m}, ...]\n&lt;1ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#388e3c;endArrow=classic;endFill=1;dashed=1;fontSize=10" edge="1" parent="1" source="c3" target="c2"><mxGeometry y="-20" relative="1" as="geometry"><mxGeometry as="offset"/></mxGeometry></mxCell>

<mxCell id="note1" value="NOTE: 80% of queries hit Redis hot cache (&lt;5ms total). If cache MISS → proceed to Phase 2 (Elasticsearch)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=10;align=left;spacing=5" vertex="1" parent="1"><mxGeometry x="60" y="290" width="600" height="40" as="geometry"/></mxCell>

<mxCell id="phase2" value="PHASE 2: Elasticsearch Search Layer (Cache MISS → ~50ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingTop=5;spacingLeft=10" vertex="1" parent="1"><mxGeometry x="40" y="370" width="1820" height="200" as="geometry"/></mxCell>

<mxCell id="s5" value="5. geo_distance query:\n{\n  bool: {\n    filter: [\n      {geo_distance: {distance: '5km', location: {lat: 12.97, lon: 77.59}}},\n      {term: {category: 'restaurant'}},\n      {range: {rating: {gte: 4}}}\n    ]\n  },\n  sort: [{_geo_distance: {location: {lat: 12.97, lon: 77.59}, order: 'asc'}}]\n}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#f57f17;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="c2" target="c4"><mxGeometry y="40" relative="1" as="geometry"><mxGeometry as="offset"/></mxGeometry></mxCell>
<mxCell id="s6" value="6. BKD tree scan + filters\n(100M docs → 200 candidates)\nSort by distance\np95: ~50ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;spacing=5" vertex="1" parent="1"><mxGeometry x="650" y="410" width="280" height="60" as="geometry"/></mxCell>
<mxCell id="s7" value="7. Return [{place_id, dist_m, score}, ...] (top 50)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#388e3c;endArrow=classic;endFill=1;dashed=1;fontSize=10" edge="1" parent="1" source="c4" target="c2"><mxGeometry y="-25" relative="1" as="geometry"><mxGeometry as="offset"/></mxGeometry></mxCell>

<mxCell id="s8" value="8. Cache results: SET search:12.97:77.59:5:restaurant:4 [results] EX 600\n(10-min TTL)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#f57f17;dashed=1;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="c2" target="c3"><mxGeometry y="-20" relative="1" as="geometry"><mxGeometry as="offset"/></mxGeometry></mxCell>

<mxCell id="note2" value="NOTE: 95% of queries satisfied by Redis (5ms) or Elasticsearch (50ms). Complex filters (category + rating + open now) only possible in Elasticsearch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=10;align=left;spacing=5" vertex="1" parent="1"><mxGeometry x="60" y="510" width="900" height="40" as="geometry"/></mxCell>

<mxCell id="phase3" value="PHASE 3: PostgreSQL PostGIS Fallback (ES failure/complex shape → ~100ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingTop=5;spacingLeft=10" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1820" height="200" as="geometry"/></mxCell>

<mxCell id="s9" value="9. SELECT place_id, name, category, rating,\n   ST_Distance(location, ST_GeogFromText('POINT(77.59 12.97)')) AS dist_m\nFROM places\nWHERE category = 'restaurant'\n  AND rating &gt;= 4\n  AND ST_DWithin(location, ST_GeogFromText('POINT(77.59 12.97)'), 5000)\nORDER BY dist_m\nLIMIT 50;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#7b1fa2;endArrow=classic;endFill=1;fontSize=9" edge="1" parent="1" source="c2" target="c5"><mxGeometry y="50" relative="1" as="geometry"><mxGeometry as="offset"/></mxGeometry></mxCell>
<mxCell id="s10" value="10. GIST index scan\n(R-tree spatial lookup)\nVincenty formula\n~100ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;spacing=5" vertex="1" parent="1"><mxGeometry x="860" y="630" width="200" height="65" as="geometry"/></mxCell>
<mxCell id="s11" value="11. Return 50 rows (ACID consistent)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#388e3c;endArrow=classic;endFill=1;dashed=1;fontSize=10" edge="1" parent="1" source="c5" target="c2"><mxGeometry y="-20" relative="1" as="geometry"><mxGeometry as="offset"/></mxGeometry></mxCell>

<mxCell id="note3" value="NOTE: PostGIS used for exact Vincenty distance (±0.5mm accuracy), complex polygons (e.g., delivery zones), and when Elasticsearch is down. Bounding box pre-filter (lat BETWEEN, lng BETWEEN) + GIST index = 10K candidates → Haversine on survivors." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=left;spacing=5" vertex="1" parent="1"><mxGeometry x="60" y="730" width="1200" height="40" as="geometry"/></mxCell>

<mxCell id="phase4" value="PHASE 4: Response Enrichment + Return (~10ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingTop=5;spacingLeft=10" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1820" height="200" as="geometry"/></mxCell>

<mxCell id="s12" value="12. Batch fetch metadata:\nGET place:12345\nGET place:67890\n...(50 place IDs)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#f57f17;endArrow=classic;endFill=1;fontSize=10" edge="1" parent="1" source="c2" target="c7"><mxGeometry y="30" relative="1" as="geometry"><mxGeometry as="offset"/></mxGeometry></mxCell>
<mxCell id="s13" value="13. CACHE MISS\n(20% stale)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#c62828;dashed=1;endArrow=classic;endFill=1;fontSize=10" edge="1" parent="1" source="c7" target="c2"><mxGeometry y="-20" relative="1" as="geometry"><mxGeometry as="offset"/></mxGeometry></mxCell>
<mxCell id="s14" value="14. Fallback batch fetch from DB:\nSELECT * FROM places WHERE place_id IN (...)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#7b1fa2;endArrow=classic;endFill=1;fontSize=10" edge="1" parent="1" source="c2" target="c6"><mxGeometry y="25" relative="1" as="geometry"><mxGeometry as="offset"/></mxGeometry></mxCell>
<mxCell id="s15" value="15. Return 10 place details\n(name, address, hours, photos)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#388e3c;dashed=1;endArrow=classic;endFill=1;fontSize=10" edge="1" parent="1" source="c6" target="c2"><mxGeometry y="-20" relative="1" as="geometry"><mxGeometry as="offset"/></mxGeometry></mxCell>

<mxCell id="s16" value="16. Combine distance + metadata → JSON response:\n{\n  places: [\n    {place_id: 12345, name: 'Pizza Place', category: 'restaurant', rating: 4.5,\n     distance_km: 0.45, address: 'MG Road', photo_url: 'cdn.../photo.jpg'},\n    ...\n  ],\n  next_cursor: 'eyJsYXQ...'\n}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;spacing=5" vertex="1" parent="1"><mxGeometry x="220" y="880" width="540" height="120" as="geometry"/></mxCell>

<mxCell id="s17" value="17. Return 200 OK + JSON (total: 5-100ms depending on tier)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#388e3c;endArrow=classic;endFill=1;dashed=1;fontSize=11" edge="1" parent="1" source="c2" target="c1"><mxGeometry y="-25" relative="1" as="geometry"><mxGeometry as="offset"/></mxGeometry></mxCell>

<mxCell id="key" value="INTERVIEW KEY\n\n✅ Sync: User waits for response (5-100ms total). All lookups (Redis → ES → PG) are sequential with fallbacks. Client blocks on HTTP request.\n✅ Async: Backend indexing (Kafka consumer → ES bulk write) happens after place update (~1-2s lag). Acceptable for static places, NOT for real-time driver locations.\n✅ Lock-free: Read-only queries (no locking). Writes (place update) use PostgreSQL MVCC (snapshot isolation). Redis GEOADD is atomic per key.\n✅ Performance: Redis hot (5ms, 80% hit) → ES (50ms, 15%) → PG (100ms, 5%). Bounding box + spatial index eliminates 99% of rows before exact distance calculation.\n✅ Edge case: Geohash boundary - query 9 cells (center + 8 neighbors) then Haversine post-filter to get exact circle. Two points 50m apart on boundary have different prefixes (9q8yyzzz vs 9q8z0000)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="60" y="1040" width="1800" height="150" as="geometry"/></mxCell>

<mxCell id="analogy" value="BEGINNER ANALOGY: Finding nearby pizza places is like asking for directions. First, check your phone's recent searches (Redis hot cache, &lt;1s). If not found, ask your smart home assistant (Elasticsearch, knows text + location, ~5s). If assistant is offline, pull out a detailed city map (PostgreSQL PostGIS master ledger, most accurate, ~10s). You don't flip through the entire phone book (full table scan) — the index jumps straight to your neighborhood (bounding box) and measures exact walking distance (Haversine) only for the 20 closest candidates." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0277bd;strokeWidth=2;fontSize=11;align=left;verticalAlign=middle;spacing=10" vertex="1" parent="1"><mxGeometry x="60" y="1230" width="1800" height="80" as="geometry"/></mxCell>

</root></mxGraphModel></diagram></mxfile>
