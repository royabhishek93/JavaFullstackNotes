        <!-- Title -->
        <mxCell id="title" value="⏱️ TinyURL Flow — Step-by-Step (What Happens in 5 Milliseconds)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="1200" height="50" as="geometry" />
        </mxCell>
        
        <!-- Subtitle -->
        <mxCell id="subtitle" value="Two flows: CREATE (slow, rare) and REDIRECT (fast, common). Interview focuses on REDIRECT optimization." style="text;html=1;strokeColor=none;fillColor=#FFF3CD;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="250" y="80" width="1100" height="40" as="geometry" />
        </mxCell>
        
        <!-- FLOW 1: CREATE SHORT URL -->
        <mxCell id="create-title" value="📝 FLOW 1: CREATE SHORT URL (Happens 1,157 times/second)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#D4E6F1;strokeColor=#2874A6;strokeWidth=3;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="150" width="1400" height="50" as="geometry" />
