<mxfile host="app.diagrams.net" modified="2026-08-30T12:00:00.000Z" agent="5.0" version="24.0.0">
  <diagram name="TinyURL-Data-Model" id="datamodel">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title -->
        <mxCell id="title" value="💾 TinyURL Data Model — Database Schema Explained" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="1000" height="50" as="geometry" />
        </mxCell>
        
        <!-- Subtitle -->
        <mxCell id="subtitle" value="Every column has a purpose. If you can't explain WHY it exists, you don't need it." style="text;html=1;strokeColor=none;fillColor=#FFF3CD;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="350" y="80" width="900" height="40" as="geometry" />
        </mxCell>
        
        <!-- Main Table: url_mappings -->
        <mxCell id="url-mappings-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#2E86C1;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="100" y="160" width="700" height="480" as="geometry" />
        </mxCell>
        
        <mxCell id="table-title" value="📋 TABLE: url_mappings (MySQL, Sharded by short_code hash)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1B4F72;" vertex="1" parent="1">
          <mxGeometry x="120" y="170" width="660" height="30" as="geometry" />
        </mxCell>
        
        <!-- Columns -->
        <mxCell id="col-header" value="Column Name | Type | Purpose | WHY It Exists" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#85C1E9;strokeColor=#1B4F72;strokeWidth=2;fontStyle=1;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="120" y="210" width="660" height="30" as="geometry" />
        </mxCell>
        
        <!-- Column 1: short_code -->
        <mxCell id="col1" value="short_code | VARCHAR(7) | Primary Key, Unique identifier&#xa;&#xa;WHY: This is what users type after tinyurl.com/&#xa;7 chars = 62^7 = 3.5 trillion unique codes&#xa;VARCHAR not CHAR because Base62 varies (aB3 vs aB3xY7z)&#xa;PRIMARY KEY = O(log n) lookup speed via B-tree index" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D6EAF8;strokeColor=#2E86C1;strokeWidth=1;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="120" y="250" width="660" height="80" as="geometry" />
        </mxCell>
        
        <!-- Column 2: long_url -->
        <mxCell id="col2" value="long_url | TEXT | The original URL to redirect to&#xa;&#xa;WHY: URLs can be 2000+ characters (query params, fragments)&#xa;VARCHAR(255) is too short&#xa;TEXT allows up to 65KB&#xa;NOT indexed (only queried by short_code lookup)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D6EAF8;strokeColor=#2E86C1;strokeWidth=1;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="120" y="340" width="660" height="80" as="geometry" />
        </mxCell>
        
        <!-- Column 3: user_id -->
        <mxCell id="col3" value="user_id | INT | Foreign key to users table (who created this)&#xa;&#xa;WHY: Track who owns the short URL&#xa;Allows DELETE /urls/{short_code} only by owner&#xa;Analytics: 'my URLs' dashboard&#xa;NULL allowed for anonymous URLs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D6EAF8;strokeColor=#2E86C1;strokeWidth=1;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="120" y="430" width="660" height="70" as="geometry" />
        </mxCell>
        
        <!-- Column 4: created_at -->
        <mxCell id="col4" value="created_at | TIMESTAMP | When URL was created&#xa;&#xa;WHY: Enforces TTL (expire after 5 years)&#xa;SELECT WHERE created_at &lt; NOW() - INTERVAL 5 YEAR → delete&#xa;Analytics: URLs created per day&#xa;INDEXED for efficient cleanup queries" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D6EAF8;strokeColor=#2E86C1;strokeWidth=1;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="120" y="510" width="660" height="70" as="geometry" />
        </mxCell>
        
        <!-- Column 5: expires_at -->
        <mxCell id="col5" value="expires_at | TIMESTAMP | Optional expiry date (NULL = never expires)&#xa;&#xa;WHY: User-set expiration (promo valid till Dec 31)&#xa;Return 410 Gone if NOW() &gt; expires_at&#xa;INDEXED for cleanup job: DELETE WHERE expires_at &lt; NOW()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D6EAF8;strokeColor=#2E86C1;strokeWidth=1;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="120" y="590" width="660" height="60" as="geometry" />
        </mxCell>
        
        <!-- WHY Separate Analytics Table -->
        <mxCell id="analytics-section-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#E74C3C;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="850" y="160" width="700" height="480" as="geometry" />
        </mxCell>
        
        <mxCell id="analytics-title" value="📊 TABLE: url_clicks (ClickHouse, Columnar OLAP)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#922B21;" vertex="1" parent="1">
          <mxGeometry x="870" y="170" width="660" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="analytics-why" value="❓ WHY Separate from url_mappings?&#xa;&#xa;Write pattern: 115,740 clicks/sec (100:1 ratio)&#xa;If stored in url_mappings: 115K writes/sec on same table doing 115K reads/sec = lock contention nightmare&#xa;&#xa;Query pattern: Analytics = GROUP BY day, country, referrer (aggregations)&#xa;MySQL row-based = slow for aggregations&#xa;ClickHouse columnar = 1000x faster for analytics&#xa;&#xa;Retention: url_mappings keeps 5 years, clicks keeps 1 year (cheaper)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FADBD8;strokeColor=#E74C3C;strokeWidth=2;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="870" y="210" width="660" height="150" as="geometry" />
        </mxCell>
        
        <!-- Analytics Columns -->
        <mxCell id="analytics-col-header" value="Column Name | Type | Purpose" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5B7B1;strokeColor=#CB4335;strokeWidth=2;fontStyle=1;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="870" y="380" width="660" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="analytics-cols" value="short_code | VARCHAR(7) | Which URL was clicked&#xa;clicked_at | TIMESTAMP | When (time-series, sorted)&#xa;ip_address | VARCHAR(45) | Client IP (IPv6 support)&#xa;country | VARCHAR(2) | ISO country code (geo-IP lookup)&#xa;city | VARCHAR(100) | City name&#xa;referrer | TEXT | HTTP Referer header (where clicked from)&#xa;user_agent | TEXT | Browser/device info&#xa;&#xa;PRIMARY KEY: (short_code, clicked_at) → Time-series partitioning&#xa;PARTITION BY toYYYYMM(clicked_at) → Monthly partitions for fast cleanup" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FADBD8;strokeColor=#E74C3C;strokeWidth=1;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="870" y="420" width="660" height="150" as="geometry" />
        </mxCell>
        
        <mxCell id="analytics-example" value="Example Query:&#xa;SELECT country, COUNT(*) FROM url_clicks&#xa;WHERE short_code = 'aB3xY7z' AND clicked_at &gt;= '2026-08-01'&#xa;GROUP BY country ORDER BY COUNT(*) DESC&#xa;&#xa;Returns: US: 12450, IN: 8320, UK: 5670 (in 20ms on 1M rows!)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFE6E6;strokeColor=#C0392B;strokeWidth=1;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="870" y="580" width="660" height="80" as="geometry" />
        </mxCell>
        
        <!-- Indexes Section -->
        <mxCell id="indexes-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F4E6;strokeColor=#27AE60;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="100" y="680" width="1450" height="200" as="geometry" />
        </mxCell>
        
        <mxCell id="indexes-title" value="🔍 INDEXES — WHY Each Index Exists" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#145A32;" vertex="1" parent="1">
          <mxGeometry x="120" y="690" width="500" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="index1" value="PRIMARY KEY (short_code)&#xa;&#xa;WHY: Main lookup (GET /aB3xY7z)&#xa;B-tree index = O(log n) = ~5ms for 1B rows&#xa;Clustered index = data sorted by short_code physically" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ABEBC6;strokeColor=#27AE60;strokeWidth=1;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="120" y="730" width="450" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="index2" value="INDEX idx_user_created (user_id, created_at)&#xa;&#xa;WHY: User dashboard query&#xa;SELECT * FROM url_mappings&#xa;WHERE user_id = 123 ORDER BY created_at DESC&#xa;Composite index avoids filesort" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ABEBC6;strokeColor=#27AE60;strokeWidth=1;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="600" y="730" width="450" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="index3" value="INDEX idx_expires (expires_at)&#xa;&#xa;WHY: Cleanup job runs nightly&#xa;DELETE FROM url_mappings&#xa;WHERE expires_at &lt; NOW() AND expires_at IS NOT NULL&#xa;Without index = full table scan (hours!)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ABEBC6;strokeColor=#27AE60;strokeWidth=1;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1080" y="730" width="450" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="index-warning" value="⚠️ INDEX WARNING: Do NOT create index on long_url!&#xa;&#xa;Problem: TEXT columns = huge index size (GBs). B-tree on variable-length TEXT = slow.&#xa;We never query by long_url, only by short_code.&#xa;Creating this index = wasted disk + slower writes + zero benefit." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFEBEE;strokeColor=#D32F2F;strokeWidth=2;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="830" width="1410" height="40" as="geometry" />
        </mxCell>
        
        <!-- Sharding Strategy -->
        <mxCell id="sharding-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF3CF;strokeColor=#F39C12;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="100" y="920" width="1450" height="220" as="geometry" />
        </mxCell>
        
        <mxCell id="sharding-title" value="🔀 SHARDING STRATEGY — How to Split Across 10 MySQL Servers" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#9A7D0A;" vertex="1" parent="1">
          <mxGeometry x="120" y="930" width="800" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="sharding-algo" value="Shard Key: hash(short_code) % 10&#xa;&#xa;Example:&#xa;short_code = 'aB3xY7z'&#xa;hash('aB3xY7z') = 38572948 (CRC32 or MurmurHash)&#xa;38572948 % 10 = 8&#xa;→ Store in Shard 8 (MySQL server db8.example.com)&#xa;&#xa;On read:&#xa;GET /aB3xY7z → compute hash → route to Shard 8 → SELECT WHERE short_code = 'aB3xY7z'&#xa;&#xa;WHY hash(short_code)?&#xa;✅ Uniform distribution (each shard gets ~equal rows)&#xa;✅ Point lookups stay on one shard (no cross-shard joins)&#xa;✅ No hotspots (popular URLs don't all land on Shard 1)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FEF5E7;strokeColor=#F39C12;strokeWidth=2;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="120" y="970" width="1410" height="160" as="geometry" />
        </mxCell>
        
        <!-- Key Takeaway -->
        <mxCell id="takeaway" value="🎯 KEY TAKEAWAY:&#xa;&#xa;url_mappings = OLTP (Online Transaction Processing): fast point lookups, indexed by short_code&#xa;url_clicks = OLAP (Online Analytical Processing): aggregate queries, time-series partitions&#xa;&#xa;NEVER mix OLTP and OLAP in same table → performance disaster&#xa;Sharding by hash(short_code) → uniform distribution, no hotspots, linear scalability" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#E8DAEF;strokeColor=#8E44AD;strokeWidth=3;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="1160" width="1450" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
