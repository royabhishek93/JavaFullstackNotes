<mxCell id="mediaUploader" value="Media&#10;Uploader Svc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="210" y="130" width="120" height="50" as="geometry"/></mxCell>
