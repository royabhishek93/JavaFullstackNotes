<mxCell id="student" value="Student" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="640" y="130" width="100" height="50" as="geometry"/></mxCell>
<mxCell id="studentLine" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#1976d2;strokeColor=#1976d2" vertex="1" parent="1"><mxGeometry x="685" y="210" width="10" height="1650" as="geometry"/></mxCell>
<mxCell id="paymentSvc" value="Payment&#10;Svc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=3;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="770" y="130" width="100" height="50" as="geometry"/></mxCell>
<mxCell id="paymentLine" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#388e3c;strokeColor=#388e3c" vertex="1" parent="1"><mxGeometry x="815" y="210" width="10" height="1650" as="geometry"/></mxCell>
<mxCell id="stripe" value="Stripe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="900" y="130" width="100" height="50" as="geometry"/></mxCell>
<mxCell id="stripeLine" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#f57f17;strokeColor=#f57f17" vertex="1" parent="1"><mxGeometry x="945" y="210" width="10" height="1650" as="geometry"/></mxCell>
<mxCell id="kafka" value="Kafka" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcc80;strokeColor=#ef6c00;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="1030" y="130" width="90" height="50" as="geometry"/></mxCell>
<mxCell id="kafkaLine" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#ef6c00;strokeColor=#ef6c00" vertex="1" parent="1"><mxGeometry x="1070" y="210" width="10" height="1650" as="geometry"/></mxCell>
<mxCell id="enrollConsumer" value="Enrollment&#10;Consumer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#ef6c00;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="1150" y="130" width="120" height="50" as="geometry"/></mxCell>
<mxCell id="enrollLine" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#ef6c00;strokeColor=#ef6c00" vertex="1" parent="1"><mxGeometry x="1205" y="210" width="10" height="1650" as="geometry"/></mxCell>
<mxCell id="videoPlayback" value="Video&#10;Playback Svc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=3;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="1300" y="130" width="120" height="50" as="geometry"/></mxCell>
<mxCell id="videoLine" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#388e3c;strokeColor=#388e3c" vertex="1" parent="1"><mxGeometry x="1355" y="210" width="10" height="1650" as="geometry"/></mxCell>
<mxCell id="cdn" value="CDN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="1450" y="130" width="90" height="50" as="geometry"/></mxCell>
<mxCell id="cdnLine" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#f57f17;strokeColor=#f57f17" vertex="1" parent="1"><mxGeometry x="1490" y="210" width="10" height="1650" as="geometry"/></mxCell>
<mxCell id="progressSvc" value="Progress&#10;Svc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="1570" y="130" width="100" height="50" as="geometry"/></mxCell>
<mxCell id="progressLine" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#388e3c;strokeColor=#388e3c" vertex="1" parent="1"><mxGeometry x="1615" y="210" width="10" height="1650" as="geometry"/></mxCell>
<mxCell id="progressConsumer" value="Progress&#10;Consumer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#ef6c00;strokeWidth=3;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="1700" y="130" width="120" height="50" as="geometry"/></mxCell>
<mxCell id="progressConsumerLine" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#ef6c00;strokeColor=#ef6c00" vertex="1" parent="1"><mxGeometry x="1755" y="210" width="10" height="1650" as="geometry"/></mxCell>
<mxCell id="progressDB" value="Progress&#10;DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="1850" y="130" width="100" height="50" as="geometry"/></mxCell>
<mxCell id="progressDBLine" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#7b1fa2;strokeColor=#7b1fa2" vertex="1" parent="1"><mxGeometry x="1895" y="210" width="10" height="1650" as="geometry"/></mxCell>
<mxCell id="certWorker" value="Certificate&#10;Consumer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#ef6c00;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="1980" y="130" width="120" height="50" as="geometry"/></mxCell>
<mxCell id="certLine" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#ef6c00;strokeColor=#ef6c00" vertex="1" parent="1"><mxGeometry x="2035" y="210" width="10" height="1650" as="geometry"/></mxCell>
<mxCell id="phase1" value="PHASE 1: VIDEO UPLOAD AND ASYNC TRANSCODE" style="text;html=1;strokeColor=#c62828;fillColor=#ffebee;align=left;fontSize=12;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="2150" y="230" width="410" height="25" as="geometry"/></mxCell>
<mxCell id="s1" value="1. POST /courses/lessons/video" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#1976d2;fontSize=10" edge="1" parent="1" source="instructorLine" target="mediaLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s2" value="2. generatePresignedUrl&#10;putObject expires 3600s" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#388e3c;fontSize=10" edge="1" parent="1" source="mediaLine" target="s3Line"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s3resp" value="3. {uploadURL, videoId}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeWidth=1;strokeColor=#388e3c;fontSize=10" edge="1" parent="1" source="mediaLine" target="instructorLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s4" value="4. S3 PUT presignedURL&#10;chunked resumable 5GB max" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=3;strokeColor=#c62828;fontSize=10" edge="1" parent="1" source="instructorLine" target="s3Line"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s5" value="5. S3 event Lambda&#10;Kafka.send(video.uploaded)" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#ef6c00;fontSize=10" edge="1" parent="1" source="s3Line" target="kafkaLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s6" value="6. Consume video.uploaded" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#ef6c00;fontSize=10" edge="1" parent="1" source="kafkaLine" target="transcodeLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s7" value="7. Download original.mp4" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#c62828;fontSize=10" edge="1" parent="1" source="transcodeLine" target="s3Line"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s8" value="8. FFmpeg transcode&#10;1080p/720p/480p/360p&#10;HLS 6-sec segments&#10;10-15 min processing" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=3;strokeColor=#ef6c00;fontSize=10" edge="1" parent="1" source="transcodeLine" target="transcodeLine"><mxGeometry width="80" relative="1" as="geometry"><mxPoint x="535" y="440" as="sourcePoint"/><mxPoint x="555" y="440" as="offset"/></mxGeometry></mxCell>
<mxCell id="s9" value="9. Upload master.m3u8&#10;+ variants + thumbnails" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#c62828;fontSize=10" edge="1" parent="1" source="transcodeLine" target="s3Line"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s10" value="10. UPDATE lessons&#10;video_url processing_status=COMPLETED" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#7b1fa2;fontSize=10" edge="1" parent="1" source="transcodeLine" target="progressDBLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s11" value="11. Notification: video ready" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeWidth=1;strokeColor=#388e3c;fontSize=10" edge="1" parent="1" source="transcodeLine" target="instructorLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="phase2" value="PHASE 2: PAYMENT AND ENROLLMENT (5-LAYER IDEMPOTENCY)" style="text;html=1;strokeColor=#7b1fa2;fillColor=#f3e5f5;align=left;fontSize=12;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="2150" y="480" width="410" height="25" as="geometry"/></mxCell>
<mxCell id="s12" value="12. POST /courses/enroll $49.99" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#1976d2;fontSize=10" edge="1" parent="1" source="studentLine" target="paymentLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s13" value="13. Create PaymentIntent&#10;metadata enrollmentRequestId" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=3;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="paymentLine" target="stripeLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s14" value="14. {id, client_secret,&#10;status:requires_payment}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeWidth=1;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="stripeLine" target="paymentLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s15" value="15. INSERT payments&#10;status=PENDING" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#7b1fa2;fontSize=10" edge="1" parent="1" source="paymentLine" target="paymentLine"><mxGeometry width="80" relative="1" as="geometry"><mxPoint x="815" y="580" as="sourcePoint"/><mxPoint x="835" y="580" as="offset"/></mxGeometry></mxCell>
<mxCell id="s16" value="16. clientSecret" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeWidth=1;strokeColor=#388e3c;fontSize=10" edge="1" parent="1" source="paymentLine" target="studentLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s17" value="17. confirmCardPayment&#10;2-5 sec processing" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#1976d2;fontSize=10" edge="1" parent="1" source="studentLine" target="stripeLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s18" value="18. Webhook payment_intent.succeeded" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=3;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="stripeLine" target="paymentLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s19" value="19. Verify signature&#10;UPDATE payments status=COMPLETED" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#7b1fa2;fontSize=10" edge="1" parent="1" source="paymentLine" target="paymentLine"><mxGeometry width="80" relative="1" as="geometry"><mxPoint x="815" y="660" as="sourcePoint"/><mxPoint x="835" y="660" as="offset"/></mxGeometry></mxCell>
<mxCell id="s20" value="20. Kafka.send(payment.completed)" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#ef6c00;fontSize=10" edge="1" parent="1" source="paymentLine" target="kafkaLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s21" value="21. Consume payment.completed" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#ef6c00;fontSize=10" edge="1" parent="1" source="kafkaLine" target="enrollLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s22" value="22. Idempotency check&#10;SELECT COUNT enrollments&#10;count=0 proceed" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#7b1fa2;fontSize=10" edge="1" parent="1" source="enrollLine" target="enrollLine"><mxGeometry width="80" relative="1" as="geometry"><mxPoint x="1205" y="750" as="sourcePoint"/><mxPoint x="1225" y="750" as="offset"/></mxGeometry></mxCell>
<mxCell id="s23" value="23. INSERT enrollments&#10;completion_status=0.0" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#7b1fa2;fontSize=10" edge="1" parent="1" source="enrollLine" target="progressDBLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s24" value="24. Kafka.send(payment.completed)&#10;→ Permission Sync consumes&#10;INSERT Access ACTIVE LIFETIME" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#ef6c00;fontSize=10" edge="1" parent="1" source="enrollLine" target="kafkaLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="phase3" value="PHASE 3: VIDEO PLAYBACK (ACCESS CHECK + CDN)" style="text;html=1;strokeColor=#388e3c;fillColor=#e8f5e9;align=left;fontSize=12;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="2150" y="850" width="410" height="25" as="geometry"/></mxCell>
<mxCell id="s25" value="25. GET /lessons/{id}/video" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#1976d2;fontSize=10" edge="1" parent="1" source="studentLine" target="videoLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s26" value="26. Check Access table&#10;SELECT status FROM access&#10;WHERE user_id AND course_id" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=3;strokeColor=#7b1fa2;fontSize=10" edge="1" parent="1" source="videoLine" target="progressDBLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s27" value="27. status=ACTIVE&#10;if REVOKED → 403" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeWidth=1;strokeColor=#7b1fa2;fontSize=10" edge="1" parent="1" source="progressDBLine" target="videoLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s28" value="28. Generate CloudFront&#10;signed URL expires 24h" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="videoLine" target="cdnLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s29" value="29. {videoURL:signedURL,&#10;thumbnailURL, duration}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeWidth=1;strokeColor=#388e3c;fontSize=10" edge="1" parent="1" source="videoLine" target="studentLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s30" value="30. fetch master.m3u8&#10;adaptive bitrate select" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=3;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="studentLine" target="cdnLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s31" value="31. Fetch .ts segments&#10;buffer 30 sec ahead&#10;95% cache hit &lt;50ms" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeWidth=1;strokeColor=#f57f17;fontSize=10" edge="1" parent="1" source="cdnLine" target="studentLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="phase4" value="PHASE 4: PROGRESS BATCHING (30-SEC HEARTBEAT)" style="text;html=1;strokeColor=#ef6c00;fillColor=#fff3e0;align=left;fontSize=12;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="2150" y="1080" width="410" height="25" as="geometry"/></mxCell>
<mxCell id="s32" value="32. Heartbeat 10s each&#10;batch 3 events (30s)&#10;POST /progress/events" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#1976d2;fontSize=10" edge="1" parent="1" source="studentLine" target="progressLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s33" value="33. Kafka.send(video.progress)&#10;100 partitions by user_id" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#ef6c00;fontSize=10" edge="1" parent="1" source="progressLine" target="kafkaLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s34" value="34. 200 OK immediately" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeWidth=1;strokeColor=#388e3c;fontSize=10" edge="1" parent="1" source="progressLine" target="studentLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s35" value="35. Consume video.progress&#10;10 instances 100 partitions" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#ef6c00;fontSize=10" edge="1" parent="1" source="kafkaLine" target="progressConsumerLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s36" value="36. UPSERT progress:&#10;last_position_sec=140 (latest)&#10;max_position_sec=GREATEST(&#10;existing,140) never decreases" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=3;strokeColor=#7b1fa2;fontSize=10" edge="1" parent="1" source="progressConsumerLine" target="progressDBLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="phase5" value="PHASE 5: COMPLETION CHECK (95% WATCHED)" style="text;html=1;strokeColor=#c62828;fillColor=#ffebee;align=left;fontSize=12;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="2150" y="1280" width="410" height="25" as="geometry"/></mxCell>
<mxCell id="s37" value="37. IF max_position_sec &gt;=&#10;duration_sec × 0.95&#10;→ status=COMPLETED" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#388e3c;fontSize=10" edge="1" parent="1" source="progressConsumerLine" target="progressConsumerLine"><mxGeometry width="80" relative="1" as="geometry"><mxPoint x="1755" y="1330" as="sourcePoint"/><mxPoint x="1775" y="1330" as="offset"/></mxGeometry></mxCell>
<mxCell id="s38" value="38. UPDATE enrollments&#10;completion_status = (completed&#10;lessons / total) × 100" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#7b1fa2;fontSize=10" edge="1" parent="1" source="progressConsumerLine" target="progressDBLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s39" value="39. IF completion_status=100&#10;Kafka.send(course.completed)" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=3;strokeColor=#c62828;fontSize=10" edge="1" parent="1" source="progressConsumerLine" target="kafkaLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="phase6" value="PHASE 6: CERTIFICATE GENERATION (IDEMPOTENT)" style="text;html=1;strokeColor=#7b1fa2;fillColor=#f3e5f5;align=left;fontSize=12;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="2150" y="1460" width="410" height="25" as="geometry"/></mxCell>
<mxCell id="s40" value="40. Consume course.completed" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#ef6c00;fontSize=10" edge="1" parent="1" source="kafkaLine" target="certLine"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
<mxCell id="s41" value="41. Verify no duplicate:&#10;SELECT COUNT certificates&#10;count=0 proceed (idempotent)" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#7b1fa2;fontSize=10" edge="1" parent="1" source="certLine" target="certLine"><mxGeometry width="80" relative="1" as="geometry"><mxPoint x="2035" y="1510" as="sourcePoint"/><mxPoint x="2055" y="1510" as="offset"/></mxGeometry></mxCell>
<mxCell id="s42" value="42. Fetch template&#10;fill name/course/date" style="html=1;verticalAlign=bottom;endArrow=block;strokeWidth=2;strokeColor=#c62828;fontSize=10" edge="1" parent="1" source="certLine" target="s3Line"><mxGeometry width="80" relative="1" as="geometry"/></mxCell>
