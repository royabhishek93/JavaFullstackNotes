<mxfile host="app.diagrams.net"><diagram name="Video Upload Play Progress Flow" id="learn-seq"><mxGraphModel dx="2600" dy="1800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2600" pageHeight="2000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="ONLINE LEARNING PLATFORM - Video Upload, Playback, Progress &amp; Payment Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="60" y="20" width="2480" height="35" as="geometry"/></mxCell>
<mxCell id="subtitle" value="6 Phases: (1) Video Upload &amp; Async Transcode | (2) Payment &amp; Enrollment | (3) Video Playback | (4) Progress Batching | (5) Completion Check | (6) Certificate Generation" style="text;html=1;strokeColor=none;fillColor=#e8eaf6;align=center;rounded=1;fontSize=12" vertex="1" parent="1"><mxGeometry x="80" y="65" width="2440" height="28" as="geometry"/></mxCell>
