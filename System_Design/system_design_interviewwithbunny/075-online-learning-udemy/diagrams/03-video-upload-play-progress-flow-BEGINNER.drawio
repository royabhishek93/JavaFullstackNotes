<mxCell id="s3" value="S3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="370" y="130" width="80" height="50" as="geometry"/></mxCell>
<mxCell id="s3Line" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#c62828;strokeColor=#c62828" vertex="1" parent="1"><mxGeometry x="405" y="210" width="10" height="1650" as="geometry"/></mxCell>
<mxCell id="transcodeWorker" value="Transcode&#10;Worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#ef6c00;strokeWidth=3;fontSize=11;align=center" vertex="1" parent="1"><mxGeometry x="480" y="130" width="120" height="50" as="geometry"/></mxCell>
