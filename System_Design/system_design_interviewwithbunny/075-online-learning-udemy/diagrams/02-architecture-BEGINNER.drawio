<mxCell id="mediaUploaderSvc" value="Media Uploader Svc&#10;S3 presigned URL&#10;resumable 5GB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=3;fontSize=11" vertex="1" parent="1"><mxGeometry x="290" y="410" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="videoPlaybackSvc" value="Video Playback Svc&#10;Access table check&#10;CloudFront sign 24h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=3;fontSize=11" vertex="1" parent="1"><mxGeometry x="520" y="410" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="progressSvc" value="User Progress Svc&#10;Batch 3 events/30s&#10;Kafka publish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="750" y="410" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="enrollmentSvc" value="Enrollment Svc&#10;5-layer idempotency&#10;UNIQUE constraint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=3;fontSize=11" vertex="1" parent="1"><mxGeometry x="980" y="410" width="200" height="90" as="geometry"/></mxCell>
