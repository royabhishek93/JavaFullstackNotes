<mxCell id="quizSvc" value="Quiz Svc&#10;quiz_attempts state&#10;auto-grade MCQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="1440" y="410" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="searchSvc" value="Course Search Svc&#10;Elasticsearch query&#10;ngram autocomplete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="1670" y="410" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="permissionSync" value="Permission Sync Svc&#10;payment/refund events&#10;Access table upsert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="1900" y="410" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="reviewSvc" value="Comment &amp; Review Svc&#10;rating 1-5 + comment&#10;UNIQUE per enrolled student" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="2120" y="410" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="workerLayer" value="ASYNC WORKER LAYER (Kafka Consumers)" style="text;html=1;strokeColor=#ef6c00;fillColor=#fff3e0;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="530" width="2280" height="25" as="geometry"/></mxCell>
<mxCell id="transcodeWorker" value="Video Transcode Worker&#10;(Spot Instances)&#10;FFmpeg 4 resolutions&#10;HLS 6-sec segments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#ef6c00;strokeWidth=3;fontSize=11" vertex="1" parent="1"><mxGeometry x="80" y="570" width="220" height="100" as="geometry"/></mxCell>
<mxCell id="progressConsumer" value="user_tracking_consumer&#10;10 instances&#10;GREATEST upsert&#10;completion check 95%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#ef6c00;strokeWidth=3;fontSize=11" vertex="1" parent="1"><mxGeometry x="320" y="570" width="220" height="100" as="geometry"/></mxCell>
<mxCell id="enrollmentConsumer" value="Enrollment Consumer&#10;idempotency check&#10;INSERT enrollment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#ef6c00;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="560" y="570" width="220" height="100" as="geometry"/></mxCell>
<mxCell id="certificateWorker" value="Certificate Consumer&#10;100% completion&#10;PDF render S3 upload&#10;idempotent guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#ef6c00;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="800" y="570" width="220" height="100" as="geometry"/></mxCell>
<mxCell id="cdcPipeline" value="Aggregator CDC&#10;Course DB changes&#10;sync to Elasticsearch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#ef6c00;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="1040" y="570" width="220" height="100" as="geometry"/></mxCell>
<mxCell id="notificationSvc" value="Notification Svc&#10;email push&#10;video ready cert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#ef6c00;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="1280" y="570" width="220" height="100" as="geometry"/></mxCell>
<mxCell id="dataLayer" value="DATA LAYER (PostgreSQL Sharded + S3 Video + Kafka Events + Elasticsearch + Redis Cache)" style="text;html=1;strokeColor=#7b1fa2;fillColor=#f3e5f5;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="700" width="2280" height="25" as="geometry"/></mxCell>
<mxCell id="courseDB" value="Course DB&#10;PostgreSQL&#10;courses enrollments&#10;quiz_attempts" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="80" y="740" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="progressDB" value="Progress DB&#10;sharded by user_id&#10;last/max_position_sec" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=3;fontSize=11" vertex="1" parent="1"><mxGeometry x="320" y="740" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="paymentDB" value="Payment DB&#10;orders payments&#10;access sharded by&#10;created_at" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;strokeWidth=3;fontSize=11" vertex="1" parent="1"><mxGeometry x="560" y="740" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="kafka" value="Kafka Topics&#10;video.uploaded&#10;video.progress 100p&#10;payment.completed&#10;course.completed" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffcc80;strokeColor=#ef6c00;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="800" y="740" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="s3" value="S3 Blob Storage&#10;raw video 5GB&#10;HLS segments&#10;Glacier after 90d" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="1040" y="740" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="elastic" value="Elasticsearch&#10;course search index&#10;full-text ngram&#10;facets category price" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="1280" y="740" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="redis" value="Redis Cache&#10;course details 1h TTL&#10;enrollment check 24h&#10;recommendations" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="1520" y="740" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="cdn" value="CloudFront CDN&#10;200+ edges&#10;95% cache hit&#10;30-day segment TTL" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=3;fontSize=11" vertex="1" parent="1"><mxGeometry x="1760" y="740" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="whyAsync" value="WHY ASYNC VIDEO TRANSCODING (NEVER SYNC ON UPLOAD)? A 2GB 1080p mp4 needs FFmpeg processing into 4 resolutions plus HLS packaging, taking 10-15 minutes. Holding an HTTP connection that long causes timeouts, wastes always-on server CPU, and delivers terrible UX. Solution: instructor uploads directly to S3 via presigned URL (bypasses server entirely), S3 event triggers Lambda, Lambda publishes Kafka video.uploaded, a pool of cheap Spot EC2 workers (70% cheaper than on-demand) picks it up asynchronously. Instructor gets instant upload confirmation and an email 15 minutes later when ready. Sync transcoding in the upload API would block the connection, crash on timeouts, and triple compute cost by running always-on instead of Spot." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=3;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="80" y="880" width="700" height="140" as="geometry"/></mxCell>
<mxCell id="whyCDN" value="WHY CDN IS MANDATORY FOR LESS THAN 2 SECOND STARTUP? Raw S3 direct access from a single region gives 200-500ms round-trip latency globally, failing the startup target entirely. CloudFront has 200+ edge locations worldwide; the first student in Mumbai watching a course causes CloudFront to cache segments at the Mumbai edge, every student after hits the local edge in under 50ms. Cache hit rate is 95%+ for popular courses, meaning 95% of requests never touch origin S3. Startup breakdown: DNS 50ms + TLS 100ms + manifest 200ms + first 6-second segment 500ms equals 850ms total, well under the 2 second target. S3 replication to every region would be expensive, slow to propagate, and not designed for billions of tiny 6-second segment reads." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="800" y="880" width="700" height="140" as="geometry"/></mxCell>
<mxCell id="whyProgress" value="WHY TWO POSITION FIELDS FOR PROGRESS TRACKING? last_position_sec always stores the latest position sent, used purely to resume playback where the student left off. max_position_sec uses GREATEST(existing, new) so it can only increase, never decrease on rewind, and is used purely for the completion check (95% watched threshold). If you stored only current position, a student rewinding to relisten a concept then closing the tab would incorrectly un-complete their progress. Batching 3 heartbeats over 30 seconds on the client reduces API call volume 3x, 1M students generating 6M calls/min drops to 2M calls/min purely through client-side buffering, with Kafka absorbing bursts asynchronously." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1520" y="880" width="760" height="140" as="geometry"/></mxCell>
<mxCell id="whyIdempotency" value="WHY FIVE-LAYER ENROLLMENT IDEMPOTENCY? Payment and enrollment must never diverge: charging without enrolling, or enrolling without charging, are both catastrophic. Layer 1: client-generated enrollmentRequestId means Stripe deduplicates PaymentIntents on double-click. Layer 2: Kafka consumer checks DB for existing enrollment before INSERT, skipping duplicate webhook deliveries. Layer 3: UNIQUE(user_id, course_id) constraint is the final database-level safety net against race conditions. Layer 4: a polling backup queries Stripe every 5 minutes for PENDING payments in case the webhook itself never arrives. Layer 5: all paths converge to the same idempotent final state regardless of event ordering, since Kafka can redeliver events out of order across retries." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="80" y="1040" width="720" height="120" as="geometry"/></mxCell>
<mxCell id="whyAccess" value="WHY ACCESS TABLE SEPARATE FROM ENROLLMENTS? Enrollment is a permanent historical record, never deleted, proving the student once joined. Access is a keycard determining if they can watch video right now, with scope_type (LIFETIME or SUBSCRIPTION) and status (ACTIVE/REVOKED/EXPIRED). Permission Sync Service listens to payment.completed, refund.issued, subscription.expired Kafka events and updates Access independently. Video Playback Service checks Access, not Enrollments, before issuing a signed CloudFront URL. This lets refunds revoke access without mutating enrollment history, and lets subscription users hold many simultaneous access windows cleanly." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="820" y="1040" width="680" height="120" as="geometry"/></mxCell>
<mxCell id="whyElastic" value="WHY ELASTICSEARCH FOR COURSE SEARCH (NOT SQL LIKE)? SQL LIKE percent-machine-learning-percent scans the entire 100K-row courses table on every keypress, cannot use an index. Elasticsearch pre-builds an inverted index mapping every word to matching courses, returning instant ranked results. It also handles typo tolerance via fuzzy matching, relevance scoring, faceted filters (category AND price AND rating in one sub-millisecond query), and ngram autocomplete. The CDC aggregator pipeline keeps Elasticsearch synced with Course DB changes asynchronously, so search stays near-real-time without ever sitting in the hot write path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="1520" y="1040" width="760" height="120" as="geometry"/></mxCell>
<mxCell id="flowSummary" value="CRITICAL PATH: Instructor upload S3 presigned URL Lambda trigger Kafka video.uploaded FFmpeg Spot workers transcode 4 resolutions HLS segments S3 upload CDN cache. Student enroll Stripe PaymentIntent webhook confirm Kafka payment.completed Enrollment Consumer INSERT enrollment Permission Sync INSERT Access ACTIVE. Student watch Video Playback Svc check Access CloudFront signed URL adaptive bitrate player. Progress batch 30s Kafka video.progress consumer GREATEST upsert 95% completion Kafka course.completed Certificate Consumer PDF render S3 upload." style="text;html=1;strokeColor=#1976d2;fillColor=#e3f2fd;align=center;fontSize=11;rounded=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="80" y="1180" width="2160" height="50" as="geometry"/></mxCell>
<mxCell id="scaleNumbers" value="SCALE: 100K+ courses, millions of enrolled students, billions of HLS segments, petabytes of content, millions of video requests per day, video startup under 2 sec, API latency under 200ms listing under 100ms enrollment check, 99.9% uptime, 11 nines S3 durability, Kafka 100 partitions by user_id 100K events/sec, 1 master + 5 read replicas PostgreSQL, Redis 90% hit rate, CDN 95% cache hit rate less than 50ms latency" style="text;html=1;strokeColor=#ef6c00;fillColor=#fff3e0;align=center;fontSize=11;rounded=1" vertex="1" parent="1"><mxGeometry x="80" y="1250" width="2160" height="40" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
