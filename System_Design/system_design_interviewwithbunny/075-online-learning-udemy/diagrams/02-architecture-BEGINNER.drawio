<mxfile host="app.diagrams.net"><diagram name="Architecture" id="learn-arch"><mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2400" pageHeight="1200" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="ONLINE LEARNING PLATFORM - Architecture (Async Transcode + CDN Streaming + Progress + Payment)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1"><mxGeometry x="60" y="20" width="2280" height="35" as="geometry"/></mxCell>
