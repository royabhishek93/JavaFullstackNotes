<mxCell id="serviceLayer" value="SERVICE LAYER (Event-Driven with Kafka Async Processing)" style="text;html=1;strokeColor=#388e3c;fillColor=#e8f5e9;align=left;fontSize=14;fontStyle=1;rounded=1" vertex="1" parent="1"><mxGeometry x="60" y="370" width="2280" height="25" as="geometry"/></mxCell>
