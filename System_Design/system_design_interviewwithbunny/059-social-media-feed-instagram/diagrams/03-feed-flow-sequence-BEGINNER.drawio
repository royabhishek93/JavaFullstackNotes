        <mxCell id="feed-svc-header" value="📰 Feed&#xa;Service" style="text;html=1;strokeColor=none;fillColor=#8e24aa;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
          <mxGeometry x="1450" y="180" width="140" height="40" as="geometry" />
        </mxCell>

        <!-- Bob Column -->
        <mxCell id="bob-lane" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1620" y="170" width="150" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="bob-header" value="👤 Bob&#xa;(Reader)" style="text;html=1;strokeColor=none;fillColor=#1976d2;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
          <mxGeometry x="1630" y="180" width="130" height="40" as="geometry" />
        </mxCell>

        <!-- PHASE 1: Post Creation (Green Path) -->
        <mxCell id="phase1-label" value="🟢 PHASE 1: POST CREATION (0-300ms)" style="text;html=1;strokeColor=none;fillColor=#c8e6c9;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="240" width="1800" height="30" as="geometry" />
        </mxCell>

        <!-- Step 1: Alice POSTs -->
        <mxCell id="step1-alice" value="POST /api/v1/posts&#xa;{content, media}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;fontSize=12;align=center" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="130" height="50" as="geometry" />
        </mxCell>

        <mxCell id="arrow-alice-apigw" value="t=0ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#1976d2;fontSize=12;fontStyle=1" edge="1" parent="1" source="step1-alice" target="step2-apigw">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Step 2: API GW validates -->
        <mxCell id="step2-apigw" value="Validate JWT&#xa;Rate limit check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=12;align=center" vertex="1" parent="1">
          <mxGeometry x="230" y="290" width="130" height="50" as="geometry" />
        </mxCell>

        <mxCell id="arrow-apigw-content" value="t=10ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#388e3c;fontSize=12;fontStyle=1" edge="1" parent="1" source="step2-apigw" target="step3-content">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 3: Content Service processes -->
        <mxCell id="step3-content" value="Validate:&#xa;• content &lt;5000 chars&#xa;• media &lt;500MB&#xa;Generate post_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontSize=12;align=center" vertex="1" parent="1">
          <mxGeometry x="400" y="280" width="150" height="70" as="geometry" />
        </mxCell>

        <!-- Step 4: Store in Cassandra -->
        <mxCell id="arrow-content-cassandra" value="INSERT&#xa;t=50ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#7b1fa2;fontSize=12;fontStyle=1" edge="1" parent="1" source="step3-content" target="step4-cassandra">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="step4-cassandra" value="INSERT INTO posts&#xa;(user_id, post_id,&#xa; content, media_urls)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=12;align=center" vertex="1" parent="1">
          <mxGeometry x="585" y="280" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="arrow-cassandra-return" value="ACK&#xa;t=100ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#7b1fa2;fontSize=11;dashed=1" edge="1" parent="1" source="step4-cassandra" target="step3-content">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="655" y="370" />
              <mxPoint x="475" y="370" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 5: Publish to Kafka -->
        <mxCell id="arrow-content-kafka" value="PUBLISH&#xa;t=120ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#e65100;fontSize=12;fontStyle=1" edge="1" parent="1" source="step3-content" target="step5-kafka">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="475" y="400" />
              <mxPoint x="825" y="400" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="step5-kafka" value="Topic: post.created&#xa;{post_id, user_id,&#xa; created_at}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=12;align=center" vertex="1" parent="1">
          <mxGeometry x="760" y="380" width="130" height="60" as="geometry" />
        </mxCell>

        <!-- Step 6: Return 202 to Alice -->
        <mxCell id="arrow-content-alice" value="202 Accepted&#xa;t=150ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#00c853;fontSize=12;fontStyle=1;dashed=1" edge="1" parent="1" source="step3-content" target="step6-alice-return">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="475" y="460" />
              <mxPoint x="125" y="460" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="step6-alice-return" value="✅ Post accepted&#xa;(fanout happening&#xa;async in background)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b9f6ca;strokeColor=#00c853;fontSize=12;align=center;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="55" y="420" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- PHASE 2: Fanout (Yellow Path) -->
        <mxCell id="phase2-label" value="🟡 PHASE 2: ASYNC FANOUT (Background Process, 0-2 seconds)" style="text;html=1;strokeColor=none;fillColor=#fff9c4;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="500" width="1800" height="30" as="geometry" />
        </mxCell>

        <!-- Step 7: Fanout Service consumes -->
        <mxCell id="arrow-kafka-fanout" value="CONSUME&#xa;t=200ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#c2185b;fontSize=12;fontStyle=1" edge="1" parent="1" source="step5-kafka" target="step7-fanout">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="825" y="570" />
              <mxPoint x="1000" y="570" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="step7-fanout" value="Read event&#xa;Extract user_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#c2185b;fontSize=12;align=center" vertex="1" parent="1">
          <mxGeometry x="930" y="540" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- Step 8: Query FollowerDB -->
        <mxCell id="arrow-fanout-followerdb" value="SELECT&#xa;t=250ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#3f51b5;fontSize=12;fontStyle=1" edge="1" parent="1" source="step7-fanout" target="step8-followerdb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="step8-followerdb" value="SELECT follower_id&#xa;WHERE followee_id&#xa;= 'alice'&#xa;&#xa;→ 500 followers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;fontSize=12;align=center" vertex="1" parent="1">
          <mxGeometry x="1105" y="530" width="140" height="80" as="geometry" />
        </mxCell>

        <mxCell id="arrow-followerdb-return" value="[bob, carol, ...]&#xa;t=300ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#3f51b5;fontSize=11;dashed=1" edge="1" parent="1" source="step8-followerdb" target="step7-fanout">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1175" y="640" />
              <mxPoint x="1000" y="640" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 9: LPUSH to Redis for each follower -->
        <mxCell id="step9-fanout-loop" value="FOR EACH follower:&#xa;(500 iterations)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#d84315;fontSize=13;align=center;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="925" y="680" width="150" height="50" as="geometry" />
        </mxCell>

        <mxCell id="arrow-fanout-loop-redis" value="LPUSH×500&#xa;t=300-2000ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#f57f17;fontSize=12;fontStyle=1" edge="1" parent="1" source="step9-fanout-loop" target="step10-redis-lpush">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="step10-redis-lpush" value="LPUSH feed:bob&#xa;{post_id}&#xa;&#xa;LPUSH feed:carol&#xa;{post_id}&#xa;...&#xa;(repeat 500×)&#xa;&#xa;LTRIM keep 1000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=12;align=center" vertex="1" parent="1">
          <mxGeometry x="1270" y="660" width="150" height="120" as="geometry" />
        </mxCell>

        <mxCell id="fanout-complete" value="✅ FANOUT COMPLETE&#xa;Bob's feed is now pre-built!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b9f6ca;strokeColor=#00c853;fontSize=13;align=center;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="920" y="820" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- PHASE 3: Bob Loads Feed (Blue Path) -->
        <mxCell id="phase3-label" value="🔵 PHASE 3: BOB LOADS FEED (Later, when Bob opens app — &lt;110ms total)" style="text;html=1;strokeColor=none;fillColor=#bbdefb;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="900" width="1800" height="30" as="geometry" />
        </mxCell>

        <!-- Step 11: Bob requests feed -->
        <mxCell id="step11-bob" value="GET /api/v1/&#xa;posts/feed&#xa;?limit=20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;fontSize=12;align=center" vertex="1" parent="1">
          <mxGeometry x="1630" y="950" width="130" height="60" as="geometry" />
        </mxCell>

        <mxCell id="arrow-bob-feedsvc" value="t=0ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#8e24aa;fontSize=12;fontStyle=1" edge="1" parent="1" source="step11-bob" target="step12-feedsvc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 12: Feed Service queries Redis -->
        <mxCell id="step12-feedsvc" value="Extract user_id&#xa;from JWT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#8e24aa;fontSize=12;align=center" vertex="1" parent="1">
          <mxGeometry x="1450" y="950" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="arrow-feedsvc-redis" value="LRANGE&#xa;t=10ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#f57f17;fontSize=12;fontStyle=1" edge="1" parent="1" source="step12-feedsvc" target="step13-redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="step13-redis" value="LRANGE feed:bob&#xa;0 19&#xa;&#xa;→ [post_123,&#xa;    post_122,&#xa;    post_121, ...]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=12;align=center" vertex="1" parent="1">
          <mxGeometry x="1270" y="940" width="150" height="85" as="geometry" />
        </mxCell>

        <mxCell id="arrow-redis-feedsvc" value="20 post_ids&#xa;t=15ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#f57f17;fontSize=11;dashed=1" edge="1" parent="1" source="step13-redis" target="step12-feedsvc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1345" y="1040" />
              <mxPoint x="1520" y="1040" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 14: Hydrate from Cassandra -->
        <mxCell id="arrow-feedsvc-cassandra" value="SELECT&#xa;WHERE&#xa;post_id IN(...)&#xa;t=20ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#7b1fa2;fontSize=12;fontStyle=1" edge="1" parent="1" source="step12-feedsvc" target="step14-cassandra">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1520" y="1070" />
              <mxPoint x="655" y="1070" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="step14-cassandra" value="SELECT * FROM&#xa;posts WHERE&#xa;post_id IN (...)&#xa;&#xa;→ 20 full posts&#xa;(content, media)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=12;align=center" vertex="1" parent="1">
          <mxGeometry x="580" y="1050" width="150" height="90" as="geometry" />
        </mxCell>

        <mxCell id="arrow-cassandra-feedsvc" value="Post data&#xa;t=70ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#7b1fa2;fontSize=11;dashed=1" edge="1" parent="1" source="step14-cassandra" target="step12-feedsvc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="655" y="1100" />
              <mxPoint x="1520" y="1100" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 15: Return to Bob -->
        <mxCell id="arrow-feedsvc-bob" value="200 OK&#xa;t=110ms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#00c853;fontSize=12;fontStyle=1;dashed=1" edge="1" parent="1" source="step12-feedsvc" target="step15-bob-result">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1520" y="1120" />
              <mxPoint x="1695" y="1120" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="step15-bob-result" value="✅ Feed loaded!&#xa;[20 posts with&#xa; content, media,&#xa; author info]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b9f6ca;strokeColor=#00c853;fontSize=13;align=center;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1625" y="1050" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- Legend/Summary Box -->
        <mxCell id="legend-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#0277bd;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="50" y="1200" width="1800" height="80" as="geometry" />
        </mxCell>

        <mxCell id="legend-title" value="⏱️ TIMING SUMMARY" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
