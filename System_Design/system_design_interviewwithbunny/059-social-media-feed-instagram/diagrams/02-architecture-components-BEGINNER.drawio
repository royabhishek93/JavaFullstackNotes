<mxfile host="app.diagrams.net">
  <diagram name="Social Media Architecture - BEGINNER" id="social-arch">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title -->
        <mxCell id="title" value="SOCIAL MEDIA ARCHITECTURE — Feed Generation Deep Dive" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="1600" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="subtitle" value="🎯 Push (Fanout on Write) vs Pull (Fanout on Read) • Redis cache • Async via Kafka" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="100" y="70" width="1600" height="30" as="geometry" />
        </mxCell>

        <!-- WHY Box 1: Why Redis for Feeds -->
        <mxCell id="why-redis-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#01579b;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="850" height="140" as="geometry" />
        </mxCell>
        
        <mxCell id="why-redis-title" value="❓ WHY REDIS FOR FEED CACHE?" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#01579b" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="810" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="why-redis-text" value="Problem: 115K feed loads per second × 200 followers avg = 23M database rows scanned/sec&#xa;&#xa;Redis is like a sticky note on the fridge — glance and read in &lt;10ms (everything in RAM)&#xa;Database is like a filing cabinet in the basement — accurate but slow (10-50ms per query)&#xa;&#xa;Redis stores each user's feed as a pre-built LIST of 1000 post_ids:&#xa;  • LRANGE feed:bob 0 19 → returns 20 post_ids instantly&#xa;  • No JOINs, no table scans, no locks&#xa;  • If Redis crashes, worst case: slower feed loads while rebuilding from DB (safe to lose)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="70" y="160" width="810" height="90" as="geometry" />
        </mxCell>

        <!-- WHY Box 2: Why Separate Post and Feed Services -->
        <mxCell id="why-separate-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="950" y="120" width="800" height="140" as="geometry" />
        </mxCell>
        
        <mxCell id="why-separate-title" value="❓ WHY SEPARATE POST SERVICE AND FEED SERVICE?" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#7b1fa2" vertex="1" parent="1">
          <mxGeometry x="970" y="130" width="760" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="why-separate-text" value="Restaurant analogy: Kitchen (Post Service) cooks food; Waiter (Feed Service) serves it&#xa;&#xa;Post Service:&#xa;  • Validates, stores, uploads media (1.2K writes/sec)&#xa;  • Owns Cassandra writes, S3 uploads&#xa;  • Scales for write throughput&#xa;&#xa;Feed Service:&#xa;  • Reads Redis cache, merges push + pull posts (115K reads/sec)&#xa;  • Owns Redis LRANGE operations&#xa;  • Scales for read throughput (different machines, different CPU/memory profiles)&#xa;&#xa;Bundling them = waste resources scaling both when only one is under load" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="970" y="160" width="760" height="90" as="geometry" />
        </mxCell>

        <!-- Main Data Flow -->
        <mxCell id="flow-title" value="📊 DATA FLOW: Post Creation → Fanout → Feed Load (6 Steps)" style="text;html=1;strokeColor=none;fillColor=#ffe082;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="280" width="1700" height="30" as="geometry" />
        </mxCell>

        <!-- Step 1: Client Posts -->
        <mxCell id="step1-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="330" width="180" height="140" as="geometry" />
        </mxCell>
        
        <mxCell id="step1-num" value="STEP 1" style="text;html=1;strokeColor=none;fillColor=#1976d2;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="160" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="step1-title" value="📱 Client Posts" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="160" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="step1-text" value="Alice creates post:&#xa;&#xa;POST /api/v1/posts&#xa;{content, media}&#xa;&#xa;→ API Gateway&#xa;→ Content Service" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="395" width="160" height="65" as="geometry" />
        </mxCell>

        <!-- Step 2: Store Post -->
        <mxCell id="step2-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="270" y="330" width="180" height="140" as="geometry" />
        </mxCell>
        
        <mxCell id="step2-num" value="STEP 2" style="text;html=1;strokeColor=none;fillColor=#388e3c;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
          <mxGeometry x="280" y="340" width="160" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="step2-title" value="💾 Store Post" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="280" y="370" width="160" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="step2-text" value="Content Service:&#xa;&#xa;1. Upload to S3&#xa;2. INSERT Cassandra:&#xa;   (user_id, post_id,&#xa;    content, media_urls)&#xa;3. Return 202 Accepted" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="395" width="160" height="65" as="geometry" />
        </mxCell>

        <!-- Step 3: Kafka Event -->
        <mxCell id="step3-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="490" y="330" width="180" height="140" as="geometry" />
        </mxCell>
        
        <mxCell id="step3-num" value="STEP 3" style="text;html=1;strokeColor=none;fillColor=#e65100;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
          <mxGeometry x="500" y="340" width="160" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="step3-title" value="📨 Kafka Event" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="500" y="370" width="160" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="step3-text" value="Publish async:&#xa;&#xa;Topic: 'post.created'&#xa;Payload:&#xa;{post_id, user_id,&#xa; created_at}&#xa;&#xa;→ Fanout Service" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="500" y="395" width="160" height="65" as="geometry" />
        </mxCell>

        <!-- Step 4: Fanout (PUSH) -->
        <mxCell id="step4-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#c2185b;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="710" y="330" width="180" height="140" as="geometry" />
        </mxCell>
        
        <mxCell id="step4-num" value="STEP 4" style="text;html=1;strokeColor=none;fillColor=#c2185b;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
          <mxGeometry x="720" y="340" width="160" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="step4-title" value="🚀 Fanout (PUSH)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="720" y="370" width="160" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="step4-text" value="Fanout Service:&#xa;&#xa;1. Query FollowerDB:&#xa;   500 followers&#xa;2. For each follower:&#xa;   LPUSH feed:bob&#xa;   {post_id}&#xa;3. Takes ~2 seconds" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="720" y="395" width="160" height="65" as="geometry" />
        </mxCell>

        <!-- Step 5: Feed Cached -->
        <mxCell id="step5-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="930" y="330" width="180" height="140" as="geometry" />
        </mxCell>
        
        <mxCell id="step5-num" value="STEP 5" style="text;html=1;strokeColor=none;fillColor=#f57f17;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
          <mxGeometry x="940" y="340" width="160" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="step5-title" value="⚡ Feed Cached" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="940" y="370" width="160" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="step5-text" value="Redis now has:&#xa;&#xa;feed:bob =&#xa;  [post_123,&#xa;   post_122,&#xa;   post_121, ...]&#xa;&#xa;Ready for instant read!" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="940" y="395" width="160" height="65" as="geometry" />
        </mxCell>

        <!-- Step 6: Client Reads Feed -->
        <mxCell id="step6-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#8e24aa;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1150" y="330" width="180" height="140" as="geometry" />
        </mxCell>
        
        <mxCell id="step6-num" value="STEP 6" style="text;html=1;strokeColor=none;fillColor=#8e24aa;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
          <mxGeometry x="1160" y="340" width="160" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="step6-title" value="📱 Client Reads Feed" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1160" y="370" width="160" height="25" as="geometry" />
        </mxCell>
        
        <mxCell id="step6-text" value="Bob opens app:&#xa;&#xa;LRANGE feed:bob 0 19&#xa;→ 20 post_ids &lt;10ms&#xa;&#xa;Hydrate from PostDB&#xa;&#xa;Total: ~110ms" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1160" y="395" width="160" height="65" as="geometry" />
        </mxCell>

        <!-- Flow Arrows -->
        <mxCell id="arrow-1-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;strokeColor=#1976d2;endArrow=block;endFill=1" edge="1" parent="1" source="step1-box" target="step2-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow-2-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;strokeColor=#388e3c;endArrow=block;endFill=1" edge="1" parent="1" source="step2-box" target="step3-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow-3-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;strokeColor=#e65100;endArrow=block;endFill=1" edge="1" parent="1" source="step3-box" target="step4-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow-4-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;strokeColor=#c2185b;endArrow=block;endFill=1" edge="1" parent="1" source="step4-box" target="step5-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow-5-6" value="Bob opens app" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;strokeColor=#8e24aa;endArrow=block;endFill=1;fontSize=13;fontStyle=1" edge="1" parent="1" source="step5-box" target="step6-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Database/Service Layer -->
        <mxCell id="db-layer-title" value="💾 DATABASE &amp; CACHE LAYER" style="text;html=1;strokeColor=none;fillColor=#b2dfdb;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="500" width="1700" height="30" as="geometry" />
        </mxCell>

        <!-- Redis Details -->
        <mxCell id="redis-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="50" y="550" width="420" height="200" as="geometry" />
        </mxCell>
        
        <mxCell id="redis-title" value="⚡ REDIS (Feed Cache)" style="text;html=1;strokeColor=none;fillColor=#e65100;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="400" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="redis-text" value="Key Patterns:&#xa;&#xa;feed:{user_id} → LIST of post_ids&#xa;  • LPUSH feed:bob {post_id}&#xa;  • LTRIM feed:bob 0 999 (keep latest 1000)&#xa;  • LRANGE feed:bob 0 19 (read 20 posts)&#xa;&#xa;likes_count:{post_id} → STRING&#xa;  • INCR likes_count:post_123&#xa;  • MGET batch reads&#xa;&#xa;Memory: ~50 bytes × 500M users × 1K posts = 25 GB&#xa;Throughput: 115K LRANGE/sec&#xa;Latency: &lt;10ms p99&#xa;&#xa;TTL: No expiry (ephemeral data, safe to lose)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="595" width="380" height="145" as="geometry" />
        </mxCell>

        <!-- Cassandra Details -->
        <mxCell id="cassandra-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="510" y="550" width="420" height="200" as="geometry" />
        </mxCell>
        
        <mxCell id="cassandra-title" value="🗄️ CASSANDRA (Posts DB)" style="text;html=1;strokeColor=none;fillColor=#7b1fa2;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
          <mxGeometry x="520" y="560" width="400" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="cassandra-text" value="Schema:&#xa;&#xa;PRIMARY KEY (user_id, created_at DESC, post_id)&#xa;  ↑ partition    ↑ clustering (newest first)&#xa;&#xa;post_id, content, media_urls[], visibility,&#xa;likes_count (denormalized), comments_count&#xa;&#xa;Why Cassandra?&#xa;  • 1.2K writes/sec (100M posts/day)&#xa;  • Partition by user_id = even distribution&#xa;  • Clustering by time = efficient range scans&#xa;  • No JOINs needed (denormalized counters)&#xa;  • Linear scalability (add nodes for writes)&#xa;&#xa;Query: SELECT * WHERE user_id='alice'&#xa;       ORDER BY created_at DESC LIMIT 100" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="530" y="595" width="380" height="145" as="geometry" />
        </mxCell>

        <!-- PostgreSQL Details -->
        <mxCell id="postgres-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="970" y="550" width="420" height="200" as="geometry" />
        </mxCell>
        
        <mxCell id="postgres-title" value="📊 POSTGRESQL (Users, Followers, Comments)" style="text;html=1;strokeColor=none;fillColor=#3f51b5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
          <mxGeometry x="980" y="560" width="400" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="postgres-text" value="Tables:&#xa;&#xa;users: user_id PK, username UNIQUE, email,&#xa;       followers_count (denormalized)&#xa;&#xa;followers: (follower_id, followee_id) PK,&#xa;           INDEX ON followee_id for reverse lookup&#xa;&#xa;comments: comment_id PK, post_id, user_id,&#xa;          parent_comment_id (NULL = top-level),&#xa;          content, likes_count&#xa;          INDEX ON (post_id, parent_comment_id)&#xa;&#xa;Why PostgreSQL?&#xa;  • Relational integrity (user profiles, social graph)&#xa;  • ACID for follows/unfollows (consistency matters)&#xa;  • Nested comments (recursive queries)&#xa;  • Read replicas for scaling reads" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="990" y="595" width="380" height="145" as="geometry" />
        </mxCell>

        <!-- S3 + CDN -->
        <mxCell id="s3-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1430" y="550" width="320" height="200" as="geometry" />
        </mxCell>
        
        <mxCell id="s3-title" value="🖼️ S3 + CloudFront CDN" style="text;html=1;strokeColor=none;fillColor=#388e3c;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
          <mxGeometry x="1440" y="560" width="300" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="s3-text" value="Media Storage:&#xa;&#xa;10TB uploaded/day&#xa;2 PB total storage&#xa;&#xa;Upload flow:&#xa;1. Client gets presigned URL&#xa;2. Direct upload to S3&#xa;3. Lambda triggers:&#xa;   • Resize: 150/400/1080px&#xa;   • Transcode video: HLS&#xa;&#xa;CDN:&#xa;• CloudFront edge cache&#xa;• 95% cache hit rate&#xa;• &lt;5ms serving from edge&#xa;• Saves bandwidth costs" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1450" y="595" width="280" height="145" as="geometry" />
        </mxCell>

        <!-- Push vs Pull Comparison -->
        <mxCell id="push-pull-title" value="🔄 PUSH vs PULL — When to Use Which?" style="text;html=1;strokeColor=none;fillColor=#ffccbc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="780" width="1700" height="30" as="geometry" />
        </mxCell>

        <!-- Push Model -->
        <mxCell id="push-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="50" y="830" width="540" height="180" as="geometry" />
        </mxCell>
        
        <mxCell id="push-title" value="🚀 PUSH MODEL (Fanout on Write)" style="text;html=1;strokeColor=none;fillColor=#388e3c;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
          <mxGeometry x="60" y="840" width="520" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="push-text" value="When: User has &lt;5,000 followers&#xa;&#xa;How it works:&#xa;1. Alice posts → Kafka event&#xa;2. Fanout Service queries FollowerDB (500 followers)&#xa;3. LPUSH to each follower's Redis feed (500 writes)&#xa;4. Takes 2 seconds to complete (async, user doesn't wait)&#xa;5. Bob's feed is PRE-BUILT before he opens app&#xa;6. Read: LRANGE feed:bob 0 19 → &lt;10ms&#xa;&#xa;Pros: ✅ Instant feed loads, ✅ Scales to billions of users&#xa;Cons: ❌ Write amplification (1 post = 500 writes)&#xa;        ❌ Breaks for celebrities (millions of writes)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="875" width="500" height="125" as="geometry" />
        </mxCell>

        <!-- Pull Model -->
        <mxCell id="pull-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffecb3;strokeColor=#ffa726;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="630" y="830" width="540" height="180" as="geometry" />
        </mxCell>
        
        <mxCell id="pull-title" value="📥 PULL MODEL (Fanout on Read)" style="text;html=1;strokeColor=none;fillColor=#ffa726;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
          <mxGeometry x="640" y="840" width="520" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="pull-text" value="When: Celebrity has &gt;5,000 followers&#xa;&#xa;How it works:&#xa;1. Selena posts → NO fanout, just store in Cassandra&#xa;2. Bob opens feed → Feed Service checks: does Bob follow celebs?&#xa;3. For each celebrity: SELECT latest 10 posts from PostDB&#xa;4. Merge with Bob's PUSH-based feed from Redis&#xa;5. Cache merged result (TTL = 10 min)&#xa;6. All 400M followers share ONE cached query result&#xa;&#xa;Pros: ✅ No write amplification, ✅ Handles unlimited followers&#xa;Cons: ❌ Slower feed loads (50-100ms vs 10ms)&#xa;        ❌ Celebrity posts may lag 5-10 min (cache TTL)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="650" y="875" width="500" height="125" as="geometry" />
        </mxCell>

        <!-- Hybrid Model -->
        <mxCell id="hybrid-box2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#8e24aa;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1210" y="830" width="540" height="180" as="geometry" />
        </mxCell>
        
        <mxCell id="hybrid-title2" value="🎯 HYBRID MODEL (Best of Both)" style="text;html=1;strokeColor=none;fillColor=#8e24aa;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
          <mxGeometry x="1220" y="840" width="520" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="hybrid-text2" value="Production reality: Instagram, Facebook use this&#xa;&#xa;Threshold: 5,000 followers&#xa;&#xa;&lt;5K followers:&#xa;  → Pure PUSH (fanout to all followers)&#xa;&#xa;5K-100K followers:&#xa;  → PUSH to active followers (logged in last 7 days)&#xa;  → PULL for inactive followers (query on-demand)&#xa;&#xa;&gt;100K followers:&#xa;  → Pure PULL (no fanout, query on-demand)&#xa;&#xa;Result: 99% of users on fast PUSH path&#xa;        Celebrities don't break the system" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1230" y="875" width="500" height="125" as="geometry" />
        </mxCell>

        <!-- Scale Numbers -->
        <mxCell id="scale-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b3e5fc;strokeColor=#0277bd;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="1040" width="1700" height="80" as="geometry" />
        </mxCell>

        <mxCell id="scale-title" value="📊 SCALE &amp; PERFORMANCE TARGETS" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="1050" width="1700" height="25" as="geometry" />
        </mxCell>

        <mxCell id="scale-row1" value="115K feed loads/sec • 1.2K post creations/sec • 100:1 read/write ratio • &lt;500ms feed load • &lt;10ms Redis LRANGE" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="1080" width="1680" height="15" as="geometry" />
        </mxCell>

        <mxCell id="scale-row2" value="25 GB Redis memory • 2 PB S3 storage • 200 avg followers/user • 5K follower threshold • 10 min cache TTL for celebrities" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
