        <mxCell id="num4" value="⚡ &lt;500ms feed load" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="600" y="995" width="160" height="20" as="geometry" />
        </mxCell>

        <mxCell id="num5" value="🖼️ 10TB media/day" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="780" y="995" width="150" height="20" as="geometry" />
        </mxCell>

        <mxCell id="num6" value="👥 200 avg follows/user" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="950" y="995" width="180" height="20" as="geometry" />
        </mxCell>

        <mxCell id="num7" value="📊 Read:Write = 100:1" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1150" y="995" width="180" height="20" as="geometry" />
        </mxCell>

        <mxCell id="num8" value="🎯 5K follower threshold" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1350" y="995" width="180" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
