        <mxCell id="num2" value="📝 100M posts/day" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="230" y="995" width="150" height="20" as="geometry" />
