        <mxCell id="num3" value="📖 115K feed loads/sec" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="400" y="995" width="180" height="20" as="geometry" />
