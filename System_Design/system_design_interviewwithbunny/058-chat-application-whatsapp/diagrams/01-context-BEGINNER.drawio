        <mxCell id="num5" value="📦 2PB media storage" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="750" y="830" width="150" height="30" as="geometry" />
        </mxCell>

        <mxCell id="num6" value="👥 256 max group size" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="920" y="830" width="150" height="30" as="geometry" />
        </mxCell>

        <mxCell id="num7" value="🗄️ 30-day msg retention" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
