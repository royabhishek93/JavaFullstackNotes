<mxfile host="app.diagrams.net">
  <diagram name="Chat Application Context - BEGINNER" id="chat-context">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title -->
        <mxCell id="title" value="CHAT APPLICATION CONTEXT — Like WhatsApp" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="1000" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="subtitle" value="🎯 Goal: Real-time message delivery with offline support, group chats, media sharing at 1B+ users scale" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="200" y="70" width="1000" height="30" as="geometry" />
        </mxCell>

        <!-- Phone Call Analogy Box -->
        <mxCell id="analogy-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="450" height="180" as="geometry" />
        </mxCell>
        
        <mxCell id="analogy-title" value="📞 WEBSOCKET = PHONE CALL ANALOGY" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="130" width="450" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="analogy-text" value="Old HTTP (walkie-talkie):&#xa;You press button → talk → say &quot;over&quot; → wait for response&#xa;&#xa;WebSocket (phone call):&#xa;Dial once → line stays open → both sides talk any time&#xa;&#xa;Why WebSocket for chat?&#xa;Server MUST reach you instantly when friend sends message&#xa;HTTP can't do that — only you can initiate HTTP requests" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="70" y="165" width="410" height="120" as="geometry" />
        </mxCell>

        <!-- Problem Box -->
        <mxCell id="problem-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="550" y="120" width="400" height="180" as="geometry" />
        </mxCell>
        
        <mxCell id="problem-title" value="❌ WITHOUT REAL-TIME ARCHITECTURE" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#cc0000;" vertex="1" parent="1">
          <mxGeometry x="550" y="130" width="400" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="problem-text" value="HTTP polling every second:&#xa;   • 1B users × 1 req/sec = 1B requests/second!&#xa;   • 99.9% of requests return &quot;nothing new&quot;&#xa;   • Battery drains in 2 hours&#xa;   • Message takes 1 second to arrive (slow)&#xa;&#xa;Without offline message queue:&#xa;   • Phone off for 10 minutes = lose all messages&#xa;   • No recovery mechanism" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="570" y="165" width="360" height="120" as="geometry" />
        </mxCell>

        <!-- WITH Architecture Box -->
        <mxCell id="with-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1000" y="120" width="350" height="180" as="geometry" />
        </mxCell>
        
        <mxCell id="with-title" value="✅ WITH WEBSOCKET + MESSAGE QUEUE" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#006600;" vertex="1" parent="1">
          <mxGeometry x="1000" y="130" width="350" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="with-text" value="Persistent WebSocket:&#xa;   • 1 connection stays open&#xa;   • Server pushes instantly&#xa;   • &lt;100ms message delivery&#xa;&#xa;Offline message queue:&#xa;   • Phone off? Messages wait&#xa;   • Come back online →&#xa;     all messages delivered&#xa;&#xa;Battery efficient! ✓" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1020" y="165" width="310" height="120" as="geometry" />
        </mxCell>

        <!-- System Boundary -->
        <mxCell id="system-boundary" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=4;dashed=1;dashPattern=8 8;" vertex="1" parent="1">
          <mxGeometry x="200" y="340" width="1000" height="420" as="geometry" />
        </mxCell>

        <mxCell id="system-title" value="💬 WHATSAPP CHAT SYSTEM" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="200" y="350" width="1000" height="30" as="geometry" />
        </mxCell>

        <!-- Users (Actors) -->
        <mxCell id="user-a" value="👤 User A&#xa;(Alice)&#xa;iPhone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="420" width="100" height="80" as="geometry" />
        </mxCell>

        <mxCell id="user-b" value="👤 User B&#xa;(Bob)&#xa;Android" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="580" width="100" height="80" as="geometry" />
        </mxCell>

        <mxCell id="user-c" value="👥 Group&#xa;256 members&#xa;Web App" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1250" y="500" width="100" height="80" as="geometry" />
        </mxCell>

        <!-- Core Components Inside System -->
        <mxCell id="websocket-layer" value="🔌 WebSocket Servers&#xa;(Stateful Connections)&#xa;&#xa;• 2,500 servers&#xa;• Each handles 400K connections&#xa;• Consistent hashing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center" vertex="1" parent="1">
          <mxGeometry x="240" y="410" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="chat-service" value="💬 Chat Service&#xa;(Message Router)&#xa;&#xa;• Validate message&#xa;• Store in Cassandra&#xa;• Publish to Redis Streams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center" vertex="1" parent="1">
          <mxGeometry x="500" y="410" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="message-store" value="🗄️ Message Store&#xa;(Cassandra)&#xa;&#xa;• 700K writes/sec&#xa;• Time-ordered per conv&#xa;• 30-day TTL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center" vertex="1" parent="1">
          <mxGeometry x="240" y="560" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="redis-streams" value="⚡ Redis Streams&#xa;(Hot Message Queue)&#xa;&#xa;• One stream per WS server&#xa;• &lt;100ms delivery&#xa;• Consumer groups" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;fontSize=13;align=center" vertex="1" parent="1">
          <mxGeometry x="500" y="560" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="media-service" value="🖼️ Media Service&#xa;(S3 + CloudFront CDN)&#xa;&#xa;• Photos, videos, voice&#xa;• Pre-signed URLs&#xa;• 2PB storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center" vertex="1" parent="1">
          <mxGeometry x="760" y="410" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="presence-service" value="🟢 Presence Service&#xa;(Redis Pub/Sub)&#xa;&#xa;• Online/offline status&#xa;• Last seen timestamp&#xa;• Typing indicators" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f4e6;strokeColor=#82b366;fontSize=13;align=center" vertex="1" parent="1">
          <mxGeometry x="760" y="560" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="notification-service" value="🔔 Notification Service&#xa;(FCM / APNs)&#xa;&#xa;• Offline users&#xa;• Push notifications&#xa;• Badge counts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center" vertex="1" parent="1">
          <mxGeometry x="1000" y="410" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="user-service" value="👤 User Service&#xa;(PostgreSQL + Redis)&#xa;&#xa;• Profiles&#xa;• Contacts&#xa;• Authentication" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center" vertex="1" parent="1">
          <mxGeometry x="1000" y="560" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- Arrows showing data flow -->
        <mxCell id="arrow1" value="1. Send message&#xa;(WebSocket)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;fontSize=13;fontStyle=1;strokeColor=#0066CC" edge="1" parent="1" source="user-a" target="websocket-layer">
          <mxGeometry x="0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="arrow2" value="2. Route&#xa;+ Store" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=12;dashed=1" edge="1" parent="1" source="websocket-layer" target="chat-service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow3" value="3. Persist" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="chat-service" target="message-store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow4" value="4. Queue for delivery" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="chat-service" target="redis-streams">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow5" value="5. Consume&#xa;+ Deliver" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=12;dashed=1" edge="1" parent="1" source="redis-streams" target="websocket-layer">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="600" y="530" />
              <mxPoint x="340" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="arrow6" value="6. Receive&#xa;message" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;fontSize=13;fontStyle=1;strokeColor=#00CC00" edge="1" parent="1" source="websocket-layer" target="user-b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow7" value="Upload media" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=12;dashed=1;strokeColor=#666666" edge="1" parent="1" source="websocket-layer" target="media-service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow8" value="If Bob offline →&#xa;Push notification" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=12;dashed=1;strokeColor=#d79b00" edge="1" parent="1" source="redis-streams" target="notification-service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Key Numbers Box -->
        <mxCell id="numbers-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="790" width="1300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="numbers-title" value="📊 SCALE NUMBERS" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="800" width="1300" height="20" as="geometry" />
        </mxCell>

        <mxCell id="num1" value="👥 1B+ active users" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="70" y="830" width="150" height="30" as="geometry" />
        </mxCell>

        <mxCell id="num2" value="💬 700K msgs/sec" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="240" y="830" width="150" height="30" as="geometry" />
        </mxCell>

        <mxCell id="num3" value="⚡ &lt;100ms delivery" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="410" y="830" width="150" height="30" as="geometry" />
        </mxCell>

        <mxCell id="num4" value="🔌 2,500 WS servers" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="580" y="830" width="150" height="30" as="geometry" />
