<mxfile host="app.diagrams.net">
  <diagram name="Chat Architecture Components - BEGINNER" id="chat-architecture">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title -->
        <mxCell id="title" value="CHAT ARCHITECTURE COMPONENTS — Why Each Part Exists" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="1200" height="40" as="geometry" />
        </mxCell>

        <!-- Why Cassandra Box -->
        <mxCell id="why-cassandra-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="480" height="160" as="geometry" />
        </mxCell>
        
        <mxCell id="why-cassandra-title" value="🗄️ WHY CASSANDRA FOR MESSAGES?" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="90" width="480" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="why-cassandra-text" value="Analogy: Like a very long receipt roll, pre-sorted by conversation&#xa;&#xa;Chat pattern: Messages ONLY go one direction (append-only)&#xa;Always read in time order per conversation → no complex joins&#xa;&#xa;Why NOT MySQL?&#xa;  • MySQL = built for complex joins across many tables (overkill!)&#xa;  • At 700K msgs/sec, MySQL needs extreme sharding + index maintenance&#xa;  • Cassandra handles append-only writes natively&#xa;  • Just add more nodes to scale → no single bottleneck" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="70" y="125" width="440" height="100" as="geometry" />
        </mxCell>

        <!-- Why Redis Streams Box -->
        <mxCell id="why-streams-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="570" y="80" width="500" height="160" as="geometry" />
        </mxCell>
        
        <mxCell id="why-streams-title" value="⚡ WHY REDIS STREAMS FOR HOT PATH?" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="570" y="90" width="500" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="why-streams-text" value="Problem: Need &lt;100ms delivery from Chat Service → recipient's phone&#xa;&#xa;Redis Streams = In-memory queue with consumer groups&#xa;   • Sub-millisecond latency (Kafka = tens of ms)&#xa;   • One stream per WebSocket server (not per user!)&#xa;   • Handles retries if WS server crashes&#xa;&#xa;Cassandra = Source of truth (durable, survives restarts)&#xa;Redis Streams = Hot delivery queue (fast, temporary)&#xa;Kafka = Separate async path for search indexing, analytics, CDC&#xa;&#xa;Why all 3? Each serves different access pattern!" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="590" y="125" width="460" height="100" as="geometry" />
        </mxCell>

        <!-- Why Chat Service Hub Box -->
        <mxCell id="why-hub-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1110" y="80" width="440" height="160" as="geometry" />
        </mxCell>
        
        <mxCell id="why-hub-title" value="🔀 WHY CHAT SERVICE AS HUB?" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1110" y="90" width="440" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="why-hub-text" value="Analogy: Postal sorting office&#xa;&#xa;Without hub: 2,500 WebSocket servers need to talk&#xa;to each other directly = 6.25 million peer connections!&#xa;(N² problem: 2500 × 2500 = 6,250,000)&#xa;&#xa;With Chat Service hub:&#xa;  • All messages flow through one central router&#xa;  • Only 2,500 connections total (N, not N²)&#xa;  • Chat Service stamps sequence IDs&#xa;  • Routes to correct Redis Stream&#xa;  • No WebSocket server knows about others!" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1130" y="125" width="400" height="100" as="geometry" />
        </mxCell>

        <!-- Main Architecture Diagram -->
        <mxCell id="arch-title" value="📐 FULL COMPONENT ARCHITECTURE" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="270" width="1500" height="40" as="geometry" />
        </mxCell>

        <!-- Client Layer -->
        <mxCell id="client-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="340" width="1500" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="client-label" value="CLIENT LAYER" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="70" y="350" width="200" height="20" as="geometry" />
        </mxCell>

        <mxCell id="ios-app" value="📱 iOS App&#xa;WebSocket client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="355" width="150" height="50" as="geometry" />
        </mxCell>

        <mxCell id="android-app" value="📱 Android App&#xa;WebSocket client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="480" y="355" width="150" height="50" as="geometry" />
        </mxCell>

        <mxCell id="web-app" value="💻 Web App&#xa;WebSocket client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="660" y="355" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- API Gateway Layer -->
        <mxCell id="gateway-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="450" width="1500" height="100" as="geometry" />
        </mxCell>

        <mxCell id="gateway-label" value="API GATEWAY / LOAD BALANCER" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="70" y="460" width="350" height="20" as="geometry" />
        </mxCell>

        <mxCell id="nginx" value="Nginx&#xa;&#xa;• WebSocket upgrade&#xa;• Consistent hashing&#xa;• JWT validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd966;strokeColor=#d79b00;fontSize=13;align=center" vertex="1" parent="1">
          <mxGeometry x="300" y="480" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="hash-note" value="Consistent Hash: User A always → WS Server #3" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="530" y="490" width="300" height="40" as="geometry" />
        </mxCell>

        <!-- WebSocket Server Layer -->
        <mxCell id="ws-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="580" width="600" height="140" as="geometry" />
        </mxCell>

        <mxCell id="ws-label" value="WEBSOCKET SERVERS (2,500 servers)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="70" y="590" width="400" height="20" as="geometry" />
        </mxCell>

        <mxCell id="ws1" value="WS Server #1&#xa;&#xa;Holds 400K&#xa;persistent&#xa;connections" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0bfff;strokeColor=#8e44ad;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="620" width="120" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ws2" value="WS Server #2&#xa;&#xa;Holds 400K&#xa;persistent&#xa;connections" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0bfff;strokeColor=#8e44ad;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="620" width="120" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ws-dots" value="..." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="645" width="40" height="30" as="geometry" />
        </mxCell>

        <mxCell id="ws2500" value="WS Server #2500&#xa;&#xa;Holds 400K&#xa;persistent&#xa;connections" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0bfff;strokeColor=#8e44ad;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="620" width="140" height="80" as="geometry" />
        </mxCell>

        <!-- Chat Service Layer -->
        <mxCell id="chat-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="700" y="580" width="850" height="140" as="geometry" />
        </mxCell>

        <mxCell id="chat-label" value="💬 CHAT SERVICE (Message Router &amp; Orchestrator)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#006600" vertex="1" parent="1">
          <mxGeometry x="720" y="590" width="500" height="20" as="geometry" />
        </mxCell>

        <mxCell id="chat-step1" value="1⃣ Validate message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a8e6cf;strokeColor=#27ae60;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="730" y="625" width="150" height="35" as="geometry" />
        </mxCell>

        <mxCell id="chat-step2" value="2⃣ Stamp sequence ID&#xa;(per conversation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a8e6cf;strokeColor=#27ae60;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="900" y="625" width="160" height="35" as="geometry" />
        </mxCell>

        <mxCell id="chat-step3" value="3⃣ Store in Cassandra&#xa;(durable truth)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a8e6cf;strokeColor=#27ae60;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1080" y="625" width="160" height="35" as="geometry" />
        </mxCell>

        <mxCell id="chat-step4" value="4⃣ Publish to Redis Stream&#xa;(hot delivery queue)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a8e6cf;strokeColor=#27ae60;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1260" y="625" width="170" height="35" as="geometry" />
        </mxCell>

        <mxCell id="chat-step5" value="5⃣ Send ACK to sender&#xa;(single ✓ tick)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a8e6cf;strokeColor=#27ae60;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="730" y="675" width="150" height="35" as="geometry" />
        </mxCell>

        <mxCell id="chat-step6" value="6⃣ Publish to Kafka&#xa;(async analytics)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd9b3;strokeColor=#d79b00;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="900" y="675" width="160" height="35" as="geometry" />
        </mxCell>

        <mxCell id="chat-note" value="All happen in &lt;5ms!" style="text;html=1;strokeColor=none;fillColor=#ffffcc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1080" y="680" width="160" height="25" as="geometry" />
        </mxCell>

        <!-- Data Layer -->
        <mxCell id="data-layer-title" value="DATA &amp; STORAGE LAYER" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="750" width="1500" height="30" as="geometry" />
        </mxCell>

        <!-- Cassandra -->
        <mxCell id="cassandra" value="🗄️ CASSANDRA (Message Store)&#xa;&#xa;• 700K writes/sec&#xa;• Append-only, time-ordered&#xa;• Wide rows per conversation&#xa;• 30-day TTL for ephemeral msgs&#xa;&#xa;Query pattern:&#xa;SELECT * FROM messages&#xa;WHERE conv_id = 'alice-bob'&#xa;  AND timestamp > yesterday&#xa;ORDER BY timestamp DESC&#xa;LIMIT 50;&#xa;&#xa;Blazing fast! ⚡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5e6ff;strokeColor=#9673a6;fontSize=13;align=left;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="80" y="810" width="280" height="310" as="geometry" />
        </mxCell>

        <!-- Redis Streams -->
        <mxCell id="redis-streams" value="⚡ REDIS STREAMS (Hot Queue)&#xa;&#xa;Stream structure:&#xa;  server.ws1.inbox → stream&#xa;  server.ws2.inbox → stream&#xa;  ...&#xa;  server.ws2500.inbox → stream&#xa;&#xa;Consumer groups:&#xa;  ws-worker-1&#xa;  ws-worker-2&#xa;&#xa;Pending entry tracking:&#xa;If worker crashes, another&#xa;picks up the unACKed message&#xa;&#xa;&lt;1ms latency ⚡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d6b656;fontSize=13;align=left;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="400" y="810" width="280" height="310" as="geometry" />
        </mxCell>

        <!-- S3 + CDN -->
        <mxCell id="s3-cdn" value="🖼️ S3 + CLOUDFRONT (Media)&#xa;&#xa;Pre-signed URL flow:&#xa;1. Client: &quot;I want to upload photo&quot;&#xa;2. Server: Here's signed URL&#xa;   (expires in 5 min)&#xa;3. Client uploads directly to S3&#xa;   (server never touches bytes!)&#xa;&#xa;Download flow:&#xa;1. Client requests photo URL&#xa;2. Server returns CloudFront URL&#xa;3. CDN serves from nearest edge&#xa;   (20ms instead of 200ms!)&#xa;&#xa;Storage: 2 PB (petabytes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#4caf50;fontSize=13;align=left;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="720" y="810" width="300" height="310" as="geometry" />
        </mxCell>

        <!-- PostgreSQL -->
        <mxCell id="postgres" value="🐘 POSTGRESQL (User Data)&#xa;&#xa;Tables:&#xa;  • users (id, name, phone, ...)&#xa;  • contacts (user_id, contact_id)&#xa;  • groups (id, name, created_at)&#xa;  • group_members (...)&#xa;&#xa;Why SQL here?&#xa;  • Structured data with relations&#xa;  • ACID transactions for signup&#xa;  • Read-heavy (cached in Redis)&#xa;&#xa;Redis cache:&#xa;  user:profile:{user_id} → JSON&#xa;  TTL 1 hour" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#2196f3;fontSize=13;align=left;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="1060" y="810" width="240" height="310" as="geometry" />
        </mxCell>

        <!-- Kafka -->
        <mxCell id="kafka" value="📨 KAFKA (Async Integrations)&#xa;&#xa;Topics:&#xa;  • messages.sent&#xa;  • messages.delivered&#xa;  • messages.read&#xa;&#xa;Consumers:&#xa;  • Elasticsearch indexer&#xa;    (for message search)&#xa;  • Analytics service&#xa;  • Audit log service&#xa;  • ML training pipeline&#xa;&#xa;Why NOT for hot path?&#xa;  • Kafka adds 10-50ms latency&#xa;  • We need &lt;100ms total" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff9800;fontSize=13;align=left;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="1340" y="810" width="210" height="310" as="geometry" />
        </mxCell>

        <!-- Arrows between layers -->
        <mxCell id="arrow-ws-chat" value="Send msg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;fontSize=12;strokeColor=#0066cc" edge="1" parent="1" source="ws1" target="chat-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow-chat-cassandra" value="3. Persist" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=12;dashed=1" edge="1" parent="1" source="chat-step3" target="cassandra">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1160" y="750" />
              <mxPoint x="220" y="750" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="arrow-chat-streams" value="4. Queue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=12;dashed=1" edge="1" parent="1" source="chat-step4" target="redis-streams">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1345" y="750" />
              <mxPoint x="540" y="750" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="arrow-chat-kafka" value="6. Publish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=12;dashed=1;strokeColor=#ff9800" edge="1" parent="1" source="chat-step6" target="kafka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow-streams-ws" value="Consume&#xa;&amp; deliver" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=12;dashed=1;strokeColor=#27ae60" edge="1" parent="1" source="redis-streams" target="ws2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="540" y="760" />
              <mxPoint x="300" y="760" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>