        <!-- Title -->
        <mxCell id="title" value="🚦 Priority Queues — WHY They're Critical (The Hospital ER Analogy)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="1200" height="50" as="geometry" />
        </mxCell>
        
        <!-- Subtitle -->
        <mxCell id="subtitle" value="Without priority queues, a Black Friday promo email campaign can delay a critical OTP for 20 minutes. That's a P0 incident." style="text;html=1;strokeColor=none;fillColor=#FADBD8;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="250" y="80" width="1100" height="40" as="geometry" />
