        <!-- Key Benefit -->
        <mxCell id="benefit-box" value="✅ KEY BENEFIT:&#xa;&#xa;Black Friday: 10M promo emails queued in PROMOTIONAL lane.&#xa;User tries to login: OTP goes to CRITICAL lane.&#xa;&#xa;CRITICAL lane has 20 dedicated workers, completely isolated.&#xa;OTP processed in 5 seconds. User logs in successfully. ✅&#xa;&#xa;Meanwhile, 10M promo emails process in background over 1 hour. Nobody notices or cares.&#xa;&#xa;ANALOGY: Hospital ER has separate triage lanes. Heart attack patient doesn't wait behind flu patients." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#C8E6C9;strokeColor=#2E7D32;strokeWidth=3;align=left;spacingLeft=10;" vertex="1" parent="1">
