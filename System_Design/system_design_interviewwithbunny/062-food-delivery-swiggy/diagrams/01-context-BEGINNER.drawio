<mxfile host="app.diagrams.net">
  <diagram name="System Context" id="context">
    <mxGraphModel dx="1650" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="950" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title -->
        <mxCell id="title" value="ZOMATO/SWIGGY — Food Delivery System Context" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#1a237e" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1610" height="35" as="geometry" />
        </mxCell>
        
        <mxCell id="subtitle" value="Three-sided marketplace: Customer (demand) ↔ Restaurant (supply) ↔ Delivery Partner (logistics) — all coordinated in real-time" style="text;html=1;strokeColor=none;fillColor=#e8eaf6;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="150" y="50" width="1350" height="25" as="geometry" />
        </mxCell>
        
        <!-- System Boundary -->
        <mxCell id="system-boundary" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#ff6f00;strokeWidth=4;" vertex="1" parent="1">
          <mxGeometry x="300" y="120" width="1050" height="750" as="geometry" />
        </mxCell>
        
        <mxCell id="system-label" value="ZOMATO / SWIGGY SYSTEM" style="text;html=1;strokeColor=none;fillColor=#ff6f00;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=16;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
          <mxGeometry x="310" y="130" width="250" height="30" as="geometry" />
        </mxCell>
        
        <!-- Core Services Inside System -->
        <mxCell id="services-box" value="CORE SERVICES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=2;fontSize=13;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="320" y="180" width="480" height="220" as="geometry" />
        </mxCell>
        
        <mxCell id="service-list" value="• Order Service (state machine: PLACED→ACCEPTED→...→DELIVERED)&#xa;• Restaurant Discovery Service (Elasticsearch geospatial + text)&#xa;• Location Tracking Service (partner GPS every 5s → Redis GEO)&#xa;• Partner Assignment Service (GEORADIUS → nearest ONLINE partner)&#xa;• Real-Time Tracking Service (SSE stream to customer app)&#xa;• Notification Service (order updates → FCM/APNs/SMS)&#xa;• Payment Service (Stripe/Razorpay integration)&#xa;• Rating &amp; Review Service (post-delivery feedback)&#xa;• Surge Pricing Calculator (demand/supply per geohash-7 cell)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="330" y="210" width="460" height="175" as="geometry" />
        </mxCell>
        
        <!-- Data Stores -->
        <mxCell id="data-stores-box" value="DATA STORES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#8e24aa;strokeWidth=2;fontSize=13;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="820" y="180" width="510" height="220" as="geometry" />
        </mxCell>
        
        <mxCell id="data-stores-list" value="• MySQL (orders, restaurants, menu_items, delivery_partners,&#xa;           order_items, payments) — ACID guarantees&#xa;&#xa;• Redis GEO (delivery_partners geospatial index)&#xa;           GEORADIUS finds nearest 10 partners in &lt;10ms&#xa;&#xa;• Redis Cache (restaurant menus, surge multipliers, session)&#xa;&#xa;• Cassandra (partner_location_history, order_status_events)&#xa;           Time-series data, 30-day TTL&#xa;&#xa;• Elasticsearch (restaurant search: cuisine+location+rating)&#xa;           Geo-distance + full-text + filter ranking" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="830" y="210" width="490" height="175" as="geometry" />
        </mxCell>
        
        <!-- Infrastructure -->
        <mxCell id="infra-box" value="INFRASTRUCTURE &amp; MESSAGING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;strokeWidth=2;fontSize=13;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="320" y="420" width="1010" height="150" as="geometry" />
        </mxCell>
        
        <mxCell id="infra-list" value="• API Gateway (authentication, rate limiting, SSL termination)&#xa;• Load Balancer (distribute traffic across service instances)&#xa;• Kafka (order-placed, partner-assigned, order-delivered events)&#xa;          Decouples services, 7-day retention for replay&#xa;• CDN (CloudFront for restaurant images, static assets)&#xa;• Monitoring (Prometheus for metrics, ELK for logs, Grafana dashboards)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="330" y="450" width="990" height="105" as="geometry" />
        </mxCell>
        
        <!-- Algorithms -->
        <mxCell id="algorithms-box" value="KEY ALGORITHMS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#01579b;strokeWidth=2;fontSize=13;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="320" y="590" width="1010" height="100" as="geometry" />
        </mxCell>
        
        <mxCell id="algorithms-list" value="• Partner Assignment: GEORADIUS → filter ONLINE → dispatch to nearest → 30s timeout → next nearest&#xa;• ETA Calculation: ML model (distance, traffic, prep time, partner speed history)&#xa;• Surge Pricing: pending_orders / available_partners per geohash-7 cell (updated every 60s)&#xa;• Restaurant Ranking: Elasticsearch score = (0.4×geo_distance + 0.3×rating + 0.2×prep_time + 0.1×delivery_fee)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="330" y="620" width="990" height="60" as="geometry" />
        </mxCell>
        
        <!-- Monitoring -->
        <mxCell id="monitoring-box" value="MONITORING &amp; OBSERVABILITY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=13;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="320" y="710" width="1010" height="140" as="geometry" />
        </mxCell>
        
        <mxCell id="monitoring-list" value="• Orders/sec, Partner GPS updates/sec (100K target)&#xa;• Partner assignment latency (p50/p99 &lt; 60s)&#xa;• Redis GEO GEORADIUS latency (p99 &lt; 10ms)&#xa;• Order state transitions (tracking funnel: placed → delivered %)&#xa;• Partner acceptance rate (first offer acceptance vs escalated radius)&#xa;• Alert: if assignment failure &gt; 5% → page ops team" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="330" y="740" width="990" height="95" as="geometry" />
        </mxCell>
        
