        <mxCell id="actor-customer" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="210" height="150" as="geometry" />
        </mxCell>
        
        <mxCell id="customer-title" value="📱 CUSTOMER APP" style="text;html=1;strokeColor=none;fillColor=#1976d2;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;fontColor=#ffffff" vertex="1" parent="1">
