        </mxCell>
        
        <!-- KEY CHALLENGES BOX -->
        <mxCell id="challenges-box" value="🎯 KEY TECHNICAL CHALLENGES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=3;fontSize=14;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="1570" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="challenges-list" value="1. **Three-sided real-time coordination**: Customer waiting → Restaurant cooking → Partner moving. Any lag breaks UX.  2. **Geospatial at scale**: 500K partners × 5s GPS = 100K GEOADD/sec.  3. **Partner assignment accuracy**: Nearest ONLINE partner in &lt;60s or escalate radius.  4. **ETA accuracy**: ML model balancing distance, traffic, prep time, partner speed history.  5. **Order state consistency**: State machine prevents invalid transitions (can't mark DELIVERED before PICKED_UP).  6. **Surge pricing fairness**: Transparent demand/supply calculation per geohash-7 cell." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="50" y="830" width="1550" height="20" as="geometry" />
        </mxCell>
        
        <!-- Real-World Analogy -->
        <mxCell id="analogy-box" value="🏪 REAL-WORLD ANALOGY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#01579b;strokeWidth=3;fontSize=14;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="750" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="analogy-text" value="Traditional delivery: Call restaurant → they prepare → call local courier agency → wait for assignment → courier picks up → delivers.  **Zomato automates all coordination**: Customer taps button → system notifies restaurant AND pre-identifies nearby riders before restaurant accepts → rider dispatched instantly when food ready → customer tracks rider on map in real-time. The hard part: all three parties (customer, restaurant, rider) have independent state that must sync continuously." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="50" y="910" width="730" height="20" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>