        <mxCell id="cdn-usage" value="• Restaurant photos&#xa;• Menu item images&#xa;• Static app assets" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10" vertex="1" parent="1">
