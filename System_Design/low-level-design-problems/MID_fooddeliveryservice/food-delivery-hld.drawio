            <mxPoint x="290" y="140" as="sourcePoint" />
            <mxPoint x="450" y="140" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="3. Create Order (PLACED)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#2E7D32;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="180" as="sourcePoint" />
            <mxPoint x="450" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="4. Publish order.placed" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;rounded=0;strokeColor=#C62828;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="220" as="sourcePoint" />
            <mxPoint x="1090" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="5. Pre-authorize payment" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;rounded=0;strokeColor=#C62828;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1090" y="270" as="sourcePoint" />
            <mxPoint x="610" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="6. payment.authorized" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;rounded=0;strokeColor=#C62828;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="610" y="320" as="sourcePoint" />
            <mxPoint x="1090" y="320" as="targetPoint" />
