        </mxCell>
        <mxCell id="m8" value="8. order.confirmed" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;rounded=0;strokeColor=#C62828;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="775" y="420" as="sourcePoint" />
            <mxPoint x="1090" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" value="9. Find driver (GEORADIUS)" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;rounded=0;strokeColor=#C62828;fontSize=10;" edge="1" parent="1">
