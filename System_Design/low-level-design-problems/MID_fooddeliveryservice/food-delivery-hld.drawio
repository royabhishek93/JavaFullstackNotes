        </mxCell>
        <mxCell id="p5" value="Restaurant Svc" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="30" width="110" height="900" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="Delivery Svc" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="890" y="30" width="100" height="900" as="geometry" />
        </mxCell>
        <mxCell id="p7" value="Kafka" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#FCE4EC;strokeColor=#C62828;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="30" width="80" height="900" as="geometry" />
        </mxCell>
        <mxCell id="p8" value="Driver" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#E1F5FE;strokeColor=#0288D1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="30" width="80" height="900" as="geometry" />
        </mxCell>
        <!-- SEQUENCE MESSAGES -->
        <mxCell id="m1" value="1. POST /orders" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1565C0;fontStyle=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="100" as="sourcePoint" />
            <mxPoint x="290" y="100" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="2. Validate + Route" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#E65100;fontSize=10;" edge="1" parent="1">
