        <mxCell id="dbnote" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#e3c800;strokeColor=#B09500;fontSize=11;align=left;spacingLeft=5;fontColor=#000000;" value="Key Design Decisions:&#xa;• unit_price in ORDER_ITEM → preserves historical price&#xa;• ORDERS → PAYMENT is 1:many (retries/refunds)&#xa;• DELIVERY_ASSIGNMENT is 0..1 per order (self-pickup)&#xa;• PostgreSQL + SELECT FOR UPDATE on order row&#xa;• Indexes: ORDERS(customer_id, created_at DESC)&#xa;• ORDER_STATUS_HISTORY for audit trail&#xa;• REVIEW(order_id, customer_id) UK → one review per order&#xa;• COUPON.coupon_id on ORDERS is nullable (most orders have no promo)&#xa;• NOTIFICATION in MongoDB — flexible payload schema across channels" vertex="1">
          <mxGeometry height="175" width="400" x="750" y="870" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
