          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- SECTION 7: SCENARIO QUESTIONS (Bottom Right) -->
        <mxCell id="title_scenario" value="SECTION 7: SCENARIO QUESTIONS (Interview Focus)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1100" y="580" width="780" height="30" as="geometry" />
        </mxCell>
        
        <!-- Scenario Box -->
        <mxCell id="scenario_box" value="Q1: Multiple users booking same seat simultaneously. How to handle?&#xa;A1: Optimistic locking with version field. User1 reads version=1, User2 reads version=1. First to update wins (version=2). Second user fails version check and must retry.&#xa;&#xa;Q2: User books seat but doesn't complete payment in 15 minutes. What happens?&#xa;A2: Redis lock with TTL expires after 15 min. Seat becomes available. First user's booking cancelled if they return later. Background job to cleanup expired bookings.&#xa;&#xa;Q3: Why optimistic locking over pessimistic for ticket booking?&#xa;A3: High traffic system. Pessimistic locks block other reads, causing poor performance. Optimistic allows concurrent reads, only conflicts on write. Better user experience.&#xa;&#xa;Q4: Show started but seats showing as booked (payment pending). How to handle?&#xa;A4: Background scheduler runs every 5 min to cancel expired bookings. Update seat status to available. Could also block booking 10 min before show starts.&#xa;&#xa;Q5: How to scale this system for millions of concurrent users?&#xa;A5: Database sharding (by city/theater). Read replicas for search. Redis cache for hot shows. Message queue for booking requests. Microservices for booking, payment, notification." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1100" y="640" width="780" height="340" as="geometry" />
        </mxCell>
        
        <!-- Design Pattern Box -->
        <mxCell id="pattern_box" value="KEY DESIGN PATTERNS:&#xa;&#xa;1. MVC Pattern - MovieController, TheaterController separate from entities&#xa;2. Optimistic Locking - Version-based concurrency control&#xa;3. Observer Pattern - Could be used for notifications&#xa;4. Factory Pattern - Could create different booking types&#xa;&#xa;CONCURRENCY STRATEGY:&#xa;- Optimistic Lock: Check version before update&#xa;- Redis TTL: Auto-expire reservations&#xa;- Database Transaction: ACID for booking+payment" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1100" y="1020" width="780" height="160" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
