          <mxGeometry x="420" y="300" width="280" height="100" as="geometry" />
        </mxCell>
        
        <mxCell id="bank_service" value="BankService&#xa;&#xa;+ addInstrument(BankInstrument)&#xa;+ getInstrument(String)&#xa;+ validateIfsc(String)" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="740" y="300" width="220" height="100" as="geometry" />
        </mxCell>
        
        <mxCell id="card_service" value="CardService&#xa;&#xa;+ addInstrument(CardInstrument)&#xa;+ getInstrument(String)&#xa;+ validateCard(String)" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1000" y="300" width="220" height="100" as="geometry" />
        </mxCell>
        
        <!-- Transaction Management -->
        <mxCell id="transaction_title" value="TRANSACTION PROCESSING (Async Pattern)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="500" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="transaction_controller" value="TransactionController&#xa;&#xa;+ makePayment(userId, receiverId, amount, instrumentId)&#xa;+ getTransactionHistory(userId)" style="swimlane;fontStyle=1;align=center;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="360" height="100" as="geometry" />
        </mxCell>
        
        <mxCell id="transaction_service" value="TransactionService&#xa;&#xa;+ createTransaction(Transaction)&#xa;+ validateBalance(userId, amount)&#xa;+ callProcessor(Transaction)&#xa;+ updateTransactionStatus(String txnId, Status)" style="swimlane;fontStyle=1;align=center;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="440" y="480" width="320" height="140" as="geometry" />
        </mxCell>
        
        <mxCell id="transaction_class" value="Transaction&#xa;&#xa;- transactionId: String&#xa;- amount: double&#xa;- senderUserId: String&#xa;- receiverUserId: String&#xa;- debitInstrumentId: String&#xa;- creditInstrumentId: String&#xa;- status: TransactionStatus&#xa;- timestamp: DateTime&#xa;&#xa;+ updateStatus(Status)" style="swimlane;fontStyle=1;align=center;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="800" y="480" width="240" height="240" as="geometry" />
        </mxCell>
        
        <mxCell id="processor_class" value="Processor&#xa;(External Service)&#xa;&#xa;+ processPayment(Transaction)&#xa;  // Takes 3-5 days&#xa;  // Returns async" style="swimlane;fontStyle=1;align=center;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1080" y="480" width="200" height="120" as="geometry" />
        </mxCell>
        
        <mxCell id="transaction_status_enum" value="&lt;&lt;enum&gt;&gt;&#xa;TransactionStatus&#xa;&#xa;SUCCESS&#xa;PENDING&#xa;DENIED&#xa;FAILED" style="swimlane;fontStyle=1;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1320" y="480" width="160" height="140" as="geometry" />
        </mxCell>
        
        <!-- DTO Pattern -->
        <mxCell id="dto_title" value="DTO PATTERN (Data Transfer Object)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="500" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="dto_explanation" value="InstrumentDo (DTO)&#xa;&#xa;// Client sees this&#xa;- instrumentId&#xa;- maskedAccountNumber (***1234)&#xa;- instrumentType&#xa;&#xa;// DB Entity (Internal)&#xa;- instrumentId&#xa;- fullAccountNumber&#xa;- encryptedDetails&#xa;- userId&#xa;&#xa;WHY DTO?&#xa;- Client never sees DB schema&#xa;- Easy to change DB without affecting clients&#xa;- Security: Mask sensitive data" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="380" height="260" as="geometry" />
        </mxCell>
        
        <!-- SECTION 4: ER DIAGRAM -->
        <mxCell id="title_er" value="SECTION 4: ER DIAGRAM" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="460" y="660" width="600" height="30" as="geometry" />
        </mxCell>
        
        <!-- User Table -->
        <mxCell id="er_user" value="User&#xa;&#xa;PK  userId: INT&#xa;    userName: VARCHAR(100)&#xa;    email: VARCHAR(100)&#xa;    phone: VARCHAR(15)" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="460" y="720" width="200" height="120" as="geometry" />
        </mxCell>
        
        <!-- Instrument Table -->
        <mxCell id="er_instrument" value="Instrument&#xa;&#xa;PK  instrumentId: INT&#xa;FK  userId: INT&#xa;    instrumentType: ENUM" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="700" y="720" width="200" height="100" as="geometry" />
        </mxCell>
        
        <!-- BankInstrument Table -->
        <mxCell id="er_bank" value="BankInstrument&#xa;&#xa;PK,FK  instrumentId: INT&#xa;       bankAccountNumber: VARCHAR(20)&#xa;       ifscCode: VARCHAR(11)" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="940" y="720" width="240" height="100" as="geometry" />
        </mxCell>
        
        <!-- CardInstrument Table -->
        <mxCell id="er_card" value="CardInstrument&#xa;&#xa;PK,FK  instrumentId: INT&#xa;       cardNumber: VARCHAR(16)&#xa;       cvv: INT (encrypted)&#xa;       expiryDate: DATE" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1220" y="720" width="220" height="120" as="geometry" />
        </mxCell>
        
        <!-- Transaction Table -->
        <mxCell id="er_transaction" value="Transaction&#xa;&#xa;PK  transactionId: INT&#xa;FK  senderUserId: INT&#xa;FK  receiverUserId: INT&#xa;FK  debitInstrumentId: INT&#xa;FK  creditInstrumentId: INT&#xa;    amount: DECIMAL(10,2)&#xa;    status: ENUM&#xa;    timestamp: DATETIME" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="460" y="880" width="240" height="200" as="geometry" />
        </mxCell>
        
        <!-- SECTION 7: SCENARIO QUESTIONS -->
        <mxCell id="title_scenario" value="SECTION 7: SCENARIO QUESTIONS (Async Processing, Instruments, Failures)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="740" y="880" width="1140" height="30" as="geometry" />
        </mxCell>
        
        <!-- Scenario Box -->
        <mxCell id="scenario_box" value="Q1: User has 3 bank accounts, 2 cards. Which instrument for transaction?&#xa;A1: User selects debit instrument when initiating payment. For credit (receiving), use user's default/preferred instrument. If not set, prompt user or use latest added instrument.&#xa;&#xa;Q2: Add new instrument type (UPI). How does design handle it without breaking existing code?&#xa;A2: Factory Pattern benefits: (1) Create UPIInstrument extends Instrument (2) Create UPIService extends InstrumentService (3) Update InstrumentServiceFactory to return UPIService for UPI type. NO changes to existing BankService or CardService. Open-Closed Principle.&#xa;&#xa;Q3: Payment processor takes 3-5 days to respond. How to handle without blocking user?&#xa;A3: Async Processing: (1) Synchronous validation: Check sender balance, receiver account valid, reserve funds (2) Create transaction with status=PENDING (3) Return to user immediately: 'Payment processing' (4) Call Processor asynchronously (5) Processor calls webhook when done (6) Update transaction status to SUCCESS/FAILED (7) Send notification to user.&#xa;&#xa;Q4: Transaction fails after debit but before credit (network failure). How to ensure consistency?&#xa;A4: Options: (1) Distributed Transaction with 2PC (complex, not for LLD) (2) Saga Pattern: Compensating transaction to rollback debit (3) For LLD: Mark transaction as FAILED with rollback flag, manual reconciliation or retry mechanism (4) Event sourcing: Log all steps, replay on failure.&#xa;&#xa;Q5: User transaction fails due to insufficient balance. What to show and how to prevent?&#xa;A5: TransactionService validates balance BEFORE calling Processor. If insufficient, return error immediately: 'Insufficient balance. Available: X, Required: Y'. Don't create transaction or call processor. Save API call cost. Show user their current balance." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="740" y="940" width="1140" height="440" as="geometry" />
        </mxCell>
        
        <!-- Design Pattern Box -->
        <mxCell id="pattern_box" value="KEY DESIGN PATTERNS:&#xa;&#xa;1. Factory Pattern - InstrumentServiceFactory creates appropriate service (Bank/Card/UPI)&#xa;2. DTO Pattern - InstrumentDo separates client view from DB entity (security + decoupling)&#xa;3. Async Processing - Synchronous validation + asynchronous processing for long-running operations&#xa;4. Strategy Pattern - Different processors for different payment methods&#xa;&#xa;ARCHITECTURE:&#xa;Client → Controller → Service → Factory → Specific Service → Processor → Webhook&#xa;&#xa;SCOPE NOTE (From Transcript):&#xa;This is PEER-TO-PEER payment (user to user), NOT peer-to-merchant.&#xa;Merchant payments involve different flows (payment gateway, merchant accounts, settlements)." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="660" height="250" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
