          <mxGeometry x="40" y="260" width="500" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="instrument_service_factory" value="InstrumentServiceFactory&#xa;&#xa;+ getService(InstrumentType): InstrumentService" style="swimlane;fontStyle=1;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="340" height="80" as="geometry" />
        </mxCell>
        
