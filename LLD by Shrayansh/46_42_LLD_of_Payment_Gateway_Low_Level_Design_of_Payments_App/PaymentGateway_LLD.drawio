          <mxGeometry x="300" y="80" width="240" height="140" as="geometry" />
        </mxCell>
        
        <mxCell id="bank_instrument" value="BankInstrument&#xa;&#xa;- bankAccountNumber: String&#xa;- ifscCode: String&#xa;&#xa;+ validateBankAccount()" style="swimlane;fontStyle=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
