        </mxCell>
        
        <mxCell id="card_instrument" value="CardInstrument&#xa;&#xa;- cardNumber: String&#xa;- cvv: int&#xa;- expiryDate: Date&#xa;&#xa;+ validateCard()" style="swimlane;fontStyle=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
