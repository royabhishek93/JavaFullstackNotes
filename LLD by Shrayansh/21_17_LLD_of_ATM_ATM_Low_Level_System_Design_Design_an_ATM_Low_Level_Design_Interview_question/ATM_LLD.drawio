<mxfile host="app.diagrams.net">
  <diagram name="ATM System LLD" id="atm">
    <mxGraphModel dx="1434" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1200">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- SECTION 1: CLASS DIAGRAM (State Pattern + Chain of Responsibility) -->
        <mxCell id="title_class" value="SECTION 1-3: CLASS DIAGRAM (State Pattern + Chain of Responsibility)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="30" as="geometry" />
        </mxCell>
        
        <!-- ATMState Interface -->
        <mxCell id="state_interface" value="&lt;&lt;interface&gt;&gt;&#xa;ATMState&#xa;&#xa;+ insertCard(ATM, Card)&#xa;+ authenticatePin(ATM, Card, int)&#xa;+ selectOperation(ATM, Card, TransactionType)&#xa;+ cashWithdrawal(ATM, Card, int)&#xa;+ displayBalance(ATM, Card)&#xa;+ returnCard()&#xa;+ exit(ATM)" style="swimlane;fontStyle=1;align=left;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="280" height="200" as="geometry" />
        </mxCell>
        
        <!-- IdleState -->
        <mxCell id="idle_state" value="IdleState&#xa;&#xa;+ insertCard(ATM, Card)&#xa;  // Only this implemented&#xa;  // Others throw exception" style="swimlane;fontStyle=1;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="80" width="200" height="100" as="geometry" />
        </mxCell>
        
        <!-- HasCardState -->
        <mxCell id="hascard_state" value="HasCardState&#xa;&#xa;+ authenticatePin(ATM, Card, int)&#xa;  // Only this implemented&#xa;  // Others throw exception" style="swimlane;fontStyle=1;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="200" width="220" height="100" as="geometry" />
        </mxCell>
        
        <!-- SelectOperationState -->
        <mxCell id="select_state" value="SelectOperationState&#xa;&#xa;+ selectOperation(ATM, Card, TransactionType)&#xa;  // Cash withdrawal, Check balance&#xa;  // Cancel/Exit" style="swimlane;fontStyle=1;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="320" width="280" height="100" as="geometry" />
        </mxCell>
        
        <!-- CashWithdrawalState -->
        <mxCell id="withdrawal_state" value="CashWithdrawalState&#xa;&#xa;+ cashWithdrawal(ATM, Card, int)&#xa;  // Calls CashWithdrawalProcessor&#xa;  // Updates balance, dispenses cash" style="swimlane;fontStyle=1;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="440" width="260" height="100" as="geometry" />
        </mxCell>
        
        <!-- ATM Class -->
        <mxCell id="atm_class" value="ATM&#xa;&#xa;- currentState: ATMState&#xa;- atmBalance: int&#xa;- noOfTwoThousandNotes: int&#xa;- noOfFiveHundredNotes: int&#xa;- noOfHundredNotes: int&#xa;&#xa;+ setCurrentState(ATMState)&#xa;+ getCurrentState()&#xa;+ getAtmBalance()&#xa;+ deductAtmBalance(int)&#xa;+ deductCashFromATM(int, int, int)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="680" y="80" width="260" height="260" as="geometry" />
        </mxCell>
        
        <!-- Card Class -->
        <mxCell id="card_class" value="Card&#xa;&#xa;- cardNumber: String&#xa;- cvv: int&#xa;- pin: int&#xa;- bankAccount: BankAccount&#xa;&#xa;+ validatePin(int)&#xa;+ getBankAccount()" style="swimlane;fontStyle=1;align=center;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="980" y="80" width="200" height="160" as="geometry" />
        </mxCell>
        
        <!-- BankAccount Class -->
        <mxCell id="account_class" value="BankAccount&#xa;&#xa;- accountNumber: String&#xa;- balance: int&#xa;&#xa;+ getBalance()&#xa;+ withdrawBalance(int)&#xa;+ depositBalance(int)" style="swimlane;fontStyle=1;align=center;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1220" y="80" width="200" height="150" as="geometry" />
        </mxCell>
        
        <!-- Chain of Responsibility for Cash Withdrawal -->
        <mxCell id="title_chain" value="CHAIN OF RESPONSIBILITY (Cash Dispensing)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="680" y="380" width="500" height="30" as="geometry" />
        </mxCell>
        
        <!-- CashWithdrawalProcessor Interface -->
        <mxCell id="processor_interface" value="&lt;&lt;abstract&gt;&gt;&#xa;CashWithdrawalProcessor&#xa;&#xa;# nextProcessor: CashWithdrawalProcessor&#xa;&#xa;+ CashWithdrawalProcessor(next)&#xa;+ withdraw(ATM, int)" style="swimlane;fontStyle=1;align=left;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="680" y="440" width="280" height="140" as="geometry" />
        </mxCell>
        
        <!-- TwoThousandProcessor -->
        <mxCell id="2k_processor" value="TwoThousandWithdrawalProcessor&#xa;&#xa;+ withdraw(ATM, int)&#xa;  // Dispense 2000 notes&#xa;  // Forward remainder to next" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1000" y="440" width="260" height="100" as="geometry" />
        </mxCell>
        
        <!-- FiveHundredProcessor -->
        <mxCell id="500_processor" value="FiveHundredWithdrawalProcessor&#xa;&#xa;+ withdraw(ATM, int)&#xa;  // Dispense 500 notes&#xa;  // Forward remainder to next" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1000" y="560" width="260" height="100" as="geometry" />
        </mxCell>
        
        <!-- HundredProcessor -->
        <mxCell id="100_processor" value="HundredWithdrawalProcessor&#xa;&#xa;+ withdraw(ATM, int)&#xa;  // Dispense 100 notes&#xa;  // No next processor" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1000" y="680" width="260" height="100" as="geometry" />
        </mxCell>
        
        <!-- Chain arrows -->
        <mxCell id="chain1" value="" style="endArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="2k_processor" target="500_processor">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="900" y="600" as="sourcePoint" />
            <mxPoint x="950" y="550" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="chain1_label" value="next" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1140" y="540" width="40" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="chain2" value="" style="endArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="500_processor" target="100_processor">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="900" y="700" as="sourcePoint" />
            <mxPoint x="950" y="650" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="chain2_label" value="next" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1140" y="660" width="40" height="20" as="geometry" />
        </mxCell>
        
        <!-- SECTION 4: ER DIAGRAM -->
        <mxCell id="title_er" value="SECTION 4: ER DIAGRAM" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="600" height="30" as="geometry" />
        </mxCell>
        
        <!-- ATM Table -->
        <mxCell id="er_atm" value="ATM&#xa;&#xa;PK  atmId: INT&#xa;    location: VARCHAR(500)&#xa;    atmBalance: DECIMAL(12,2)&#xa;    noOfTwoThousandNotes: INT&#xa;    noOfFiveHundredNotes: INT&#xa;    noOfHundredNotes: INT&#xa;    currentState: VARCHAR(50)" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="240" height="180" as="geometry" />
        </mxCell>
        
        <!-- Card Table -->
        <mxCell id="er_card" value="Card&#xa;&#xa;PK  cardId: INT&#xa;    cardNumber: VARCHAR(16)&#xa;    cvv: INT&#xa;    pin: INT (encrypted)&#xa;FK  bankAccountId: INT" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="320" y="880" width="220" height="140" as="geometry" />
        </mxCell>
        
        <!-- BankAccount Table -->
        <mxCell id="er_account" value="BankAccount&#xa;&#xa;PK  accountId: INT&#xa;    accountNumber: VARCHAR(20)&#xa;    balance: DECIMAL(12,2)&#xa;FK  userId: INT" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="580" y="880" width="220" height="120" as="geometry" />
        </mxCell>
        
        <!-- Transaction Table -->
        <mxCell id="er_transaction" value="Transaction&#xa;&#xa;PK  transactionId: INT&#xa;FK  atmId: INT&#xa;FK  cardId: INT&#xa;    transactionType: ENUM&#xa;    amount: DECIMAL(10,2)&#xa;    timestamp: DATETIME&#xa;    status: ENUM" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="1100" width="240" height="170" as="geometry" />
        </mxCell>
        
        <!-- User Table -->
        <mxCell id="er_user" value="User&#xa;&#xa;PK  userId: INT&#xa;    userName: VARCHAR(100)&#xa;    email: VARCHAR(100)&#xa;    phone: VARCHAR(15)" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="320" y="1050" width="220" height="120" as="geometry" />
        </mxCell>
        
        <!-- SECTION 7: SCENARIO QUESTIONS -->
        <mxCell id="title_scenario" value="SECTION 7: SCENARIO QUESTIONS" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="860" y="820" width="1020" height="30" as="geometry" />
        </mxCell>
        
        <!-- Scenario Box -->
        <mxCell id="scenario_box" value="Q1: User in IDLE state tries to check balance. What happens?&#xa;A1: IdleState only implements insertCard(). checkBalance() throws exception or shows error. User must first insert card (→ HasCardState), authenticate PIN (→ SelectOperationState), then check balance.&#xa;&#xa;Q2: ATM has 1×2000, 2×500, 5×100 notes. User requests 2700. Can dispense?&#xa;A2: Chain of Responsibility: TwoThousandProcessor dispenses 1×2000 (remaining 700) → FiveHundredProcessor dispenses 1×500 (remaining 200) → HundredProcessor dispenses 2×100 (remaining 0). SUCCESS. Final: 0×2000, 1×500, 3×100.&#xa;&#xa;Q3: Why State Pattern instead of if-else for ATM states?&#xa;A3: State Pattern: Each state knows only its operations, prevents invalid state transitions, easy to add new states (e.g., MaintenanceState), follows Open-Closed Principle. If-else: Complex nested conditions, error-prone, hard to maintain.&#xa;&#xa;Q4: User cancels transaction after inserting card but before PIN. What happens?&#xa;A4: From HasCardState, call exit(ATM). Change state to IdleState, return card, no charges. If PIN already entered (in SelectOperationState), same flow but log attempted transaction.&#xa;&#xa;Q5: ATM has only 100 rupee notes. User requests 2500. What happens?&#xa;A5: HundredProcessor dispenses 25×100 if sufficient. If only 20 notes available (2000 max), two options: (1) Dispense 2000, show 'Insufficient cash in ATM', (2) Ask user if they want 2000 instead of 2500. Bank account remains unchanged if not dispensed." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="860" y="880" width="1020" height="390" as="geometry" />
        </mxCell>
        
        <!-- Design Pattern Box -->
        <mxCell id="pattern_box" value="KEY DESIGN PATTERNS:&#xa;&#xa;1. State Design Pattern - Different ATM states with state-specific operations&#xa;2. Chain of Responsibility - Cash dispensing (2000→500→100 note processors)&#xa;&#xa;STATE TRANSITIONS:&#xa;IDLE → (insert card) → HAS_CARD → (auth PIN) → SELECT_OPERATION → (select withdrawal) → CASH_WITHDRAWAL → (dispense) → IDLE&#xa;&#xa;CASH DISPENSING ALGORITHM:&#xa;- Each processor handles maximum denomination possible&#xa;- Forwards remainder to next processor in chain&#xa;- Greedy algorithm: use largest notes first&#xa;- Final processor (100) handles remaining amount" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="580" y="1040" width="1300" height="230" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
