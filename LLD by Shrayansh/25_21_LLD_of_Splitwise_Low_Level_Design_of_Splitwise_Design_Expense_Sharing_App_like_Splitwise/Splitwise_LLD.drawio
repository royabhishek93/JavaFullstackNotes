<mxfile host="app.diagrams.net">
  <diagram name="Splitwise LLD" id="splitwise">
    <mxGraphModel dx="1434" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1200">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- SECTION 1: CLASS DIAGRAM -->
        <mxCell id="title_class" value="SECTION 1-3: CLASS DIAGRAM (Factory Pattern + Balance Sheet Management)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="30" as="geometry" />
        </mxCell>
        
        <!-- User Class -->
        <mxCell id="user_class" value="User&#xa;&#xa;- userId: String&#xa;- userName: String&#xa;- email: String&#xa;- balanceSheet: UserExpenseBalanceSheet&#xa;&#xa;+ addExpense(Expense)&#xa;+ updateBalance(User, amount)&#xa;+ getBalance(User)" style="swimlane;fontStyle=1;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="260" height="180" as="geometry" />
        </mxCell>
        
        <!-- Group Class -->
        <mxCell id="group_class" value="Group&#xa;&#xa;- groupId: String&#xa;- groupName: String&#xa;- users: List&lt;User&gt;&#xa;- expenses: List&lt;Expense&gt;&#xa;&#xa;+ addUser(User)&#xa;+ addExpense(Expense)&#xa;+ getGroupExpenses()" style="swimlane;fontStyle=1;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="340" y="80" width="220" height="180" as="geometry" />
        </mxCell>
        
        <!-- Expense Class -->
        <mxCell id="expense_class" value="Expense&#xa;&#xa;- expenseId: String&#xa;- description: String&#xa;- amount: double&#xa;- paidBy: User&#xa;- splits: List&lt;Split&gt;&#xa;- expenseType: ExpenseType&#xa;- createdDate: Date&#xa;&#xa;+ createExpense()&#xa;+ validateSplits()" style="swimlane;fontStyle=1;align=center;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="600" y="80" width="220" height="220" as="geometry" />
        </mxCell>
        
        <!-- Split Class -->
        <mxCell id="split_class" value="Split&#xa;&#xa;- user: User&#xa;- amount: double&#xa;&#xa;+ getAmount()&#xa;+ getUser()" style="swimlane;fontStyle=1;align=center;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="860" y="80" width="160" height="120" as="geometry" />
        </mxCell>
        
        <!-- UserExpenseBalanceSheet -->
        <mxCell id="balance_sheet_class" value="UserExpenseBalanceSheet&#xa;&#xa;- userVsBalance: Map&lt;User, Balance&gt;&#xa;- totalGetBack: double&#xa;- totalOwe: double&#xa;&#xa;+ addBalance(User, amount, BalanceType)&#xa;+ getTotalBalance()&#xa;+ getFriendBalance(User)" style="swimlane;fontStyle=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="300" height="180" as="geometry" />
        </mxCell>
        
        <!-- Balance Class -->
        <mxCell id="balance_class" value="Balance&#xa;&#xa;- amountGetBack: double&#xa;- amountOwe: double&#xa;&#xa;+ getBalance()&#xa;+ updateGetBack(double)&#xa;+ updateOwe(double)" style="swimlane;fontStyle=1;align=center;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="380" y="300" width="180" height="160" as="geometry" />
        </mxCell>
        
        <!-- ExpenseController -->
        <mxCell id="expense_ctrl_class" value="ExpenseController&#xa;&#xa;+ createExpense(Group, Expense)&#xa;+ updateBalances(Expense)&#xa;+ validateExpense(Expense)" style="swimlane;fontStyle=1;align=center;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="600" y="340" width="240" height="120" as="geometry" />
        </mxCell>
        
        <!-- SplitFactory (Factory Pattern) -->
        <mxCell id="factory_title" value="FACTORY PATTERN FOR SPLIT VALIDATION" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1080" y="80" width="400" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="split_factory" value="SplitFactory&#xa;&#xa;+ getSplitValidator(ExpenseType): SplitValidator" style="swimlane;fontStyle=1;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1080" y="120" width="340" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="split_validator_interface" value="&lt;&lt;interface&gt;&gt;&#xa;SplitValidator&#xa;&#xa;+ validateSplits(Expense): boolean" style="swimlane;fontStyle=1;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1080" y="220" width="240" height="100" as="geometry" />
        </mxCell>
        
        <mxCell id="equal_validator" value="EqualSplitValidator&#xa;&#xa;+ validateSplits(Expense)&#xa;  // Sum of splits == total&#xa;  // Each split = total/count" style="swimlane;fontStyle=1;align=left;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1080" y="360" width="200" height="100" as="geometry" />
        </mxCell>
        
        <mxCell id="percentage_validator" value="PercentageSplitValidator&#xa;&#xa;+ validateSplits(Expense)&#xa;  // Sum of %ages == 100%&#xa;  // Compute amounts" style="swimlane;fontStyle=1;align=left;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1320" y="360" width="220" height="100" as="geometry" />
        </mxCell>
        
        <!-- ExpenseType Enum -->
        <mxCell id="expense_type_enum" value="&lt;&lt;enum&gt;&gt;&#xa;ExpenseType&#xa;&#xa;EQUAL&#xa;PERCENTAGE&#xa;EXACT" style="swimlane;fontStyle=1;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1460" y="120" width="140" height="120" as="geometry" />
        </mxCell>
        
        <!-- SECTION 4: ER DIAGRAM -->
        <mxCell id="title_er" value="SECTION 4: ER DIAGRAM (Database Schema)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="900" height="30" as="geometry" />
        </mxCell>
        
        <!-- User Table -->
        <mxCell id="er_user" value="User&#xa;&#xa;PK  userId: INT&#xa;    userName: VARCHAR(100)&#xa;    email: VARCHAR(100)&#xa;    phone: VARCHAR(15)" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="220" height="120" as="geometry" />
        </mxCell>
        
        <!-- Group Table -->
        <mxCell id="er_group" value="Group&#xa;&#xa;PK  groupId: INT&#xa;    groupName: VARCHAR(100)&#xa;    createdDate: DATETIME" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="300" y="600" width="220" height="100" as="geometry" />
        </mxCell>
        
        <!-- UserGroup Table (Many-to-Many) -->
        <mxCell id="er_usergroup" value="UserGroup&#xa;&#xa;PK  id: INT&#xa;FK  userId: INT&#xa;FK  groupId: INT" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="560" y="600" width="180" height="100" as="geometry" />
        </mxCell>
        
        <!-- Expense Table -->
        <mxCell id="er_expense" value="Expense&#xa;&#xa;PK  expenseId: INT&#xa;FK  groupId: INT&#xa;FK  paidBy: INT (userId)&#xa;    description: VARCHAR(500)&#xa;    amount: DECIMAL(10,2)&#xa;    expenseType: ENUM&#xa;    createdDate: DATETIME" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="780" y="600" width="240" height="180" as="geometry" />
        </mxCell>
        
        <!-- Split Table -->
        <mxCell id="er_split" value="Split&#xa;&#xa;PK  splitId: INT&#xa;FK  expenseId: INT&#xa;FK  userId: INT&#xa;    amount: DECIMAL(10,2)&#xa;    percentage: DECIMAL(5,2)" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1060" y="600" width="220" height="140" as="geometry" />
        </mxCell>
        
        <!-- UserBalanceSheet Table -->
        <mxCell id="er_balance_sheet" value="UserBalanceSheet&#xa;&#xa;PK  id: INT&#xa;FK  userId: INT (owner)&#xa;FK  friendUserId: INT&#xa;    amountGetBack: DECIMAL(10,2)&#xa;    amountOwe: DECIMAL(10,2)&#xa;    lastUpdated: DATETIME" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="260" height="160" as="geometry" />
        </mxCell>
        
        <!-- Balance Simplification Example -->
        <mxCell id="balance_example" value="BALANCE SHEET STRUCTURE:&#xa;&#xa;User1:&#xa;  Friend1: {getBack: 500, owe: 0}&#xa;  Friend2: {getBack: 0, owe: 300}&#xa;  Friend3: {getBack: 200, owe: 0}&#xa;  Total: {getBack: 700, owe: 300}&#xa;&#xa;GRAPH SIMPLIFICATION (Advanced):&#xa;A owes B: 100&#xa;B owes C: 100&#xa;Simplified: A owes C: 100 (B removed)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="340" y="760" width="340" height="220" as="geometry" />
        </mxCell>
        
        <!-- SECTION 7: SCENARIO QUESTIONS -->
        <mxCell id="title_scenario" value="SECTION 7: SCENARIO QUESTIONS (Split Validation, Balance Management)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1080" y="540" width="820" height="30" as="geometry" />
        </mxCell>
        
        <!-- Scenario Box -->
        <mxCell id="scenario_box" value="Q1: Equal split of 1000 among 3 people. How much does each pay?&#xa;A1: EqualSplitValidator: 1000/3 = 333.33 each. Validation: 333.33 + 333.33 + 333.34 = 1000 ✓. One person gets 333.34 to handle rounding. Sum must exactly equal total.&#xa;&#xa;Q2: Percentage split: Friend1=50%, Friend2=30%, Friend3=20%. Amount=1000. Calculate and validate.&#xa;A2: PercentageSplitValidator: Friend1=500, Friend2=300, Friend3=200. Validate: (1) 50+30+20=100% ✓ (2) 500+300+200=1000 ✓. Both checks must pass.&#xa;&#xa;Q3: User1 paid 1000, split equally among User1, User2, User3. How to update balances?&#xa;A3: Each owes 333.33. User1: paid 1000, owes 333.33 → net +666.67 (get back). User2: paid 0, owes 333.33 → net -333.33 (owe to User1). User3: similar. Update User1's balanceSheet: {User2: +333.33, User3: +333.33}. User2's balanceSheet: {User1: -333.33}.&#xa;&#xa;Q4: Multiple expenses in group. How to simplify debts efficiently?&#xa;A4: Graph algorithm (mentioned by Splitwise CEO on Quora). Create debt graph with users as nodes, debts as edges. Find cycles and eliminate. Use min-cost max-flow to find minimum transactions needed to settle all debts. Advanced optimization.&#xa;&#xa;Q5: User leaves group mid-way. How to settle and remove?&#xa;A5: Calculate net balance for leaving user. If positive (others owe them), collect from group members proportionally. If negative (they owe others), they pay. Update remaining members' balance sheets. Remove user from group. Archive expense history for audit." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1080" y="600" width="820" height="380" as="geometry" />
        </mxCell>
        
        <!-- Design Pattern Box -->
        <mxCell id="pattern_box" value="KEY DESIGN PATTERNS:&#xa;&#xa;1. Factory Pattern - SplitFactory creates EQUAL or PERCENTAGE validators&#xa;2. Strategy Pattern - Different split strategies (equal, percentage, exact)&#xa;3. Graph Algorithms - Debt simplification using cycle detection&#xa;&#xa;VALIDATION LOGIC:&#xa;- EQUAL: Sum of splits == total, each split = total / count&#xa;- PERCENTAGE: Sum of percentages == 100%, computed amounts == total&#xa;- EXACT: User provides exact amounts, sum must equal total&#xa;&#xa;BALANCE SHEET:&#xa;- Per-user, per-friend granularity&#xa;- Map&lt;Friend, Balance&gt; for each user&#xa;- Balance has amountGetBack and amountOwe&#xa;- Prevents global balance confusion" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="720" y="800" width="1180" height="180" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
