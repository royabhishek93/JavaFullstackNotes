          <mxGeometry x="1440" y="80" width="160" height="160" as="geometry" />
        </mxCell>
        
        <!-- SECTION 4: ER DIAGRAM -->
        <mxCell id="title_er" value="SECTION 4: ER DIAGRAM (Database Schema)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="900" height="30" as="geometry" />
        </mxCell>
        
        <!-- Match Table -->
        <mxCell id="er_match" value="Match&#xa;&#xa;PK  matchId: INT&#xa;FK  teamAId: INT&#xa;FK  teamBId: INT&#xa;    venue: VARCHAR(200)&#xa;    matchDate: DATETIME&#xa;    matchType: ENUM&#xa;FK  tossWinnerId: INT" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="220" height="180" as="geometry" />
        </mxCell>
        
        <!-- Team Table -->
        <mxCell id="er_team" value="Team&#xa;&#xa;PK  teamId: INT&#xa;    teamName: VARCHAR(100)" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="300" y="720" width="220" height="90" as="geometry" />
        </mxCell>
        
        <!-- Player Table -->
        <mxCell id="er_player" value="Player&#xa;&#xa;PK  playerId: INT&#xa;FK  teamId: INT&#xa;    playerName: VARCHAR(100)&#xa;    playerType: ENUM&#xa;    address: VARCHAR(500)" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="560" y="720" width="220" height="140" as="geometry" />
        </mxCell>
        
        <!-- BattingScoreCard Table -->
        <mxCell id="er_batting" value="BattingScoreCard&#xa;&#xa;PK  scoreCardId: INT&#xa;FK  playerId: INT&#xa;FK  matchId: INT&#xa;    totalRuns: INT&#xa;    totalBalls: INT&#xa;    totalFours: INT&#xa;    totalSixes: INT&#xa;    strikeRate: DECIMAL(5,2)" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="820" y="720" width="240" height="200" as="geometry" />
        </mxCell>
        
        <!-- BowlingScoreCard Table -->
        <mxCell id="er_bowling" value="BowlingScoreCard&#xa;&#xa;PK  scoreCardId: INT&#xa;FK  playerId: INT&#xa;FK  matchId: INT&#xa;    oversDelivered: DECIMAL(3,1)&#xa;    runsGiven: INT&#xa;    wicketsTaken: INT&#xa;    noBalls: INT&#xa;    wideBalls: INT&#xa;    economyRate: DECIMAL(5,2)" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1100" y="720" width="260" height="220" as="geometry" />
        </mxCell>
        
        <!-- Innings Table -->
        <mxCell id="er_innings" value="Innings&#xa;&#xa;PK  inningsId: INT&#xa;FK  matchId: INT&#xa;FK  battingTeamId: INT&#xa;FK  bowlingTeamId: INT&#xa;    inningsNumber: INT" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="940" width="220" height="140" as="geometry" />
        </mxCell>
        
        <!-- Over Table -->
        <mxCell id="er_over" value="Over&#xa;&#xa;PK  overId: INT&#xa;FK  inningsId: INT&#xa;FK  bowledBy: INT (playerId)&#xa;    overNumber: INT" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="300" y="940" width="220" height="120" as="geometry" />
        </mxCell>
        
        <!-- Ball Table -->
        <mxCell id="er_ball" value="Ball&#xa;&#xa;PK  ballId: INT&#xa;FK  overId: INT&#xa;FK  playedBy: INT (playerId)&#xa;FK  bowledBy: INT (playerId)&#xa;    ballNumber: INT&#xa;    ballType: ENUM&#xa;    runType: ENUM&#xa;    timestamp: DATETIME" style="swimlane;fontStyle=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="560" y="940" width="240" height="200" as="geometry" />
        </mxCell>
        
        <!-- SECTION 7: SCENARIO QUESTIONS -->
        <mxCell id="title_scenario" value="SECTION 7: SCENARIO QUESTIONS (Real-time Score Updates)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1430" y="660" width="450" height="30" as="geometry" />
        </mxCell>
        
        <!-- Scenario Box -->
        <mxCell id="scenario_box" value="Q1: Ball is bowled, multiple scorecards need update. How to ensure all update?&#xa;A1: Observer pattern. Ball maintains list of ScoreUpdaters. After ball bowled, notifyObservers() called. Each observer (BattingUpdater, BowlingUpdater) updates respective scorecard. Decoupled design.&#xa;&#xa;Q2: Same bowler tries to bowl consecutive overs. How to prevent?&#xa;A2: PlayerBowlingController uses Deque. After over complete, remove bowler from front. Check remaining overs allowed. If allowed, add to back. Next bowler always from front of queue.&#xa;&#xa;Q3: Need to support T20, ODI, Test matches. Different rules. How?&#xa;A3: Strategy pattern with MatchType. T20Strategy: 20 overs, max 4 per bowler. ODI: 50 overs, max 10. Test: unlimited. Each strategy implements getMaxOvers(), getMaxOversPerBowler().&#xa;&#xa;Q4: Mid-match need current run rate, required rate. How to calculate?&#xa;A4: Query BattingScoreCard for total runs, total balls. Current RR = (runs * 6) / balls. Required RR = ((target - runs) * 6) / balls_remaining. Real-time computation from scorecards.&#xa;&#xa;Q5: 10,000 users refreshing scorecard every second. How to scale?&#xa;A5: WebSocket for push updates (not polling). Redis cache for current score. Read replicas for historical data. CDN for static assets. Event-driven architecture with message queue." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1430" y="720" width="450" height="420" as="geometry" />
        </mxCell>
        
        <!-- Design Pattern Box -->
        <mxCell id="pattern_box" value="KEY DESIGN PATTERNS:&#xa;&#xa;1. Observer Pattern - Ball notifies multiple ScoreUpdaters&#xa;2. Strategy Pattern - Different match types (T20, ODI, Test)&#xa;3. Queue/Deque - Batting order, bowling rotation&#xa;&#xa;DATA STRUCTURES:&#xa;- Queue: Batsmen yet to play (FIFO)&#xa;- Deque: Bowler rotation (remove from front, add to back)&#xa;- Map: Bowler → over count tracking" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="840" y="960" width="520" height="180" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
